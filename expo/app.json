{
  "expo": {
    "name": "WhaleChat",
    "slug": "whalechat",
    "version": "3.65.0",
    "orientation": "portrait",
    "scheme": "whalechat",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#04101a",
    "splash": {
      "backgroundColor": "#04101a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.whalechat.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "app.whalechat.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#04101a"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "webUrl": "https://whalechat.appwrite.network/whalechat.html",
      "eas": {
        "projectId": "c114889f-0f49-4647-9be2-92ad1a6cdef1"
      }
    },
    "owner": "whalechat.com",
    "sdkVersion": "52.0.0",
    "plugins": [
      "expo-asset"
    ]
  }
}
