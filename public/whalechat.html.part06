          ${m.note ? `<div class="tiny" style="color:var(--warn)">${esc(m.note)}</div>` : ''}</div>
        <div class="row gap4"><button class="btn btn-xs btn-ghost" data-act="crypto-edit" data-id="${m.id}">${ic('edit', 11)}</button>
        <button class="btn btn-xs btn-ghost" data-act="crypto-del" data-id="${m.id}">${ic('trash', 11)}</button></div></div>`).join('') : '<p class="tiny muted">No crypto methods.</p>'}
    </div>
    <div class="card">
      <div class="between mb16"><h3 style="font-size:15px">Bank transfer methods</h3>
        <button class="btn btn-sm btn-primary" data-act="bank-new">${ic('plus', 14)} Add</button></div>
      ${(s.banks || []).length ? (s.banks || []).map(b => `<div class="list-item" style="align-items:flex-start">
        <div style="width:30px;height:30px;border-radius:8px;background:rgba(58,160,255,.13);color:var(--accent-2);display:flex;align-items:center;justify-content:center;flex:none">${ic('store', 14)}</div>
        <div class="grow" style="min-width:0"><div class="small" style="font-weight:650">${esc(b.bankName)}</div>
          <div class="tiny muted">${esc(b.accountName)} · ${esc(b.accountNumber)}</div>
          <div class="tiny muted">${esc(b.swift || '')} ${esc(b.country || '')}</div></div>
        <div class="row gap4"><button class="btn btn-xs btn-ghost" data-act="bank-edit" data-id="${b.id}">${ic('edit', 11)}</button>
        <button class="btn btn-xs btn-ghost" data-act="bank-del" data-id="${b.id}">${ic('trash', 11)}</button></div></div>`).join('') : '<p class="tiny muted">No bank methods.</p>'}
    </div>
  </div>
  <div class="card mt16">
    <div class="between mb16"><h3 style="font-size:15px">USDT withdrawal networks</h3>
      <button class="btn btn-sm btn-primary" data-act="network-add">${ic('plus', 14)} Add network</button></div>
    <div class="row wrap gap8">${(s.networks || []).map(n => `<span class="badge" style="padding:7px 10px;font-size:12px">${esc(n)}
      <button data-act="network-del" data-id="${esc(n)}" style="color:var(--danger);margin-left:4px">${ic('x', 11)}</button></span>`).join('')}</div>
    <div class="divider"></div>
    <div class="field"><label class="label">Deposit instructions note</label><textarea class="input" id="asDepNote" style="min-height:70px">${esc(s.depositNote || '')}</textarea></div>
    <div class="row gap8"><button class="btn btn-primary btn-sm" data-act="save-settings">${ic('check', 14)} Save payment settings</button>
      <button class="btn btn-ghost btn-sm" data-act="edit-networks">Manage networks</button></div>
  </div>
  <div class="card mt16">
    <div class="between wrap gap10">
      <div><h3 style="font-size:15px">Vendor plans & activation fees</h3>
        <p class="tiny muted mt6">Applicants pick a duration, pay its fee to the company account and upload a slip. Vendors freeze automatically when their plan ends.</p></div>
      <button class="btn btn-xs btn-primary" data-act="vendor-plan-new">${ic('plus', 12)} Add plan</button>
    </div>
    <div class="table-wrap mt14"><table class="tbl"><thead><tr><th>Duration</th><th>Fee</th><th style="text-align:right">Actions</th></tr></thead><tbody>
      ${(DB.settings.vendorPlans || []).map(pl => `<tr><td style="font-weight:600">${pl.months} month${pl.months > 1 ? 's' : ''}</td><td>${usd(pl.priceUsd)}</td>
        <td><div class="row gap6" style="justify-content:flex-end">
          <button class="btn btn-xs btn-ghost" data-act="vendor-plan-edit" data-id="${pl.id}">${ic('edit', 11)}</button>
          <button class="btn btn-xs btn-ghost" data-act="vendor-plan-del" data-id="${pl.id}">${ic('trash', 11)}</button></div></td></tr>`).join('') || `<tr><td colspan="3" class="center muted" style="padding:18px">No plans yet</td></tr>`}
    </tbody></table></div>
    <div class="between mb10 mt16"><div class="label" style="margin:0">Company payment accounts</div>
      <button class="btn btn-xs btn-primary" data-act="vendor-method-new">${ic('plus', 12)} Add account</button></div>
    ${vendorPayMethods().length ? `<div class="col gap8">${vendorPayMethods().map(m => `<div class="list-item" style="align-items:flex-start">
      <div style="width:30px;height:30px;border-radius:8px;background:rgba(46,230,201,.12);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none">${ic('wallet', 14)}</div>
      <div class="grow" style="min-width:0"><div class="small" style="font-weight:650">${esc(m.label)} ${m.network ? `<span class="badge" style="font-size:9px">${esc(m.network)}</span>` : ''}</div>
        <div class="tiny muted" style="word-break:break-all">${esc(m.address)}</div></div>
      <div class="row gap4"><button class="btn btn-xs btn-ghost" data-act="copy" data-id="${esc(m.address)}">${ic('copy', 11)}</button>
        <button class="btn btn-xs btn-ghost" data-act="vendor-method-edit" data-id="${esc(m.id)}">${ic('edit', 11)}</button>
        <button class="btn btn-xs btn-ghost" data-act="vendor-method-del" data-id="${esc(m.id)}">${ic('trash', 11)}</button></div></div>`).join('')}</div>` : '<p class="tiny muted">No vendor payment accounts yet — applicants cannot pay.</p>'}
    <div class="field mt14"><label class="label">Payment instructions</label><input class="input" id="vendorPayNote" value="${esc((DB.settings.vendorPayments && DB.settings.vendorPayments.note) || '')}"/></div>
    <button class="btn btn-primary btn-sm" data-act="save-vendor-fee">${ic('check', 14)} Save payment instructions</button>
  </div>
  <div class="card mt16">
    <div class="between wrap gap10">
      <div><h3 style="font-size:15px">App link &amp; invite links</h3>
        <p class="tiny muted mt6">This is the public link users see when they tap <b>Invite friends</b> and the link copied from their referral page. Leave it empty to use the address that served the app.</p></div>
      <span class="badge ${appLinkBase() ? 'badge-success' : ''}">${appLinkBase() ? 'Custom link' : 'Automatic'}</span>
    </div>
    <div class="field mt14"><label class="label">Custom app link (branded)</label>
      <input class="input" id="asAppLink" placeholder="https://whalechat.com" value="${esc(s.appLink || '')}"/>
      <div class="help">The short, branded link users share — e.g. <b>https://whalechat.com/ref/CODE</b>. Must start with http:// or https://</div></div>
    <div class="field"><label class="label">Main app link (destination)</label>
      <input class="input" id="asAppDest" placeholder="${esc(location.origin + '/whalechat.html')}" value="${esc(s.appLinkDestination || '')}"/>
      <div class="help">Where the branded link sends visitors — paste the real app URL (e.g. your hosted <b>/whalechat.html</b>). If empty, the app URL that served this page is used.</div></div>
    <div class="field"><label class="label">Invite message</label>
      <textarea class="input" id="asInviteMsg" style="min-height:88px" placeholder="Join me on WhaleChat…">${esc(s.inviteMessage || '')}</textarea>
      <div class="help">Placeholders: <b>{link}</b> (full invite link), <b>{code}</b> (referral code), <b>{name}</b> (your name)</div></div>
    <div class="panel" style="padding:11px 12px">
      <div class="tiny muted">Shared invite link (branded)</div>
      <div class="small mt6" id="asInvitePreview" style="word-break:break-all;color:var(--accent)">${esc(referralLink(me().referralCode))}</div>
      <div class="tiny muted mt10">Redirects to</div>
      <div class="small mt6" id="asDestPreview" style="word-break:break-all">${esc(destinationLink(me().referralCode) || location.origin + '/whalechat.html')}</div>
    </div>
    <div class="row gap8 mt12 wrap">
      <button class="btn btn-primary btn-sm" data-act="save-app-link">${ic('check', 14)} Save app link</button>
      <button class="btn btn-ghost btn-sm" data-act="copy" data-id="${esc(referralLink(me().referralCode))}">${ic('copy', 14)} Copy preview</button>
    </div>
  </div>
  <div class="card mt16">
    <div class="between wrap gap10">
      <div><h3 style="font-size:15px">Google Analytics</h3>
        <p class="tiny muted mt6">Track page views across the web app and installed apps with a GA4 measurement ID. Analytics loads only for the ID saved here.</p></div>
      <span class="badge ${(gaMeasurementId() || gtmInstalled()) ? 'badge-success' : ''}">${gtmInstalled() ? 'Tag Manager · GTM-5WNCBL8N' : (gaMeasurementId() ? 'Connected · ' + esc(gaMeasurementId()) : 'Not set')}</span>
    </div>
    <div class="field mt14"><label class="label">GA4 measurement ID</label>
      <input class="input" id="asGaId" placeholder="G-XXXXXXXXXX" value="${esc(s.gaMeasurementId || '')}" autocomplete="off"/>
      <div class="help">Find it in Google Analytics → Admin → Data streams → your web stream. Leave empty to disable analytics.</div></div>
    <div class="row gap8 mt6 wrap">
      <button class="btn btn-primary btn-sm" data-act="save-ga">${ic('check', 14)} Save analytics</button>
      ${gaMeasurementId() ? `<button class="btn btn-ghost btn-sm" data-act="copy" data-id="${esc(gaMeasurementId())}">${ic('copy', 14)} Copy ID</button>` : ''}
    </div>
    <div class="tiny muted mt10" style="line-height:1.6">${gtmInstalled()
      ? 'Google Tag Manager (<b>GTM-5WNCBL8N</b>) is installed in the page &lt;head&gt; and receives <b>page_view</b> events on every route change. Configure the GA4 tag inside Tag Manager — no second Google tag is added here.'
      : 'Events sent: <b>page_view</b> on every route change, plus the app version and platform. No message contents are sent.'}</div>
  </div>
  <div class="card mt16">
    <div class="between wrap gap10">
      <div><h3 style="font-size:15px">Email notifications</h3>
        <p class="tiny muted mt6">Account-creation and package-delivery emails are sent through the app's mail provider (Brevo, Resend or Outlook SMTP, whichever is configured). Delivery is queued and retried, so a temporary mail outage never loses a notification.</p></div>
      <span class="badge" id="emailBadge">Checking…</span>
    </div>
    <div class="mt14" id="emailStatus"><div class="tiny muted">Reading mail settings…</div></div>
    <div class="field mt14"><label class="label">Send a test email</label>
      <div class="row gap8"><input class="input" id="emailTestTo" placeholder="you@email.com" value="${esc(me().email || '')}"/>
      <button class="btn btn-primary btn-sm" data-act="email-test">${ic('send', 14)} Send</button></div>
      <div class="help">Uses the SMTP mailbox configured on the server.</div></div>
    <div class="tiny muted mt10" style="line-height:1.6">Triggers: <b>account created</b> and <b>order marked delivered</b>.</div>
  </div>
  <div class="card mt16">
    <div class="between wrap gap10">
      <div><h3 style="font-size:15px">Login without password</h3>
        <p class="tiny muted mt6">When enabled, users sign in with their registered email or username and <b>any password</b>.</p></div>
      <div class="switch ${DB.settings.allowAnyPassword ? 'on' : ''}" data-act="toggle-anypass"></div>
    </div>
    <div class="tiny mt10" style="color:${DB.settings.allowAnyPassword ? 'var(--warn)' : 'var(--muted)'}">
      ${DB.settings.allowAnyPassword ? 'Currently ON — anyone who knows a username or email can enter that account.' : 'Currently OFF — normal password checks apply.'}
    </div>
  </div>
  <div class="card mt16">
    <div class="between wrap gap10">
      <div><h3 style="font-size:15px">Maintenance mode</h3>
        <p class="tiny muted mt6">Show a full-page maintenance notice with a live countdown. Access returns automatically when it ends — or end it now.</p></div>
      ${maintenanceInfo().active ? '<span class="badge badge-warn">Active</span>' : '<span class="badge badge-success">Offline off</span>'}
    </div>
    ${maintenanceInfo().active ? `<div class="panel mt14" style="padding:12px">
      <div class="between"><span class="tiny muted">Ends</span><span class="small" style="font-weight:600">${new Date(maintenanceInfo().until).toLocaleString()}</span></div>
      <div class="between mt6"><span class="tiny muted">Remaining</span><span class="small mono" style="font-weight:700;color:var(--accent)" id="adminMaintRemaining">—</span></div>
      <div class="row gap8 mt12"><button class="btn btn-danger btn-sm" data-act="maint-end">${ic('ban', 14)} End maintenance now</button></div>
    </div>` : ''}
    <div class="grid2 mt14" style="display:grid;grid-template-columns:130px 1fr;gap:12px">
      <div class="field"><label class="label">Duration (min)</label><input class="input" id="maintMinutes" type="number" min="1" step="1" value="${DB.settings.maintenance && DB.settings.maintenance.enabled ? Math.max(1, Math.round((DB.settings.maintenance.until - Date.now()) / 60000)) : 30}"/></div>
      <div class="field"><label class="label">Maintenance notice</label><input class="input" id="maintMessage" value="${esc((DB.settings.maintenance && DB.settings.maintenance.message) || 'WhaleChat is being upgraded to serve you better. We will be back very soon.')}"/></div>
    </div>
    <div class="row gap8 mt6 wrap">
      <button class="btn btn-primary btn-sm" data-act="maint-start">${ic('clock', 14)} ${maintenanceInfo().active ? 'Update countdown' : 'Start maintenance'}</button>
      ${maintenanceInfo().active ? `<button class="btn btn-ghost btn-sm" data-act="maint-end">End now</button>` : ''}
    </div>
  </div>
  <div class="card mt16">
    <h3 style="font-size:15px">Admin security</h3>
    <p class="tiny muted mt6">Change the administrator password. Default credentials should be replaced on first login.</p>
    <div class="row gap8 mt16"><button class="btn btn-ghost btn-sm" data-act="admin-change-password">${ic('lock', 14)} Change admin password</button>
      <a href="#/admin" class="btn btn-ghost btn-sm">${ic('grid', 14)} Back to overview</a></div>
  </div>
  <style>@media(max-width:860px){.dash2{grid-template-columns:1fr!important}}</style>`;
}
function bindSettings() {
  const n = document.getElementById('asDepNote');
  if (n) n.oninput = () => { DB.settings.depositNote = n.value; persist(); };
  const link = document.getElementById('asAppLink');
  const prev = document.getElementById('asInvitePreview');
  const dest = document.getElementById('asAppDest');
  const dprev = document.getElementById('asDestPreview');
  const code = (me() && me().referralCode) || 'CODE';
  const syncPreview = () => {
    const v = (link && link.value || '').trim().replace(/\/+$/, '');
    const base = /^https?:\/\/[^\s]+$/i.test(v) ? v : (window.__WC_SERVER__ ? location.origin : location.origin + location.pathname.replace(/\/[^/]*$/, ''));
    if (prev) prev.textContent = base + '/ref/' + encodeURIComponent(code);
    if (dprev) {
      const raw = (dest && dest.value || '').trim();
      dprev.textContent = /^https?:\/\//i.test(raw) ? raw : (location.origin + '/whalechat.html');
    }
  };
  if (link) link.oninput = syncPreview;
  if (dest) dest.oninput = syncPreview;
  loadEmailPanel();
}
App.saveSettings = function () {
  const n = document.getElementById('asDepNote');
  if (n) DB.settings.depositNote = n.value;
  sync(); toast('Payment settings saved', 'ok');
};
App.cryptoNew = function () { cryptoForm(null); };
App.cryptoEdit = function (id) { cryptoForm((DB.settings.crypto || []).find(m => m.id === id)); };
function qrField(inputId, prevId, current) {
  return `<div class="field"><label class="label">Payment QR code (optional)</label>
    <div class="row gap10" style="align-items:center">
      <div id="${prevId}" class="qr-preview">${current ? `<img src="${current}" alt="QR"/>` : ic('grid', 22)}</div>
      <div class="grow"><input class="input" type="file" id="${inputId}" accept="image/*" onchange="previewQrInput(this,'${prevId}')"/>
        <div class="help">Upload the QR users should scan with their exchange wallet.</div></div>
    </div></div>`;
}
window.previewQrInput = async function (input, prevId) {
  const f = input.files && input.files[0];
  if (!f) return;
  try {
    const c = await compressImage(f, 640, 0.9);
    const d = await fileToDataURL(c);
    input.dataset.qr = d;
    const box = document.getElementById(prevId);
    if (box) box.innerHTML = `<img src="${d}" alt="QR"/>`;
  } catch (e) { toast('Could not read that image', 'err'); }
};
function qrFromInput(inputId) {
  const el = document.getElementById(inputId);
  return el && el.dataset ? el.dataset.qr || null : null;
}

App.viewQr = function (id, ds) {
  const kind = (ds && ds.kind) || 'crypto';
  const list = kind === 'bank' ? (DB.settings.banks || []) : (DB.settings.crypto || []);
  const m = list.find(x => x.id === id);
  if (!m || !m.qr) return;
  openModal(modalShell('Scan to pay', `
    <img class="qr-big" src="${m.qr}" alt="Payment QR"/>
    <div class="center small mt14" style="font-weight:650">${esc(m.name || m.bankName || '')}</div>
    <div class="center tiny muted mt6" style="word-break:break-all">${esc(m.address || m.accountNumber || '')}</div>
    <div class="center tiny muted mt10">Open your exchange wallet → Scan → send the exact amount.</div>`,
    `<button class="btn btn-ghost" data-close style="flex:1">Close</button>
     <button class="btn btn-primary" data-act="copy" data-id="${esc(m.address || m.accountNumber || '')}" style="flex:1">${ic('copy', 14)} Copy details</button>`), { width: '480px' });
};

function cryptoForm(m) {
  openModal(modalShell(m ? 'Edit crypto method' : 'Add crypto method', `
    ${field('Name', 'cfName', { value: m ? m.name : '', ph: 'e.g. USDT (TRC20)' })}
    ${field('Network badge', 'cfNet', { value: m ? m.network : '', ph: 'TRC20' })}
    ${field('Wallet address', 'cfAddr', { value: m ? m.address : '', ph: 'Paste deposit address' })}
    <div class="field"><label class="label">Note</label><textarea class="input" id="cfNote" style="min-height:70px">${esc(m ? m.note || '' : '')}</textarea></div>
    ${qrField('cfQr', 'cfQrPrev', m ? m.qr : null)}`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="crypto-save" data-id="${m ? m.id : ''}">Save</button>`));
}
App.cryptoSave = function (id) {
  const name = document.getElementById('cfName').value.trim();
  const addr = document.getElementById('cfAddr').value.trim();
  if (!name || !addr) return toast('Name and address are required', 'err');
  const qr = qrFromInput('cfQr');
  DB.settings.crypto = DB.settings.crypto || [];
  if (id) {
    const m = DB.settings.crypto.find(x => x.id === id); if (m) { Object.assign(m, { name, address: addr, network: document.getElementById('cfNet').value.trim(), note: document.getElementById('cfNote').value.trim() }); if (qr) m.qr = qr; }
  } else {
    DB.settings.crypto.push({ id: uid('cr'), name, address: addr, network: document.getElementById('cfNet').value.trim(), note: document.getElementById('cfNote').value.trim(), qr: qr || null });
  }
  sync(); closeModal(); toast('Deposit method saved', 'ok'); render();
};
App.cryptoDel = async function (id) {
  if (!await confirmDialog({ title: 'Remove crypto method?', danger: true, ok: 'Remove' })) return;
  DB.settings.crypto = (DB.settings.crypto || []).filter(m => m.id !== id); sync(); render();
};
App.bankNew = function () { bankForm(null); };
App.bankEdit = function (id) { bankForm((DB.settings.banks || []).find(b => b.id === id)); };
function bankForm(b) {
  openModal(modalShell(b ? 'Edit bank method' : 'Add bank method', `
    ${field('Bank name', 'bfBank', { value: b ? b.bankName : '' })}
    ${field('Account name', 'bfName', { value: b ? b.accountName : '' })}
    ${field('Account number', 'bfNum', { value: b ? b.accountNumber : '' })}
    <div class="grid2" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      ${field('SWIFT / BIC', 'bfSwift', { value: b ? b.swift || '' : '' })}
      ${field('Routing number', 'bfRoute', { value: b ? b.routing || '' : '' })}
    </div>
    ${field('Country', 'bfCountry', { value: b ? b.country || '' : '' })}
    <div class="field"><label class="label">Note</label><textarea class="input" id="bfNote" style="min-height:70px">${esc(b ? b.note || '' : '')}</textarea></div>
    ${qrField('bfQr', 'bfQrPrev', b ? b.qr : null)}`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="bank-save" data-id="${b ? b.id : ''}">Save</button>`), { width: '520px' });
}
