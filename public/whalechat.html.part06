coins)} WC</div>
            <div class="tiny muted">${esc(b ? b.username : '')} · ${esc(d.methodName)}</div></div>
            <div class="row gap6"><button class="btn btn-xs btn-primary" data-act="dep-approve" data-id="${d.id}">Approve</button></div></div>`;
        }).join('') : `<div class="empty" style="padding:18px"><p>No pending deposits.</p></div>`}
      </div>
    </div>
    <div class="card mt16">
      <div class="section-title"><h3>Newest users</h3><a href="#/admin/users" class="link tiny">All users</a></div>
      ${users.slice().sort((a, b) => b.createdAt - a.createdAt).slice(0, 5).map(x => `<div class="between" style="padding:9px 0;border-bottom:1px dashed var(--border)">
        <div class="row gap10">${avatarHTML(x, 'sm')}<div><div class="small" style="font-weight:600">${esc(x.fullName)}</div><div class="tiny muted">@${esc(x.username)} · ${dateLabel(x.createdAt)}</div></div></div>
        <div class="row gap8"><span class="small" style="font-weight:600">${coins(x.balance)} WC</span><button class="btn btn-xs btn-ghost" data-act="admin-user" data-id="${x.id}">Manage</button></div></div>`).join('') || '<p class="muted small">No users yet.</p>'}
    </div>
    <style>@media(max-width:860px){.dash2{grid-template-columns:1fr!important}}</style>`;
}

let ADMIN_USER_Q = '';
function adminUsers(params) {
  const q = (params.q || ADMIN_USER_Q || '').toLowerCase();
  const users = DB.users.filter(u => u.role !== 'admin' && (!q || u.fullName.toLowerCase().includes(q) || u.username.toLowerCase().includes(q) || u.email.toLowerCase().includes(q)));
  return `<div class="card">
    <div class="between wrap gap10 mb16">
      <div class="searchbar" style="width:min(100%,320px)">${ic('search', 16)}<input id="adminUserSearch" placeholder="Search users…" value="${esc(q)}"/></div>
      <div class="row gap8"><span class="badge">${users.length} users</span><button class="btn btn-sm btn-ghost" data-act="admin-export" data-id="users">${ic('download', 14)} Export</button></div>
    </div>
    <div class="table-wrap"><table class="tbl"><thead><tr><th>User</th><th>Balance</th><th>Trust</th><th>Status</th><th>Joined</th><th style="text-align:right">Actions</th></tr></thead><tbody>
      ${users.length ? users.map(x => `<tr>
        <td><div class="row gap8">${avatarHTML(x, 'sm')}<div><div style="font-weight:600">${esc(x.fullName)} ${vendorOf(x.id) ? '<span class="badge" style="font-size:9px">Vendor</span>' : ''}</div><div class="tiny muted">@${esc(x.username)} · ${esc(x.email)}</div></div></div></td>
        <td style="font-weight:600">${coins(x.balance)} <span class="tiny muted">WC</span></td>
        <td>${x.trustScore}/100</td>
        <td>${x.banned ? '<span class="badge badge-danger">Banned</span>' : '<span class="badge badge-success">Active</span>'}</td>
        <td class="muted">${dateLabel(x.createdAt)}</td>
        <td><div class="row gap6" style="justify-content:flex-end">
          <button class="btn btn-xs btn-ghost" data-act="admin-user" data-id="${x.id}">Manage</button>
          <button class="btn btn-xs btn-ghost" data-act="admin-msg-user" data-id="${x.id}" title="Support chat">${ic('chat', 12)}</button>
          <button class="btn btn-xs btn-ghost" data-act="admin-login-as" data-id="${x.id}" title="Log in as user">${ic('key', 12)}</button>
          <button class="btn btn-xs ${x.banned ? 'btn-soft' : 'btn-danger'}" data-act="admin-ban" data-id="${x.id}">${x.banned ? 'Unban' : 'Ban'}</button>
          <button class="btn btn-xs btn-danger" data-act="admin-del-user" data-id="${x.id}">${ic('trash', 12)}</button>
        </div></td></tr>`).join('') : `<tr><td colspan="6" class="center muted" style="padding:30px">No users found</td></tr>`}
    </tbody></table></div>
  </div>`;
}
App.adminUser = function (id) {
  const x = findUser(id); if (!x) return;
  const v = vendorOf(id);
  openModal(modalShell('Manage user', `
    <div class="row gap12 mb16">${avatarHTML(x, 'lg')}
      <div><div style="font-weight:650">${esc(x.fullName)}</div><div class="small muted">@${esc(x.username)}</div>
      <div class="row gap6 mt6">${v ? `<span class="badge badge-accent">Vendor @${esc(v.username)}</span>` : ''}<span class="badge">${x.banned ? 'Banned' : 'Active'}</span></div></div></div>
    <div class="grid2" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      ${field('Whale Coin balance', 'auBal', { type: 'number', value: x.balance, inputmode: 'decimal' })}
      ${field('Trust score (0–100)', 'auTrust', { type: 'number', value: x.trustScore })}
      ${field('Completed sales', 'auSales', { type: 'number', value: x.completedSales || 0 })}
      ${field('Total earnings (WC)', 'auEarn', { type: 'number', value: x.totalEarnings || 0 })}
    </div>
    <div class="kv"><span class="k">Email</span><span class="v">${esc(x.email)}</span></div>
    <div class="kv"><span class="k">Phone</span><span class="v">${esc(x.phone || '—')}</span></div>
    <div class="kv"><span class="k">Total deposits</span><span class="v">${coins(x.totalDeposits || 0)} WC</span></div>
    <div class="kv"><span class="k">Total withdrawals</span><span class="v">${coins(x.totalWithdrawals || 0)} WC</span></div>
    <div class="kv"><span class="k">Withdrawal PIN</span><span class="v">${x.pin ? 'Set' : 'Not set'}</span></div>
    <div class="mt16 col gap8">
      <button class="btn btn-ghost btn-block" data-act="admin-credit" data-id="${x.id}">${ic('wallet', 15)} Add Whale Coin</button>
      <button class="btn btn-ghost btn-block" data-act="admin-notify-user" data-id="${x.id}">${ic('bell', 15)} Send notification</button>
      <button class="btn btn-ghost btn-block" data-act="admin-msg-user" data-id="${x.id}" data-close>${ic('chat', 15)} Open support chat</button>
      <button class="btn btn-soft btn-block" data-act="admin-login-as" data-id="${x.id}">${ic('key', 15)} Log in as this user (no password)</button>
      <button class="btn ${x.banned ? 'btn-soft' : 'btn-danger'} btn-block" data-act="admin-ban" data-id="${x.id}">${x.banned ? 'Unban account' : 'Ban account'}</button>
    </div>`,
    `<button class="btn btn-ghost" data-close style="flex:1">Close</button><button class="btn btn-primary" data-act="admin-save-user" data-id="${x.id}" style="flex:1">Save changes</button>`), { width: '520px' });
};
App.adminSaveUser = function (id) {
  const x = findUser(id); if (!x) return;
  const bal = Number(document.getElementById('auBal').value);
  const trust = Number(document.getElementById('auTrust').value);
  const sales = Number(document.getElementById('auSales').value);
  const earn = Number(document.getElementById('auEarn').value);
  if (isNaN(bal) || bal < 0) return toast('Invalid balance', 'err');
  const diff = Math.round((bal - x.balance) * 100) / 100;
  x.balance = Math.round(bal * 100) / 100;
  x.trustScore = Math.max(0, Math.min(100, trust || 0));
  x.completedSales = Math.max(0, sales || 0);
  x.totalEarnings = Math.round((earn || 0) * 100) / 100;
  if (diff) tx(x.id, diff > 0 ? 'deposit' : 'withdrawal', 'Admin balance adjustment', diff);
  notify(x.id, 'Account updated', 'Your account settings were updated by the WhaleChat team.', '#/profile', 'settings');
  sync(); closeModal(); toast('User updated', 'ok'); render();
};
App.adminCredit = async function (id) {
  const v = await promptDialog({ title: 'Add Whale Coin', label: 'Amount in WC (negative to deduct)', type: 'number', placeholder: '10' });
  if (!v) return;
  const amt = Number(v);
  if (!isFinite(amt) || amt === 0) return toast('Enter a valid amount', 'err');
  const x = findUser(id); if (!x) return;
  x.balance = Math.round((x.balance + amt) * 100) / 100;
  tx(x.id, amt > 0 ? 'deposit' : 'withdrawal', 'Admin credit', amt);
  notify(x.id, amt > 0 ? 'Wallet credited' : 'Wallet adjusted', `${coins(Math.abs(amt))} WC ${amt > 0 ? 'added to' : 'deducted from'} your balance by the WhaleChat team.`, '#/wallet', 'wallet');
  sync(); closeModal(); toast('Balance updated', 'ok'); render();
};
App.adminBan = async function (id) {
  const x = findUser(id); if (!x) return;
  if (!x.banned) {
    if (!await confirmDialog({ title: 'Ban this user?', body: 'They will not be able to sign in.', danger: true, ok: 'Ban' })) return;
    x.banned = true;
    notify(x.id, 'Account suspended', 'Your account has been suspended. Contact support for assistance.', null, 'ban');
  } else x.banned = false;
  sync(); closeModal(); toast(x.banned ? 'User banned' : 'User unbanned', 'ok'); render();
};
App.adminDeleteUser = async function (id) {
  const x = findUser(id); if (!x) return;
  if (!await confirmDialog({ title: 'Delete user?', body: 'This permanently removes the account, its vendor profile and notifications. Orders are kept for records.', danger: true, ok: 'Delete' })) return;
  DB.users = DB.users.filter(u => u.id !== id);
  DB.vendors = DB.vendors.filter(v => v.userId !== id);
  DB.contacts = DB.contacts.filter(c => c.ownerId !== id && c.userId !== id);
  DB.notifications = DB.notifications.filter(n => n.userId !== id);
  sync(); toast('User deleted', 'ok'); render();
};
App.adminMsgUser = function (id) {
  const admin = me();
  if (!isContact(admin.id, id)) DB.contacts.push({ id: uid('ct'), ownerId: admin.id, userId: id, createdAt: Date.now() });
  sync(); closeModal(); go('chat/' + id);
};

function adminVendorRequests() {
  const list = (DB.vendorApplications || []).slice().sort((a, b) => (a.status === 'pending' ? -1 : 1) - (b.status === 'pending' ? -1 : 1) || b.createdAt - a.createdAt);
  const pending = list.filter(a => a.status === 'pending');
  return `<div class="card mb16" style="background:linear-gradient(120deg,rgba(46,230,201,.08),rgba(58,160,255,.05))">
      <div class="between wrap gap10">
        <div><h3 style="font-size:15px">Vendor activation payments</h3>
          <p class="tiny muted mt6">Review the uploaded payment slip, then approve to unlock the applicant's vendor dashboard.</p></div>
        <div class="row gap8"><span class="badge badge-warn">${pending.length} pending</span>
          <a href="#/admin/settings" class="btn btn-xs btn-ghost">${ic('settings', 12)} Fee & payment accounts</a></div>
      </div>
      <div class="grid-kpi k4 mt14">
        ${[['Fee', usd(DB.settings.vendorFeeUsd || 0), 'tag'], ['Applications', list.length, 'users'], ['Pending', pending.length, 'clock'], ['Approved', list.filter(a => a.status === 'approved').length, 'check']]
          .map(([k, v, i]) => `<div class="kpi"><div class="ic">${ic(i, 15)}</div><div class="v" style="font-size:17px">${v}</div><div class="k">${k}</div></div>`).join('')}
      </div>
    </div>
    <div class="card">
      <div class="table-wrap"><table class="tbl"><thead><tr><th>Applicant</th><th>Vendor name</th><th>Plan</th><th>Fee</th><th>Payment account</th><th>Slip</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead><tbody>
      ${list.length ? list.map(a => {
        const u = findUser(a.userId);
        return `<tr>
          <td><div class="row gap8">${avatarHTML(u || {}, 'sm')}<div><div style="font-weight:600">${esc(u ? u.fullName : a.userName || '—')}</div><div class="tiny muted">@${esc(u ? u.username : a.username || '')} · ${dateLabel(a.createdAt)}</div></div></div></td>
          <td style="font-weight:600">@${esc(a.vendorUsername)}</td>
          <td><div style="font-weight:600">${a.months || 1} month${(a.months || 1) > 1 ? 's' : ''}</div><div class="tiny muted">${a.kind === 'renewal' ? 'Renewal' : 'New vendor'}</div></td>
          <td>${usd(a.feeUsd)}</td>
          <td class="tiny muted" style="max-width:180px"><div>${esc(a.methodLabel || '—')}</div><div style="word-break:break-all">${esc(a.address || '')}</div></td>
          <td>${a.proof ? `<img src="${a.proof}" style="width:46px;height:46px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer" data-act="vendor-view-proof" data-id="${a.id}"/>` : '<span class="tiny muted">none</span>'}</td>
          <td>${statusBadge(a.status)}</td>
          <td><div class="row gap6" style="justify-content:flex-end">
            ${a.status === 'pending' ? `<button class="btn btn-xs btn-primary" data-act="vendor-app-approve" data-id="${a.id}">Approve</button>
              <button class="btn btn-xs btn-danger" data-act="vendor-app-reject" data-id="${a.id}">Reject</button>` : ''}
            ${a.status !== 'pending' ? `<button class="btn btn-xs btn-ghost" data-act="vendor-app-del" data-id="${a.id}">${ic('trash', 12)}</button>` : ''}
          </div></td></tr>`;
      }).join('') : `<tr><td colspan="7" class="center muted" style="padding:30px">No vendor applications yet</td></tr>`}
      </tbody></table></div>
    </div>`;
}

function adminVendors() {
  return `<div class="card">
    <div class="between mb16"><h3 style="font-size:15px">Vendors</h3><span class="badge">${DB.vendors.length} total</span></div>
    <div class="table-wrap"><table class="tbl"><thead><tr><th>Vendor</th><th>Owner</th><th>Products</th><th>Sales</th><th>Expiry</th><th style="text-align:right">Actions</th></tr></thead><tbody>
    ${DB.vendors.length ? DB.vendors.map(v => {
      const owner = findUser(v.userId);
      const prods = DB.products.filter(p => p.vendorId === v.id);
      const rev = DB.orders.filter(o => o.vendorId === v.id).reduce((s, o) => s + o.usd || 0, 0);
      return `<tr><td><div style="font-weight:600">@${esc(v.username)}</div><div class="tiny muted">Since ${dateLabel(v.createdAt)}</div></td>
        <td><div class="row gap6">${owner ? avatarHTML(owner, 'sm') : ''}<div><div class="small">${esc(owner ? owner.fullName : '—')}</div><div class="tiny muted">${esc(owner ? owner.username : '')}</div></div></div></td>
        <td>${prods.length}</td><td>${v.sales || 0}</td><td>${coins(DB.orders.filter(o => o.vendorId === v.id).reduce((s, o) => s + o.totalUsd, 0) / COIN_USD)} WC</td>
        <td>${v.rating.toFixed(1)} ★</td>
        <td><div class="row gap6" style="justify-content:flex-end">
          <button class="btn btn-xs btn-ghost" data-act="admin-vendor" data-id="${v.id}">View</button>
          <button class="btn btn-xs btn-ghost" data-act="admin-edit-vendor" data-id="${v.id}">Edit</button>
          <button class="btn btn-xs btn-ghost" data-act="vendor-extend" data-id="${v.id}" title="Add 30 days">+30d</button>
          ${owner ? `<button class="btn btn-xs btn-ghost" data-act="admin-msg-user" data-id="${owner.id}">${ic('chat', 12)}</button>` : ''}
        </div></td></tr>`;
    }).join('') : `<tr><td colspan="7" class="center muted" style="padding:30px">No vendors yet</td></tr>`}
    </tbody></table></div></div>`;
}
App.adminVendor = function (id) {
  const v = vendorById(id); if (!v) return;
  const owner = findUser(v.userId);
  const prods = DB.products.filter(p => p.vendorId === id);
  openModal(modalShell('Vendor @' + v.username, `
    <div class="row gap12 mb16">${avatarHTML(owner || {}, 'lg')}<div><div style="font-weight:650">${esc(v.name)}</div>
      <div class="small muted">${esc(owner ? owner.fullName : '')}</div><div class="row gap6 mt6"><span class="badge badge-accent">${v.rating.toFixed(1)} ★</span><span class="badge">Trust ${v.trustScore}</span><span class="badge">${v.sales || 0} sales</span></div></div></div>
    <div class="kv"><span class="k">Wallet balance</span><span class="v">${coins(owner ? owner.balance : 0)} WC</span></div>
    <div class="kv"><span class="k">Products in inventory</span><span class="v">${prods.length}</span></div>
    <div class="kv"><span class="k">Created</span><span class="v">${dateLabel(v.createdAt)}</span></div>
    <div class="divider"></div>
    <div class="label mb10">Inventory</div>
    ${prods.length ? `<div class="list">${prods.slice(0, 8).map(p => `<div class="list-item" style="padding:8px 10px">
      <div style="width:32px;height:32px;border-radius:8px;background:var(--surface-3);display:flex;align-items:center;justify-content:center;font-size:15px">${p.emoji || '📦'}</div>
      <div class="grow"><div class="tiny" style="font-weight:600">${esc(p.name)}</div><div class="tiny muted">Stock ${p.stock} · ${p.active ? 'Listed' : 'Hidden'}</div></div>
      <span class="tiny">${p.priceUsd ? coins(p.priceUsd / COIN_USD) + ' WC' : '—'}</span></div>`).join('')}</div>` : '<p class="tiny muted">No products.</p>'}`,
    `<button class="btn btn-ghost" data-close style="flex:1">Close</button><button class="btn btn-primary" data-act="admin-edit-vendor" data-id="${v.id}" style="flex:1">Edit vendor</button>`));
};
App.adminEditVendor = function (id) {
  const v = vendorById(id); if (!v) return;
  openModal(modalShell('Edit vendor', `
    ${field('Vendor username', 'evName', { value: v.username })}
    ${field('Display name', 'evDisplay', { value: v.name })}
    ${field('Star rating (0–5)', 'evRating', { type: 'number', value: v.rating, step: '0.1' })}
    ${field('Trust score (0–100)', 'evTrust', { type: 'number', value: v.trustScore })}`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="admin-save-vendor" data-id="${v.id}">Save</button>`));
};
App.adminSaveVendor = function (id) {
  const v = vendorById(id); if (!v) return;
  const name = document.getElementById('evName').value.trim();
  if (!/^[a-zA-Z0-9._-]{3,24}$/.test(name)) return toast('Invalid vendor username', 'err');
  v.username = name;
  v.name = document.getElementById('evDisplay').value.trim() || name;
  v.rating = Math.max(0, Math.min(5, Number(document.getElementById('evRating').value) || 5));
  v.trustScore = Math.max(0, Math.min(100, Number(document.getElementById('evTrust').value) || 50));
  sync(); closeModal(); toast('Vendor updated', 'ok'); render();
};

/* ---------------- products ---------------- */
let PRODUCT_EDIT = null, PRODUCT_IMAGE = null;
function adminProducts() {
  return `<div class="card">
    <div class="between wrap gap10 mb16">
      <div><h3 style="font-size:15px">Company marketplace</h3><p class="tiny muted mt6">Wholesale catalogue available to vendors only.</p></div>
      <button class="btn btn-primary btn-sm" data-act="admin-product-new">${ic('plus', 15)} Add product</button>
    </div>
    <div class="table-wrap"><table class="tbl"><thead><tr><th>Product</th><th>Category</th><th>Wholesale price</th><th>Stock</th><th>Listings</th><th style="text-align:right">Actions</th></tr></thead><tbody>
    ${DB.companyProducts.length ? DB.companyProducts.map(p => {
      const listings = DB.products.filter(x => x.companyProductId === p.id);
      return `<tr>
        <td><div class="row gap8"><div style="width:38px;height:38px;border-radius:9px;overflow:hidden;background:var(--surface-2);display:flex;align-items:center;justify-content:center;font-size:17px">${p.image ? `<img src="${p.image}" style="width:100%;height:100%;object-fit:cover"/>` : (p.emoji || '📦')}</div>
          <div><div style="font-weight:600">${esc(p.name)}</div><div class="tiny muted">${esc((p.description || '').slice(0, 44))}…</div></div></div></td>
        <td>${esc(p.category)}</td>
        <td><div style="font-weight:600">${coins(p.priceUsd / COIN_USD)} WC</div><div class="tiny muted">${usd(p.priceUsd)}</div></td>
        <td>${p.stock}</td><td>${listings.length} vendors</td>
        <td><div class="row gap6" style="justify-content:flex-end">
          <button class="btn btn-xs btn-ghost" data-act="admin-product-edit" data-id="${p.id}">${ic('edit', 12)}</button>
          <button class="btn btn-xs btn-danger" data-act="admin-product-del" data-id="${p.id}">${ic('trash', 12)}</button></div></td></tr>`;
    }).join('') : `<tr><td colspan="6" class="center muted" style="padding:30px">No company products yet</td></tr>`}
    </tbody></table></div>
  </div>
  <div class="card mt16">
    <h3 style="font-size:15px">Vendor listings</h3><p class="tiny muted mt6">Everything currently listed on the public marketplace.</p>
    <div class="table-wrap mt16"><table class="tbl"><thead><tr><th>Product</th><th>Vendor</th><th>Price</th><th>Stock</th><th>Stars</th><th>Status</th></tr></thead><tbody>
      ${DB.products.filter(p => p.priceUsd).length ? DB.products.filter(p => p.priceUsd).map(p => {
        const v = vendorById(p.vendorId);
        return `<tr><td style="font-weight:600">${esc(p.name)}</td><td>@${esc(v ? v.username : '—')}</td>
          <td>${coins(p.priceUsd / COIN_USD)} WC <span class="tiny muted">${usd(p.priceUsd)}</span></td>
          <td>${p.stock}</td><td>${(p.starUsers || []).length}</td>
          <td>${p.active && p.stock > 0 ? '<span class="badge badge-success">Live</span>' : '<span class="badge">Hidden</span>'}</td></tr>`;
      }).join('') : `<tr><td colspan="6" class="center muted" style="padding:24px">No vendor listings yet</td></tr>`}
    </tbody></table></div>
  </div>`;
}
function bindProductForm() {
  const f = document.getElementById('productForm');
  if (!f) return;
  const price = document.getElementById('pfPrice');
  const calc = () => {
    const el = document.getElementById('pfCoins');
    if (el) el.textContent = coins(usdToCoins(Number(price.value) || 0)) + ' WC';
  };
  price.addEventListener('input', calc); calc();
}
App.adminProductNew = function () {
  PRODUCT_EDIT = null; PRODUCT_IMAGE = null;
  openProductModal();
};
App.adminProductEdit = function (id) {
  PRODUCT_EDIT = DB.companyProducts.find(p => p.id === id) || null;
  PRODUCT_IMAGE = PRODUCT_EDIT ? PRODUCT_EDIT.image : null;
  openProductModal();
};
function openProductModal() {
  const p = PRODUCT_EDIT;
  openModal(modalShell(p ? 'Edit product' : 'Add company product', `
    <div id="productForm">
      <div class="row gap12 mb16">
        <div id="pfThumb" style="width:74px;height:74px;border-radius:12px;overflow:hidden;background:var(--surface-2);display:flex;align-items:center;justify-content:center;font-size:28px;flex:none">${PRODUCT_IMAGE ? `<img src="${PRODUCT_IMAGE}" style="width:100%;height:100%;object-fit:cover"/>` : (p && p.emoji ? p.emoji : '📦')}</div>
        <div class="col gap6"><button class="btn btn-ghost btn-sm" data-act="admin-product-image">${ic('image', 14)} Upload image</button>
          <span class="tiny muted">JPG or PNG, auto-compressed</span></div>
      </div>
      ${field('Product name', 'pfName', { value: p ? p.name : '', ph: 'e.g. Whale X1 Pro 5G' })}
      <div class="field"><label class="label">Category</label>
        <select class="input" id="pfCat">${['Phones', 'Laptops', 'Tablets', 'Headphones', 'Chargers', 'Video Games', 'Phone Pouches', 'Accessories'].map(c => `<option ${p && p.category === c ? 'selected' : ''}>${c}</option>`).join('')}</select></div>
      ${field('Wholesale price (USD)', 'pfPrice', { type: 'number', step: '0.01', value: p ? p.priceUsd : '', ph: '100.00' })}
      <div class="panel" style="padding:10px 12px;margin-bottom:12px"><div class="between"><span class="tiny muted">Vendors pay in Whale Coin</span><span id="pfCoins" style="font-weight:700;color:var(--accent)">0 WC</span></div></div>
      ${field('Company stock', 'pfStock', { type: 'number', value: p ? p.stock : 0 })}
      ${field('Emoji fallback', 'pfEmoji', { value: p ? (p.emoji || '') : '📦', maxlength: '4', help: 'Shown when no image is uploaded.' })}
      <div class="field"><label class="label">Description</label><textarea class="input" id="pfDesc" style="min-height:80px">${esc(p ? p.description || '' : '')}</textarea></div>
    </div>`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="admin-product-save">${ic('check', 15)} ${p ? 'Save product' : 'Add product'}</button>`), { width: '520px' });
  bindProductForm();
}
App.adminProductImage = async function () {
  const f = await pickFile({ accept: 'image/*' });
  if (!f) return;
  const c = await compressImage(f, 640, 0.66);
  PRODUCT_IMAGE = await fileToDataURL(c);
  const t = document.getElementById('pfThumb');
  if (t) t.innerHTML = `<img src="${PRODUCT_IMAGE}" style="width:100%;height:100%;object-fit:cover"/>`;
};
App.adminProductSave = function () {
  const name = document.getElementById('pfName').value.trim();
  const price = Number(document.getElementById('pfPrice').value);
  const stock = Number(document.getElementById('pfStock').value);
  if (name.length < 2) return toast('Enter a product name', 'err');
  if (!(price > 0)) return toast('Enter a valid price', 'err');
  if (!catValid(document.getElementById('pfCat').value)) return toast('Invalid category', 'err');
  const data = {
    name, category: document.getElementById('pfCat').value, priceUsd: Math.round(price * 100) / 100,
    stock: Math.max(0, Math.round(stock) || 0), emoji: document.getElementById('pfEmoji').value || '📦',
    description: document.getElementById('pfDesc').value.trim(), image: PRODUCT_IMAGE
  };
  if (PRODUCT_EDIT) Object.assign(PRODUCT_EDIT, data);
  else DB.companyProducts.unshift(Object.assign({ id: uid('cp'), createdAt: Date.now() }, data));
  sync(); closeModal(); toast(PRODUCT_EDIT ? 'Product updated' : 'Product added', 'ok'); render();
};
function catValid(c) { return ['Phones', 'Laptops', 'Tablets', 'Headphones', 'Chargers', 'Video Games', 'Phone Pouches', 'Accessories'].includes(c); }
App.adminProductDel = async function (id) {
  if (!await confirmDialog({ title: 'Delete company product?', body: 'Vendors keep their existing inventory, but it can no longer be restocked.', danger: true, ok: 'Delete' })) return;
  DB.companyProducts = DB.companyProducts.filter(p => p.id !== id);
  sync(); toast('Product deleted', 'ok'); render();
};

/* ---------------- orders ---------------- */
function adminOrders() {
  const orders = DB.orders;
  return `<div class="grid-kpi mb16">
    ${[['Processing', orders.filter(o => o.status === 'processing').length, 'clock'], ['Shipped', orders.filter(o => o.status === 'shipped').length, 'truck'],
       ['Delivered', orders.filter(o => o.status === 'delivered').length, 'check'], ['Revenue', usd(orders.reduce((s, o) => s + o.totalUsd, 0)), 'trend']]
      .map(([k, v, i]) => `<div class="kpi"><div class="ic">${ic(i, 15)}</div><div class="v">${v}</div><div class="k">${k}</div></div>`).join('')}
    </div>
    <div class="card">
      <div class="between mb16"><h3 style="font-size:15px">All orders</h3><span class="badge">${orders.length} orders</span></div>
      <div class="table-wrap"><table class="tbl"><thead><tr><th>Order</th><th>Buyer</th><th>Items</th><th>Total</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead><tbody>
      ${orders.length ? orders.map(o => {
        const b = findUser(o.buyerId);
        return `<tr><td><div style="font-weight:600">${esc(o.ref)}</div><div class="tiny muted">${dateLabel(o.createdAt)}</div></td>
          <td><div class="small" style="font-weight:600">${esc(o.delivery.fullName)}</div><div class="tiny muted">${esc(b ? '@' + b.username : 'deleted user')}</div></td>
          <td class="muted tiny">${o.items.map(i => esc(i.name) + ' ×' + i.qty).join('<br/>')}</td>
          <td style="font-weight:600">${coins(o.totalCoins)} WC<div class="tiny muted">${usd(o.totalUsd)}</div></td>
          <td>${statusBadge(o.status)}</td>
          <td><div class="row gap6" style="justify-content:flex-end">
            <button class="btn btn-xs btn-primary" data-act="admin-order" data-id="${o.id}">Manage</button>
            <button class="btn btn-xs btn-ghost" data-act="admin-order-del" data-id="${o.id}">${ic('trash', 12)}</button></div></td></tr>`;
      }).join('') : `<tr><td colspan="6" class="center muted" style="padding:30px">No orders yet</td></tr>`}
      </tbody></table></div>
    </div>`;
}
App.adminOrder = function (id) {
  const o = DB.orders.find(x => x.id === id); if (!o) return;
  const b = findUser(o.buyerId);
  const v = vendorById(o.vendorId); const vu = v ? findUser(v.userId) : null;
  openModal(modalShell('Order ' + o.ref, `
    <div class="between mb10"><div class="row gap8">${statusBadge(o.status)}<span class="badge">${dateLabel(o.createdAt)}</span></div>
      <span style="font-weight:700;font-family:var(--display)">${coins(o.totalCoins)} WC</span></div>
    <div class="panel" style="padding:12px;margin-bottom:12px">
      ${o.items.map(i => `<div class="between" style="padding:4px 0"><span class="small">${esc(i.name)} ×${i.qty}</span><span class="small muted">${usd(i.priceUsd * i.qty)}</span></div>`).join('')}
    </div>
    <div class="small" style="font-weight:650;margin-bottom:4px">Buyer</div>
    <div class="kv"><span class="k">Account</span><span class="v">${esc(b ? b.fullName + ' (@' + b.username + ')' : 'Deleted user')}</span></div>
    <div class="kv"><span class="k">Receiver</span><span class="v">${esc(o.delivery.fullName)}</span></div>
    <div class="kv"><span class="k">Phone</span><span class="v">${esc(o.delivery.phone)}</span></div>
    <div class="kv"><span class="k">Email</span><span class="v">${esc(o.delivery.email)}</span></div>
    <div class="kv"><span class="k">Country</span><span class="v">${esc(o.delivery.country)}</span></div>
    <div class="kv"><span class="k">Address</span><span class="v" style="max-width:62%">${esc(o.delivery.address)}</span></div>
    <div class="kv"><span class="k">Vendor</span><span class="v">@${esc(vu ? vu.username : '—')}</span></div>
    ${field('Tracking reference (optional)', 'aoTrack', { value: o.tracking || '', ph: 'e.g. PKG-88123' })}
    <div class="field"><label class="label">Update status</label>
      <select class="input" id="aoStatus">
        ${['processing', 'shipped', 'delivered', 'cancelled'].map(s => `<option value="${s}" ${o.status === s ? 'selected' : ''}>${s[0].toUpperCase() + s.slice(1)}</option>`).join('')}
      </select></div>
    <div class="field"><label class="label">Message to buyer (optional)</label><input class="input" id="aoNote" placeholder="e.g. Dispatched with express courier"/></div>`,
    `<button class="btn btn-ghost" data-close>Close</button><button class="btn btn-primary" data-act="admin-order-save" data-id="${o.id}">${ic('check', 15)} Save & notify</button>`), { width: '520px' });
};
App.adminOrderSave = function (id) {
  const o = DB.orders.find(x => x.id === id); if (!o) return;
  const st = document.getElementById('aoStatus').value;
  const note = document.getElementById('aoNote').value.trim();
  o.tracking = document.getElementById('aoTrack').value.trim() || o.tracking;
  if (st !== o.status) {
    o.status = st;
    o.timeline.push({ status: st, at: Date.now(), note: note || '' });
    notify(o.buyerId, 'Order ' + o.ref + ' · ' + st[0].toUpperCase() + st.slice(1),
      (st === 'shipped' ? 'Your package is on the way. ' : st === 'delivered' ? 'Your package was delivered. ' : '') + (note || 'Track your package movements in the app.'),
      '#/orders', 'truck');
    if (o.vendorId) {
      const v = vendorById(o.vendorId);
      if (v) notify(v.userId, 'Order ' + o.ref + ' is now ' + st, note || 'Status updated by WhaleChat admin.', '#/vendor/orders', 'truck');
    }
  } else if (note) {
    notify(o.buyerId, 'Update on order ' + o.ref, note, '#/orders', 'chat');
  }
  sync(); closeModal(); toast('Order updated', 'ok'); render();
};
App.adminOrderDel = async function (id) {
  if (!await confirmDialog({ title: 'Delete order?', body: 'Removes the order record. Buyer will no longer see tracking.', danger: true, ok: 'Delete' })) return;
  DB.orders = DB.orders.filter(o => o.id !== id); sync(); toast('Order deleted', 'ok'); render();
};

/* ---------------- refunds ---------------- */
function adminRefunds() {
  const list = DB.refunds || [];
  const pending = list.filter(r => r.status === 'pending');
  const approved = list.filter(r => r.status === 'approved');
  return `<div class="grid-kpi k4 mb16">
      ${[['Pending refunds', pending.length, 'clock'], ['Approved', approved.length, 'check'],
         ['Refunded value', coins(approved.reduce((s, r) => s + r.coins, 0)) + ' WC', 'wallet'],
         ['Requests total', list.length, 'refresh']]
        .map(([k, v, i]) => `<div class="kpi"><div class="ic">${ic(i, 15)}</div><div class="v" style="font-size:17px">${v}</div><div class="k">${k}</div></div>`).join('')}
    </div>
    <div class="card">
      <div class="between mb16"><div><h3 style="font-size:15px">Company purchase refunds</h3>
        <p class="tiny muted mt6">Approve to return the vendor's unsold units to company stock and credit the amount back to their balance.</p></div>
        <span class="badge badge-warn">${pending.length} pending</span></div>
      <div class="table-wrap"><table class="tbl"><thead><tr><th>Vendor</th><th>Product</th><th>Qty</th><th>Amount</th><th>Reason</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead><tbody>
      ${list.length ? list.map(r => {
        const v = vendorById(r.vendorId); const vu = v ? findUser(v.userId) : null;
        return `<tr>
          <td><div style="font-weight:600">@${esc(v ? v.username : '—')}</div><div class="tiny muted">${esc(vu ? vu.fullName : '')}</div></td>
          <td style="font-weight:600">${esc(r.name)}</td><td>${r.qty}</td>
          <td><div style="font-weight:600">${coins(r.coins)} WC</div><div class="tiny muted">${usd(r.usd)}</div></td>
          <td class="tiny muted" style="max-width:180px">${esc(r.reason || '—')}</td>
          <td>${statusBadge(r.status)}</td>
          <td><div class="row gap6" style="justify-content:flex-end">
            ${r.status === 'pending' ? `<button class="btn btn-xs btn-primary" data-act="refund-approve" data-id="${r.id}">Approve</button>
              <button class="btn btn-xs btn-danger" data-act="refund-reject" data-id="${r.id}">Reject</button>` : ''}
            <button class="btn btn-xs btn-ghost" data-act="refund-del" data-id="${r.id}">${ic('trash', 12)}</button>
          </div></td></tr>`;
      }).join('') : `<tr><td colspan="7" class="center muted" style="padding:30px">No refund requests yet</td></tr>`}
      </tbody></table></div>
    </div>`;
}

/* ---------------- deposits ---------------- */
function adminDeposits() {
  const list = DB.deposits;
  return `<div class="card">
    <div class="between mb16"><h3 style="font-size:15px">Deposit requests</h3>
      <div class="row gap8"><span class="badge badge-warn">${list.filter(d => d.status === 'pending').length} pending</span>
      <button class="btn btn-sm btn-ghost" data-nav="#/admin/settings">${ic('settings', 14)} Payment methods</button></div></div>
    <div class="table-wrap"><table class="tbl"><thead><tr><th>User</th><th>Amount</th><th>Whale Coin</th><th>Method</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead><tbody>
    ${list.length ? list.map(d => {
      const u = findUser(d.userId);
      return `<tr><td><div style="font-weight:600">${esc(u ? u.fullName : 'Deleted user')}</div><div class="tiny muted">${esc(u ? '@' + u.username : '')} · ${timeAgo(d.createdAt)} ago</div></td>
        <td style="font-weight:600">${usd(d.usd)}</td><td>${coins(d.coins)} WC</td>
        <td><div class="small">${esc(d.methodName || d.method)}</div><div class="tiny muted" style="max-width:180px;overflow:hidden;text-overflow:ellipsis">${esc(d.detail || '')}</div></td>
        <td>${statusBadge(d.status)}</td>
        <td><div class="row gap6" style="justify-content:flex-end">
          ${d.status === 'pending' ? `<button class="btn btn-xs btn-primary" data-act="dep-approve" data-id="${d.id}">Approve</button>
          <button class="btn btn-xs btn-danger" data-act="dep-reject" data-id="${d.id}">Reject</button>` : ''}
          <button class="btn btn-xs btn-ghost" data-act="dep-del" data-id="${d.id}">${ic('trash', 12)}</button></div></td></tr>`;
    }).join('') : `<tr><td colspan="6" class="center muted" style="padding:30px">No deposit requests</td></tr>`}
    </tbody></table></div>
  </div>`;
}
App.depApprove = async function (id) {
  const d = DB.deposits.find(x => x.id === id); if (!d || d.status !== 'pending') return;
  const u = findUser(d.userId); if (!u) return toast('User not found', 'err');
  d.status = 'approved'; d.reviewedAt = Date.now();
  u.balance = Math.round((u.balance + d.coins) * 100) / 100;
  u.totalDeposits = Math.round(((u.totalDeposits || 0) + d.usd) * 100) / 100;
  tx(u.id, 'deposit', 'Deposit approved · ' + (d.methodName || d.method), d.coins);
  notify(u.id, 'Deposit approved ✅', `${coins(d.coins)} WC has been credited to your wallet.`, '#/wallet', 'wallet');
  // referral payout on first approved deposit (idempotent)
  try { resolvePendingReferrals(); } catch (e) {}
  let bonus = false;
  try { bonus = referralBonus(u.id); } catch (e) {}
  sync();
  toast(bonus ? 'Deposit approved · 10 WC referral bonus paid' : 'Deposit approved and credited', 'ok');
  render();
};
App.depReject = async function (id) {
  const d = DB.deposits.find(x => x.id === id); if (!d) return;
  const reason = await promptDialog({ title: 'Reject deposit', label: 'Reason (sent to user)', placeholder: 'Payment not received' });
  if (reason === null) return;
  d.status = 'rejected'; d.note = reason; d.reviewedAt = Date.now();
  notify(d.userId, 'Deposit rejected', `${usd(d.usd)} deposit was rejected. ${reason || ''}`, '#/wallet', 'ban');
  sync(); toast('Deposit rejected', 'ok'); render();
};
App.depDel = async function (id) {
  if (!await confirmDialog({ title: 'Delete deposit record?', danger: true, ok: 'Delete' })) return;
  DB.deposits = DB.deposits.filter(d => d.id !== id); sync(); render();
};

/* ---------------- withdrawals ---------------- */
function adminWithdrawals() {
  const list = DB.withdrawals;
  return `<div class="card">
    <div class="between mb16"><h3 style="font-size:15px">Withdrawal requests</h3>
      <div class="row gap8"><span class="badge badge-warn">${list.filter(w => w.status === 'pending').length} pending</span>
      <button class="btn btn-sm btn-ghost" data-act="edit-networks">${ic('settings', 14)} USDT networks</button></div></div>
    <div class="table-wrap"><table class="tbl"><thead><tr><th>User</th><th>Amount</th><th>Network · Address</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead><tbody>
    ${list.length ? list.map(w => {
      const u = findUser(w.userId);
      return `<tr><td><div style="font-weight:600">${esc(u ? u.fullName : 'Deleted user')}</div><div class="tiny muted">${esc(u ? '@' + u.username : '')} · ${timeAgo(w.createdAt)} ago</div></td>
        <td><div style="font-weight:600">${coins(w.coins)} WC</div><div class="tiny muted">${usd(w.usd)}</div></td>
        <td><span class="badge">${esc(w.network)}</span><div class="tiny muted" style="max-width:190px;overflow:hidden;text-overflow:ellipsis;margin-top:3px">${esc(w.address)}</div></td>
        <td>${statusBadge(w.status)}</td>
        <td><div class="row gap6" style="justify-content:flex-end">
          ${w.status === 'pending' ? `<button class="btn btn-xs btn-primary" data-act="wd-approve" data-id="${w.id}">Approve</button>
          <button class="btn btn-xs btn-danger" data-act="wd-reject" data-id="${w.id}">Reject</button>` : ''}
          <button class="btn btn-xs btn-ghost" data-act="wd-edit" data-id="${w.id}">${ic('edit', 12)}</button>
          <button class="btn btn-xs btn-ghost" data-act="wd-del" data-id="${w.id}">${ic('trash', 12)}</button></div></td></tr>`;
    }).join('') : `<tr><td colspan="5" class="center muted" style="padding:30px">No withdrawal requests</td></tr>`}
    </tbody></table></div>
  </div>`;
}
App.wdApprove = async function (id) {
  const w = DB.withdrawals.find(x => x.id === id); if (!w) return;
  const u = findUser(w.userId);
  const txRef = await promptDialog({ title: 'Approve withdrawal', label: 'Blockchain transaction hash (optional)', placeholder: '0x… or leave blank' });
  if (txRef === null) return;
  w.status = 'approved'; w.txHash = txRef; w.reviewedAt = Date.now();
  const act = DB.txs.find(t => t.id === w.txId || (t.meta && t.meta.withdrawalId === w.id));
  if (act) { act.label = 'Withdrawal approved · ' + w.network; act.meta = Object.assign({}, act.meta, { withdrawalId: w.id, status: 'approved' }); }
  if (u) {
    u.totalWithdrawals = Math.round(((u.totalWithdrawals || 0) + w.coins) * 100) / 100;
    notify(u.id, 'Withdrawal approved 💸', `${coins(w.coins)} WC (${usd(w.usd)}) was sent via ${w.network}.${txRef ? ' Tx: ' + txRef : ''}`, '#/wallet', 'download');
  }
  sync(); toast('Withdrawal approved', 'ok'); render();
};
App.wdReject = async function (id) {
  const w = DB.withdrawals.find(x => x.id === id); if (!w) return;
  const reason = await promptDialog({ title: 'Reject withdrawal', label: 'Reason (sent to user)', placeholder: 'Invalid wallet address' });
  if (reason === null) return;
  const u = findUser(w.userId);
  w.status = 'rejected'; w.note = reason; w.reviewedAt = Date.now();
  const actR = DB.txs.find(t => t.id === w.txId || (t.meta && t.meta.withdrawalId === w.id));
  if (actR) { actR.label = 'Withdrawal rejected · ' + w.network; actR.meta = Object.assign({}, actR.meta, { withdrawalId: w.id, status: 'rejected' }); }
  if (u) {
    u.balance = Math.round((u.balance + w.coins) * 100) / 100;
    tx(u.id, 'refund', 'Withdrawal rejected · refund', w.coins);
    notify(u.id, 'Withdrawal rejected', `${coins(w.coins)} WC has been returned to your balance. ${reason || ''}`, '#/wallet', 'ban');
  }
  sync(); toast('Withdrawal rejected and refunded', 'ok'); render();
};
App.wdEdit = function (id) {
  const w = DB.withdrawals.find(x => x.id === id); if (!w) return;
  openModal(modalShell('Edit withdrawal', `
    ${field('Amount (Whale Coin)', 'ewCoins', { type: 'number', value: w.coins })}
    <div class="field"><label class="label">Network</label><select class="input" id="ewNet">${(DB.settings.networks || []).map(n => `<option ${w.network === n ? 'selected' : ''}>${esc(n)}</option>`).join('')}</select></div>
    ${field('USDT address', 'ewAddr', { value: w.address })}
    ${field('Admin note', 'ewNote', { value: w.note || '' })}`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="wd-save" data-id="${w.id}">Save changes</button>`));
};
App.wdSave = function (id) {
  const w = DB.withdrawals.find(x => x.id === id); if (!w) return;
  const coinsVal = Number(document.getElementById('ewCoins').value);
  const addr = document.getElementById('ewAddr').value.trim();
  if (!(coinsVal > 0) || !addr) return toast('Enter a valid amount and address', 'err');
  const u = findUser(w.userId);
  const diff = Math.round((coinsVal - w.coins) * 100) / 100;
  if (diff > 0 && u && u.balance < diff) return toast('User balance too low for this increase', 'err');
  if (u && diff !== 0) { u.balance = Math.round((u.balance - diff) * 100) / 100; tx(u.id, 'withdrawal', 'Withdrawal adjusted by admin', -diff); }
  w.coins = coinsVal; w.usd = coinsToUsd(coinsVal);
  w.network = document.getElementById('ewNet').value;
  w.address = addr;
  w.note = document.getElementById('ewNote').value.trim();
  // keep the user's activity row in sync with admin edits
  const linked = DB.txs.find(t => t.id === w.txId || (t.meta && t.meta.withdrawalId === w.id));
  if (linked && (w.status === 'pending' || w.status === 'approved')) {
    linked.coins = -w.coins;
    linked.label = (w.status === 'approved' ? 'Withdrawal approved · ' : 'Withdrawal request · ') + w.network;
    linked.meta = Object.assign({}, linked.meta, { withdrawalId: w.id, network: w.network, editedByAdmin: true });
  }
  if (u) notify(u.id, 'Withdrawal request updated', `Your ${coins(w.coins)} WC withdrawal was updated by our team (${w.network}).`, '#/wallet', 'download');
  sync(); closeModal(); toast('Withdrawal updated', 'ok'); render();
};
App.wdDel = async function (id) {
  if (!await confirmDialog({ title: 'Delete withdrawal history?', body: 'This removes the record only; funds already approved are not affected.', danger: true, ok: 'Delete' })) return;
  DB.withdrawals = DB.withdrawals.filter(w => w.id !== id); sync(); render();
};

/* ---------------- notification management ---------------- */
function adminNotifications() {
  const list = DB.notifications.slice(0, 100);
  return `<div class="card mb16">
    <h3 style="font-size:15px">Send a notification</h3>
    <p class="tiny muted mt6">Delivered instantly to a single account or every user.</p>
    <div class="mt16" style="display:grid;grid-template-columns:1fr 1fr;gap:12px" class="dash2">
      <div class="field"><label class="label">Recipient</label><select class="input" id="anUser"><option value="all">All users</option>
        ${DB.users.filter(x => x.role !== 'admin').map(x => `<option value="${x.id}">${esc(x.fullName)} (@${esc(x.username)})</option>`).join('')}</select></div>
      ${field('Title', 'anTitle', { ph: 'e.g. Platform update' })}
    </div>
    <div class="field"><label class="label">Message</label><textarea class="input" id="anBody" style="min-height:80px" placeholder="Write your message…"></textarea></div>
    <div class="row gap8"><button class="btn btn-primary btn-sm" data-act="admin-send-notif">${ic('send', 14)} Send notification</button>
    <button class="btn btn-ghost btn-sm" data-act="admin-test-notif">${ic('bell', 14)} Test on this device</button></div>
  </div>
  <div class="card">
    <div class="between mb16"><h3 style="font-size:15px">All notifications</h3><span class="badge">${DB.notifications.length} total</span></div>
    <div class="list">
      ${list.length ? list.map(n => {
        const u = findUser(n.userId);
        return `<div class="notif-item">
          <div style="width:32px;height:32px;border-radius:9px;background:var(--surface-3);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none">${ic(n.icon || 'bell', 14)}</div>
          <div class="grow" style="min-width:0"><div class="small" style="font-weight:650">${esc(n.title)}</div>
            <div class="tiny muted" style="line-height:1.5">${esc(n.body)}</div>
            <div class="tiny" style="color:var(--muted-2);margin-top:4px">${esc(u ? u.fullName : 'Deleted user')} · ${timeAgo(n.createdAt)} ago</div></div>
          <div class="row gap4">
            <button class="btn btn-xs btn-ghost" data-act="admin-notif-edit" data-id="${n.id}">${ic('edit', 11)}</button>
            <button class="btn btn-xs btn-ghost" data-act="admin-notif-del" data-id="${n.id}">${ic('trash', 11)}</button>
          </div></div>`;
      }).join('') : `<div class="empty"><p>No notifications yet.</p></div>`}
    </div>
  </div>
  <style>@media(max-width:860px){.dash2{grid-template-columns:1fr!important}}</style>`;
}
App.adminSendNotif = function () {
  const to = document.getElementById('anUser').value;
  const title = document.getElementById('anTitle').value.trim();
  const body = document.getElementById('anBody').value.trim();
  if (!title || !body) return toast('Title and message are required', 'err');
  if (to === 'all') {
    DB.users.filter(u => u.role !== 'admin').forEach(u => notify(u.id, title, body, null, 'bell'));
    toast('Notification sent to ' + DB.users.filter(u => u.role !== 'admin').length + ' users', 'ok');
  } else { notify(to, title, body, null, 'bell'); toast('Notification sent', 'ok'); }
  sync(); render();
};
App.adminTestNotif = async function () {
  await requestNotifyPermission(false);
  const title = document.getElementById('anTitle').value.trim() || 'WhaleChat';
  const body = document.getElementById('anBody').value.trim() || 'Test notification from the admin console.';
  if (Notification.permission !== 'granted') return toast('Enable notifications in your browser first', 'err');
  new Notification(title, { body, icon: 'data:image/png;base64,' });
  toast('Test sent', 'ok');
};
App.adminNotifEdit = function (id) {
  const n = DB.notifications.find(x => x.id === id); if (!n) return;
  openModal(modalShell('Edit notification', `${field('Title', 'enTitle', { value: n.title })}
    <div class="field"><label class="label">Message</label><textarea class="input" id="enBody" style="min-height:90px">${esc(n.body)}</textarea></div>`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="admin-notif-save" data-id="${n.id}">Save</button>`));
};
App.adminNotifSave = function (id) {
  const n = DB.notifications.find(x => x.id === id); if (!n) return;
  n.title = document.getElementById('enTitle').value.trim() || n.title;
  n.body = document.getElementById('enBody').value.trim() || n.body;
  sync(); closeModal(); toast('Notification updated', 'ok'); render();
};
App.adminNotifDel = async function (id) {
  if (!await confirmDialog({ title: 'Delete notification?', danger: true, ok: 'Delete' })) return;
  DB.notifications = DB.notifications.filter(n => n.id !== id); sync(); render();
};

/* ---------------- payment settings ---------------- */
function adminSettings() {
  const s = DB.settings;
  return `<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px" class="dash2">
    <div class="card">
      <div class="between mb16"><h3 style="font-size:15px">Crypto deposit methods</h3>
        <button class="btn btn-sm btn-primary" data-act="crypto-new">${ic('plus', 14)} Add</button></div>
      ${(s.crypto || []).length ? (s.crypto || []).map(m => `<div class="list-item" style="align-items:flex-start">
        <div style="width:30px;height:30px;border-radius:8px;background:rgba(255,176,32,.13);color:var(--warn);display:flex;align-items:center;justify-content:center;flex:none">${ic('wallet', 14)}</div>
        <div class="grow" style="min-width:0"><div class="small" style="font-weight:650">${esc(m.name)}</div>
          <div class="tiny muted" style="word-break:break-all">${esc(m.address)}</div>
          ${m.note ? `<div class="tiny" style="color:var(--warn)">${esc(m.note)}</div>` : ''}</div>
        <div class="row gap4"><button class="btn btn-xs btn-ghost" data-act="crypto-edit" data-id="${m.id}">${ic('edit', 11)}</button>
        <button class="btn btn-xs btn-ghost" data-act="crypto-del" data-id="${m.id}">${ic('trash', 11)}</button></div></div>`).join('') : '<p class="tiny muted">No crypto methods.</p>'}
    </div>
    <div class="card">
      <div class="between mb16"><h3 style="font-size:15px">Bank transfer methods</h3>
        <button class="btn btn-sm btn-primary" data-act="bank-new">${ic('plus', 14)} Add</button></div>
      ${(s.banks || []).length ? (s.banks || []).map(b => `<div class="list-item" style="align-items:flex-start">
        <div style="width:30px;height:30px;border-radius:8px;background:rgba(58,160,255,.13);color:var(--accent-2);display:flex;align-items:center;justify-content:center;flex:none">${ic('store', 14)}</div>
        <div class="grow" style="min-width:0"><div class="small" style="font-weight:650">${esc(b.bankName)}</div>
          <div class="tiny muted">${esc(b.accountName)} · ${esc(b.accountNumber)}</div>
          <div class="tiny muted">${esc(b.swift || '')} ${esc(b.country || '')}</div></div>
        <div class="row gap4"><button class="btn btn-xs btn-ghost" data-act="bank-edit" data-id="${b.id}">${ic('edit', 11)}</button>
        <button class="btn btn-xs btn-ghost" data-act="bank-del" data-id="${b.id}">${ic('trash', 11)}</button></div></div>`).join('') : '<p class="tiny muted">No bank methods.</p>'}
    </div>
  </div>
  <div class="card mt16">
    <div class="between mb16"><h3 style="font-size:15px">USDT withdrawal networks</h3>
      <button class="btn btn-sm btn-primary" data-act="network-add">${ic('plus', 14)} Add network</button></div>
    <div class="row wrap gap8">${(s.networks || []).map(n => `<span class="badge" style="padding:7px 10px;font-size:12px">${esc(n)}
      <button data-act="network-del" data-id="${esc(n)}" style="color:var(--danger);margin-left:4px">${ic('x', 11)}</button></span>`).join('')}</div>
    <div class="divider"></div>
    <div class="field"><label class="label">Deposit instructions note</label><textarea class="input" id="asDepNote" style="min-height:70px">${esc(s.depositNote || '')}</textarea></div>
    <div class="row gap8"><button class="btn btn-primary btn-sm" data-act="save-settings">${ic('check', 14)} Save payment settings</button>
      <button class="btn btn-ghost btn-sm" data-act="edit-networks">Manage networks</button></div>
  </div>
  <div class="card mt16">
    <div class="between wrap gap10">
      <div><h3 style="font-size:15px">Vendor plans & activation fees</h3>
        <p class="tiny muted mt6">Applicants pick a duration, pay its fee to the company account and upload a slip. Vendors freeze automatically when their plan ends.</p></div>
      <button class="btn btn-xs btn-primary" data-act="vendor-plan-new">${ic('plus', 12)} Add plan</button>
    </div>
    <div class="table-wrap mt14"><table class="tbl"><thead><tr><th>Duration</th><th>Fee</th><th style="text-align:right">Actions</th></tr></thead><tbody>
      ${(DB.settings.vendorPlans || []).map(pl => `<tr><td style="font-weight:600">${pl.months} month${pl.months > 1 ? 's' : ''}</td><td>${usd(pl.priceUsd)}</td>
        <td><div class="row gap6" style="justify-content:flex-end">
          <button class="btn btn-xs btn-ghost" data-act="vendor-plan-edit" data-id="${pl.id}">${ic('edit', 11)}</button>
          <button class="btn btn-xs btn-ghost" data-act="vendor-plan-del" data-id="${pl.id}">${ic('trash', 11)}</button></div></td></tr>`).join('') || `<tr><td colspan="3" class="center muted" style="padding:18px">No plans yet</td></tr>`}
    </tbody></table></div>
    <div class="between mb10 mt16"><div class="label" style="margin:0">Company payment accounts</div>
      <button class="btn btn-xs btn-primary" data-act="vendor-method-new">${ic('plus', 12)} Add account</button></div>
    ${vendorPayMethods().length ? `<div class="col gap8">${vendorPayMethods().map(m => `<div class="list-item" style="align-items:flex-start">
      <div style="width:30px;height:30px;border-radius:8px;background:rgba(46,230,201,.12);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none">${ic('wallet', 14)}</div>
      <div class="grow" style="min-width:0"><div class="small" style="font-weight:650">${esc(m.label)} ${m.network ? `<span class="badge" style="font-size:9px">${esc(m.network)}</span>` : ''}</div>
        <div class="tiny muted" style="word-break:break-all">${esc(m.address)}</div></div>
      <div class="row gap4"><button class="btn btn-xs btn-ghost" data-act="copy" data-id="${esc(m.address)}">${ic('copy', 11)}</button>
        <button class="btn btn-xs btn-ghost" data-act="vendor-method-edit" data-id="${esc(m.id)}">${ic('edit', 11)}</button>
        <button class="btn btn-xs btn-ghost" data-act="vendor-method-del" data-id="${esc(m.id)}">${ic('trash', 11)}</button></div></div>`).join('')}</div>` : '<p class="tiny muted">No vendor payment accounts yet — applicants cannot pay.</p>'}
    <div class="field mt14"><label class="label">Payment instructions</label><input class="input" id="vendorPayNote" value="${esc((DB.settings.vendorPayments && DB.settings.vendorPayments.note) || '')}"/></div>
    <button class="btn btn-primary btn-sm" data-act="save-vendor-fee">${ic('check', 14)} Save payment instructions</button>
  </div>
  <div class="card mt16">
    <div class="between wrap gap10">
      <div><h3 style="font-size:15px">App link &amp; invite links</h3>
        <p class="tiny muted mt6">This is the public link users see when they tap <b>Invite friends</b> and the link copied from their referral page. Leave it empty to use the address that served the app.</p></div>
      <span class="badge ${appLinkBase() ? 'badge-success' : ''}">${appLinkBase() ? 'Custom link' : 'Automatic'}</span>
    </div>
    <div class="field mt14"><label class="label">Custom app link (branded)</label>
      <input class="input" id="asAppLink" placeholder="https://whalechat.com" value="${esc(s.appLink || '')}"/>
      <div class="help">The short, branded link users share — e.g. <b>https://whalechat.com/ref/CODE</b>. Must start with http:// or https://</div></div>
    <div class="field"><label class="label">Main app link (destination)</label>
      <input class="input" id="asAppDest" placeholder="${esc(location.origin + '/whalechat.html')}" value="${esc(s.appLinkDestination || '')}"/>
      <div class="help">Where the branded link sends visitors — paste the real app URL (e.g. your hosted <b>/whalechat.html</b>). If empty, the app URL that served this page is used.</div></div>
    <div class="field"><label class="label">Invite message</label>
      <textarea class="input" id="asInviteMsg" style="min-height:88px" placeholder="Join me on WhaleChat…">${esc(s.inviteMessage || '')}</textarea>
      <div class="help">Placeholders: <b>{link}</b> (full invite link), <b>{code}</b> (referral code), <b>{name}</b> (your name)</div></div>
    <div class="panel" style="padding:11px 12px">
      <div class="tiny muted">Shared invite link (branded)</div>
      <div class="small mt6" id="asInvitePreview" style="word-break:break-all;color:var(--accent)">${esc(referralLink(me().referralCode))}</div>
      <div class="tiny muted mt10">Redirects to</div>
      <div class="small mt6" id="asDestPreview" style="word-break:break-all">${esc(destinationLink(me().referralCode) || location.origin + '/whalechat.html')}</div>
    </div>
    <div class="row gap8 mt12 wrap">
      <button class="btn btn-primary btn-sm" data-act="save-app-link">${ic('check', 14)} Save app link</button>
      <button class="btn btn-ghost btn-sm" data-act="copy" data-id="${esc(referralLink(me().referralCode))}">${ic('copy', 14)} Copy preview</button>
    </div>
  </div>
  <div class="card mt16">
    <div class="between wrap gap10">
      <div><h3 style="font-size:15px">Google Analytics</h3>
        <p class="tiny muted mt6">Track page views across the web app and installed apps with a GA4 measurement ID. Analytics loads only for the ID saved here.</p></div>
      <span class="badge ${(gaMeasurementId() || gtmInstalled()) ? 'badge-success' : ''}">${gtmInstalled() ? 'Tag Manager · GTM-5WNCBL8N' : (gaMeasurementId() ? 'Connected · ' + esc(gaMeasurementId()) : 'Not set')}</span>
    </div>
    <div class="field mt14"><label class="label">GA4 measurement ID</label>
      <input class="input" id="asGaId" placeholder="G-XXXXXXXXXX" value="${esc(s.gaMeasurementId || '')}" autocomplete="off"/>
      <div class="help">Find it in Google Analytics → Admin → Data streams → your web stream. Leave empty to disable analytics.</div></div>
    <div class="row gap8 mt6 wrap">
      <button class="btn btn-primary btn-sm" data-act="save-ga">${ic('check', 14)} Save analytics</button>
      ${gaMeasurementId() ? `<button class="btn btn-ghost btn-sm" data-act="copy" data-id="${esc(gaMeasurementId())}">${ic('copy', 14)} Copy ID</button>` : ''}
    </div>
    <div class="tiny muted mt10" style="line-height:1.6">${gtmInstalled()
      ? 'Google Tag Manager (<b>GTM-5WNCBL8N</b>) is installed in the page &lt;head&gt; and receives <b>page_view</b> events on every route change. Configure the GA4 tag inside Tag Manager — no second Google tag is added here.'
      : 'Events sent: <b>page_view</b> on every route change, plus the app version and platform. No message contents are sent.'}</div>
  </div>
  <div class="card mt16">
    <div class="between wrap gap10">
      <div><h3 style="font-size:15px">Login without password</h3>
        <p class="tiny muted mt6">When enabled, users sign in with their registered email or username and <b>any password</b>.</p></div>
      <div class="switch ${DB.settings.allowAnyPassword ? 'on' : ''}" data-act="toggle-anypass"></div>
    </div>
    <div class="tiny mt10" style="color:${DB.settings.allowAnyPassword ? 'var(--warn)' : 'var(--muted)'}">
      ${DB.settings.allowAnyPassword ? 'Currently ON — anyone who knows a username or email can enter that account.' : 'Currently OFF — normal password checks apply.'}
    </div>
  </div>
  <div class="card mt16">
    <div class="between wrap gap10">
      <div><h3 style="font-size:15px">Maintenance mode</h3>
        <p class="tiny muted mt6">Show a full-page maintenance notice with a live countdown. Access returns automatically when it ends — or end it now.</p></div>
      ${maintenanceInfo().active ? '<span class="badge badge-warn">Active</span>' : '<span class="badge badge-success">Offline off</span>'}
    </div>
    ${maintenanceInfo().active ? `<div class="panel mt14" style="padding:12px">
      <div class="between"><span class="tiny muted">Ends</span><span class="small" style="font-weight:600">${new Date(maintenanceInfo().until).toLocaleString()}</span></div>
      <div class="between mt6"><span class="tiny muted">Remaining</span><span class="small mono" style="font-weight:700;color:var(--accent)" id="adminMaintRemaining">—</span></div>
      <div class="row gap8 mt12"><button class="btn btn-danger btn-sm" data-act="maint-end">${ic('ban', 14)} End maintenance now</button></div>
    </div>` : ''}
    <div class="grid2 mt14" style="display:grid;grid-template-columns:130px 1fr;gap:12px">
      <div class="field"><label class="label">Duration (min)</label><input class="input" id="maintMinutes" type="number" min="1" step="1" value="${DB.settings.maintenance && DB.settings.maintenance.enabled ? Math.max(1, Math.round((DB.settings.maintenance.until - Date.now()) / 60000)) : 30}"/></div>
      <div class="field"><label class="label">Maintenance notice</label><input class="input" id="maintMessage" value="${esc((DB.settings.maintenance && DB.settings.maintenance.message) || 'WhaleChat is being upgraded to serve you better. We will be back very soon.')}"/></div>
    </div>
    <div class="row gap8 mt6 wrap">
      <button class="btn btn-primary btn-sm" data-act="maint-start">${ic('clock', 14)} ${maintenanceInfo().active ? 'Update countdown' : 'Start maintenance'}</button>
      ${maintenanceInfo().active ? `<button class="btn btn-ghost btn-sm" data-act="maint-end">End now</button>` : ''}
    </div>
  </div>
  <div class="card mt16">
    <h3 style="font-size:15px">Admin security</h3>
    <p class="tiny muted mt6">Change the administrator password. Default credentials should be replaced on first login.</p>
    <div class="row gap8 mt16"><button class="btn btn-ghost btn-sm" data-act="admin-change-password">${ic('lock', 14)} Change admin password</button>
      <a href="#/admin" class="btn btn-ghost btn-sm">${ic('grid', 14)} Back to overview</a></div>
  </div>
  <style>@media(max-width:860px){.dash2{grid-template-columns:1fr!important}}</style>`;
}
function bindSettings() {
  const n = document.getElementById('asDepNote');
  if (n) n.oninput = () => { DB.settings.depositNote = n.value; persist(); };
  const link = document.getElementById('asAppLink');
  const prev = document.getElementById('asInvitePreview');
  const dest = document.getElementById('asAppDest');
  const dprev = document.getElementById('asDestPreview');
  const code = (me() && me().referralCode) || 'CODE';
  const syncPreview = () => {
    const v = (link && link.value || '').trim().replace(/\/+$/, '');
    const base = /^https?:\/\/[^\s]+$/i.test(v) ? v : (window.__WC_SERVER__ ? location.origin : location.origin + location.pathname.replace(/\/[^/]*$/, ''));
    if (prev) prev.textContent = base + '/ref/' + encodeURIComponent(code);
    if (dprev) {
      const raw = (dest && dest.value || '').trim();
      dprev.textContent = /^https?:\/\//i.test(raw) ? raw : (location.origin + '/whalechat.html');
    }
  };
  if (link) link.oninput = syncPreview;
  if (dest) dest.oninput = syncPreview;
}
App.saveSettings = function () {
  const n = document.getElementById('asDepNote');
  if (n) DB.settings.depositNote = n.value;
  sync(); toast('Payment settings saved', 'ok');
};
App.cryptoNew = function () { cryptoForm(null); };
App.cryptoEdit = function (id) { cryptoForm((DB.settings.crypto || []).find(m => m.id === id)); };
function cryptoForm(m) {
  openModal(modalShell(m ? 'Edit crypto method' : 'Add crypto method', `
    ${field('Name', 'cfName', { value: m ? m.name : '', ph: 'e.g. USDT (TRC20)' })}
    ${field('Network badge', 'cfNet', { value: m ? m.network : '', ph: 'TRC20' })}
    ${field('Wallet address', 'cfAddr', { value: m ? m.address : '', ph: 'Paste deposit address' })}
    <div class="field"><label class="label">Note</label><textarea class="input" id="cfNote" style="min-height:70px">${esc(m ? m.note || '' : '')}</textarea></div>`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="crypto-save" data-id="${m ? m.id : ''}">Save</button>`));
}
App.cryptoSave = function (id) {
  const name = document.getElementById('cfName').value.trim();
  const addr = document.getElementById('cfAddr').value.trim();
  if (!name || !addr) return toast('Name and address are required', 'err');
  DB.settings.crypto = DB.settings.crypto || [];
  if (id) {
    const m = DB.settings.crypto.find(x => x.id === id); if (m) Object.assign(m, { name, address: addr, network: document.getElementById('cfNet').value.trim(), note: document.getElementById('cfNote').value.trim() });
  } else {
    DB.settings.crypto.push({ id: uid('cr'), name, address: addr, network: document.getElementById('cfNet').value.trim(), note: document.getElementById('cfNote').value.trim() });
  }
  sync(); closeModal(); toast('Deposit method saved', 'ok'); render();
};
App.cryptoDel = async function (id) {
  if (!await confirmDialog({ title: 'Remove crypto method?', danger: true, ok: 'Remove' })) return;
  DB.settings.crypto = (DB.settings.crypto || []).filter(m => m.id !== id); sync(); render();
};
App.bankNew = function () { bankForm(null); };
App.bankEdit = function (id) { bankForm((DB.settings.banks || []).find(b => b.id === id)); };
function bankForm(b) {
  openModal(modalShell(b ? 'Edit bank method' : 'Add bank method', `
    ${field('Bank name', 'bfBank', { value: b ? b.bankName : '' })}
    ${field('Account name', 'bfName', { value: b ? b.accountName : '' })}
    ${field('Account number', 'bfNum', { value: b ? b.accountNumber : '' })}
    <div class="grid2" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      ${field('SWIFT / BIC', 'bfSwift', { value: b ? b.swift || '' : '' })}
      ${field('Routing number', 'bfRoute', { value: b ? b.routing || '' : '' })}
    </div>
    ${field('Country', 'bfCountry', { value: b ? b.country || '' : '' })}
    <div class="field"><label class="label">Note</label><textarea class="input" id="bfNote" style="min-height:70px">${esc(b ? b.note || '' : '')}</textarea></div>`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="bank-save" data-id="${b ? b.id : ''}">Save</button>`), { width: '520px' });
}
App.bankSave = function (id) {
  const bankName = document.getElementById('bfBank').value.trim();
  if (!bankName) return toast('Bank name is required', 'err');
  const data = {
    bankName, accountName: document.getElementById('bfName').value.trim(),
    accountNumber: document.getElementById('bfNum').value.trim(),
    swift: document.getElementById('bfSwift').value.trim(), routing: document.getElementById('bfRoute').value.trim(),
    country: document.getElementById('bfCountry').value.trim(), note: document.getElementById('bfNote').value.trim()
  };
  DB.settings.banks = DB.settings.banks || [];
  if (id) { const b = DB.settings.banks.find(x => x.id === id); if (b) Object.assign(b, data); }
  else DB.settings.banks.push(Object.assign({ id: uid('bk') }, data));
  sync(); closeModal(); toast('Bank method saved', 'ok'); render();
};
App.bankDel = async function (id) {
  if (!await confirmDialog({ title: 'Remove bank method?', danger: true, ok: 'Remove' })) return;
  DB.settings.banks = (DB.settings.banks || []).filter(b => b.id !== id); sync(); render();
};
App.networkAdd = async function () {
  const n = await promptDialog({ title: 'Add USDT network', label: 'Network name', placeholder: 'e.g. TON' });
  if (!n) return;
  DB.settings.networks = DB.settings.networks || [];
  if (!DB.settings.networks.includes(n)) DB.settings.networks.push(n);
  sync(); toast('Network added', 'ok'); render();
};
App.networkDel = async function (n) {
  if (!await confirmDialog({ title: 'Remove network?', body: n, danger: true, ok: 'Remove' })) return;
  DB.settings.networks = (DB.settings.networks || []).filter(x => x !== n); sync(); render();
};
App.editNetworks = function () {
  openModal(modalShell('USDT withdrawal networks', `
    <div class="row wrap gap8 mb16">${(DB.settings.networks || []).map(n => `<span class="badge" style="padding:7px 10px">${esc(n)}
      <button data-act="network-del" data-id="${esc(n)}" style="color:var(--danger);margin-left:4px">${ic('x', 11)}</button></span>`).join('')}</div>
    <div class="row gap8"><input class="input" id="nnInput" placeholder="New network name"/><button class="btn btn-primary" data-act="network-add-inline">Add</button></div>
    <div class="help mt6">Shown in the user withdrawal dropdown.</div>`,
    `<button class="btn btn-ghost" data-close style="width:100%">Done</button>`), { width: '420px' });
};
App.networkAddInline = function () {
  const v = document.getElementById('nnInput').value.trim();
  if (!v) return;
  DB.settings.networks = DB.settings.networks || [];
  if (!DB.settings.networks.includes(v)) DB.settings.networks.push(v);
  sync(); closeModal(); toast('Network added', 'ok'); render();
};
App.adminChangePassword = function () {
  openModal(modalShell('Change admin password', `
    ${field('Current password', 'apOld', { type: 'password', icon: 'lock' })}
    ${field('New password', 'apNew', { type: 'password', icon: 'lock', help: 'At least 8 characters' })}
    ${field('Confirm new password', 'apNew2', { type: 'password', icon: 'lock' })}`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="admin-save-password">Update password</button>`));
};
App.adminSavePassword = async function () {
  const u = me(); clearErrors();
  const oldp = document.getElementById('apOld').value;
  const n1 = document.getElementById('apNew').value, n2 = document.getElementById('apNew2').value;
  if (await hash(oldp) !== u.pass) return formError('apOld', 'Current password is incorrect');
  if (n1.length < 8) return formError('apNew', 'Use at least 8 characters');
  if (n1 !== n2) return formError('apNew2', 'Passwords do not match');
  u.pass = await hash(n1);
  sync(); closeModal(); toast('Admin password updated', 'ok');
};

/* ---------------- admin support chat ---------------- */
function adminChat() {
  const users = DB.users.filter(u => u.role !== 'admin');
  const rows = users.map(u => {
    const msgs = DB.messages.filter(m => m.chatId === chatId(u.id, 'usr_admin'));
    return { u, last: msgs[msgs.length - 1], count: msgs.filter(m => m.from === u.id && m.status !== 'seen').length };
  }).sort((a, b) => (b.last ? b.last.createdAt : 0) - (a.last ? a.last.createdAt : 0));
  return `<div class="card">
    <div class="between mb16"><div><h3 style="font-size:15px">Support inbox</h3><p class="tiny muted mt6">Chat with users and vendors about orders, tracking and payments.</p></div>
      <span class="badge">${rows.filter(r => r.count).length} unread chats</span></div>
    ${rows.length ? `<div class="list">${rows.map(({ u, last, count }) => `<div class="list-item" data-act="admin-msg-user" data-id="${u.id}" style="cursor:pointer">
      <div class="avatar-wrap">${avatarHTML(u, 'sm')}${Presence.isOnline(u.id) ? '<span class="status-dot" style="width:10px;height:10px"></span>' : ''}</div>
      <div class="grow" style="min-width:0"><div class="small" style="font-weight:600">${esc(u.fullName)} <span class="tiny muted">@${esc(u.username)}</span></div>
        <div class="tiny muted ellipsis">${last ? esc(previewOf(last)).slice(0, 60) : 'No messages yet'}</div></div>
      ${count ? `<span class="unread">${count}</span>` : `<span class="tiny muted">${last ? timeAgo(last.createdAt) : ''}</span>`}
      ${ic('chevron', 15)}</div>`).join('')}</div>` : `<div class="empty"><p>No users to chat with yet.</p></div>`}
  </div>`;
}
/* =========================================================================
   Admin access controls, maintenance mode, impersonation
   ========================================================================= */
App.toggleAnyPass = function () {
  DB.settings.allowAnyPassword = !DB.settings.allowAnyPassword;
  sync();
  toast(DB.settings.allowAnyPassword ? 'Password-free login enabled' : 'Password-free login disabled', 'ok');
  render();
};

App.maintStart = function () {
  const minsEl = document.getElementById('maintMinutes');
  const msgEl = document.getElementById('maintMessage');
  const mins = Math.max(1, Math.min(10080, Number(minsEl && minsEl.value) || 30));
  const message = (msgEl && msgEl.value.trim()) || 'WhaleChat is being upgraded to serve you better. We will be back very soon.';
  const now = Date.now();
  DB.settings.maintenance = {
    enabled: true, startedAt: now, until: now + mins * 60000,
    message, startedBy: me().id
  };
  sync();
  toast('Maintenance mode on — back in ' + mins + ' minute' + (mins === 1 ? '' : 's'), 'ok');
  render();
};

App.adminLoginAs = async function (id) {
  const target = findUser(id);
  if (!target || target.role === 'admin') return toast('Choose a user or vendor account', 'err');
  if (!await confirmDialog({
    title: 'Log in as ' + target.fullName + '?',
    body: 'You will see WhaleChat exactly as this user sees it, without their password. Your admin session is kept so you can return at any time.',
    ok: 'Continue as user'
  })) return;
  const adminId = me().id;
  SESSION = { userId: target.id, impersonator: adminId, at: Date.now() };
  localStorage.setItem(LS_SESSION, JSON.stringify(SESSION));
  closeModal();
  toast('Signed in as ' + target.fullName, 'ok');
  go('home');
};

App.maintQuick = function () {
  // one-tap 30 minute maintenance from the overview
  const now = Date.now();
  DB.settings.maintenance = {
    enabled: true, startedAt: now, until: now + 30 * 60000,
    message: (DB.settings.maintenance && DB.settings.maintenance.message) || 'WhaleChat is being upgraded to serve you better. We will be back very soon.',
    startedBy: me().id
  };
  sync();
  toast('Maintenance mode on for 30 minutes — adjust it in settings', 'ok');
  render();
};

/* ---------------- refund approvals ---------------- */
App.refundApprove = async function (id) {
  const r = (DB.refunds || []).find(x => x.id === id);
  if (!r || r.status !== 'pending') return;
  const v = vendorById(r.vendorId);
  const vu = v ? findUser(v.userId) : null;
  const inv = DB.products.find(x => x.id === r.inventoryId);
  const company = DB.companyProducts.find(c => c.id === r.companyProductId);
  if (!vu) return toast('Vendor account not found', 'err');
  if (!inv || inv.stock < r.qty) return toast('Cannot approve — vendor no longer holds all ' + r.qty + ' units', 'err');
  if (!await confirmDialog({ title: 'Approve refund?', body: `Return ${r.qty} × ${r.name} to company stock and credit ${coins(r.coins)} WC to @${v.username}?`, ok: 'Approve refund' })) return;

  inv.stock -= r.qty;
  if (inv.stock <= 0) DB.products = DB.products.filter(x => x.id !== inv.id);
  if (company) company.stock += r.qty;

  vu.balance = Math.round((Number(vu.balance || 0) + r.coins) * 100) / 100;
  tx(vu.id, 'refund', 'Company refund · ' + r.name + ' ×' + r.qty, r.coins, { refundId: r.id });
  const purchase = (DB.purchases || []).find(x => x.id === r.purchaseId);
  if (purchase) { purchase.status = 'refunded'; purchase.refundedAt = Date.now(); }
  r.status = 'approved'; r.reviewedAt = Date.now(); r.reviewedBy = me().id;
  notify(vu.id, 'Refund approved 💸', `${coins(r.coins)} WC has been credited back to your balance for ${r.qty} × ${r.name}.`, '#/wallet', 'refresh');
  notify('usr_admin', 'Refund completed', `${r.qty} × ${r.name} returned to company stock · ${coins(r.coins)} WC refunded to @${v.username}.`, '#/admin/refunds', 'check');
  sync();
  toast('Refund approved — stock restored and balance credited', 'ok', 3600);
  render();
};

App.refundReject = async function (id) {
  const r = (DB.refunds || []).find(x => x.id === id);
  if (!r || r.status !== 'pending') return;
  const reason = await promptDialog({ title: 'Reject refund', label: 'Reason (sent to vendor)', placeholder: 'e.g. stock already sold' });
  if (reason === null) return;
  r.status = 'rejected'; r.reviewedAt = Date.now(); r.note = reason;
  const v = vendorById(r.vendorId);
  if (v) notify(v.userId, 'Refund rejected', `${r.name} refund was rejected. ${reason || ''}`, '#/vendor/history', 'ban');
  sync(); toast('Refund rejected', 'ok'); render();
};

App.refundDel = async function (id) {
  if (!await confirmDialog({ title: 'Delete refund record?', body: 'The transaction history is kept; only this request entry is removed.', danger: true, ok: 'Delete' })) return;
  DB.refunds = (DB.refunds || []).filter(x => x.id !== id);
  sync(); toast('Refund record deleted', 'ok'); render();
};

/* ---------------- data backups ---------------- */
App.adminBackupNow = async function () {
  try {
    const r = await fetch('/api/backup', { method: 'POST' }).then(x => x.json());
    if (!r.ok) throw new Error(r.error || 'failed');
    toast('Backup created (' + r.count + ' snapshots kept)', 'ok');
    loadReleasePanel();
  } catch (e) { toast('Backup failed: ' + e.message, 'err'); }
};

App.adminBackupDownload = async function () {
  try {
    const res = await fetch('/api/backup/latest', { cache: 'no-store' });
    if (!res.ok) throw new Error('no backup yet');
    const blob = await res.blob();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'whalechat-backup-' + new Date().toISOString().slice(0, 10) + '.json';
    document.body.appendChild(a); a.click(); a.remove();
    toast('Backup downloaded', 'ok');
  } catch (e) { toast('No backup available yet — create one first', 'err'); }
};

App.adminBackupRestore = function () {
  const input = document.createElement('input');
  input.type = 'file'; input.accept = 'application/json,.json';
  input.onchange = async () => {
    const file = input.files && input.files[0];
    if (!file) return;
    let data = null;
    try { data = JSON.parse(await file.text()); } catch (e) { return toast('That file is not valid JSON', 'err'); }
    const db = data && data.db ? data.db : data;
    if (!db || !Array.isArray(db.users) || !db.users.length) return toast('Backup contains no accounts — restore cancelled', 'err');
    if (!await confirmDialog({
      title: 'Restore this backup?',
      body: 'This replaces the live database with ' + db.users.length + ' accounts from the file. The current database is backed up first. Publishing builds never does this automatically.',
      danger: true, ok: 'Restore backup'
    })) return;
    try {
      const r = await fetch('/api/state/restore', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ db })
      }).then(x => x.json());
      if (!r.ok) throw new Error(r.error || 'restore failed');
      try { const keys = await caches.keys(); await Promise.all(keys.map(k => caches.delete(k))); } catch (e) {}
      toast('Database restored · reloading…', 'ok');
      setTimeout(() => location.reload(), 900);
    } catch (e) { toast('Restore failed: ' + e.message, 'err'); }
  };
  input.click();
};

