   Auth, onboarding, app shell, navigation
   ========================================================================= */
const App = {};
window.A = App;

function brandMark(size = 36, name = true) {
  return `<div class="brand"><img src="${LOGO}" alt="WhaleChat" style="width:${size}px;height:${size}px"/>${name ? `<div class="brand-name">Whale<b>Chat</b></div>` : ''}</div>`;
}

function authSplit(formHTML) {
  return `<div class="auth">
    <aside class="auth-art">
      <img class="bg" src="data:image/jpeg;base64," alt="" />
      <div class="brand" style="color:#fff"><img src="${LOGO}" alt="" style="width:38px;height:38px"/><div class="brand-name" style="color:#fff">Whale<b style="color:var(--accent)">Chat</b></div></div>
      <div class="auth-hero">
        <h1>Chat, shop and get paid in one calm place.</h1>
        <p>WhaleChat brings your conversations, your store and your wallet together, with referral rewards for every friend you invite.</p>
        <div class="auth-feats">
          <span class="auth-feat">${ic('chat', 14)} Private messaging</span>
          <span class="auth-feat">${ic('bag', 14)} Marketplace</span>
          <span class="auth-feat">${ic('wallet', 14)} USDT wallet</span>
          <span class="auth-feat">${ic('shield', 14)} PIN protected</span>
        </div>
      </div>
      <div class="small" style="color:#7e97a8">© ${new Date().getFullYear()} WhaleChat · 1 Whale Coin = $0.50 USD</div>
    </aside>
    <section class="auth-form-wrap">
      <div class="auth-card">
        <div class="auth-mobile-logo">${brandMark(38)}</div>
        ${formHTML}
      </div>
    </section>
  </div>`;
}

function field(label, id, opts = {}) {
  const { type = 'text', ph = '', value = '', icon = null, help = '', maxlength = '', autocomplete = 'off', inputmode = '' } = opts;
  const inp = `<input class="input" id="${id}" name="${id}" type="${type}" placeholder="${esc(ph)}" value="${esc(value)}"
    autocomplete="${autocomplete}" ${maxlength ? `maxlength="${maxlength}"` : ''} ${inputmode ? `inputmode="${inputmode}"` : ''} />`;
  return `<div class="field"><label class="label" for="${id}">${esc(label)}</label>
    ${icon ? `<div class="input-wrap"><span class="ic">${ic(icon, 17)}</span>${inp}${type === 'password' ? `<button type="button" class="eye" data-peek="${id}">${ic('eye', 16)}</button>` : ''}</div>` : inp}
    ${help ? `<div class="help">${help}</div>` : ''}
    <div class="err" id="err_${id}" style="display:none"></div></div>`;
}
function formError(id, msg) {
  const e = document.getElementById('err_' + id);
  if (!e) { toast(msg, 'err'); return; }
  e.textContent = msg; e.style.display = 'block';
  const inp = document.getElementById(id);
  if (inp) { inp.style.borderColor = 'var(--danger)'; inp.focus(); }
}
function clearErrors(scope) {
  $$('.err', scope || document).forEach(e => { e.style.display = 'none'; e.textContent = ''; });
  $$('.input', scope || document).forEach(i => i.style.borderColor = '');
}

