          ${[['shield', 'PIN protected withdrawals'], ['wallet', 'Whale Coin wallet'], ['truck', 'Order tracking']].map(([i, t]) => `<span class="row gap6 muted tiny" style="font-weight:600">${ic(i, 15)} ${t}</span>`).join('')}
