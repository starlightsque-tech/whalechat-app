ypto.subtle) {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(salt + str));
      return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
    }
  } catch (e) { /* fall through */ }
  return 'fb' + fnv(salt + str) + fnv(str + salt);
}
function fnv(s) {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }
  return h.toString(16);
}
function copyText(text) {
  const done = () => toast('Copied to clipboard', 'ok');
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
  } else fallbackCopy(text, done);
}
function fallbackCopy(text, done) {
  const ta = document.createElement('textarea');
  ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
  document.body.appendChild(ta); ta.select();
  try { document.execCommand('copy'); done(); } catch (e) { toast('Copy failed', 'err'); }
  ta.remove();
}

/* ---------------- persistence ---------------- */
let DB = null;
let SESSION = null;
let SAVE_TIMER = null;

function blankDB() {
  return {
    version: 1,
    users: [], vendors: [], companyProducts: [], products: [], orders: [],
    deposits: [], withdrawals: [], messages: [], statuses: [], chatsMeta: {}, referrals: [], purchases: [],
    contacts: [], blocks: [], notifications: [], txs: [], reports: [], refunds: [], vendorApplications: [], bonuses: [], bonusClaims: [], emailCampaigns: [],
    settings: {
      crypto: [
        { id: 'cr_1', name: 'USDT (TRC20)', address: 'TQn9Y2khEsLJW1ChVWFMSMeRDow5KcbLSE', network: 'TRC20', note: 'Send only USDT on TRC20. Minimum $5.' },
        { id: 'cr_2', name: 'Bitcoin (BTC)', address: 'bc1qwhalechat9d2f7k4m8s3v6x1p5n0r2t4y7u', network: 'Bitcoin', note: 'Minimum $10.' }
      ],
      banks: [
        { id: 'bk_1', bankName: 'WhaleChat Trust Bank', accountName: 'WhaleChat Ltd', accountNumber: '4102 8890 7712', swift: 'WCTRUS33', routing: '021000021', country: 'United States', note: 'Use your username as reference.' }
      ],
      networks: ['TRC20', 'ERC20', 'BEP20', 'Polygon', 'Solana', 'Avalanche'],
      depositNote: 'Deposits are reviewed by our team and credited to your Whale Coin balance.',
      supportEmail: 'support@whalechat.app',
      appLink: '',
      appLinkDestination: '',
      inviteMessage: '',
      gaMeasurementId: '',
      allowAnyPassword: false,
      vendorFeeUsd: 50,
      vendorPlans: [
        { id: 'vpl_1', months: 1, priceUsd: 50 },
        { id: 'vpl_2', months: 2, priceUsd: 200 },
        { id: 'vpl_3', months: 3, priceUsd: 400 }
      ],
      vendorPayments: {
        note: 'Pay the exact vendor activation fee, then upload your payment receipt for review.',
        methods: [
          { id: 'vpm_1', label: 'USDT (TRC20)', network: 'TRC20', address: 'TQn9Y2khEsLJW1ChVWFMSMeRDow5KcbLSE' }
        ]
      },
      maintenance: { enabled: false, until: 0, startedAt: 0, message: 'WhaleChat is being upgraded to serve you better. We will be back very soon.' }
    },
    meta: { createdAt: Date.now(), adminSeeded: false }
  };
}

async function seedDB() {
  const db = blankDB();
  const admin = {
    id: 'usr_admin', role: 'admin', fullName: 'WhaleChat Admin', username: 'Admin',
    email: 'admin@whalechat.app', phone: '+10000000000',
    pass: await hash('Admin@12345'), pin: null, avatar: null, balance: 0,
    totalDeposits: 0, totalWithdrawals: 0, totalEarnings: 0,
    referralCode: 'WHALEADMIN', referredBy: null, referralPaid: true,
    trustScore: 100, completedSales: 0, rating: 5, verified: true, banned: false,
    vendorId: null, cart: [], stars: [], settings: { notifications: true },
    createdAt: Date.now(), isAdmin: true
  };
  db.users.push(admin);
  // Company catalog so vendors have something to buy on day one (admin-editable)
  const catalog = [
    { name: 'Whale X1 Pro 5G', category: 'Phones', priceUsd: 620, stock: 40, emoji: '📱', desc: '6.7" AMOLED, 256GB, triple camera, 5000mAh.' },
    { name: 'OrcaBook Air 14"', category: 'Laptops', priceUsd: 940, stock: 22, emoji: '💻', desc: 'M2-class chip, 16GB RAM, 512GB SSD.' },
    { name: 'DeepBlue Pad 11', category: 'Tablets', priceUsd: 380, stock: 30, emoji: '📲', desc: '11" 120Hz display with stylus support.' },
    { name: 'EchoBuds Pro ANC', category: 'Headphones', priceUsd: 128, stock: 80, emoji: '🎧', desc: 'Hybrid ANC, 38h battery, spatial audio.' },
    { name: 'TidalCharge 65W GaN', category: 'Chargers', priceUsd: 34, stock: 180, emoji: '🔌', desc: '65W dual USB-C fast charger, travel ready.' },
    { name: 'WaveConsole X', category: 'Video Games', priceUsd: 480, stock: 26, emoji: '🎮', desc: '4K gaming console with wireless controller.' },
    { name: 'HarborShield Case', category: 'Phone Pouches', priceUsd: 19, stock: 240, emoji: '🛡️', desc: 'Military-grade drop protection, slim profile.' },
    { name: 'Nautilus Watch S2', category: 'Accessories', priceUsd: 210, stock: 45, emoji: '⌚', desc: 'AMOLED smartwatch, 14-day battery, GPS.' }
  ];
  db.companyProducts = catalog.map((c, i) => ({
    id: 'cp_' + (i + 1), name: c.name, category: c.category, priceUsd: c.priceUsd,
    stock: c.stock, emoji: c.emoji, image: null, description: c.desc, createdAt: Date.now() - i * 86400000
  }));
  db.meta.adminSeeded = true;
  return db;
}

function loadDB() {
  try {
    const raw = localStorage.getItem(LS_DB);
    if (!raw) return null;
    const db = JSON.parse(raw);
    if (!db || !Array.isArray(db.users)) return null;
    const merged = Object.assign(blankDB(), db);
    merged.settings = withSettingsDefaults(Object.assign({}, blankDB().settings, db.settings || {}));
    migrateVendorExpiry(merged);
    return merged;
  } catch (e) { return null; }
}

let DB_READY = false;
async function initDB() {
  DB = loadDB();
  if (!DB) { DB = await seedDB(); persist(true); }
  else if (!DB.users.some(u => u.role === 'admin')) {
    const admin = {
      id: 'usr_admin', role: 'admin', fullName: 'WhaleChat Admin', username: 'Admin',
      email: 'admin@whalechat.app', phone: '+10000000000', pass: await hash('Admin@12345'),
      pin: null, avatar: null, balance: 0, totalDeposits: 0, totalWithdrawals: 0, totalEarnings: 0,
      referralCode: 'WHALEADMIN', referredBy: null, referralPaid: true, trustScore: 100,
      completedSales: 0, rating: 5, verified: true, banned: false, vendorId: null,
      cart: [], stars: [], settings: { notifications: true }, createdAt: Date.now(), isAdmin: true
    };
    DB.users.push(admin); persist(true);
  }
  try { SESSION = JSON.parse(localStorage.getItem(LS_SESSION) || 'null'); } catch (e) { SESSION = null; }
  DB_READY = true;
  try { resolvePendingReferrals(); reconcileReferralBonuses(); } catch (e) {}
}

function withSettingsDefaults(settings) {
  const base = blankDB().settings;
  const out = Object.assign({}, base, settings || {});
  if (!Number.isFinite(Number(out.vendorFeeUsd))) out.vendorFeeUsd = base.vendorFeeUsd;
  out.vendorFeeUsd = Math.max(0, Number(out.vendorFeeUsd));
  if (!Array.isArray(out.vendorPlans) || !out.vendorPlans.length) out.vendorPlans = base.vendorPlans.slice();
  out.vendorPlans = out.vendorPlans
    .filter(p => p && Number(p.months) > 0)
    .map(p => ({ id: p.id || ('vpl_' + Math.random().toString(36).slice(2, 7)), months: Math.max(1, Math.round(Number(p.months))), priceUsd: Math.max(0, Number(p.priceUsd) || 0) }))
    .sort((a, b) => a.months - b.months);
  // keep the legacy single fee aligned with the cheapest plan
  if (out.vendorPlans[0]) out.vendorFeeUsd = out.vendorPlans[0].priceUsd;
  if (!out.vendorPayments || typeof out.vendorPayments !== 'object') out.vendorPayments = base.vendorPayments;
  if (!Array.isArray(out.vendorPayments.methods)) out.vendorPayments.methods = base.vendorPayments.methods.slice();
  if (typeof out.vendorPayments.note !== 'string') out.vendorPayments.note = base.vendorPayments.note;
  if (typeof out.appLink !== 'string') out.appLink = '';
  if (typeof out.appLinkDestination !== 'string') out.appLinkDestination = '';
  if (typeof out.inviteMessage !== 'string') out.inviteMessage = '';
  if (typeof out.gaMeasurementId !== 'string') out.gaMeasurementId = '';
  return out;
}

function migrateVendorExpiry(db) {
  // Vendors created before subscription plans existed get a 30-day grace period.
  (db.vendors || []).forEach(v => {
    if (!v.expiresAt) {
      v.expiresAt = Date.now() + 30 * 86400000;
      v.planMonths = v.planMonths || 1;
      v.planId = v.planId || ((db.settings.vendorPlans || [])[0] || {}).id || null;
    }
  });
  (db.vendorApplications || []).forEach(a => {
    if (!a.kind) a.kind = a.vendorId ? 'renewal' : 'new';
    if (!a.months) a.months = 1;
  });
  return db;
}

function persist(now) {
  if (!DB) return;
  const write = () => {
    try { localStorage.setItem(LS_DB, JSON.stringify(DB)); }
    catch (e) { toast('Storage is full — remove some media', 'err'); }
    SAVE_TIMER = null;
    try { if (typeof Remote !== 'undefined' && Remote && Remote.enabled) Remote.onLocalChange(); } catch (e) {}
  };
  if (now) { clearTimeout(SAVE_TIMER); write(); }
  else if (!SAVE_TIMER) SAVE_TIMER = setTimeout(write, 90);
}

const BC = ('BroadcastChannel' in window) ? new BroadcastChannel('whalechat.sync') : null;
function sync() {
  persist();
  try { BC && BC.postMessage({ t: Date.now(), from: SESSION && SESSION.userId }); } catch (e) {}
}
if (BC) BC.onmessage = (ev) => {
  if (!ev.data || ev.data.from === (SESSION && SESSION.userId)) return;
  DB = loadDB(); render();
};
window.addEventListener('storage', (e) => {
  if (e.key === LS_DB) { DB = loadDB(); render(); }
});
window.addEventListener('focus', () => {
  const fresh = loadDB();
  if (fresh && JSON.stringify(fresh) !== JSON.stringify(DB)) { DB = fresh; render(); }
});

/* ---------------- session helpers ---------------- */
function me() { return SESSION ? DB.users.find(u => u.id === SESSION.userId) || null : null; }
function findUser(id) { return DB.users.find(u => u.id === id) || null; }
function normalizeRefCode(input) {
  let s = String(input || '').trim();
  const m = s.match(/(?:ref[=\/])([A-Za-z0-9]{4,12})/i) || s.match(/[?#&]ref=([A-Za-z0-9]{4,12})/i);
  if (m) s = m[1];
  return s.replace(/[^A-Za-z0-9]/g, '').toUpperCase();
}

function findReferrer(code) {
  const c = normalizeRefCode(code);
  if (!c) return null;
  return DB.users.find(u => normalizeRefCode(u.referralCode) === c) || null;
}

/**
 * A referral can be saved before the inviter's account exists on this
 * database (different device/server, restored server, etc). Resolve those
 * as soon as the inviter shows up — on every boot, sync and payout.
 */
function resolvePendingReferrals() {
  let changed = false;
  DB.users.forEach(u => {
    if (u.referredBy || !u.pendingReferralCode) return;
    const ref = findReferrer(u.pendingReferralCode);
    if (!ref || ref.id === u.id) return;
    u.referredBy = ref.id;
    u.pendingReferralCode = null;
    changed = true;
    if (!isContact(u.id, ref.id)) DB.contacts.push({ id: uid('ct'), ownerId: u.id, userId: ref.id, createdAt: Date.now() });
    if (!isContact(ref.id, u.id)) DB.contacts.push({ id: uid('ct'), ownerId: ref.id, userId: u.id, createdAt: Date.now() });
    notify(ref.id, 'Referral linked 🎁', `${u.fullName} (@${u.username}) signed up with your code. You earn 10 Whale Coins when they make their first deposit.`, '#/referrals', 'gift');
    notify(u.id, 'Referral applied', `Your referral code ${normalizeRefCode(u.pendingReferralCode || '')} was linked successfully.`, '#/referrals', 'gift');
  });
  if (changed) persist();
  return changed;
}

/**
 * Credits the 10 WC referral bonus exactly once, and only after the invitee's
 * first deposit has been approved. Safe to call repeatedly (idempotent).
 */
function referralBonus(userId) {
  const u = findUser(userId);
  if (!u || u.role === 'admin' || !u.referredBy || u.referralPaid) return false;
  const inviter = findUser(u.referredBy);
  if (!inviter || inviter.id === u.id) return false;
  const approved = DB.deposits.some(d => d.userId === u.id && d.status === 'approved');
  if (!approved) return false;
  const alreadyPaid = DB.txs.some(t => t.userId === inviter.id && t.type === 'referral' && t.meta && t.meta.inviteeId === u.id);
  u.referralPaid = true;
  if (alreadyPaid) return false;
  inviter.balance = Math.round((Number(inviter.balance || 0) + 10) * 100) / 100;
  inviter.totalEarnings = Math.round((Number(inviter.totalEarnings || 0) + 10) * 100) / 100;
  tx(inviter.id, 'referral', 'Referral reward · @' + u.username, 10, { inviteeId: u.id });
  DB.referrals = DB.referrals || [];
  if (!DB.referrals.some(r => r.userId === u.id)) {
    DB.referrals.push({ id: uid('rf'), inviterId: inviter.id, userId: u.id, coins: 10, createdAt: Date.now() });
  }
  notify(inviter.id, 'Referral reward 🎁', `@${u.username} made their first deposit — 10 Whale Coins were credited to your balance.`, '#/referrals', 'gift');
  notify(u.id, 'Referral confirmed', `Your invite was confirmed. @${inviter.username} received a referral reward.`, '#/referrals', 'gift');
  return true;
}

function reconcileReferralBonuses() {
  let changed = false;
  DB.users.forEach(u => {
    if (!u.referralPaid && u.referredBy) { if (referralBonus(u.id)) changed = true; }
  });
  if (changed) { persist(); reconcileReferralBonuses(); }
  return changed;
}

function byUsername(s) {
  const q = String(s || '').trim().toLowerCase().replace(/^@/, '');
  return DB.users.find(u => u.username.toLowerCase() === q || u.email.toLowerCase() === q || (u.phone || '').replace(/\s/g, '') === q.replace(/\s/g, '')) || null;
}
function vendorOf(userId) { return DB.vendors.find(v => v.userId === userId) || null; }
function vendorPlanById(id) { return (DB.settings.vendorPlans || []).find(p => p.id === id) || null; }
function vendorIsActive(v) { return !!v && (!v.expiresAt || Number(v.expiresAt) > Date.now()); }
function vendorDaysLeft(v) {
  if (!v || !v.expiresAt) return null;
  return Math.max(0, Math.ceil((Number(v.expiresAt) - Date.now()) / 86400000));
}
function vendorExpiryText(v) {
  if (!v || !v.expiresAt) return 'No expiry set';
  return new Date(Number(v.expiresAt)).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
function vendorById(id) { return DB.vendors.find(v => v.id === id) || null; }
function isVendor(u) { return !!(u && vendorOf(u.id)); }
function myContacts(id) {
  return DB.contacts.filter(c => c.ownerId === id).map(c => findUser(c.userId)).filter(Boolean);
}
function isContact(ownerId, otherId) { return DB.contacts.some(c => c.ownerId === ownerId && c.userId === otherId); }
function isBlocked(a, b) { return DB.blocks.some(x => (x.by === a && x.target === b)); }
function blockedMe(a, b) { return DB.blocks.some(x => (x.by === b && x.target === a)); }
function chatId(a, b) { return [a, b].sort().join('__'); }
function isReadBy(m, userId) {
  if (!m) return true;
  if (Array.isArray(m.readBy)) return m.readBy.includes(userId);
  return m.status === 'seen'; // legacy messages
}
function unreadCount(userId) {
  return DB.messages.filter(m => m.to === userId && !m.deleted && !isReadBy(m, userId)).length;
}
function totalUnread() {
  const u = me(); if (!u) return 0;
  return unreadCount(u.id);
}
function cartCount() { const u = me(); return u ? (u.cart || []).reduce((s, i) => s + i.qty, 0) : 0; }
function unreadNotifs() { const u = me(); if (!u) return 0; return DB.notifications.filter(n => n.userId === u.id && !n.read).length; }
function notify(userId, title, body, link, icon) {
  DB.notifications.unshift({ id: uid('nt'), userId, title, body, link: link || null, icon: icon || 'bell', read: false, createdAt: Date.now() });
  const u = findUser(userId);
  const isMe = !!(SESSION && SESSION.userId === userId);
  if (isMe && u && u.settings && u.settings.notifications !== false && typeof Notification !== 'undefined' && Notification.permission === 'granted' && document.hidden) {
    try {
      new Notification(title, {
        body, icon: LOGO, badge: LOGO,
        tag: 'wc-' + userId, renotify: true,
        vibrate: [120, 60, 120], timestamp: Date.now()
      });
    } catch (e) {}
  }
}
function tx(userId, type, label, amountCoins, meta) {
  const rec = {
    id: uid('tx'), userId, type, label,
    coins: Math.round(amountCoins * 100) / 100,
    meta: meta || null, createdAt: Date.now()
  };
  DB.txs.unshift(rec);
  if (DB.txs.length > 900) DB.txs.length = 900;
  return rec;
}

/* ---------------- media store (IndexedDB) ---------------- */
const Media = {
  dbp: null, cache: {},
  async open() {
    if (this.dbp) return this.dbp;
    this.dbp = new Promise((res, rej) => {
      let req;
      try { req = indexedDB.open('whalechat-media', 1); } catch (e) { return rej(e); }
      req.onupgradeneeded = () => { if (!req.result.objectStoreNames.contains('files')) req.result.createObjectStore('files'); };
      req.onsuccess = () => res(req.result);
      req.onerror = () => rej(req.error);
    }).catch(() => null);
    return this.dbp;
  },
  async put(blob) {
    const id = uid('m');
    try {
      const db = await this.open();
      if (!db) throw new Error('no idb');
      await new Promise((res, rej) => {
        const tx = db.transaction('files', 'readwrite');
        tx.objectStore('files').put(blob, id);
        tx.oncomplete = res; tx.onerror = () => rej(tx.error);
      });
      return id;
    } catch (e) { return null; }
  },
  async get(id) {
    const db = await this.open(); if (!db) return null;
    return await new Promise((res) => {
      const tx = db.transaction('files', 'readonly');
      const r = tx.objectStore('files').get(id);
      r.onsuccess = () => res(r.result || null); r.onerror = () => res(null);
    });
  },
  async url(id) {
    if (!id) return '';
    if (this.cache[id]) return this.cache[id];
    const b = await this.get(id); if (!b) return '';
    const u = URL.createObjectURL(b);
    this.cache[id] = u; return u;
  },
  async hydrate(container) {
    const els = $$('[data-media]', container);
    for (const el of els) {
      const id = el.getAttribute('data-media');
      if (!id || el.dataset.loaded) continue;
      const src = await this.url(id);
      if (!src) continue;
      el.dataset.loaded = '1';
      if (el.tagName === 'IMG') el.src = src;
      else if (el.tagName === 'VIDEO') { el.src = src; el.load(); }
      else if (el.tagName === 'AUDIO') el.src = src;
      el.classList.remove('skeleton');
    }
  }
};

async function compressImage(file, max = 1100, q = 0.72) {
  try {
    const bmp = await createImageBitmap(file);
    let { width: w, height: h } = bmp;
    const r = Math.min(1, max / Math.max(w, h));
    w = Math.round(w * r); h = Math.round(h * r);
    const c = document.createElement('canvas'); c.width = w; c.height = h;
    c.getContext('2d').drawImage(bmp, 0, 0, w, h);
    const blob = await new Promise(res => c.toBlob(res, 'image/jpeg', q));
    if (!blob) throw new Error('no blob');
    return new File([blob], (file.name || 'image') + '.jpg', { type: 'image/jpeg' });
  } catch (e) { return file; }
}

function pickFile(opts = {}) {
  return new Promise((resolve) => {
    const input = document.getElementById(opts.any ? 'fileInputAny' : 'fileInput');
    input.accept = opts.accept || 'image/*';
    if (opts.capture) { input.setAttribute('capture', 'environment'); } else input.removeAttribute('capture');
    input.value = '';
    const onChange = () => {
      input.removeEventListener('change', onChange);
      resolve(input.files && input.files[0] ? input.files[0] : null);
    };
    input.addEventListener('change', onChange);
    input.click();
  });
}

/* ---------------- UI primitives ---------------- */
let toastTimer = [];
function toast(msg, kind = '', ms = 2600) {
  const box = document.getElementById('toasts');
  if (!box) return;
  const el = document.createElement('div');
  el.className = 'toast ' + kind;
  el.innerHTML = `<span class="i">${kind === 'err' ? '!' : '✓'}</span><span>${esc(msg)}</span>`;
  box.appendChild(el);
  setTimeout(() => { el.style.opacity = '0'; el.style.transform = 'translateY(-6px)'; el.style.transition = '.25s'; setTimeout(() => el.remove(), 260); }, ms);
}

function openModal(html, opts = {}) {
  document.body.classList.add('modal-open');
  const ov = document.getElementById('overlay');
  ov.innerHTML = `<div class="modal-back" data-modal-back><div class="modal" role="dialog" aria-modal="true" style="${opts.width ? 'max-width:' + opts.width : ''}">${html}</div></div>`;
  const back = $('[data-modal-back]', ov);
  back.addEventListener('click', (e) => { if (e.target === back && !opts.locked) closeModal(); });
  Media.hydrate(ov);
  return ov;
}
function closeModal() { const ov = document.getElementById('overlay'); ov.innerHTML = ''; document.body.classList.remove('modal-open'); }
function modalShell(title, body, foot, sub) {
  return `<div class="modal-head"><div><div style="font-family:var(--display);font-weight:700;font-size:16px">${esc(title)}</div>${sub ? `<div class="small muted" style="margin-top:2px">${esc(sub)}</div>` : ''}</div>
    <button class="btn-icon" data-close style="width:34px;height:34px">${ic('x', 17)}</button></div>
    <div class="modal-body">${body}</div>${foot ? `<div class="modal-foot">${foot}</div>` : ''}`;
}
document.addEventListener('click', (e) => {
  if (e.target.closest('[data-close]')) { closeModal(); return; }
  const ov = document.getElementById('overlay');
  if (ov && ov.innerHTML && e.target.matches('[data-modal-back]') && !e.target.closest('.modal')) { closeModal(); }
});
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeModal(); closeViewer(); } });

function confirmDialog(opts) {
  return new Promise((resolve) => {
    openModal(modalShell(opts.title || 'Are you sure?', `<p class="muted" style="font-size:13.5px;line-height:1.6">${esc(opts.body || '')}</p>`,
      `<button class="btn btn-ghost" data-cancel>${esc(opts.cancel || 'Cancel')}</button><button class="btn ${opts.danger ? 'btn-danger' : 'btn-primary'}" data-ok>${esc(opts.ok || 'Confirm')}</button>`));
    $('[data-cancel]').onclick = () => { closeModal(); resolve(false); };
    $('[data-ok]').onclick = () => { closeModal(); resolve(true); };
  });
}
function promptDialog(opts) {
  return new Promise((resolve) => {
    openModal(modalShell(opts.title || 'Enter value', `<div class="field"><label class="label">${esc(opts.label || '')}</label>
      <input class="input" id="pd_input" type="${opts.type || 'text'}" placeholder="${esc(opts.placeholder || '')}" value="${esc(opts.value || '')}" ${opts.maxlength ? 'maxlength=' + opts.maxlength : ''}/></div>
      ${opts.help ? `<div class="help">${esc(opts.help)}</div>` : ''}`,
      `<button class="btn btn-ghost" data-cancel>Cancel</button><button class="btn btn-primary" data-ok>${esc(opts.ok || 'Save')}</button>`));
    const inp = $('#pd_input');
    setTimeout(() => inp.focus(), 60);
    inp.addEventListener('keydown', (e) => { if (e.key === 'Enter') { const v = inp.value.trim(); closeModal(); resolve(v || null); } });
    $('[data-cancel]').onclick = () => { closeModal(); resolve(null); };
    $('[data-ok]').onclick = () => { const v = inp.value.trim(); closeModal(); resolve(v || null); };
  });
}

function closeViewer() {
  const v = document.getElementById('storyRoot'); if (v) v.remove();
  try { if (STATUS_VIEW) { clearTimeout(STATUS_VIEW.timer); STATUS_VIEW = null; } } catch (e) {}
}

/* ---------------- routing ---------------- */
const ROUTES = {};
let CURRENT = null;
function parseHash() {
  const raw = (location.hash || '').replace(/^#\/?/, '');
  const [p, q] = raw.split('?');
  const parts = (p || '').split('/').filter(Boolean);
  const params = {};
  if (q) q.split('&').forEach(kv => { const [k, v] = kv.split('='); if (k) params[decodeURIComponent(k)] = decodeURIComponent(v || ''); });
  return { parts, params };
}
function go(path) {
  if (!path.startsWith('#')) path = '#/' + path.replace(/^\/+/, '');
  if (location.hash === path) render(); else location.hash = path;
}
function back() { if (history.length > 1) history.back(); else go('home'); }

window.addEventListener('hashchange', () => {
  try { gaTrack(); } catch (e) {}
  if (!me()) { const { parts } = parseHash(); if (['login', 'signup', 'forgot', 'welcome', 'splash'].includes(parts[0])) render(); else routeGuard(); return; }
  render();
  const c = document.querySelector('.content'); if (c) c.scrollTop = 0;
});
function routeGuard() { go('login'); }

/* ---------------- theme ---------------- */
function applyTheme(t) {
  document.documentElement.setAttribute('data-theme', t);
  const meta = document.querySelector('meta[name="theme-color"]');
  if (meta) meta.setAttribute('content', t === 'light' ? '#f2f7fa' : '#04101a');
  const u = me(); if (u) { u.settings.theme = t; persist(true); }
  try { localStorage.setItem(LS_THEME, t); } catch (e) {}
}
function initTheme() {
  let t = null;
  try { t = localStorage.getItem(LS_THEME); } catch (e) {}
  const u = me();
  if (u && u.settings && u.settings.theme) t = u.settings.theme;
  if (!t) t = (window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', t);
}
function toggleTheme() {
  const cur = document.documentElement.getAttribute('data-theme');
  applyTheme(cur === 'dark' ? 'light' : 'dark');
  render();
}

/* ---------------- product visuals ---------------- */
const CAT_HUES = { Phones: 195, Laptos: 210, Laptops: 210, Tablets: 250, Headphones: 168, Chargers: 38, 'Video Games': 280, 'Phone Pouches': 320, Accessories: 145 };
function productThumb(p, h = 150) {
  if (p.image) return `<div class="thumb" style="height:${h}px"><img src="${p.image}" alt="${esc(p.name)}" loading="lazy"/></div>`;
  const hue = CAT_HUES[p.category] != null ? CAT_HUES[p.category] : 190;
  const emoji = p.emoji || '📦';
  return `<div class="thumb" style="height:${h}px;background:
      radial-gradient(120% 120% at 20% 8%, hsla(${hue},70%,55%,.32), transparent 60%),
      radial-gradient(120% 130% at 90% 100%, hsla(${(hue + 45) % 360},75%,50%,.28), transparent 60%),
      linear-gradient(140deg,#0b2230,#071520)">
      <span class="ph-emoji">${emoji}</span></div>`;
}
function statusBadge(s) {
  const map = {
    pending: ['badge-warn', 'Pending'], processing: ['badge-warn', 'Processing'],
    approved: ['badge-success', 'Approved'], shipped: ['badge-accent', 'Shipped'],
    delivered: ['badge-success', 'Delivered'], rejected: ['badge-danger', 'Rejected'],
    cancelled: ['badge-danger', 'Cancelled'], sold: ['badge-danger', 'Sold out']
  };
  const m = map[s] || ['', s];
  return `<span class="badge ${m[0]}">${esc(m[1])}</span>`;
}
