  const s = DB.settings;
  const crypto = s.crypto || [], banks = s.banks || [];
  return `<div class="page-head"><div><button class="btn btn-ghost btn-sm mb10" data-nav="#/wallet">${ic('back', 14)} Wallet</button>
      <h1>Deposit Whale Coin</h1><p>Fund your wallet by crypto or bank transfer. Our team reviews each deposit.</p></div></div>
    <div style="display:grid;grid-template-columns:1fr 360px;gap:20px" class="cart-grid">
      <div class="card">
        <div class="field"><label class="label">Amount in USD</label>
          <div class="input-wrap"><span class="ic">$</span><input class="input" id="depUsd" type="number" min="1" step="1" placeholder="5.00" inputmode="decimal"/></div>
          <div class="help">Minimum $1. You will receive <b id="depCoins" style="color:var(--accent)">0 WC</b> at 1 WC = $0.50.</div></div>
        <div class="chip-row mb16">${[5, 10, 25, 50, 100].map(v => `<button class="chip" data-act="dep-quick" data-id="${v}">$${v} → ${v / COIN_USD} WC</button>`).join('')}</div>
        <div class="label mb10">Payment method</div>
        <div class="tabs mb16"><button class="tab on" data-depmode="crypto">${ic('wallet', 13)} Crypto</button><button class="tab" data-depmode="bank">${ic('store', 13)} Bank transfer</button></div>
        <div id="depCrypto">
          ${crypto.length ? `<div class="col gap8">${crypto.map((m, i) => `<label class="list-item" style="cursor:pointer;align-items:flex-start">
            <input type="radio" name="depm" value="${m.id}" ${i === 0 ? 'checked' : ''} style="margin-top:3px;accent-color:var(--accent)"/>
            <div class="grow"><div class="small" style="font-weight:650">${esc(m.name)}</div>
              <div class="tiny muted" style="word-break:break-all;margin-top:3px">${esc(m.address)}</div>
              ${m.note ? `<div class="tiny" style="color:var(--warn);margin-top:4px">${esc(m.note)}</div>` : ''}
              ${m.qr ? `<div class="mt10"><img class="qr-thumb" src="${m.qr}" alt="Payment QR" data-act="view-qr" data-kind="crypto" data-id="${m.id}"/><div class="tiny muted mt6">${ic('grid', 11)} Scan with your exchange wallet</div></div>` : ''}</div>
            <button type="button" class="btn-icon" data-act="copy" data-id="${esc(m.address)}" style="width:30px;height:30px">${ic('copy', 13)}</button></label>`).join('')}</div>`
            : `<div class="empty" style="padding:18px"><p>No crypto methods configured yet. Contact support.</p></div>`}
        </div>
        <div id="depBank" class="hidden">
          ${banks.length ? banks.map((b, i) => `<div class="panel" style="padding:13px;margin-bottom:8px">
            <div class="between mb10"><div class="small" style="font-weight:650">${esc(b.bankName)}</div>${i === 0 ? '<span class="badge badge-accent">Recommended</span>' : ''}</div>
            <div class="kv"><span class="k">Account name</span><span class="v">${esc(b.accountName)}</span></div>
            <div class="kv"><span class="k">Account number</span><span class="v">${esc(b.accountNumber)} <button class="btn-icon" data-act="copy" data-id="${esc(b.accountNumber)}" style="width:24px;height:24px;vertical-align:middle">${ic('copy', 11)}</button></span></div>
            <div class="kv"><span class="k">SWIFT / BIC</span><span class="v">${esc(b.swift || '—')}</span></div>
            <div class="kv"><span class="k">Routing</span><span class="v">${esc(b.routing || '—')}</span></div>
            <div class="kv"><span class="k">Country</span><span class="v">${esc(b.country || '—')}</span></div>
            ${b.note ? `<div class="tiny mt6" style="color:var(--warn)">${esc(b.note)}</div>` : ''}
            ${b.qr ? `<div class="mt10"><img class="qr-thumb" src="${b.qr}" alt="Payment QR" data-act="view-qr" data-kind="bank" data-id="${b.id}"/><div class="tiny muted mt6">${ic('grid', 11)} Scan with your banking app</div></div>` : ''}
          </div>`).join('') : `<div class="empty" style="padding:18px"><p>No bank details configured yet. Contact support.</p></div>`}
          <div class="field mt16"><label class="label">Payment reference (optional)</label><input class="input" id="depRef" placeholder="Bank transfer reference / sender name"/></div>
        </div>
        <div class="panel mt16" style="padding:12px"><div class="row gap6 tiny" style="font-weight:600;color:var(--accent)">${ic('shield', 13)} Reviewed by our team</div>
