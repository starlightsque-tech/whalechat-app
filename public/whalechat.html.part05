          <div class="mt16"><div class="kv"><span class="k">USD amount</span><span class="v" id="sumUsd">$0.00</span></div>
            <div class="kv"><span class="k">Rate</span><span class="v">1 WC = $0.50</span></div>
            <div class="kv"><span class="k">Whale Coin received</span><span class="v" id="sumCoins" style="color:var(--accent)">0 WC</span></div>
            <div class="kv"><span class="k">Method</span><span class="v" id="sumMethod">Crypto</span></div></div>
          <div class="divider"></div>
          <div class="tiny muted" style="line-height:1.65">Deposits usually confirm within 30 minutes after payment. You'll receive a notification the moment your balance is credited.</div>
        </div>
        <div class="card mt14">
          <div class="row gap8">${ic('help', 16)}<span class="small" style="font-weight:600">Need help?</span></div>
          <p class="tiny muted mt6" style="line-height:1.6">Chat with our team if a deposit has not appeared after 1 hour.</p>
          <button class="btn btn-ghost btn-sm mt10" data-act="support-chat" style="width:100%">${ic('chat', 14)} Contact support</button>
        </div>
      </div>
    </div>
    <style>@media(max-width:860px){.cart-grid{grid-template-columns:1fr!important}}</style>`;
};
AFTER.deposit = function () {
  const amt = document.getElementById('depUsd');
  const upd = () => {
    const v = Number(amt.value) || 0;
    document.getElementById('depCoins').textContent = coins(usdToCoins(v)) + ' WC';
    const a = document.getElementById('sumUsd'), b = document.getElementById('sumCoins');
    if (a) a.textContent = usd(v);
    if (b) b.textContent = coins(usdToCoins(v)) + ' WC';
  };
  amt.addEventListener('input', upd);
  let mode = 'crypto';
  $$('[data-depmode]').forEach(t => t.onclick = () => {
    $$('[data-depmode]').forEach(x => x.classList.remove('on')); t.classList.add('on');
    mode = t.getAttribute('data-depmode');
    document.getElementById('depCrypto').classList.toggle('hidden', mode !== 'crypto');
    document.getElementById('depBank').classList.toggle('hidden', mode !== 'bank');
    document.getElementById('sumMethod').textContent = mode === 'crypto' ? 'Crypto' : 'Bank transfer';
  });
  document.getElementById('depSubmit').onclick = () => App.submitDeposit(mode);
};
App.depQuick = function (v) {
  const i = document.getElementById('depUsd');
  i.value = v; i.dispatchEvent(new Event('input'));
};
App.submitDeposit = function (mode) {
  const u = me(); clearErrors();
  const usdAmt = Math.round(Number(document.getElementById('depUsd').value) * 100) / 100;
  if (!(usdAmt >= 1)) return formError('depUsd', 'Enter at least $1');
  let methodName = '', detail = '';
  if (mode === 'crypto') {
    const sel = document.querySelector('input[name="depm"]:checked');
    if (!sel) return toast('Select a crypto payment method', 'err');
    const m = (DB.settings.crypto || []).find(x => x.id === sel.value);
    methodName = m ? m.name : 'Crypto';
    detail = m ? m.address : '';
  } else {
    methodName = 'Bank transfer';
    detail = (document.getElementById('depRef') || {}).value || '';
    if (!(DB.settings.banks || []).length) return toast('No bank details configured', 'err');
  }
  DB.deposits.unshift({
    id: uid('dep'), userId: u.id, usd: usdAmt, coins: usdToCoins(usdAmt),
    method: mode, methodName, detail, status: 'pending', createdAt: Date.now(), note: ''
  });
  notify('usr_admin', 'New deposit request', `${u.fullName} (@${u.username}) submitted ${usd(usdAmt)} via ${methodName}.`, '#/admin/deposits', 'wallet');
  notify(u.id, 'Deposit submitted', `Your ${usd(usdAmt)} deposit is pending review. You'll be credited ${coins(usdToCoins(usdAmt))} WC once approved.`, '#/wallet', 'wallet');
  sync();
  openModal(modalShell('Deposit submitted', `
    <div class="center">
      <div style="width:58px;height:58px;border-radius:50%;background:rgba(255,176,32,.14);color:var(--warn);display:flex;align-items:center;justify-content:center;margin:0 auto">${ic('clock', 26)}</div>
      <h3 class="mt16" style="font-size:17px">Awaiting confirmation</h3>
      <p class="small muted mt10" style="line-height:1.7">We've received your ${usd(usdAmt)} request via ${esc(methodName)}. Our team will verify and credit <b style="color:var(--accent)">${coins(usdToCoins(usdAmt))} WC</b> to your wallet.</p>
    </div>`,
    `<a href="#/wallet" class="btn btn-primary" data-close style="width:100%">Back to wallet</a>`));
  setTimeout(() => render(), 60);
};

/* ---------------- withdraw ---------------- */
VIEWS.withdraw = function () {
  const u = me();
  const nets = DB.settings.networks || [];
  if (!u.pin) {
    return `<div class="page-head"><div><button class="btn btn-ghost btn-sm mb10" data-nav="#/wallet">${ic('back', 14)} Wallet</button><h1>Withdraw</h1></div></div>
      <div class="card empty"><div class="ic">${ic('lock', 26)}</div><h3>Set your withdrawal PIN first</h3>
      <p>For your security, withdrawals require a 4–6 digit PIN.</p><button class="btn btn-primary" data-act="set-pin-now">Create withdrawal PIN</button></div>`;
  }
  return `<div class="page-head"><div><button class="btn btn-ghost btn-sm mb10" data-nav="#/wallet">${ic('back', 14)} Wallet</button>
      <h1>Withdraw USDT</h1><p>Withdrawals are processed on the network you choose and reviewed by our team.</p></div></div>
    <div style="display:grid;grid-template-columns:1fr 360px;gap:20px" class="cart-grid">
      <div class="card">
        <div class="field"><label class="label">Network</label>
          <select class="input" id="wdNet">${nets.map(n => `<option value="${esc(n)}">${esc(n)}</option>`).join('')}</select>
          <div class="help">USDT only. Make sure the network matches your wallet.</div></div>
        ${field('USDT wallet address', 'wdAddr', { ph: 'Paste your USDT address', icon: 'wallet' })}
        <div class="field"><label class="label">Amount in Whale Coin</label>
          <div class="input-wrap"><span class="ic">${ic('wallet', 16)}</span><input class="input" id="wdCoins" type="number" min="1" step="1" placeholder="0" inputmode="decimal"/></div>
          <div class="row between"><span class="help">Available: ${coins(u.balance)} WC</span><button class="link tiny" data-act="wd-max">Use max</button></div></div>
        <div class="panel" style="padding:12px;margin-bottom:14px">
          <div class="between"><span class="tiny muted">You receive</span><span id="wdUsd" style="font-weight:700">$0.00</span></div>
          <div class="between mt6"><span class="tiny muted">Network fee</span><span class="tiny">Paid by WhaleChat</span></div>
          <div class="between mt6"><span class="tiny muted">Rate</span><span class="tiny">1 WC = $0.50</span></div>
        </div>
        ${field('Withdrawal PIN', 'wdPin', { type: 'password', ph: '4–6 digit PIN', icon: 'lock', inputmode: 'numeric', maxlength: '6' })}
        <label class="checkline" style="margin-bottom:14px"><input type="checkbox" id="wdConfirm"/>
          <span>I confirm this USDT address is correct. Blockchain transfers cannot be reversed.</span></label>
        <button class="btn btn-primary btn-block btn-lg" id="wdSubmit">${ic('lock', 16)} Request withdrawal</button>
        <div class="tiny muted center mt10">Withdrawals are reviewed and usually paid within 24 hours.</div>
      </div>
      <div class="card" style="height:fit-content">
        <h3 style="font-size:15px">Withdrawal policy</h3>
        <div class="mt10">
          <div class="kv"><span class="k">Minimum</span><span class="v">5 WC</span></div>
          <div class="kv"><span class="k">Currency</span><span class="v">USDT</span></div>
          <div class="kv"><span class="k">Networks</span><span class="v">${nets.length} available</span></div>
          <div class="kv"><span class="k">Review time</span><span class="v">≤ 24 hours</span></div>
        </div>
        <div class="panel mt14" style="padding:11px 12px"><div class="row gap6 tiny" style="font-weight:600;color:var(--warn)">${ic('shield', 13)} Double-check the network</div>
          <div class="tiny muted mt6" style="line-height:1.6">Sending USDT on the wrong network can result in permanent loss.</div></div>
      </div>
    </div>
    <style>@media(max-width:860px){.cart-grid{grid-template-columns:1fr!important}}</style>`;
};
AFTER.withdraw = function () {
  const i = document.getElementById('wdCoins');
  if (!i) return;
  const upd = () => {
    const v = Number(i.value) || 0;
    const el = document.getElementById('wdUsd');
    if (el) el.textContent = usd(coinsToUsd(v));
  };
  i.addEventListener('input', upd);
  document.getElementById('wdSubmit').onclick = () => App.submitWithdraw();
};
App.wdMax = function () {
  const i = document.getElementById('wdCoins'); i.value = Math.floor(me().balance);
  i.dispatchEvent(new Event('input'));
};
App.submitWithdraw = async function () {
  const u = me(); clearErrors();
  const net = document.getElementById('wdNet').value;
  const addr = document.getElementById('wdAddr').value.trim();
  const amt = Math.round((Number(document.getElementById('wdCoins').value) || 0) * 100) / 100;
  const pin = document.getElementById('wdPin').value;
  if (!addr || addr.length < 12) return formError('wdAddr', 'Enter a valid USDT wallet address');
  if (!(amt >= 5)) return formError('wdCoins', 'Minimum withdrawal is 5 WC');
  if (amt > u.balance) return formError('wdCoins', 'Amount exceeds your available balance');
  if (!/^\d{4,6}$/.test(pin)) return formError('wdPin', 'Enter your 4–6 digit PIN');
  if (!document.getElementById('wdConfirm').checked) return toast('Please confirm the wallet address', 'err');
  if (await hash('pin::' + pin) !== u.pin) return formError('wdPin', 'Incorrect PIN');
  u.balance = Math.round((u.balance - amt) * 100) / 100;
  const wdId = uid('wd');
  const activity = tx(u.id, 'withdrawal', 'Withdrawal request · ' + net, -amt, { withdrawalId: wdId });
  DB.withdrawals.unshift({
    id: wdId, userId: u.id, network: net, address: addr, coins: amt,
    usd: coinsToUsd(amt), status: 'pending', createdAt: Date.now(), note: '',
    txId: activity.id
  });
  notify('usr_admin', 'New withdrawal request', `${u.fullName} requested ${coins(amt)} WC (${usd(coinsToUsd(amt))}) via ${net}.`, '#/admin/withdrawals', 'download');
  notify(u.id, 'Withdrawal submitted', `Your request for ${coins(amt)} WC is pending review.`, '#/wallet', 'download');
  sync();
  openModal(modalShell('Withdrawal requested', `
    <div class="center"><div style="width:58px;height:58px;border-radius:50%;background:rgba(46,230,201,.14);color:var(--accent);display:flex;align-items:center;justify-content:center;margin:0 auto">${ic('check', 26)}</div>
    <h3 class="mt16" style="font-size:17px">Request received</h3>
    <p class="small muted mt10" style="line-height:1.7">${coins(amt)} WC (${usd(coinsToUsd(amt))}) via ${esc(net)}. Our team will review and send USDT to your address.</p></div>`,
    `<a href="#/wallet" class="btn btn-primary" data-close style="width:100%">Done</a>`));
  setTimeout(() => render(), 60);
};
App.setPinNow = async function () { await App.startSetPin(); render(); };

/* ---------------- referrals ---------------- */
VIEWS.referrals = function () {
  const u = me();
  const invited = DB.users.filter(x => x.referredBy === u.id && x.id !== u.id);
  const paid = invited.filter(x => x.referralPaid);
  const pending = invited.filter(x => !x.referralPaid);
  const earned = DB.txs.filter(t => t.userId === u.id && t.type === 'referral').length * 10;
  const inviter = u.referredBy ? findUser(u.referredBy) : null;
  const link = referralLink(u.referralCode);

  return `<div class="page-head"><div><button class="btn btn-ghost btn-sm mb10" data-nav="#/profile">${ic('back', 14)} Profile</button>
      <h1>Invite friends to earn</h1><p>Earn 10 Whale Coins for every friend who signs up and makes their first deposit.</p></div></div>

    ${u.pendingReferralCode ? `<div class="card mb16" style="border-color:rgba(255,176,32,.35);background:linear-gradient(120deg,rgba(255,176,32,.10),rgba(46,230,201,.05))">
      <div class="row gap10" style="align-items:flex-start"><span style="width:32px;height:32px;border-radius:9px;background:rgba(255,176,32,.15);color:var(--warn);display:flex;align-items:center;justify-content:center;flex:none">${ic('clock', 16)}</span>
      <div><div class="small" style="font-weight:650">Referral pending · ${esc(u.pendingReferralCode)}</div>
      <div class="tiny muted mt6" style="line-height:1.6">Your code is saved. It links to your inviter automatically as soon as their account is on this server.</div></div></div>
    </div>` : ''}

    ${inviter ? `<div class="card mb16" style="padding:13px 14px">
      <div class="between gap10 wrap">
        <div class="row gap10">${avatarHTML(inviter, 'sm')}
          <div><div class="tiny muted">You were invited by</div>
          <div class="small" style="font-weight:650">${esc(inviter.fullName)} <span class="muted">@${esc(inviter.username)}</span></div></div></div>
        ${u.referralPaid ? `<span class="badge badge-success">${ic('check', 11)} Bonus credited</span>` : (DB.deposits.some(d => d.userId === u.id && d.status === 'approved') ? `<span class="badge badge-success">Deposit approved</span>` : `<span class="badge badge-warn">First deposit pending</span>`)}
      </div>
    </div>` : ''}

    <div class="wallet-card mb16">
      <div class="between"><div class="tiny" style="opacity:.85;letter-spacing:.08em;font-weight:700">REFERRAL EARNINGS</div>${ic('gift', 18)}</div>
      <div class="row" style="gap:8px