/* ---------------- bonuses / tasks ---------------- */
async function bonusCodeHash(code) {
  const raw = 'bonus::v1::' + String(code || '').trim().toUpperCase();
  try {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(raw));
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
  } catch (e) { return 'fb' + fnv(raw); }
}

VIEWS.bonuses = function () {
  const u = me();
  const list = (DB.bonuses || []).filter(b => b.active !== false);
  const claims = DB.bonusClaims || [];
  const claimed = new Set(claims.filter(c => c.userId === u.id && c.status === 'claimed').map(c => c.bonusId));
  return `<div class="page-head"><div><button class="btn btn-ghost btn-sm mb10" data-nav="#/profile">${ic('back', 14)} Account</button>
      <h1>Check Bonuses</h1><p>Complete a task, get your code from support, and redeem your reward.</p></div></div>
    ${list.length ? `<div class="col gap12">${list.map(b => {
      const done = claimed.has(b.id);
      const coinsValue = Math.round((Number(b.rewardUsd) || 0) / COIN_USD * 100) / 100;
      return `<div class="card bonus-card">
        <div class="between gap10 wrap" style="align-items:flex-start">
          <div class="grow" style="min-width:0">
            <div class="row gap8" style="align-items:center;flex-wrap:wrap">
              <h3 style="font-size:16px">${esc(b.title)}</h3>
              <span class="badge ${done ? 'badge-success' : 'badge-accent'}">${done ? 'Claimed' : 'Available'}</span>
            </div>
            <p class="small muted mt8" style="line-height:1.65">${esc(b.description || '')}</p>
            ${b.taskUrl ? `<a class="btn btn-ghost btn-sm mt12" href="${esc(b.taskUrl)}" target="_blank" rel="noopener">${ic('link', 14)} ${esc(b.taskLabel || 'Do the task')}</a>` : ''}
          </div>
          <div style="text-align:right;flex:none">
            <div style="font-size:24px;font-weight:800;letter-spacing:-.02em;color:var(--accent)">${usd(b.rewardUsd)}</div>
            <div class="tiny muted">${coins(coinsValue)} WC</div>
          </div>
        </div>
        <div class="row gap8 mt14 wrap">
          ${done
            ? `<span class="badge badge-success">${ic('check', 12)} Reward credited</span>`
            : `<button class="btn btn-primary btn-sm" data-act="claim-bonus" data-id="${b.id}">${ic('gift', 14)} Claim</button>`}
          ${b.taskUrl ? `<span class="tiny muted" style="align-self:center">Complete the task first, then contact support for your code.</span>` : ''}
        </div>
      </div>`;
    }).join('')}</div>` : `<div class="empty"><div class="ic">${ic('gift', 26)}</div><h3>No bonuses right now</h3><p>New tasks will appear here. Check back soon.</p></div>`}
    <div class="panel mt16" style="padding:12px 14px"><div class="tiny muted" style="line-height:1.7">
      <b style="color:var(--text)">How it works:</b> complete the task → contact support → receive a one-time code → enter it under Claim. Codes are single-use and tied to your account.
    </div></div>`;
};

App.claimBonus = function (id) {
  const b = (DB.bonuses || []).find(x => x.id === id);
  if (!b) return;
  openModal(modalShell('Claim “' + b.title + '”', `
    <div class="panel" style="padding:13px">
      <div class="between"><span class="tiny muted">Reward</span><span class="small" style="font-weight:700;color:var(--accent)">${usd(b.rewardUsd)}</span></div>
    </div>
    <div class="field mt16"><label class="label">Redeem code</label>
      <input class="input" id="bonCode" placeholder="Enter your code" autocomplete="off" style="text-transform:uppercase;letter-spacing:.08em;font-weight:700"/>
      <div class="help">To get your code, please complete the task and contact Support.</div></div>
    <div class="tiny muted" style="line-height:1.6">Each code can be used once and only on the account it was issued to.</div>`,
    `<button class="btn btn-ghost" data-close>Cancel</button>
     <button class="btn btn-primary" data-act="claim-bonus-submit" data-id="${b.id}">${ic('check', 15)} Submit</button>`), { width: '460px' });
  setTimeout(() => { const i = document.getElementById('bonCode'); if (i) i.focus(); }, 90);
};

App.claimBonusSubmit = async function (id) {
  const el = document.getElementById('bonCode');
  const code = ((el && el.value) || '').trim().toUpperCase();
  if (!code) return toast('Enter your redeem code', 'err');
  const btn = document.querySelector('[data-act="claim-bonus-submit"]');
  if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner"></span> Checking…'; }
  if (Remote.enabled) {
    try {
      const res = await fetch(Remote.url('/api/bonus/claim'), { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ userId: me().id, bonusId: id, code }) });
      const d = await res.json().catch(() => null);
      if (res.ok && d && d.ok) {
        closeModal();
        toast('Bonus Credited Successfully! 🎁', 'ok');
        await Remote.refresh(true);
        render();
        return;
      }
      if (btn) { btn.disabled = false; btn.innerHTML = 'Submit'; }
      return toast((d && (d.message || d.error)) || 'Invalid or already used code', 'err');
    } catch (e) {}
  }
  // local / offline fallback
  const hash = await bonusCodeHash(code);
  const u = me();
  const claim = (DB.bonusClaims || []).find(c => c.codeHash === hash && c.userId === u.id && c.bonusId === id && c.status !== 'claimed');
  if (!claim) { if (btn) { btn.disabled = false; btn.innerHTML = 'Submit'; } return toast('Invalid or already used code', 'err'); }
  const b = (DB.bonuses || []).find(x => x.id === id);
  if (!b) return toast('This bonus no longer exists', 'err');
  claim.status = 'claimed'; claim.claimedAt = Date.now();
  const coinsAmt = Math.round((Number(b.rewardUsd) || 0) / COIN_USD * 100) / 100;
  u.balance = Math.round((Number(u.balance || 0) + coinsAmt) * 100) / 100;
  u.totalEarnings = Math.round((Number(u.totalEarnings || 0) + coinsAmt) * 100) / 100;
  tx(u.id, 'bonus', 'Task bonus · ' + b.title, coinsAmt, { bonusId: b.id, claimId: claim.id });
  notify(u.id, 'Bonus credited 🎁', b.title + ' · ' + coins(coinsAmt) + ' WC added to your balance.', '#/bonuses', 'gift');
  sync(); closeModal(); toast('Bonus Credited Successfully! 🎁', 'ok'); render();
};

VIEWS.wallet = function () {
  const u = me();
  const txs = DB.txs.filter(t => t.userId === u.id);
  const pendingDep = DB.deposits.filter(d => d.userId === u.id && d.status === 'pending');
  const pendingWd = DB.withdrawals.filter(w => w.userId === u.id && w.status === 'pending');
  return `<div class="page-head"><div><h1>Wallet</h1><p>Your Whale Coin balance, deposits and withdrawals.</p></div>
      <a href="#/referrals" class="btn btn-ghost btn-sm">${ic('gift', 15)} Invite & earn</a></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px" class="wallet-grid">
      <div class="wallet-card">
        <div class="between"><div class="tiny" style="opacity:.8;letter-spacing:.08em;font-weight:700">WHALE COIN BALANCE</div>${ic('wallet', 20)}</div>
        <div class="row" style="gap:8px;align-items:baseline;margin-top:8px"><span class="wallet-bal">${coins(u.balance)}</span><span class="small" style="opacity:.8">WC</span></div>
        <div class="small" style="opacity:.8;margin-top:4px">≈ ${usd(coinsToUsd(u.balance))} USD <span style="opacity:.6">· 1 WC = $0.50</span></div>
        <div class="wallet-actions">
          <a href="#/deposit" class="btn">${ic('plus', 14)} Deposit</a>
          <a href="#/withdraw" class="btn">${ic('download', 14)} Withdraw</a>
          <a href="#/referrals" class="btn">${ic('gift', 14)} Invite</a>
        </div>
      </div>
      <div class="grid-kpi" style="grid-template-columns:1fr 1fr">
        ${[['Total deposits', coins(u.totalDeposits || 0) + ' WC', 'wallet'], ['Total withdrawals', coins(u.totalWithdrawals || 0) + ' WC', 'download'],
           ['Total earnings', coins(u.totalEarnings || 0) + ' WC', 'trend'], ['Referral code', u.referralCode, 'gift']]
          .map(([k, v, i]) => `<div class="kpi"><div class="ic">${ic(i, 15)}</div><div class="v" style="font-size:17px">${v}</div><div class="k">${k}</div></div>`).join('')}
      </div>
    </div>
    ${pendingDep.length || pendingWd.length ? `<div class="card mt16">
      <div class="section-title"><h3>Pending requests</h3><span class="badge badge-warn">${pendingDep.length + pendingWd.length}</span></div>
      ${pendingDep.map(d => `<div class="between" style="padding:9px 0;border-bottom:1px dashed var(--border)"><div><div class="small" style="font-weight:600">Deposit · ${coins(d.coins)} WC</div><div class="tiny muted">${esc(d.methodName || d.method)} · ${timeAgo(d.createdAt)} ago</div></div>${statusBadge('pending')}</div>`).join('')}
      ${pendingWd.map(w => `<div class="between" style="padding:9px 0;border-bottom:1px dashed var(--border)"><div><div class="small" style="font-weight:600">Withdrawal · ${coins(w.coins)} WC</div><div class="tiny muted">${esc(w.network)} · ${esc(w.address.slice(0, 10))}… · ${timeAgo(w.createdAt)} ago</div></div>${statusBadge('pending')}</div>`).join('')}
    </div>` : ''}
    <div class="card mt16">
      <div class="section-title"><h3>Activity</h3><span class="tiny muted">${txs.length} transactions</span></div>
      ${txs.length ? `<div class="list">${txs.slice(0, 40).map(t => {
        const pos = t.coins >= 0;
        const iconMap = { deposit: 'wallet', withdrawal: 'download', purchase: 'bag', sale: 'trend', stock: 'box', referral: 'gift', refund: 'refresh' };
        return `<div class="list-item">
          <div style="width:34px;height:34px;border-radius:10px;background:${pos ? 'rgba(47,214,166,.12)' : 'rgba(255,95,116,.1)'};color:${pos ? 'var(--success)' : 'var(--danger)'};display:flex;align-items:center;justify-content:center;flex:none">${ic(iconMap[t.type] || 'wallet', 15)}</div>
          <div class="grow" style="min-width:0"><div class="small" style="font-weight:600">${esc(t.label)}</div><div class="tiny muted">${timeAgo(t.createdAt)} ago · ${dateLabel(t.createdAt)}</div></div>
          <div style="text-align:right"><div class="small" style="font-weight:700;color:${pos ? 'var(--success)' : 'var(--text)'}">${pos ? '+' : ''}${coins(t.coins)}</div><div class="tiny muted">WC</div></div>
        </div>`;
      }).join('')}</div>` : `<div class="empty" style="padding:26px"><p>No wallet activity yet. Deposit Whale Coin to get started.</p><a href="#/deposit" class="btn btn-primary">Deposit now</a></div>`}
    </div>
    <style>@media(max-width:860px){.wallet-grid{grid-template-columns:1fr!important}}</style>`;
};

