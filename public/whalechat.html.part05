 groups = {};
  items.forEach(it => { const k = it.p.vendorId; (groups[k] = groups[k] || []).push(it); });
  const created = [];
  Object.keys(groups).forEach(vid => {
    const v = vendorById(vid);
    if (!v) return;
    const gItems = groups[vid];
    const gUsd = gItems.reduce((s, x) => s + x.p.priceUsd * x.qty, 0);
    const gCoins = Math.round(gUsd / COIN_USD * 100) / 100;
    const off = delivery(fullName, phone, email, country, address);
    const order = {
      id: uid('ord'), ref: 'WC-' + Math.random().toString(36).slice(2, 7).toUpperCase(),
      buyerId: u.id, vendorId: vid,
      items: gItems.map(x => ({ productId: x.p.id, name: x.p.name, qty: x.qty, priceUsd: x.p.priceUsd, image: x.p.image, emoji: x.p.emoji, category: x.p.category })),
      totalUsd: Math.round(gUsd * 100) / 100, totalCoins: gCoins,
      delivery: off, status: 'processing', createdAt: Date.now(), payment: 'whale_coin',
      timeline: [{ status: 'processing', at: Date.now(), note: 'Order placed and awaiting team review.' }]
    };
    DB.orders.unshift(order);
    created.push(order);
    // stock + vendor credit
    gItems.forEach(x => {
      x.p.stock = Math.max(0, x.p.stock - x.qty);
      if (x.p.stock === 0) x.p.active = false;
    });
    const vu = findUser(v.userId);
    if (vu) {
      vu.balance = Math.round((vu.balance + gCoins) * 100) / 100;
      vu.totalEarnings = Math.round(((vu.totalEarnings || 0) + gCoins) * 100) / 100;
      v.sales = (v.sales || 0) + 1;
      v.revenue = Math.round(((v.revenue || 0) + gUsd) * 100) / 100;
      tx(vu.id, 'sale', 'Sale · ' + order.ref, gCoins);
      notify(vu.id, 'Your product was purchased 🎉', `${gItems[0].name}${gItems.length > 1 ? ' +' + (gItems.length - 1) + ' more' : ''} · ${coins(gCoins)} WC credited to your balance.`, '#/vendor/orders', 'bag');
    }
    notify('usr_admin', 'New order · ' + order.ref, `${items.length} item(s) from ${esc(v.username)} — delivery details attached.`, '#/admin/orders', 'truck');
  });

  u.balance = Math.round((u.balance - totalCoins) * 100) / 100;
  u.cart = [];
  tx(u.id, 'purchase', 'Order ' + (created[0] ? created[0].ref : ''), -totalCoins);
  notify(u.id, 'Request processing', 'Your request is being processed. Please wait for our team to proceed. You can track your package movements anytime.', '#/orders', 'truck');
  sync();
  const total = created.reduce((s, o) => s + o.totalCoins, 0);
  openModal(modalShell('Request processing', `
    <div class="center" style="padding:6px 0 4px">
      <div style="width:64px;height:64px;border-radius:50%;background:rgba(46,230,201,.14);color:var(--accent);display:flex;align-items:center;justify-content:center;margin:0 auto">${ic('check', 30)}</div>
      <h3 class="mt16" style="font-size:18px">Your request is being processed</h3>
      <p class="small muted mt10" style="line-height:1.7">Please wait for our team to proceed. We've reserved ${coins(total)} WC from your wallet and notified the vendor.</p>
      <div class="panel mt16" style="padding:12px;text-align:left">
        ${created.map(o => `<div class="between" style="padding:5px 0"><span class="tiny muted">${esc(o.ref)}</span><span class="small" style="font-weight:600">${coins(o.totalCoins)} WC</span></div>`).join('')}
      </div>
    </div>`,
    `<button class="btn btn-ghost" data-close style="flex:1">Keep shopping</button>
     <a href="#/orders" class="btn btn-primary" data-close style="flex:1">${ic('truck', 15)} Track package</a>`), { locked: false, width: '430px' });
  setTimeout(() => { if (me()) render(); }, 100);
};
function delivery(fullName, phone, email, country, address) {
  return { fullName, phone, email, country, address };
}

/* ---------------- orders (buyer) ---------------- */
VIEWS.orders = function () {
  const u = me();
  const orders = DB.orders.filter(o => o.buyerId === u.id);
  return `<div class="page-head"><div><h1>My orders</h1><p>Track every package from approval to delivery.</p></div>
    <a href="#/market" class="btn btn-ghost btn-sm">${ic('bag', 15)} Shop</a></div>
    ${orders.length ? `<div class="col gap10">${orders.map(o => {
      const v = vendorById(o.vendorId); const vu = v ? findUser(v.userId) : null;
      return `<div class="card">
        <div class="between wrap gap10">
          <div class="row gap10"><div style="width:44px;height:44px;border-radius:11px;background:var(--surface-2);display:flex;align-items:center;justify-content:center;font-size:20px">${o.items[0] && o.items[0].image ? `<img src="${o.items[0].image}" style="width:100%;height:100%;object-fit:cover;border-radius:11px"/>` : (o.items[0] ? (o.items[0].emoji || '📦') : '📦')}</div>
            <div><div class="small" style="font-weight:650">${esc(o.ref)} · ${o.items.length} item${o.items.length > 1 ? 's' : ''}</div>
            <div class="tiny muted mt6">${dateLabel(o.createdAt)} · ${esc(vu ? vu.username : 'vendor')}</div></div></div>
          <div class="row gap8">${statusBadge(o.status)}
            <span style="font-weight:700;font-family:var(--display)">${coins(o.totalCoins)} <span class="tiny muted">WC</span></span></div>
        </div>
        <div class="divider"></div>
        <div class="row between wrap gap10">
          <div class="tiny muted">${o.items.map(i => esc(i.name) + ' ×' + i.qty).join(', ')}</div>
          <div class="row gap8">
            <button class="btn btn-sm btn-ghost" data-act="order-detail" data-id="${o.id}">${ic('eye', 14)} Details</button>
            <button class="btn btn-sm btn-primary" data-act="track-order" data-id="${o.id}">${ic('truck', 14)} Track package</button>
          </div>
        </div>
      </div>`;
    }).join('')}</div>` : `<div class="card empty"><div class="ic">${ic('truck', 26)}</div><h3>No orders yet</h3><p>Your purchases and their tracking will appear here.</p><a href="#/market" class="btn btn-primary">Browse marketplace</a></div>`}`;
};

App.orderDetail = function (id) {
  const o = DB.orders.find(x => x.id === id); if (!o) return;
  const steps = ['processing', 'shipped', 'delivered'];
  const v = vendorById(o.vendorId); const vu = v ? findUser(v.userId) : null;
  openModal(modalShell('Order ' + o.ref, `
    <div class="between mb10">${statusBadge(o.status)}<span style="font-family:var(--display);font-weight:800">${coins(o.totalCoins)} WC</span></div>
    <div class="panel" style="padding:12px;margin-bottom:12px">
      ${o.items.map(i => `<div class="between" style="padding:5px 0"><span class="small">${esc(i.name)} ×${i.qty}</span><span class="small muted">${usd(i.priceUsd * i.qty)}</span></div>`).join('')}
    </div>
    <div class="timeline">
      ${steps.map(s => {
        const hit = o.timeline.find(t => t.status === s);
        const done = !!hit;
        const names = { processing: 'Processing', shipped: 'Shipped', delivered: 'Delivered' };
        return `<div class="step ${done ? 'done' : ''}"><div class="bullet">${done ? ic('check', 11) : ''}</div>
          <div><h4>${names[s]}</h4><p>${hit ? new Date(hit.at).toLocaleString() + (hit.note ? ' · ' + esc(hit.note) : '') : 'Waiting'}</p></div></div>`;
      }).join('')}
    </div>
    <div class="divider"></div>
    <div class="small" style="font-weight:650;margin-bottom:6px">Delivery details</div>
    <div class="kv"><span class="k">Receiver</span><span class="v">${esc(o.delivery.fullName)}</span></div>
    <div class="kv"><span class="k">Phone</span><span class="v">${esc(o.delivery.phone)}</span></div>
    <div class="kv"><span class="k">Email</span><span class="v">${esc(o.delivery.email)}</span></div>
    <div class="kv"><span class="k">Address</span><span class="v" style="max-width:60%">${esc(o.delivery.address)}, ${esc(o.delivery.country)}</span></div>
    <div class="kv"><span class="k">Vendor</span><span class="v">@${esc(vu ? vu.username : '—')}</span></div>
    ${o.tracking ? `<div class="kv"><span class="k">Tracking ref</span><span class="v">${esc(o.tracking)}</span></div>` : ''}`,
    `<button class="btn btn-ghost" data-close style="flex:1">Close</button>
     ${vu ? `<button class="btn btn-ghost" data-act="open-chat" data-id="${vu.id}" data-close style="flex:1">${ic('chat', 15)} Vendor</button>` : ''}
     <button class="btn btn-primary" data-act="track-order" data-id="${o.id}" style="flex:1">${ic('truck', 15)} Track</button>`));
};

App.trackOrder = function (id) {
  const o = DB.orders.find(x => x.id === id);
  go('track' + (o ? '?ref=' + o.ref : ''));
};

VIEWS.track = function (parts, params) {
  const u = me();
  const ref = params.ref || '';
  const o = DB.orders.find(x => x.ref === ref && (x.buyerId === u.id || u.role === 'admin'));
  const doneSteps = o ? ['processing', 'shipped', 'delivered'].map(s => {
    const hit = o.timeline.find(t => t.status === s);
    const names = { processing: 'Processing', shipped: 'Shipped', delivered: 'Delivered' };
    return `<div class="step ${hit ? 'done' : ''}"><div class="bullet">${hit ? ic('check', 11) : ''}</div>
      <div><h4>${names[s]}</h4><p>${hit ? new Date(hit.at).toLocaleString() + (hit.note ? ' · ' + esc(hit.note) : '') : 'Waiting for update'}</p></div></div>`;
  }).join('') : '';
  return `<div class="page-head"><div><button class="btn btn-ghost btn-sm mb10" data-act="back">${ic('back', 14)} Back</button>
      <h1>Track package</h1><p>${o ? esc(o.ref) + ' · ' + o.items.map(i => esc(i.name)).join(', ') : 'Follow every movement of your delivery.'}</p></div>
    ${o ? statusBadge(o.status) : ''}</div>
    ${o ? `<div class="card mb16">
      <div class="between mb10"><h3 style="font-size:15px">Delivery progress</h3>
        ${o.tracking ? `<button class="btn btn-xs btn-ghost" data-act="copy" data-id="${esc(o.tracking)}">${ic('copy', 12)} ${esc(o.tracking)}</button>` : ''}</div>
      <div class="timeline">${doneSteps}</div>
      <div class="divider"></div>
      <div class="row wrap gap14">
        <div class="tiny muted">Receiver: <b style="color:var(--text)">${esc(o.delivery.fullName)}</b></div>
        <div class="tiny muted">To: ${esc(o.delivery.country)}</div>
      </div>
    </div>` : ''}
    <div class="card">
      <div class="row gap12" style="align-items:flex-start">
        <div style="width:44px;height:44px;border-radius:12px;background:rgba(46,230,201,.12);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none">${ic('truck', 20)}</div>
        <div class="grow">
          <h3 style="font-size:15px">Package Air Tracker</h3>
          <p class="small muted mt6" style="line-height:1.65">Our delivery partner hosts live package movements on its own secure portal. Open it below — tracking opens in a new tab, so it always works even when a host blocks embedded pages.</p>
          <div class="row gap8 mt16 wrap">
            <a class="btn btn-primary" href="https://package-airtracker.zite.so" target="_blank" rel="noopener noreferrer">${ic('link', 15)} Open tracking portal</a>
            <button class="btn btn-ghost" data-act="track-embed">${ic('grid', 15)} Try in-app view</button>
            ${o && o.tracking ? `<button class="btn btn-ghost" data-act="copy" data-id="${esc(o.tracking)}">${ic('copy', 15)} Copy reference</button>` : ''}
          </div>
        </div>
      </div>
      <div id="trackEmbed" class="mt16 hidden"></div>
      <div class="panel mt16" style="padding:11px 13px">
        <div class="tiny" style="font-weight:600;color:var(--accent)">${ic('shield', 12)} Protected delivery</div>
        <div class="tiny muted mt6" style="line-height:1.6">If the portal shows an access message, open it in your browser (or contact support in chat) — your order and tracking reference are always available here.</div>
      </div>
    </div>`;
};

App.trackEmbed = function () {
  const box = document.getElementById('trackEmbed');
  if (!box) return;
  box.classList.remove('hidden');
  box.innerHTML = `<div class="between" style="padding:10px 12px;border:1px solid var(--border);border-bottom:0;border-radius:12px 12px 0 0;background:var(--surface-2)">
      <span class="tiny muted">package-airtracker.zite.so</span>
      <a href="https://package-airtracker.zite.so" target="_blank" rel="noopener" class="link tiny">Open in new tab</a></div>
    <iframe src="https://package-airtracker.zite.so" title="Package tracker" style="width:100%;height:min(65vh,600px);border:1px solid var(--border);border-radius:0 0 12px 12px;background:#fff"></iframe>
    <div class="tiny muted mt10" style="line-height:1.6">The portal owner can block embedding for security. If you see “AccessDenied”, that is the portal’s own protection — use “Open in new tab”.</div>`;
};

/* ---------------- vendor: create ---------------- */
VIEWS.vendor = function (parts) {
  const u = me();
  if (u.role === 'admin') return adminSupportView();
  const v = vendorOf(u.id);
  if (!v) return viewBecomeVendor(u);
  if (!vendorIsActive(v)) return viewVendorFrozen(u, v);
  if (parts[1] === 'renew') return viewVendorRenewForm(u, v, false);
  return viewVendorDash(u, v, parts[1]);
};

let VENDOR_SLIP = null;
function vendorPayMethods() {
  const p = DB.settings.vendorPayments || {};
  return Array.isArray(p.methods) ? p.methods : [];
}
function viewBecomeVendor(u) {
  const fee = Math.max(0, Number(DB.settings.vendorFeeUsd) || 0);
  const apps = (DB.vendorApplications || []).filter(a => a.userId === u.id).sort((a, b) => b.createdAt - a.createdAt);
  const pending = apps.find(a => a.status === 'pending');
  if (pending) return viewVendorApplicationStatus(u, pending);
  const rejected = apps.find(a => a.status === 'rejected');
  if (fee > 0) return viewVendorApplyForm(u, rejected);
  return viewVendorFreeForm(u);
}

function viewVendorFreeForm(u) {
  return `<div class="page-head"><div><h1>Become a vendor</h1><p>Open your own WhaleChat store and get paid instantly in Whale Coin.</p></div></div>
    <div style="display:grid;grid-template-columns:1.1fr .9fr;gap:20px" class="cart-grid">
      <div class="card">
        <div class="row gap10 mb16"><div style="width:40px;height:40px;border-radius:12px;background:rgba(46,230,201,.12);color:var(--accent);display:flex;align-items:center;justify-content:center">${ic('store', 19)}</div>
          <div><h3 style="font-size:16px">Create vendor profile</h3><div class="tiny muted">One profile per account · activation is free</div></div></div>
        ${field('Preferred vendor username', 'vName', { ph: 'e.g. harbor.tech', icon: 'tag', help: '3–24 characters. Letters, numbers, dot, dash or underscore.' })}
        ${field('Account password', 'vPass', { type: 'password', ph: 'Confirm your login password', icon: 'lock', help: 'For your security, confirm your WhaleChat account password.' })}
        ${field('Confirm password', 'vPass2', { type: 'password', ph: 'Repeat password', icon: 'lock' })}
        <label class="checkline" style="margin:4px 0 16px"><input type="checkbox" id="vAgree" />
          <span>I agree to the Vendor Terms: accurate listings, honouring sales, and shipping within 5 business days.</span></label>
        <button class="btn btn-primary btn-block btn-lg" id="createVendorBtn">${ic('store', 17)} Create vendor profile</button>
      </div>
      <div class="col gap12">
        <div class="wallet-card" style="padding:20px">
          <div class="tiny" style="opacity:.8;letter-spacing:.08em;font-weight:700">VENDOR WALLET</div>
          <div class="wallet-bal" style="font-size:30px">${coins(u.balance)} <span style="font-size:14px;opacity:.7">WC</span></div>
          <div class="tiny" style="opacity:.8;margin-top:4px">Available balance</div>
          <div class="wallet-actions"><a href="#/deposit" class="btn">Deposit</a><a href="#/withdraw" class="btn">Withdraw</a><a href="#/wallet" class="btn">Activity</a></div>
        </div>
        ${[['box', 'Buy from the company', 'Stock your store from the official WhaleChat catalogue at wholesale prices.'],
           ['tag', 'Set your selling price', 'Price in USD — we convert to Whale Coin automatically at $0.50 per coin.'],
           ['truck', 'We handle delivery', 'Our team approves orders, ships and tracks packages for you.']]
          .map(([i, t, d]) => `<div class="card" style="padding:14px"><div class="row gap10"><div style="width:32px;height:32px;border-radius:9px;background:var(--surface-2);color:var(--accent);display:flex;align-items:center;justify-content:center">${ic(i, 15)}</div>
            <div><div class="small" style="font-weight:650">${t}</div><div class="tiny muted mt6" style="line-height:1.55">${d}</div></div></div></div>`).join('')}
      </div>
    </div>
    <style>@media(max-width:860px){.cart-grid{grid-template-columns:1fr!important}}</style>`;
}

function viewVendorApplyForm(u, rejected) {
  const plans = (DB.settings.vendorPlans || []).slice().sort((a, b) => a.months - b.months);
  const fee = plans.length ? Number(plans[0].priceUsd) : 0;
  const pay = DB.settings.vendorPayments || {};
  const methods = vendorPayMethods();
  return `<div class="page-head"><div><h1>Become a vendor</h1><p>Pay the one-time activation fee, upload your receipt and our team will activate your store.</p></div>
      <span class="badge badge-warn">${ic('clock', 12)} Admin approval required</span></div>
    ${rejected ? `<div class="card mb16" style="border-color:rgba(255,95,116,.35);background:rgba(255,95,116,.06)">
      <div class="between wrap gap10"><div><div class="small" style="font-weight:650;color:var(--danger)">Previous application rejected</div>
      <div class="tiny muted mt6">${esc(rejected.note || 'No reason provided.')}</div></div>
      <span class="badge badge-danger">${ic('ban', 11)} Rejected</span></div></div>` : ''}
    <div style="display:grid;grid-template-columns:1.05fr .95fr;gap:20px" class="cart-grid">
      <div class="card">
        <div class="row gap10 mb16"><div style="width:40px;height:40px;border-radius:12px;background:rgba(46,230,201,.12);color:var(--accent);display:flex;align-items:center;justify-content:center">${ic('store', 19)}</div>
          <div><h3 style="font-size:16px">Vendor application</h3><div class="tiny muted">Fee: <b style="color:var(--accent)">${usd(fee)}</b> · one-time</div></div></div>
        <div class="grid2" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          ${field('Preferred vendor username', 'vName', { ph: 'e.g. harbor.tech', icon: 'tag', help: '3–24 chars: letters, numbers, dot, dash, underscore' })}
          ${field('Your account password', 'vPass', { type: 'password', ph: 'Confirm password', icon: 'lock' })}
        </div>
        ${field('Confirm password', 'vPass2', { type: 'password', ph: 'Repeat password', icon: 'lock' })}

        <div class="label mt6 mb10">Choose your vendor account duration</div>
        <div class="col gap8">${plans.map((pl, i) => `<label class="list-item" style="cursor:pointer;align-items:center">
          <input type="radio" name="vplan" value="${esc(pl.id)}" data-price="${pl.priceUsd}" data-months="${pl.months}" ${i === 0 ? 'checked' : ''} onchange="A.updatePlanFee(this)" style="accent-color:var(--accent)"/>
          <div class="grow"><div class="small" style="font-weight:650">${pl.months} month${pl.months > 1 ? 's' : ''}</div>
            <div class="tiny muted">Full vendor access · renew when it ends</div></div>
          <span style="font-family:var(--display);font-weight:800;color:var(--accent)">${usd(pl.priceUsd)}</span></label>`).join('')}</div>

        <div class="label mt16 mb10">Pay <b id="planFee">${usd(fee)}</b> to one of these company accounts</div>
        ${methods.length ? `<div class="col gap8">${methods.map((m, i) => `<label class="list-item" style="cursor:pointer;align-items:flex-start">
          <input type="radio" name="vpm" value="${esc(m.id)}" ${i === 0 ? 'checked' : ''} style="margin-top:3px;accent-color:var(--accent)"/>
          <div class="grow" style="min-width:0"><div class="small" style="font-weight:650">${esc(m.label)} ${m.network ? `<span class="badge" style="font-size:9px">${esc(m.network)}</span>` : ''}</div>
            <div class="tiny muted" style="word-break:break-all;margin-top:3px">${esc(m.address)}</div></div>
          <button type="button" class="btn-icon" data-act="copy" data-id="${esc(m.address)}" style="width:30px;height:30px">${ic('copy', 13)}</button></label>`).join('')}</div>`
          : `<div class="empty" style="padding:14px"><p>No vendor payment account configured yet. Please contact support.</p></div>`}
        ${pay.note ? `<div class="tiny muted mt8" style="line-height:1.6">${esc(pay.note)}</div>` : ''}

        <div class="mt16">
          <div class="label mb8">Payment slip / receipt</div>
          <div class="row gap10">
            <button class="btn btn-ghost btn-sm" data-act="vendor-slip">${ic('image', 14)} Upload slip</button>
            <span class="tiny muted" id="slipStatus">${VENDOR_SLIP ? 'Receipt attached ✓' : 'JPG or PNG screenshot of your payment'}</span>
          </div>
          <div id="slipPreview" class="mt10">${VENDOR_SLIP ? `<img src="${VENDOR_SLIP}" style="max-width:220px;border-radius:10px;border:1px solid var(--border)"/>` : ''}</div>
        </div>

        <label class="checkline mt14"><input type="checkbox" id="vAgree" />
          <span>I confirm I paid the ${usd(fee)} vendor activation fee and agree to the Vendor Terms.</span></label>
        <button class="btn btn-primary btn-block btn-lg mt14" id="applyVendorBtn">${ic('check', 16)} Submit application for review</button>
      </div>
      <div class="col gap12">
        <div class="wallet-card">
          <div class="tiny" style="opacity:.85;letter-spacing:.08em;font-weight:700">VENDOR ACTIVATION FEE</div>
          <div class="row" style="gap:8px;align-items:baseline;margin-top:6px"><span class="wallet-bal" id="planSummaryFee">${usd(fee)}</span></div>
          <div class="tiny" style="opacity:.8;margin-top:4px">One-time payment · includes store activation</div>
          <div class="wallet-actions"><a href="#/wallet" class="btn">Deposit WC</a><a href="#/market" class="btn">Marketplace</a><a href="#/settings" class="btn">Settings</a></div>
        </div>
        <div class="card">
          <h3 style="font-size:15px">How activation works</h3>
          <div class="col gap10 mt12">
            ${[['link', 'Copy the company payment account above and pay the exact fee.'],
               ['image', 'Upload the payment slip / receipt with this application.'],
               ['clock', 'Admin reviews your payment and details.'],
               ['store', 'Once approved, your vendor dashboard unlocks automatically.']]
              .map(([i, t]) => `<div class="row gap10"><span style="width:28px;height:28px;border-radius:8px;background:var(--surface-2);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none">${ic(i, 14)}</span><span class="tiny muted" style="line-height:1.6">${t}</span></div>`).join('')}
          </div>
        </div>
      </div>
    </div>
    <style>@media(max-width:860px){.cart-grid{grid-template-columns:1fr!important}}</style>`;
}

function viewVendorApplicationStatus(u, app) {
  const fee = Number(app.feeUsd) || 0;
  return `<div class="page-head"><div><h1>Vendor application</h1><p>Your payment is being reviewed by our team.</p></div>
      ${statusBadge(app.status)}</div>
    <div style="display:grid;grid-template-columns:1fr 340px;gap:20px" class="cart-grid">
      <div class="card">
        <div class="center" style="padding:8px 0 18px">
          <div style="width:64px;height:64px;border-radius:18px;background:rgba(255,176,32,.14);color:var(--warn);display:flex;align-items:center;justify-content:center;margin:0 auto">${ic('clock', 30)}</div>
          <h3 class="mt14" style="font-size:18px">Waiting for admin approval</h3>
          <p class="small muted mt8" style="line-height:1.7">We received your ${usd(fee)} payment proof. Our team usually reviews vendor applications within 24 hours.</p>
        </div>
        <div class="kv"><span class="k">Vendor username</span><span class="v">@${esc(app.vendorUsername)}</span></div>
        <div class="kv"><span class="k">Fee</span><span class="v">${usd(fee)}</span></div>
        <div class="kv"><span class="k">Payment method</span><span class="v">${esc(app.methodLabel || '—')}</span></div>
        <div class="kv"><span class="k">Submitted</span><span class="v">${dateLabel(app.createdAt)}</span></div>
        ${app.proof ? `<div class="mt14"><div class="label mb6">Your uploaded slip</div><img src="${app.proof}" style="max-width:100%;max-height:320px;border-radius:12px;border:1px solid var(--border);cursor:pointer" data-act="vendor-view-proof" data-id="${app.id}"/></div>` : ''}
        <div class="row gap8 mt16">
          <button class="btn btn-ghost btn-sm" data-act="vendor-cancel-app" data-id="${app.id}">Cancel application</button>
          <button class="btn btn-ghost btn-sm" data-act="support-chat">${ic('chat', 14)} Contact support</button>
        </div>
      </div>
      <div class="col gap12">
        <div class="card"><h3 style="font-size:15px">What happens next?</h3>
          <ol class="tiny muted mt10" style="padding-left:18px;line-height:1.9">
            <li>Admin verifies your payment slip.</li>
            <li>Your vendor profile is activated.</li>
            <li>You'll get a notification and the Vendor Hub appears in your menu.</li>
          </ol></div>
        <div class="wallet-card" style="padding:18px">
          <div class="tiny" style="opacity:.8;letter-spacing:.08em;font-weight:700">VENDOR WALLET</div>
          <div class="wallet-bal" style="font-size:26px">${coins(u.balance)} <span style="font-size:13px;opacity:.7">WC</span></div>
          <div class="wallet-actions"><a href="#/deposit" class="btn">Deposit</a><a href="#/wallet" class="btn">Activity</a></div>
        </div>
      </div>
    </div>
    <style>@media(max-width:860px){.cart-grid{grid-template-columns:1fr!important}}</style>`;
}

App.vendorSlip = async function () {
  const f = await pickFile({ accept: 'image/*' });
  if (!f) return;
  toast('Preparing receipt…');
  const c = await compressImage(f, 1100, 0.7);
  VENDOR_SLIP = await fileToDataURL(c);
  const prev = document.getElementById('slipPreview');
  const st = document.getElementById('slipStatus');
  if (prev) prev.innerHTML = `<img src="${VENDOR_SLIP}" style="max-width:220px;border-radius:10px;border:1px solid var(--border)"/>`;
  if (st) st.textContent = 'Receipt attached ✓';
};

App.applyVendor = async function () {
  const u = me(); clearErrors();
  const name = document.getElementById('vName').value.trim();
  const p1 = document.getElementById('vPass').value, p2 = document.getElementById('vPass2').value;
  if (!/^[a-zA-Z0-9._-]{3,24}$/.test(name)) return formError('vName', '3–24 characters: letters, numbers, dot, dash or underscore');
  if (DB.vendors.some(v => v.username.toLowerCase() === name.toLowerCase())) return formError('vName', 'That vendor username is taken');
  if ((DB.vendorApplications || []).some(a => a.status === 'pending' && a.vendorUsername.toLowerCase() === name.toLowerCase() && a.userId !== u.id)) return formError('vName', 'That vendor username is under review by another applicant');
  if (!p1) return formError('vPass', 'Confirm your account password');
  if (await hash(p1) !== u.pass) return formError('vPass', 'That password does not match your account');
  if (p1 !== p2) return formError('vPass2', 'Passwords do not match');
  const methodEl = document.querySelector('input[name="vpm"]:checked');
  const methods = vendorPayMethods();
  const method = methodEl ? methods.find(m => m.id === methodEl.value) : methods[0];
  if (!method) return toast('No vendor payment account is configured — contact support', 'err');
  if (!VENDOR_SLIP) return toast('Upload your payment slip / receipt', 'err');
  if (!document.getElementById('vAgree').checked) return toast('Please confirm the fee was paid and accept the terms', 'err');
  const planEl = document.querySelector('input[name="vplan"]:checked');
  const plan = planEl ? vendorPlanById(planEl.value) : (DB.settings.vendorPlans || [])[0];
  if (!plan) return toast('No vendor duration is configured — contact support', 'err');
  const fee = Math.max(0, Number(plan.priceUsd) || 0);

  DB.vendorApplications = DB.vendorApplications || [];
  const app = {
    id: uid('vap'), kind: 'new', userId: u.id, userName: u.fullName, username: u.username,
    vendorUsername: name, feeUsd: fee, planId: plan.id, months: plan.months,
    methodId: method.id, methodLabel: method.label + (method.network ? ' · ' + method.network : ''),
    address: method.address, proof: VENDOR_SLIP, status: 'pending', note: '', createdAt: Date.now()
  };
  DB.vendorApplications.unshift(app);
  notify('usr_admin', 'Vendor application · ' + usd(fee), `${u.fullName} (@${u.username}) applied as @${name} and uploaded a payment slip.`, '#/admin/vendor-requests', 'store');
  notify(u.id, 'Vendor application submitted', 'Your payment slip is under review. You will be notified once approved.', '#/vendor', 'clock');
  VENDOR_SLIP = null;
  sync();
  toast('Application submitted — awaiting admin approval', 'ok', 3600);
  render();
};

App.vendorCancelApp = async function (id) {
  const app = (DB.vendorApplications || []).find(a => a.id === id && a.userId === me().id);
  if (!app) return;
  if (!await confirmDialog({ title: 'Cancel application?', body: 'Your uploaded slip stays with the admin for audit. You can apply again later.', danger: true, ok: 'Cancel application' })) return;
  DB.vendorApplications = DB.vendorApplications.filter(a => a.id !== id);
  sync(); toast('Application cancelled', 'ok'); render();
};

App.vendorViewProof = function (id) {
  const app = (DB.vendorApplications || []).find(a => a.id === id);
  if (!app || !app.proof) return;
  openModal(modalShell('Payment slip · @' + app.vendorUsername, `<img src="${app.proof}" style="width:100%;border-radius:12px;border:1px solid var(--border)"/>`, `<button class="btn btn-ghost" data-close style="width:100%">Close</button>`), { width: '560px' });
};

App.createVendor = async function () {
  const u = me(); clearErrors();
  const name = document.getElementById('vName').value.trim();
  const p1 = document.getElementById('vPass').value, p2 = document.getElementById('vPass2').value;
  if (!/^[a-zA-Z0-9._-]{3,24}$/.test(name)) return formError('vName', '3–24 characters: letters, numbers, dot, dash or underscore');
  if (DB.vendors.some(v => v.username.toLowerCase() === name.toLowerCase())) return formError('vName', 'That vendor username is taken');
  if (!p1) return formError('vPass', 'Confirm your account password');
  if (await hash(p1) !== u.pass) return formError('vPass', 'That password does not match your account');
  if (p1 !== p2) return formError('vPass2', 'Passwords do not match');
  if (!document.getElementById('vAgree').checked) return toast('Please accept the Vendor Terms', 'err');
  const v = {
    id: uid('vnd'), userId: u.id, username: name, name: name, avatar: u.avatar,
    rating: 5, trustScore: 80, sales: 0, revenue: 0, createdAt: Date.now(), status: 'active', completedSales: 0,
    planMonths: 1, planId: (DB.settings.vendorPlans || [])[0] ? DB.settings.vendorPlans[0].id : null,
    expiresAt: Date.now() + 30 * 86400000
  };
  DB.vendors.push(v);
  u.vendorId = v.id;
  notify('usr_admin', 'New vendor profile', `${u.fullName} opened a store as @${name}.`, '#/admin/vendors', 'store');
  notify(u.id, 'Vendor profile created 🎉', 'Buy stock from the Company Marketplace and start selling.', '#/vendor/company', 'store');
  sync(); toast('Vendor profile created', 'ok'); go('vendor');
};

function viewVendorFrozen(u, v) {
  const apps = (DB.vendorApplications || []).filter(a => a.userId === u.id && a.kind === 'renewal').sort((a, b) => b.createdAt - a.createdAt);
  const pending = apps.find(a => a.status === 'pending');
  if (pending) {
    return `<div class="page-head"><div><h1>Vendor account frozen</h1><p>Your subscription ended on ${vendorExpiryText(v)}.</p></div>${statusBadge('pending')}</div>
      <div class="card">
        <div class="center" style="padding:8px 0 16px">
          <div style="width:64px;height:64px;border-radius:18px;background:rgba(255,176,32,.14);color:var(--warn);display:flex;align-items:center;justify-content:center;margin:0 auto">${ic('clock', 30)}</div>
          <h3 class="mt14" style="font-size:18px">Renewal under review</h3>
          <p class="small muted mt8">We received your ${usd(pending.feeUsd)} renewal payment slip for ${pending.months} month${pending.months > 1 ? 's' : ''}. Your store reopens as soon as the admin approves it.</p>
        </div>
        <div class="kv"><span class="k">Plan</span><span class="v">${pending.months} month${pending.months > 1 ? 's' : ''} · ${usd(pending.feeUsd)}</span></div>
        <div class="kv"><span class="k">Submitted</span><span class="v">${dateLabel(pending.createdAt)}</span></div>
        ${pending.proof ? `<img src="${pending.proof}" style="max-width:100%;max-height:300px;border-radius:12px;border:1px solid var(--border);margin-top:14px;cursor:pointer" data-act="vendor-view-proof" data-id="${pending.id}"/>` : ''}
        <div class="row gap8 mt16"><button class="btn btn-ghost btn-sm" data-act="support-chat">${ic('chat', 14)} Contact support</button></div>
      </div>`;
  }
  return viewVendorRenewForm(u, v, true);
}

function viewVendorRenewForm(u, v, frozen) {
  const plans = (DB.settings.vendorPlans || []).slice().sort((a, b) => a.months - b.months);
  const pay = DB.settings.vendorPayments || {};
  const methods = vendorPayMethods();
  const fee = plans.length ? Number(plans[0].priceUsd) : 0;
  return `<div class="page-head"><div><h1>${frozen ? 'Renew vendor account' : 'Extend vendor account'}</h1>
      <p>${frozen ? 'Your vendor account is frozen — renew to reopen your store.' : 'Current access ends ' + vendorExpiryText(v) + '.'}</p></div>
    ${frozen ? '<span class="badge badge-danger">Frozen</span>' : '<span class="badge badge-success">Active · ' + (vendorDaysLeft(v) || 0) + ' days left</span>'}</div>
    ${frozen ? `<div class="card mb16" style="border-color:rgba(255,95,116,.35);background:rgba(255,95,116,.06)">
      <div class="small" style="font-weight:650;color:var(--danger)">Your store and its products are hidden from the marketplace until renewal.</div>
    </div>` : ''}
    <div style="display:grid;grid-template-columns:1.05fr .95fr;gap:20px" class="cart-grid">
      <div class="card">
        <div class="label mb10">Choose a renewal duration</div>
        <div class="col gap8">${plans.map((pl, i) => `<label class="list-item" style="cursor:pointer;align-items:center">
          <input type="radio" name="vplan" value="${esc(pl.id)}" data-price="${pl.priceUsd}" data-months="${pl.months}" ${i === 0 ? 'checked' : ''} onchange="A.updatePlanFee(this)" style="accent-color:var(--accent)"/>
          <div class="grow"><div class="small" style="font-weight:650">${pl.months} month${pl.months > 1 ? 's' : ''}</div>
            <div class="tiny muted">${frozen ? 'Reopens immediately after approval' : 'Added to your current expiry date'}</div></div>
          <span style="font-family:var(--display);font-weight:800;color:var(--accent)">${usd(pl.priceUsd)}</span></label>`).join('')}</div>
        <div class="label mt16 mb10">Pay <b id="planFee">${usd(fee)}</b> to one of these company accounts</div>
        ${methods.length ? `<div class="col gap8">${methods.map((m, i) => `<label class="list-item" style="cursor:pointer;align-items:flex-start">
          <input type="radio" name="vpm" value="${esc(m.id)}" ${i === 0 ? 'checked' : ''} style="margin-top:3px;accent-color:var(--accent)"/>
          <div class="grow" style="min-width:0"><div class="small" style="font-weight:650">${esc(m.label)} ${m.network ? `<span class="badge" style="font-size:9px">${esc(m.network)}</span>` : ''}</div>
            <div class="tiny muted" style="word-break:break-all;margin-top:3px">${esc(m.address)}</div></div>
          <button type="button" class="btn-icon" data-act="copy" data-id="${esc(m.address)}" style="width:30px;height:30px">${ic('copy', 13)}</button></label>`).join('')}</div>`
          : '<p class="tiny muted">No vendor payment account configured — contact support.</p>'}
        <div class="mt16"><div class="label mb8">Payment slip / receipt</div>
          <div class="row gap10"><button class="btn btn-ghost btn-sm" data-act="vendor-slip">${ic('image', 14)} Upload slip</button>
          <span class="tiny muted" id="slipStatus">${VENDOR_SLIP ? 'Receipt attached ✓' : 'JPG or PNG screenshot'}</span></div>
          <div id="slipPreview" class="mt10">${VENDOR_SLIP ? `<img src="${VENDOR_SLIP}" style="max-width:220px;border-radius:10px;border:1px solid var(--border)"/>` : ''}</div></div>
        <button class="btn btn-primary btn-block btn-lg mt16" id="renewVendorBtn">${ic('refresh', 16)} Submit renewal for approval</button>
      </div>
      <div class="col gap12">
        <div class="wallet-card" style="padding:18px">
          <div class="tiny" style="opacity:.85;letter-spacing:.08em;font-weight:700">CURRENT EXPIRY</div>
          <div class="wallet-bal" style="font-size:26px">${vendorExpiryText(v)}</div>
          <div class="tiny" style="opacity:.8;margin-top:4px">${frozen ? 'Frozen' : (vendorDaysLeft(v) || 0) + ' days remaining'}</div>
        </div>
        <div class="card"><h3 style="font-size:15px">Renewal rules</h3>
          <ul class="tiny muted mt10" style="padding-left:18px;line-height:1.9">
            <li>Pick any duration and pay the exact fee.</li>
            <li>Upload the receipt — admin approves the renewal.</li>
            <li>${frozen ? 'Store reopens on approval.' : 'New months are added to your current expiry.'}</li>
            <li>Unsold stock and listings are preserved.</li>
          </ul></div>
      </div>
    </div>
    <style>@media(max-width:860px){.cart-grid{grid-template-columns:1fr!important}}</style>`;
}

App.updatePlanFee = function (el) {
  const fee = el && el.getAttribute('data-price');
  const a = document.getElementById('planFee'); if (a && fee != null) a.textContent = usd(Number(fee));
  const b = document.getElementById('planSummaryFee'); if (b && fee != null) b.textContent = usd(Number(fee));
};

App.applyVendorRenew = async function () {
  const u = me(); const v = vendorOf(u.id);
  if (!v) return;
  const planEl = document.querySelector('input[name="vplan"]:checked');
  const plan = planEl ? vendorPlanById(planEl.value) : (DB.settings.vendorPlans || [])[0];
  if (!plan) return toast('Choose a renewal duration', 'err');
  const methodEl = document.querySelector('input[name="vpm"]:checked');
  const methods = vendorPayMethods();
  const method = methodEl ? methods.find(m => m.id === methodEl.value) : methods[0];
  if (!method) return toast('No vendor payment account configured', 'err');
  if (!VENDOR_SLIP) return toast('Upload your payment slip / receipt', 'err');
  DB.vendorApplications = DB.vendorApplications || [];
  DB.vendorApplications.unshift({
    id: uid('vap'), kind: 'renewal', userId: u.id, vendorId: v.id,
    userName: u.fullName, username: u.username, vendorUsername: v.username,
    feeUsd: Number(plan.priceUsd) || 0, planId: plan.id, months: plan.months,
    methodId: method.id, methodLabel: method.label + (method.network ? ' · ' + method.network : ''),
    address: method.address, proof: VENDOR_SLIP, status: 'pending', note: '', createdAt: Date.now()
  });
  notify('usr_admin', 'Vendor renewal · @' + v.username, `${u.fullName} paid ${usd(plan.priceUsd)} for ${plan.months} month${plan.months > 1 ? 's' : ''} and uploaded a slip.`, '#/admin/vendor-requests', 'clock');
  notify(u.id, 'Renewal submitted', 'Your payment slip is under review. Access resumes once approved.', '#/vendor', 'clock');
  VENDOR_SLIP = null;
  sync(); toast('Renewal submitted for approval', 'ok'); render();
};

function viewVendorDash(u, v, tab) {
  const products = DB.products.filter(p => p.vendorId === v.id);
  const listed = products.filter(p => p.active && p.stock > 0);
  const soldItems = DB.orders.reduce((s, o) => s + o.items.filter(i => products.some(p => p.id === i.productId)).reduce((x, i) => x + i.qty, 0), 0);
  const revenue = DB.orders.reduce((s, o) => s + (o.vendorId === v.id ? o.totalCoins : 0), 0);
  const pendingOrders = DB.orders.filter(o => o.vendorId === v.id && o.status !== 'delivered').length;
  return `<div class="page-head"><div>
      <span class="badge badge-accent mb10">${ic('store', 12)} Vendor</span>
      <h1>${esc(v.name)}</h1><p>@${esc(v.username)} · ${v.rating.toFixed(1)} ★ · Trust ${v.trustScore}/100</p></div>
      <div class="row gap8"><a href="#/market" class="btn btn-ghost btn-sm">${ic('bag', 15)} View store</a>
      <a href="#/vendor/renew" class="btn btn-ghost btn-sm">${ic('refresh', 15)} Renew</a>
      <a href="#/vendor/company" class="btn btn-primary btn-sm">${ic('plus', 15)} Buy stock</a></div></div>
    <div class="card mb16" style="padding:12px 14px">
      <div class="between wrap gap10">
        <div class="row gap8"><span class="badge badge-success">${ic('check', 11)} Active vendor</span>
          <span class="tiny muted">Subscription ends <b style="color:var(--text)">${vendorExpiryText(v)}</b> · ${vendorDaysLeft(v)} days left</span></div>
        <button class="btn btn-xs btn-ghost" data-nav="#/vendor/renew">${ic('refresh', 12)} Extend / renew</button>
      </div>
    </div>
    <div class="wallet-card mb16">
      <div class="between"><div class="tiny" style="opacity:.8;letter-spacing:.08em;font-weight:700">VENDOR BALANCE</div>${ic('wallet', 18)}</div>
      <div class="row" style="gap:8px;align-items:baseline;margin-top:6px"><span class="wallet-bal">${coins(u.balance)}</span><span class="small" style="opacity:.75">WC</span></div>
      <div class="tiny" style="opacity:.8;margin-top:4px">≈ ${usd(coinsToUsd(u.balance))} USD</div>
      <div class="wallet-actions">
        <a href="#/deposit" class="btn">Deposit</a><a href="#/withdraw" class="btn">Withdraw</a><a href="#/vendor/products" class="btn">Inventory</a>
      </div>
    </div>
    <div class="grid-kpi mb16">
      ${[['Completed sales', fmtNum(v.sales || 0), 'bag'], ['Revenue', coins(revenue) + ' WC', 'trend'], ['Listed products', fmtNum(listed.length), 'tag'], ['Pending orders', fmtNum(pendingOrders), 'truck']]
        .map(([k, val, icon]) => `<div class="kpi"><div class="ic">${ic(icon, 15)}</div><div class="v">${val}</div><div class="k">${k}</div><span class="spark">${ic(icon, 52)}</span></div>`).join('')}
    </div>
    <div class="grid2" style="display:grid;grid-template-columns:1fr 1fr;gap:14px" class="dash2">
      <div class="card"><div class="section-title"><h3>Vendor actions</h3></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
          ${[['box', 'Buy from company', '#/vendor/company', 'Wholesale stock'],
             ['tag', 'My products', '#/vendor/products', products.length + ' items'],
             ['truck', 'Orders', '#/vendor/orders', pendingOrders + ' pending'],
             ['trend', 'Sales history', '#/vendor/history', v.sales + ' sales']]
            .map(([i, t, h, s]) => `<a href="${h}" class="panel" style="padding:12px;display:flex;flex-direction:column;gap:7px;border-radius:12px">
              <span style="width:30px;height:30px;border-radius:8px;background:rgba(46,230,201,.12);color:var(--accent);display:flex;align-items:center;justify-content:center">${ic(i, 15)}</span>
              <span class="small" style="font-weight:600">${t}</span><span class="tiny muted">${s}</span></a>`).join('')}
        </div>
      </div>
      <div class="card"><div class="section-title"><h3>Recent sales</h3><a href="#/vendor/orders" class="link tiny">All orders</a></div>
        ${DB.orders.filter(o => o.vendorId === v.id).slice(0, 4).length ? DB.orders.filter(o => o.vendorId === v.id).slice(0, 4).map(o => `<div class="row between" style="padding:8px 0;border-bottom:1px dashed var(--border)">
          <div><div class="small" style="font-weight:600">${esc(o.ref)}</div><div class="tiny muted">${o.items[0] ? esc(o.items[0].name) : ''}</div></div>
          <div class="row gap8">${statusBadge(o.status)}<span class="small" style="font-weight:700">${coins(o.totalCoins)} WC</span></div></div>`).join('')
        : `<div class="empty" style="padding:16px"><p>No sales yet. List a product to get started.</p></div>`}
      </div>
    </div>
    <style>@media(max-width:860px){.dash2{grid-template-columns:1fr!important}}</style>`;
}

/* ---------------- company marketplace (vendors) ---------------- */
VIEWS.vendorCompany = undefined;
VIEWS.vendor_company = function () {
  return `<div class="page-head"><div><button class="btn btn-ghost btn-sm mb10" data-nav="#/vendor">${ic('back', 14)} Vendor hub</button>
      <h1>Company Marketplace</h1><p>Wholesale stock for vendors only. Buy with your Whale Coin balance.</p></div>
      <span class="badge badge-accent">${ic('shield', 12)} Wholesale</span></div>
    ${DB.companyProducts.length ? `<div class="grid-products">${DB.companyProducts.map(p => `<div class="product-card">
      ${productThumb(p, 150)}
      <div class="product-body">
        <div class="tiny muted">${esc(p.category)}</div>
        <div class="product-name">${esc(p.name)}</div>
        <div class="price">${coins(p.priceUsd / COIN_USD)} <span class="tiny muted">WC</span></div>
        <div class="tiny muted">${usd(p.priceUsd)} · ${p.stock} in company stock</div>
        <button class="btn btn-primary btn-sm mt6" data-act="buy-company" data-id="${p.id}" ${p.stock > 0 ? '' : 'disabled'}>${ic('box', 14)} ${p.stock > 0 ? 'Buy stock' : 'Out of stock'}</button>
      </div></div>`).join('')}</div>` : `<div class="card empty"><div class="ic">${ic('box', 26)}</div><h3>No wholesale products yet</h3><p>The admin hasn't added company products. Check back soon.</p></div>`}`;
};

App.buyCompany = function (id) {
  const u = me(); const p = DB.companyProducts.find(x => x.id === id);
  if (!p) return;
  const v = vendorOf(u.id); if (!v) return toast('Vendor profile required', 'err');
  openModal(modalShell('Buy stock · ' + p.name, `
    <div class="row gap12 mb16"><div style="width:64px;height:64px;border-radius:12px;overflow:hidden;background:#0b2230;display:flex;align-items:center;justify-content:center;font-size:26px">${p.image ? `<img src="${p.image}" style="width:100%;height:100%;object-fit:cover"/>` : (p.emoji || '📦')}</div>
      <div><div class="small" style="font-weight:650">${esc(p.name)}</div><div class="tiny muted mt6">${coins(p.priceUsd / COIN_USD)} WC each · ${usd(p.priceUsd)}</div><div class="tiny muted">Company stock: ${p.stock}</div></div></div>
    <div class="field"><label class="label">Quantity</label><input class="input" id="bq" type="number" min="1" max="${p.stock}" value="1" inputmode="numeric"/></div>
    <div class="panel" style="padding:12px">
      <div class="between"><span class="tiny muted">Total cost</span><span id="bqTotal" style="font-weight:700">${coins(p.priceUsd / COIN_USD)} WC</span></div>
      <div class="between mt6"><span class="tiny muted">Your balance</span><span class="tiny" style="font-weight:600">${coins(u.balance)} WC</span></div>
      <div class="between mt6"><span class="tiny muted">After purchase</span><span id="bqAfter" class="tiny" style="font-weight:600">${coins(u.balance - p.priceUsd / COIN_USD)} WC</span></div>
    </div>`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="confirm-company" data-id="${p.id}">Confirm purchase</button>`));
  const upd = () => {
    const q = Math.max(1, Math.min(p.stock, Number(document.getElementById('bq').value) || 1));
    const total = p.priceUsd * q / COIN_USD;
    document.getElementById('bqTotal').textContent = coins(total) + ' WC';
    document.getElementById('bqAfter').textContent = coins(u.balance - total) + ' WC';
    document.getElementById('bqAfter').style.color = (u.balance - total) < 0 ? 'var(--danger)' : 'var(--text)';
  };
  document.getElementById('bq').addEventListener('input', upd);
};
App.confirmCompany = function (id) {
  const u = me(); const p = DB.companyProducts.find(x => x.id === id);
  const v = vendorOf(u.id);
  if (!p || !v) return;
  const q = Math.max(1, Math.min(p.stock, Number(document.getElementById('bq').value) || 1));
  const totalUsd = p.priceUsd * q;
  const totalCoins = Math.round(totalUsd / COIN_USD * 100) / 100;
  if (u.balance < totalCoins) return toast('Insufficient balance — deposit Whale Coins first', 'err');
  u.balance = Math.round((u.balance - totalCoins) * 100) / 100;
  p.stock -= q;
  const existing = DB.products.find(x => x.vendorId === v.id && x.companyProductId === p.id && !x.active);
  let inventory;
  if (existing) { existing.stock += q; inventory = existing; }
  else {
    inventory = {
      id: uid('prd'), vendorId: v.id, companyProductId: p.id, name: p.name, category: p.category,
      priceUsd: null, costUsd: p.priceUsd, stock: q, image: p.image, emoji: p.emoji,
      description: p.description, active: false, starUsers: [], stars: 0, createdAt: Date.now()
    };
    DB.products.push(inventory);
  }
  DB.purchases = DB.purchases || [];
  DB.purchases.unshift({
    id: uid('buy'), vendorId: v.id, productId: p.id, companyProductId: p.id,
    inventoryId: inventory.id, name: p.name, qty: q, totalUsd, totalCoins,
    status: 'active', createdAt: Date.now()
  });
  tx(u.id, 'stock', 'Company stock · ' + p.name + ' ×' + q, -totalCoins);
  notify('usr_admin', 'Vendor stock purchase', `@${v.username} bought ${q} × ${p.name} (${coins(totalCoins)} WC).`, '#/admin/products', 'box');
  notify(u.id, 'Stock added to inventory', `${q} × ${p.name} is ready. Set a selling price to publish it.`, '#/vendor/products', 'tag');
  sync(); closeModal(); toast('Stock purchased — set a selling price', 'ok'); go('vendor/products');
};

/* ---------------- vendor products ---------------- */
VIEWS.vendorProducts = function () {
  const u = me(); const v = vendorOf(u.id);
  if (!v) { setTimeout(() => go('vendor'), 10); return ''; }
  const products = DB.products.filter(p => p.vendorId === v.id);
  return `<div class="page-head"><div><button class="btn btn-ghost btn-sm mb10" data-nav="#/vendor">${ic('back', 14)} Vendor hub</button>
      <h1>My products</h1><p>${products.length} item${products.length === 1 ? '' : 's'} in inventory</p></div>
      <a href="#/vendor/company" class="btn btn-primary btn-sm">${ic('plus', 15)} Buy stock</a></div>
    ${products.length ? `<div class="col gap10">${products.map(p => `<div class="card" style="padding:12px;display:flex;gap:12px;align-items:center;flex-wrap:wrap">
      <div style="width:64px;height:64px;border-radius:11px;overflow:hidden;flex:none;background:#0b2230;display:flex;align-items:center;justify-content:center;font-size:26px">${p.image ? `<img src="${p.image}" style="width:100%;height:100%;object-fit:cover"/>` : (p.emoji || '📦')}</div>
      <div class="grow" style="min-width:140px">
        <div class="small" style="font-weight:650">${esc(p.name)}</div>
        <div class="tiny muted mt6">${esc(p.category)} · Stock ${p.stock} · Cost ${coins(p.costUsd / COIN_USD)} WC</div>
        <div class="row gap6 mt6">
          ${p.active && p.stock > 0 ? `<span class="badge badge-success">Live on marketplace</span>` : p.priceUsd ? `<span class="badge badge-warn">Hidden · ${p.stock === 0 ? 'out of stock' : 'paused'}</span>` : `<span class="badge">Not listed</span>`}
          ${p.priceUsd ? `<span class="badge">${coins(p.priceUsd / COIN_USD)} WC · ${usd(p.priceUsd)}</span>` : ''}
        </div>
      </div>
      <div class="row gap6" style="flex-wrap:wrap">
        <button class="btn btn-sm ${p.active ? 'btn-ghost' : 'btn-primary'}" data-act="sell-product" data-id="${p.id}">${p.priceUsd ? ic('edit', 14) : ic('tag', 14)} ${p.priceUsd ? 'Edit listing' : 'Sell'}</button>
        ${p.active ? `<button class="btn btn-sm btn-ghost" data-act="toggle-product" data-id="${p.id}">Pause</button>` : (p.priceUsd ? `<button class="btn btn-sm btn-ghost" data-act="toggle-product" data-id="${p.id}">Publish</button>` : '')}
        <button class="btn-icon" data-act="delete-product" data-id="${p.id}" style="width:34px;height:34px;color:var(--danger)">${ic('trash', 15)}</button>
      </div>
    </div>`).join('')}</div>` : `<div class="card empty"><div class="ic">${ic('tag', 26)}</div><h3>No products yet</h3><p>Buy stock from the Company Marketplace, then set your selling price.</p><a href="#/vendor/company" class="btn btn-primary">${ic('box', 16)} Buy from company</a></div>`}`;
};

App.sellProduct = function (id) {
  const u = me(); const p = DB.products.find(x => x.id === id);
  if (!p) return;
  openModal(modalShell((p.priceUsd ? 'Edit listing' : 'Sell product') + ' · ' + p.name, `
    <div class="field"><label class="label">Selling price (USD)</label>
      <div class="input-wrap"><span class="ic">$</span><input class="input" id="sellUsd" type="number" min="0.5" step="0.5" value="${p.priceUsd || Math.round(p.costUsd * 1.25)}" inputmode="decimal"/></div>
      <div class="help">Auto-converted to Whale Coin at $0.50 per coin.</div></div>
    <div class="panel" style="padding:12px;margin-bottom:14px">
      <div class="between"><span class="tiny muted">Customer pays</span><span id="sellCoins" style="font-weight:700">0 WC</span></div>
      <div class="between mt6"><span class="tiny muted">Your cost</span><span class="tiny">${coins(p.costUsd / COIN_USD)} WC</span></div>
      <div class="between mt6"><span class="tiny muted">Profit per unit</span><span id="sellProfit" class="tiny" style="font-weight:700;color:var(--success)">—</span></div>
    </div>
    <div class="field"><label class="label">Quantity available</label><input class="input" id="sellQty" type="number" min="0" max="${p.stock}" value="${p.stock}" inputmode="numeric"/>
      <div class="help">You hold ${p.stock} in inventory. The listing hides automatically at 0.</div></div>`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="save-listing" data-id="${p.id}">${ic('check', 15)} Publish listing</button>`));
  const upd = () => {
    const usdVal = Number(document.getElementById('sellUsd').value) || 0;
    document.getElementById('sellCoins').textContent = coins(usdVal / COIN_USD) + ' WC';
    document.getElementById('sellProfit').textContent = coins((usdVal - p.costUsd) / COIN_USD) + ' WC';
  };
  document.getElementById('sellUsd').addEventListener('input', upd); upd();
};
App.saveListing = function (id) {
  const u = me(); const p = DB.products.find(x => x.id === id);
  if (!p) return;
  const usdVal = Math.round(Number(document.getElementById('sellUsd').value) * 100) / 100;
  const qty = Math.max(0, Math.min(p.stock, Number(document.getElementById('sellQty').value) || 0));
  if (!(usdVal > 0)) return toast('Enter a selling price', 'err');
  p.priceUsd = usdVal;
  if (qty < p.stock) {
    // keep the unlisted remainder as a separate hidden inventory record
    DB.products.push({
      id: uid('prd'), vendorId: p.vendorId, companyProductId: p.companyProductId,
      name: p.name, category: p.category, priceUsd: null, costUsd: p.costUsd,
      stock: p.stock - qty, image: p.image, emoji: p.emoji, description: p.description,
      active: false, starUsers: [], stars: 0, createdAt: Date.now()
    });
  }
  p.stock = qty;
  p.active = qty > 0;
  sync(); closeModal();
  toast(p.active ? 'Listed on the public marketplace' : 'Listing saved (hidden — no stock)', 'ok');
  render();
};
App.toggleProduct = function (id) {
  const p = DB.products.find(x => x.id === id); if (!p) return;
  p.active = !p.active;
  sync(); toast(p.active ? 'Product published' : 'Product paused', 'ok'); render();
};
App.deleteProduct = async function (id) {
  if (!await confirmDialog({ title: 'Delete product?', body: 'This removes it from your inventory and the marketplace.', danger: true, ok: 'Delete' })) return;
  DB.products = DB.products.filter(p => p.id !== id);
  sync(); render();
};

VIEWS.vendorOrders = function () {
  const u = me(); const v = vendorOf(u.id);
  if (!v) { setTimeout(() => go('vendor'), 10); return ''; }
  const orders = DB.orders.filter(o => o.vendorId === v.id);
  return `<div class="page-head"><div><button class="btn btn-ghost btn-sm mb10" data-nav="#/vendor">${ic('back', 14)} Vendor hub</button>
    <h1>Orders</h1><p>Sales of your listed products.</p></div><span class="badge">${orders.length} total</span></div>
    ${orders.length ? `<div class="col gap10">${orders.map(o => `<div class="card">
      <div class="between wrap gap10"><div><div class="small" style="font-weight:650">${esc(o.ref)}</div><div class="tiny muted mt6">${dateLabel(o.createdAt)}</div></div>
        <div class="row gap8">${statusBadge(o.status)}<span style="font-weight:700">${coins(o.totalCoins)} WC</span></div></div>
      <div class="divider"></div>
      <div class="tiny muted">${o.items.map(i => esc(i.name) + ' ×' + i.qty).join(', ')}</div>
      <div class="row gap8 mt10"><button class="btn btn-sm btn-ghost" data-act="vendor-order-detail" data-id="${o.id}">${ic('eye', 14)} Buyer & delivery</button></div>
    </div>`).join('')}</div>` : `<div class="card empty"><div class="ic">${ic('truck', 26)}</div><h3>No orders yet</h3><p>Your sales will appear here with buyer delivery details.</p></div>`}`;
};
App.vendorOrderDetail = function (id) {
  const o = DB.orders.find(x => x.id === id); if (!o) return;
  openModal(modalShell('Order ' + o.ref, `
    <div class="between mb10">${statusBadge(o.status)}<span style="font-weight:700">${coins(o.totalCoins)} WC</span></div>
    <div class="small" style="font-weight:650;margin-bottom:6px">Buyer delivery details</div>
    <div class="kv"><span class="k">Name</span><span class="v">${esc(o.delivery.fullName)}</span></div>
    <div class="kv"><span class="k">Phone</span><span class="v">${esc(o.delivery.phone)}</span></div>
    <div class="kv"><span class="k">Email</span><span class="v">${esc(o.delivery.email)}</span></div>
    <div class="kv"><span class="k">Country</span><span class="v">${esc(o.delivery.country)}</span></div>
    <div class="kv"><span class="k">Address</span><span class="v" style="max-width:60%">${esc(o.delivery.address)}</span></div>
    <div class="divider"></div>
    ${o.items.map(i => `<div class="between" style="padding:5px 0"><span class="small">${esc(i.name)} ×${i.qty}</span><span class="small muted">${usd(i.priceUsd * i.qty)}</span></div>`).join('')}
    <div class="tiny muted mt10">Delivery and status updates are handled by WhaleChat admin.</div>`,
    `<button class="btn btn-ghost" data-close style="width:100%">Close</button>`));
};

VIEWS.vendorHistory = function () {
  const u = me(); const v = vendorOf(u.id);
  if (!v) { setTimeout(() => go('vendor'), 10); return ''; }
  const sales = DB.orders.filter(o => o.vendorId === v.id);
  const buys = (DB.purchases || []).filter(b => b.vendorId === v.id);
  return `<div class="page-head"><div><button class="btn btn-ghost btn-sm mb10" data-nav="#/vendor">${ic('back', 14)} Vendor hub</button>
    <h1>History</h1><p>Sales and company purchases.</p></div></div>
    <div class="tabs mb16"><button class="tab on" data-hist="sales">Sales history</button><button class="tab" data-hist="buys">Buy history</button></div>
    <div id="histSales">
      <div class="table-wrap"><table class="tbl"><thead><tr><th>Order</th><th>Items</th><th>Status</th><th>Amount</th><th>Date</th></tr></thead><tbody>
      ${sales.length ? sales.map(o => `<tr><td style="font-weight:600">${esc(o.ref)}</td><td class="muted">${o.items.map(i => esc(i.name) + ' ×' + i.qty).join(', ')}</td><td>${statusBadge(o.status)}</td><td style="font-weight:600">${coins(o.totalCoins)} WC</td><td class="muted">${dateLabel(o.createdAt)}</td></tr>`).join('')
        : `<tr><td colspan="5" class="muted center" style="padding:26px">No sales yet</td></tr>`}
      </tbody></table></div>
    </div>
    <div id="histBuys" class="hidden">
      <div class="table-wrap"><table class="tbl"><thead><tr><th>Product</th><th>Qty</th><th>Total</th><th>Status</th><th>Date</th><th style="text-align:right">Action</th></tr></thead><tbody>
      ${buys.length ? buys.map(b => {
        const refund = (DB.refunds || []).find(r => r.purchaseId === b.id);
        const inv = DB.products.find(x => x.id === b.inventoryId);
        const unsold = inv ? inv.stock >= b.qty : false;
        let badge = '<span class="badge">Purchased</span>';
        if (b.status === 'refunded') badge = '<span class="badge badge-success">Refunded</span>';
        else if (refund && refund.status === 'pending') badge = '<span class="badge badge-warn">Refund pending</span>';
        else if (refund && refund.status === 'rejected') badge = '<span class="badge badge-danger">Refund rejected</span>';
        else if (!unsold) badge = '<span class="badge badge-warn">Stock sold</span>';
        let action = '—';
        if (b.status !== 'refunded' && !refund && unsold) action = `<button class="btn btn-xs btn-ghost" data-act="request-refund" data-id="${b.id}">${ic('refresh', 12)} Return / Refund</button>`;
        else if (refund && refund.status === 'pending') action = `<button class="btn btn-xs btn-ghost" data-act="cancel-refund" data-id="${refund.id}">Cancel request</button>`;
        else if (refund && refund.status === 'rejected') action = `<button class="btn btn-xs btn-ghost" data-act="request-refund" data-id="${b.id}">Request again</button>`;
        return `<tr><td style="font-weight:600">${esc(b.name)}</td><td>${b.qty}</td><td>${coins(b.totalCoins)} WC</td><td>${badge}</td><td class="muted">${dateLabel(b.createdAt)}</td><td style="text-align:right">${action}</td></tr>`;
      }).join('')
        : `<tr><td colspan="6" class="muted center" style="padding:26px">No company purchases yet</td></tr>`}
      </tbody></table></div>
    </div>`;
};
AFTER.vendorHistory = function () {
  $$('[data-hist]').forEach(t => t.onclick = () => {
    $$('[data-hist]').forEach(x => x.classList.remove('on')); t.classList.add('on');
    document.getElementById('histSales').classList.toggle('hidden', t.getAttribute('data-hist') !== 'sales');
    document.getElementById('histBuys').classList.toggle('hidden', t.getAttribute('data-hist') !== 'buys');
  });
};
/* route-level after hooks for vendor pages */
AFTER.vendor = function (parts) {
  const createBtn = document.getElementById('createVendorBtn');
  if (createBtn) createBtn.onclick = () => App.createVendor();
  const applyBtn = document.getElementById('applyVendorBtn');
  if (applyBtn) applyBtn.onclick = () => App.applyVendor();
  const renewBtn = document.getElementById('renewVendorBtn');
  if (renewBtn) renewBtn.onclick = () => App.applyVendorRenew();
  if (parts[1] === 'history' && typeof AFTER.vendorHistory === 'function') AFTER.vendorHistory(parts);
};

function adminSupportView() {
  return `<div class="card empty"><h3>You are signed in as the administrator</h3><p>Open the management console for users, vendors, orders and payments.</p><a href="#/admin" class="btn btn-primary">Go to admin console</a></div>`;
}


/* ---------------- company purchase refunds (vendor side) ---------------- */
App.requestRefund = function (purchaseId) {
  const u = me(); const v = vendorOf(u.id);
  const b = (DB.purchases || []).find(x => x.id === purchaseId && x.vendorId === (v && v.id));
  if (!b) return toast('Purchase not found', 'err');
  if (b.status === 'refunded') return toast('This purchase is already refunded', 'err');
  const pending = (DB.refunds || []).find(r => r.purchaseId === b.id && r.status === 'pending');
  if (pending) return toast('A refund request is already pending', 'err');
  const inv = DB.products.find(x => x.id === b.inventoryId);
  if (!inv || inv.stock < b.qty) return toast('Some units were already sold or listed — refund unavailable', 'err');
  openModal(modalShell('Return & refund · ' + b.name, `
    <div class="row gap12 mb16">
      <div style="width:56px;height:56px;border-radius:12px;background:var(--surface-2);display:flex;align-items:center;justify-content:center;font-size:24px">${inv.emoji || '📦'}</div>
      <div><div class="small" style="font-weight:650">${esc(b.name)} × ${b.qty}</div>
        <div class="tiny muted mt6">Paid ${coins(b.totalCoins)} WC · ${usd(b.totalUsd)}</div></div>
    </div>
    <div class="panel" style="padding:12px;margin-bottom:14px">
      <div class="tiny" style="font-weight:600;color:var(--accent)">How refunds work</div>
      <div class="tiny muted mt6" style="line-height:1.7">The admin reviews your request. If approved, the unsold units return to the company stock and the full amount is credited back to your Whale Coin balance.</div>
    </div>
    <div class="field"><label class="label">Reason (optional)</label>
      <textarea class="input" id="refundReason" style="min-height:80px" placeholder="Why are you returning this stock?"></textarea></div>`,
    `<button class="btn btn-ghost" data-close>Cancel</button>
     <button class="btn btn-primary" data-act="submit-refund" data-id="${b.id}">${ic('refresh', 15)} Request refund</button>`), { width: '460px' });
};
App.submitRefund = function (purchaseId) {
  const u = me(); const v = vendorOf(u.id);
  const b = (DB.purchases || []).find(x => x.id === purchaseId && x.vendorId === (v && v.id));
  if (!b) return;
  const reason = (document.getElementById('refundReason') || {}).value || '';
  const inv = DB.products.find(x => x.id === b.inventoryId);
  if (!inv || inv.stock < b.qty) return toast('Stock already sold — refund unavailable', 'err');
  DB.refunds = DB.refunds || [];
  DB.refunds.unshift({
    id: uid('rfd'), purchaseId: b.id, vendorId: v.id, companyProductId: b.companyProductId,
    inventoryId: b.inventoryId, name: b.name, qty: b.qty, coins: b.totalCoins, usd: b.totalUsd,
    reason: String(reason).slice(0, 400), status: 'pending', createdAt: Date.now()
  });
  notify('usr_admin', 'Refund request', `@${v.username} requested a refund for ${b.qty} × ${b.name} (${coins(b.totalCoins)} WC).`, '#/admin/refunds', 'refresh');
  notify(u.id, 'Refund requested', 'Your request is pending admin review.', '#/vendor/history', 'refresh');
  sync(); closeModal(); toast('Refund request submitted', 'ok'); render();
};
App.cancelRefund = async function (refundId) {
  const r = (DB.refunds || []).find(x => x.id === refundId);
  if (!r) return;
  if (!await confirmDialog({ title: 'Cancel refund request?', body: 'You can submit a new request later.', danger: true, ok: 'Cancel request' })) return;
  DB.refunds = DB.refunds.filter(x => x.id !== refundId);
  sync(); toast('Refund request cancelled', 'ok'); render();
};
/* =========================================================================
   Wallet, deposits, withdrawals, referrals, profile, settings, notifications
   ========================================================================= */

/* ---------------- bonuses / tasks ---------------- */
async function bonusCodeHash(code) {
  const raw = 'bonus::v1::' + String(code || '').trim().toUpperCase();
  try {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(raw));
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
  } catch (e) { return 'fb' + fnv(raw); }
}

VIEWS.bonuses = function () {
  const u = me();
  const list = (DB.bonuses || []).filter(b => b.active !== false);
  const claims = DB.bonusClaims || [];
  const claimed = new Set(claims.filter(c => c.userId === u.id && c.status === 'claimed').map(c => c.bonusId));
  return `<div class="page-head"><div><button class="btn btn-ghost btn-sm mb10" data-nav="#/profile">${ic('back', 14)} Account</button>
      <h1>Check Bonuses</h1><p>Complete a task, get your code from support, and redeem your reward.</p></div></div>
    ${list.length ? `<div class="col gap12">${list.map(b => {
      const done = claimed.has(b.id);
      const coinsValue = Math.round((Number(b.rewardUsd) || 0) / COIN_USD * 100) / 100;
      return `<div class="card bonus-card">
        <div class="between gap10 wrap" style="align-items:flex-start">
          <div class="grow" style="min-width:0">
            <div class="row gap8" style="align-items:center;flex-wrap:wrap">
              <h3 style="font-size:16px">${esc(b.title)}</h3>
              <span class="badge ${done ? 'badge-success' : 'badge-accent'}">${done ? 'Claimed' : 'Available'}</span>
            </div>
            <p class="small muted mt8" style="line-height:1.65">${esc(b.description || '')}</p>
            ${b.taskUrl ? `<a class="btn btn-ghost btn-sm mt12" href="${esc(b.taskUrl)}" target="_blank" rel="noopener">${ic('link', 14)} ${esc(b.taskLabel || 'Do the task')}</a>` : ''}
          </div>
          <div style="text-align:right;flex:none">
            <div style="font-size:24px;font-weight:800;letter-spacing:-.02em;color:var(--accent)">${usd(b.rewardUsd)}</div>
            <div class="tiny muted">${coins(coinsValue)} WC</div>
          </div>
        </div>
        <div class="row gap8 mt14 wrap">
          ${done
            ? `<span class="badge badge-success">${ic('check', 12)} Reward credited</span>`
            : `<button class="btn btn-primary btn-sm" data-act="claim-bonus" data-id="${b.id}">${ic('gift', 14)} Claim</button>`}
          ${b.taskUrl ? `<span class="tiny muted" style="align-self:center">Complete the task first, then contact support for your code.</span>` : ''}
        </div>
      </div>`;
    }).join('')}</div>` : `<div class="empty"><div class="ic">${ic('gift', 26)}</div><h3>No bonuses right now</h3><p>New tasks will appear here. Check back soon.</p></div>`}
    <div class="panel mt16" style="padding:12px 14px"><div class="tiny muted" style="line-height:1.7">
      <b style="color:var(--text)">How it works:</b> complete the task → contact support → receive a one-time code → enter it under Claim. Codes are single-use and tied to your account.
    </div></div>`;
};

App.claimBonus = function (id) {
  const b = (DB.bonuses || []).find(x => x.id === id);
  if (!b) return;
  openModal(modalShell('Claim “' + b.title + '”', `
    <div class="panel" style="padding:13px">
      <div class="between"><span class="tiny muted">Reward</span><span class="small" style="font-weight:700;color:var(--accent)">${usd(b.rewardUsd)}</span></div>
    </div>
    <div class="field mt16"><label class="label">Redeem code</label>
      <input class="input" id="bonCode" placeholder="Enter your code" autocomplete="off" style="text-transform:uppercase;letter-spacing:.08em;font-weight:700"/>
      <div class="help">To get your code, please complete the task and contact Support.</div></div>
    <div class="tiny muted" style="line-height:1.6">Each code can be used once and only on the account it was issued to.</div>`,
    `<button class="btn btn-ghost" data-close>Cancel</button>
     <button class="btn btn-primary" data-act="claim-bonus-submit" data-id="${b.id}">${ic('check', 15)} Submit</button>`), { width: '460px' });
  setTimeout(() => { const i = document.getElementById('bonCode'); if (i) i.focus(); }, 90);
};

App.claimBonusSubmit = async function (id) {
  const el = document.getElementById('bonCode');
  const code = ((el && el.value) || '').trim().toUpperCase();
  if (!code) return toast('Enter your redeem code', 'err');
  const btn = document.querySelector('[data-act="claim-bonus-submit"]');
  if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner"></span> Checking…'; }
  if (Remote.enabled) {
    try {
      const res = await fetch(Remote.url('/api/bonus/claim'), { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ userId: me().id, bonusId: id, code }) });
      const d = await res.json().catch(() => null);
      if (res.ok && d && d.ok) {
        closeModal();
        toast('Bonus Credited Successfully! 🎁', 'ok');
        await Remote.refresh(true);
        render();
        return;
      }
      if (btn) { btn.disabled = false; btn.innerHTML = 'Submit'; }
      return toast((d && (d.message || d.error)) || 'Invalid or already used code', 'err');
    } catch (e) {}
  }
  // local / offline fallback
  const hash = await bonusCodeHash(code);
  const u = me();
  const claim = (DB.bonusClaims || []).find(c => c.codeHash === hash && c.userId === u.id && c.bonusId === id && c.status !== 'claimed');
  if (!claim) { if (btn) { btn.disabled = false; btn.innerHTML = 'Submit'; } return toast('Invalid or already used code', 'err'); }
  const b = (DB.bonuses || []).find(x => x.id === id);
  if (!b) return toast('This bonus no longer exists', 'err');
  claim.status = 'claimed'; claim.claimedAt = Date.now();
  const coinsAmt = Math.round((Number(b.rewardUsd) || 0) / COIN_USD * 100) / 100;
  u.balance = Math.round((Number(u.balance || 0) + coinsAmt) * 100) / 100;
  u.totalEarnings = Math.round((Number(u.totalEarnings || 0) + coinsAmt) * 100) / 100;
  tx(u.id, 'bonus', 'Task bonus · ' + b.title, coinsAmt, { bonusId: b.id, claimId: claim.id });
  notify(u.id, 'Bonus credited 🎁', b.title + ' · ' + coins(coinsAmt) + ' WC added to your balance.', '#/bonuses', 'gift');
  sync(); closeModal(); toast('Bonus Credited Successfully! 🎁', 'ok'); render();
};

VIEWS.wallet = function () {
  const u = me();
  const txs = DB.txs.filter(t => t.userId === u.id);
  const pendingDep = DB.deposits.filter(d => d.userId === u.id && d.status === 'pending');
  const pendingWd = DB.withdrawals.filter(w => w.userId === u.id && w.status === 'pending');
  return `<div class="page-head"><div><h1>Wallet</h1><p>Your Whale Coin balance, deposits and withdrawals.</p></div>
      <a href="#/referrals" class="btn btn-ghost btn-sm">${ic('gift', 15)} Invite & earn</a></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px" class="wallet-grid">
      <div class="wallet-card">
        <div class="between"><div class="tiny" style="opacity:.8;letter-spacing:.08em;font-weight:700">WHALE COIN BALANCE</div>${ic('wallet', 20)}</div>
        <div class="row" style="gap:8px;align-items:baseline;margin-top:8px"><span class="wallet-bal">${coins(u.balance)}</span><span class="small" style="opacity:.8">WC</span></div>
        <div class="small" style="opacity:.8;margin-top:4px">≈ ${usd(coinsToUsd(u.balance))} USD <span style="opacity:.6">· 1 WC = $0.50</span></div>
        <div class="wallet-actions">
          <a href="#/deposit" class="btn">${ic('plus', 14)} Deposit</a>
          <a href="#/withdraw" class="btn">${ic('download', 14)} Withdraw</a>
          <a href="#/referrals" class="btn">${ic('gift', 14)} Invite</a>
        </div>
      </div>
      <div class="grid-kpi" style="grid-template-columns:1fr 1fr">
        ${[['Total deposits', coins(u.totalDeposits || 0) + ' WC', 'wallet'], ['Total withdrawals', coins(u.totalWithdrawals || 0) + ' WC', 'download'],
           ['Total earnings', coins(u.totalEarnings || 0) + ' WC', 'trend'], ['Referral code', u.referralCode, 'gift']]
          .map(([k, v, i]) => `<div class="kpi"><div class="ic">${ic(i, 15)}</div><div class="v" style="font-size:17px">${v}</div><div class="k">${k}</div></div>`).join('')}
      </div>
    </div>
    ${pendingDep.length || pendingWd.length ? `<div class="card mt16">
      <div class="section-title"><h3>Pending requests</h3><span class="badge badge-warn">${pendingDep.length + pendingWd.length}</span></div>
      ${pendingDep.map(d => `<div class="between" style="padding:9px 0;border-bottom:1px dashed var(--border)"><div><div class="small" style="font-weight:600">Deposit · ${coins(d.coins)} WC</div><div class="tiny muted">${esc(d.methodName || d.method)} · ${timeAgo(d.createdAt)} ago</div></div>${statusBadge('pending')}</div>`).join('')}
      ${pendingWd.map(w => `<div class="between" style="padding:9px 0;border-bottom:1px dashed var(--border)"><div><div class="small" style="font-weight:600">Withdrawal · ${coins(w.coins)} WC</div><div class="tiny muted">${esc(w.network)} · ${esc(w.address.slice(0, 10))}… · ${timeAgo(w.createdAt)} ago</div></div>${statusBadge('pending')}</div>`).join('')}
    </div>` : ''}
    <div class="card mt16">
      <div class="section-title"><h3>Activity</h3><span class="tiny muted">${txs.length} transactions</span></div>
      ${txs.length ? `<div class="list">${txs.slice(0, 40).map(t => {
        const pos = t.coins >= 0;
        const iconMap = { deposit: 'wallet', withdrawal: 'download', purchase: 'bag', sale: 'trend', stock: 'box', referral: 'gift', refund: 'refresh' };
        return `<div class="list-item">
          <div style="width:34px;height:34px;border-radius:10px;background:${pos ? 'rgba(47,214,166,.12)' : 'rgba(255,95,116,.1)'};color:${pos ? 'var(--success)' : 'var(--danger)'};display:flex;align-items:center;justify-content:center;flex:none">${ic(iconMap[t.type] || 'wallet', 15)}</div>
          <div class="grow" style="min-width:0"><div class="small" style="font-weight:600">${esc(t.label)}</div><div class="tiny muted">${timeAgo(t.createdAt)} ago · ${dateLabel(t.createdAt)}</div></div>
          <div style="text-align:right"><div class="small" style="font-weight:700;color:${pos ? 'var(--success)' : 'var(--text)'}">${pos ? '+' : ''}${coins(t.coins)}</div><div class="tiny muted">WC</div></div>
        </div>`;
      }).join('')}</div>` : `<div class="empty" style="padding:26px"><p>No wallet activity yet. Deposit Whale Coin to get started.</p><a href="#/deposit" class="btn btn-primary">Deposit now</a></div>`}
    </div>
    <style>@media(max-width:860px){.wallet-grid{grid-template-columns:1fr!important}}</style>`;
};

/* ---------------- deposit ---------------- */
let DEP_METHOD = null;
VIEWS.deposit = function () {
