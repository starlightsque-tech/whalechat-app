<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<script async src="https://www.googletagmanager.com/gtm.js?id=GTM-5WNCBL8N"></script><script>window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#04101a" />
<title>WhaleChat — Chat, shop and get paid</title>
<meta name="description" content="WhaleChat brings your conversations, your store and your wallet together — with referral rewards for every friend you invite." />
<link rel="manifest" href="manifest.webmanifest" />
<link rel="icon" type="image/png" href="data:image/png;base64," />
<link rel="apple-touch-icon" href="data:image/png;base64," />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="WhaleChat" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --font:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --display:'Sora','Inter',sans-serif;
  --bg:#04101a; --bg-soft:#071725; --surface:#0a1a28; --surface-2:#0f2333; --surface-3:#143044;
  --border:rgba(255,255,255,.085); --border-strong:rgba(255,255,255,.16);
  --text:#e9f4f9; --muted:#8ba4b6; --muted-2:#63798a;
  --accent:#2ee6c9; --accent-ink:#03221d; --accent-2:#3aa0ff;
  --gold:#ffc861; --danger:#ff5f74; --warn:#ffb020; --success:#2fd6a6;
  --grad: linear-gradient(135deg,#2ee6c9 0%,#37c6e8 55%,#3aa0ff 100%);
  --shadow: 0 18px 50px -18px rgba(0,0,0,.85);
  --r:18px; --r-sm:12px; --r-lg:26px;
  --nav-h:70px; --top-h:64px;
  color-scheme: dark;
}
html[data-theme="light"]{
  --bg:#f2f7fa; --bg-soft:#e9f1f6; --surface:#ffffff; --surface-2:#f6fafc; --surface-3:#eaf3f8;
  --border:rgba(9,40,56,.10); --border-strong:rgba(9,40,56,.18);
  --text:#06202c; --muted:#5a7282; --muted-2:#7d92a0;
  --accent:#00b39a; --accent-ink:#ffffff; --accent-2:#1779d4;
  --gold:#b98112; --danger:#d93b52; --warn:#b47100; --success:#0a9c78;
  --grad: linear-gradient(135deg,#00c9ae 0%,#00b1d8 55%,#1d7fe0 100%);
  --shadow: 0 18px 44px -22px rgba(10,45,64,.45);
  color-scheme: light;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{
  margin:0;font-family:var(--font);background:var(--bg);color:var(--text);
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  overscroll-behavior-y:none;
}
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(900px 520px at 12% -8%, rgba(46,230,201,.10), transparent 60%),
    radial-gradient(760px 500px at 105% 8%, rgba(58,160,255,.10), transparent 62%);
}
html[data-theme="light"] body::before{
  background:
    radial-gradient(900px 520px at 12% -8%, rgba(0,179,154,.10), transparent 60%),
    radial-gradient(760px 500px at 105% 8%, rgba(23,121,212,.10), transparent 62%);
}
h1,h2,h3,h4,h5{margin:0;font-family:var(--display);letter-spacing:-.02em;font-weight:700}
p{margin:0}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:0;background:none;color:inherit}
input,select,textarea{font-family:inherit;font-size:15px;color:var(--text)}
img{display:block;max-width:100%}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-thumb{background:rgba(140,170,190,.28);border-radius:99px;border:2px solid transparent;background-clip:content-box}
::-webkit-scrollbar-track{background:transparent}
.hidden{display:none!important}
.mono{font-variant-numeric:tabular-nums}
.muted{color:var(--muted)}
.small{font-size:12.5px}
.tiny{font-size:11.5px}
.center{text-align:center}
.row{display:flex;align-items:center;gap:10px}
.between{display:flex;align-items:center;justify-content:space-between;gap:12px}
.col{display:flex;flex-direction:column}
.grow{flex:1;min-width:0}
.wrap{flex-wrap:wrap}
.ellipsis{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mt6{margin-top:6px}.mt10{margin-top:10px}.mt16{margin-top:16px}.mt22{margin-top:22px}.mt28{margin-top:28px}
.mb10{margin-bottom:10px}.mb16{margin-bottom:16px}
.gap6{gap:6px}.gap14{gap:14px}.gap18{gap:18px}
.hide-desktop{display:none}
@media(max-width:1023px){.hide-mobile{display:none!important}.hide-desktop{display:flex}}

/* ============ Brand ============ */
.brand{display:flex;align-items:center;gap:10px}
.brand img{width:36px;height:36px;border-radius:50%;box-shadow:0 0 0 1px rgba(46,230,201,.35),0 8px 22px -8px rgba(46,230,201,.5)}
.brand-name{font-family:var(--display);font-weight:700;font-size:19px;letter-spacing:-.03em}
.brand-name b{color:var(--accent);font-weight:700}

/* ============ Buttons ============ */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 18px;border-radius:12px;
  font-weight:600;font-size:14.5px;border:1px solid transparent;transition:.16s ease;white-space:nowrap;user-select:none}
.btn:active{transform:translateY(1px) scale(.995)}
.btn-primary{background:var(--grad);color:var(--accent-ink);box-shadow:0 10px 26px -12px rgba(46,230,201,.7)}
.btn-primary:hover{filter:brightness(1.06)}
.btn-ghost{background:var(--surface-2);border-color:var(--border);color:var(--text)}
.btn-ghost:hover{background:var(--surface-3);border-color:var(--border-strong)}
.btn-soft{background:rgba(46,230,201,.12);color:var(--accent);border-color:rgba(46,230,201,.22)}
html[data-theme="light"] .btn-soft{background:rgba(0,179,154,.1)}
.btn-danger{background:rgba(255,95,116,.13);color:var(--danger);border-color:rgba(255,95,116,.28)}
.btn-dark{background:#0b1c2a;color:#fff;border-color:rgba(255,255,255,.08)}
.btn-sm{height:36px;padding:0 13px;font-size:13px;border-radius:10px}
.btn-xs{height:29px;padding:0 10px;font-size:12px;border-radius:8px}
.btn-lg{height:52px;font-size:16px;border-radius:14px;padding:0 24px}
.btn-block{width:100%}
.btn-icon{width:40px;height:40px;padding:0;border-radius:11px;display:inline-flex;align-items:center;justify-content:center;
  background:var(--surface-2);border:1px solid var(--border);color:var(--text);flex:none}
.btn-icon:hover{background:var(--surface-3)}
.btn[disabled],.btn-icon[disabled]{opacity:.5;pointer-events:none}
.link{color:var(--accent);font-weight:600;cursor:pointer}
.link:hover{text-decoration:underline}

/* ============ Forms ============ */
.field{display:flex;flex-direction:column;gap:7px;margin-bottom:14px}
.label{font-size:12.5px;font-weight:600;color:var(--muted);letter-spacing:.01em}
.input,select.input,textarea.input{
  width:100%;height:47px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border);
  padding:0 14px;outline:none;transition:.16s;font-size:15px}
textarea.input{height:auto;min-height:96px;padding:12px 14px;resize:vertical;line-height:1.5}
.input:focus{border-color:rgba(46,230,201,.6);background:var(--surface-3);box-shadow:0 0 0 3px rgba(46,230,201,.12)}
html[data-theme="light"] .input:focus{box-shadow:0 0 0 3px rgba(0,179,154,.13)}
.input::placeholder{color:var(--muted-2)}
.input-wrap{position:relative;display:flex;align-items:center}
.input-wrap .ic{position:absolute;left:14px;color:var(--muted);pointer-events:none;display:flex}
.input-wrap .input{padding-left:42px}
.input-wrap .eye{position:absolute;right:8px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:8px;color:var(--muted)}
.input-wrap .eye:hover{background:var(--surface-3);color:var(--text)}
.help{font-size:11.5px;color:var(--muted-2)}
.err{font-size:12.5px;color:var(--danger);margin-top:-4px}
.checkline{display:flex;gap:9px;align-items:flex-start;font-size:12.5px;color:var(--muted);line-height:1.5}
.checkline input{margin-top:2px;accent-color:var(--accent)}
.switch{position:relative;width:46px;height:26px;border-radius:99px;background:var(--surface-3);border:1px solid var(--border);
  transition:.2s;flex:none;cursor:pointer}
.switch::after{content:"";position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;transition:.2s;box-shadow:0 2px 6px rgba(0,0,0,.3)}
.switch.on{background:var(--accent);border-color:transparent}
.switch.on::after{left:22px;background:#062b25}

/* ============ Cards ============ */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:18px;box-shadow:0 1px 0 rgba(255,255,255,.03) inset}
.card-hover{transition:.18s;cursor:pointer}
.card-hover:hover{transform:translateY(-2px);border-color:var(--border-strong);box-shadow:var(--shadow)}
.card-title{font-size:15px;font-weight:650;font-family:var(--display);letter-spacing:-.01em}
.panel{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r)}
.divider{height:1px;background:var(--border);margin:14px 0}
.badge{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;padding:3px 8px;border-radius:99px;
  background:var(--surface-3);color:var(--muted);border:1px solid var(--border);white-space:nowrap}
.badge-accent{background:rgba(46,230,201,.14);color:var(--accent);border-color:rgba(46,230,201,.25)}
.badge-warn{background:rgba(255,176,32,.14);color:var(--warn);border-color:rgba(255,176,32,.25)}
.badge-danger{background:rgba(255,95,116,.14);color:var(--danger);border-color:rgba(255,95,116,.25)}
.badge-success{background:rgba(47,214,166,.14);color:var(--success);border-color:rgba(47,214,166,.25)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--success);display:inline-block;flex:none}
.dot.grey{background:var(--muted-2)}
.avatar{width:44px;height:44px;border-radius:50%;object-fit:cover;background:var(--surface-3);flex:none;display:flex;align-items:center;justify-content:center;
  font-weight:700;color:var(--accent);border:1px solid var(--border);overflow:hidden;font-size:15px}
.avatar img{width:100%;height:100%;object-fit:cover}
.avatar.sm{width:34px;height:34px;font-size:12px}
.avatar.lg{width:78px;height:78px;font-size:26px}
.avatar.xl{width:104px;height:104px;font-size:34px}
@media(max-width:560px){.avatar.xl{width:82px;height:82px;font-size:26px}}
.avatar-ring{box-shadow:0 0 0 2px var(--bg),0 0 0 4px rgba(46,230,201,.55)}
.status-dot{position:absolute;right:-1px;bottom:-1px;width:12px;height:12px;border-radius:50%;background:var(--success);border:2.5px solid var(--surface)}

/* ============ Auth ============ */
.auth{min-height:100dvh;display:grid;grid-template-columns:1.05fr .95fr;position:relative;z-index:1}
.auth-art{position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;padding:38px 44px;
  background:#041019;border-right:1px solid var(--border)}
.auth-art img.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.62;transform:scale(1.02)}
.auth-art::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,16,25,.72) 0%,rgba(4,16,25,.35) 40%,rgba(4,16,25,.94) 100%)}
.auth-art>*{position:relative;z-index:2}
.auth-hero h1{font-size:clamp(34px,3.4vw,54px);line-height:1.04;color:#f2fbff;max-width:12ch}
.auth-hero p{margin-top:16px;color:#a9c3d3;max-width:36ch;line-height:1.65;font-size:15px}
.auth-feats{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}
.auth-feat{display:flex;align-items:center;gap:7px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
  padding:7px 12px;border-radius:99px;font-size:12px;color:#d6e9f3;backdrop-filter:blur(8px)}
.auth-form-wrap{display:flex;align-items:center;justify-content:center;padding:34px 22px;background:var(--bg)}
.auth-card{width:100%;max-width:432px}
.auth-card h2{font-size:27px;margin-bottom:6px}
.auth-card .sub{color:var(--muted);font-size:14px;margin-bottom:22px;line-height:1.5}
.auth-foot{margin-top:18px;text-align:center;font-size:13.5px;color:var(--muted)}
.auth-mobile-logo{display:none;margin-bottom:22px}
@media(max-width:900px){
  .auth{grid-template-columns:1fr}
  .auth-art{display:none}
  .auth-form-wrap{padding:22px 16px 36px;align-items:flex-start}
  .auth-mobile-logo{display:flex;justify-content:center}
  .auth-card{padding-top:6px}
}
.steps{display:flex;gap:6px;margin-bottom:18px}
.steps i{height:3px;flex:1;border-radius:99px;background:var(--surface-3)}
.steps i.on{background:var(--accent)}

/* ============ Shell ============ */
.shell{display:flex;height:100dvh;position:relative;z-index:1;overflow:hidden}
.sidebar{width:248px;flex:none;border-right:1px solid var(--border);background:rgba(7,22,34,.72);backdrop-filter:blur(14px);
  display:flex;flex-direction:column;padding:20px 14px;gap:6px}
html[data-theme="light"] .sidebar{background:rgba(255,255,255,.8)}
.side-brand{padding:2px 8px 18px}
.nav-item{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:11px;color:var(--muted);font-size:14px;font-weight:550;
  transition:.15s;position:relative}
.nav-item:hover{background:var(--surface-2);color:var(--text)}
.nav-item.on{background:rgba(46,230,201,.11);color:var(--accent)}
html[data-theme="light"] .nav-item.on{background:rgba(0,179,154,.10)}
.nav-item.on::before{content:"";position:absolute;left:0;top:9px;bottom:9px;width:3px;border-radius:0 4px 4px 0;background:var(--accent)}
.nav-item .nbadge{margin-left:auto;background:var(--danger);color:#fff;font-size:10.5px;font-weight:700;min-width:18px;height:18px;
  border-radius:99px;display:flex;align-items:center;justify-content:center;padding:0 5px}
.side-foot{margin-top:auto;display:flex;flex-direction:column;gap:8px}
.side-user{display:flex;align-items:center;gap:10px;padding:9px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border);cursor:pointer}
.main{flex:1;display:flex;flex-direction:column;min-width:0;position:relative}
.topbar{height:var(--top-h);flex:none;display:flex;align-items:center;gap:12px;padding:0 20px;border-bottom:1px solid var(--border);
  background:rgba(6,19,30,.72);backdrop-filter:blur(16px);position:sticky;top:0;z-index:20}
html[data-theme="light"] .topbar{background:rgba(255,255,255,.78)}
.topbar .brand{display:none}
@media(max-width:1023px){.topbar .brand{display:flex}}
.topbar-search{flex:1;max-width:420px}
.content{flex:1;overflow-y:auto;overflow-x:hidden;padding:22px 24px 120px;scroll-behavior:smooth}
.content.nopad{padding:0}
.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:18px;flex-wrap:wrap}
.page-head h1{font-size:23px;letter-spacing:-.03em}
.page-head p{color:var(--muted);font-size:13.5px;margin-top:4px}
.bottomnav{display:none}
@media(max-width:1023px){
  .sidebar{display:none}
  .shell{height:100dvh}
  .content{padding:16px 14px calc(var(--nav-h) + 104px)}
  .bottomnav{display:flex;position:fixed;left:0;right:0;bottom:0;height:calc(var(--nav-h) + env(safe-area-inset-bottom));
    padding-bottom:env(safe-area-inset-bottom);z-index:40;background:rgba(6,20,31,.92);backdrop-filter:blur(20px);
    border-top:1px solid var(--border);align-items:center;justify-content:space-around}
  html[data-theme="light"] .bottomnav{background:rgba(255,255,255,.94)}
  .bnav{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:10px;color:var(--muted);padding:8px 6px;flex:1;position:relative;font-weight:600}
  .bnav.on{color:var(--accent)}
  .bnav .nbadge{position:absolute;top:2px;right:50%;transform:translateX(14px);background:var(--danger);color:#fff;font-size:9.5px;
    min-width:16px;height:16px;border-radius:99px;display:flex;align-items:center;justify-content:center;padding:0 4px}
  .main.chat-mode .topbar{display:none}
  .main.chat-mode .bottomnav{display:none}
  .main.chat-mode .content{padding:0;height:100dvh}
  .topbar{padding:0 12px;gap:8px}
  .topbar .brand img{width:30px;height:30px}
  .topbar .brand .brand-name{font-size:16px}
  .hero-card{padding:18px}
  .hero-card .wb{width:140px;opacity:.16;right:-26px;bottom:-20px}
}
@media(max-width:768px){
  .topbar-search{display:none}
  .chip-row{flex-wrap:nowrap;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
  .chip-row::-webkit-scrollbar{display:none}
}
@media(max-width:560px){
  .topbar .brand .brand-name{display:none}
  .page-head h1{font-size:21px}
  .bottomnav .bnav span{font-size:9.5px}
}

/* ============ Home layout ============ */
.home-grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:22px}
@media(max-width:1279px){.home-grid{grid-template-columns:1fr}.home-side{display:none}}
.hero-card{position:relative;overflow:hidden;border-radius:22px;padding:24px;border:1px solid var(--border);
  background:linear-gradient(115deg,rgba(46,230,201,.16),rgba(58,160,255,.10) 55%,rgba(10,26,40,.4));}
.hero-card .wb{position:absolute;right:-10px;bottom:-28px;width:210px;opacity:.30;pointer-events:none;border-radius:20px;filter:saturate(1.2)}
.hero-card h2{font-size:22px}
.hero-card p{color:var(--muted);font-size:13.5px;margin-top:6px;max-width:44ch}
.chip-row{display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:7px 12px;border-radius:99px;background:var(--surface-2);border:1px solid var(--border);font-size:12.5px;font-weight:600;color:var(--muted);cursor:pointer}
.chip.on{background:rgba(46,230,201,.14);border-color:rgba(46,230,201,.35);color:var(--accent)}
.searchbar{display:flex;align-items:center;gap:9px;height:42px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border);padding:0 13px;color:var(--muted)}
.searchbar input{background:none;border:0;outline:none;flex:1;font-size:14px;min-width:0}

/* Chats */
.chat-list{display:flex;flex-direction:column}
.chat-item{display:flex;gap:12px;align-items:center;padding:11px 12px;border-radius:14px;cursor:pointer;transition:.14s}
.chat-item:hover{background:var(--surface-2)}
.chat-item .meta{flex:1;min-width:0}
.chat-item .nm{font-weight:600;font-size:14.5px;display:flex;align-items:center;gap:6px}
.chat-item .pv{font-size:12.5px;color:var(--muted);margin-top:3px;display:flex;align-items:center;gap:5px}
.chat-item .right{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:5px;flex:none}
.chat-item .time{font-size:11px;color:var(--muted-2)}
.unread{background:var(--accent);color:var(--accent-ink);font-size:10.5px;font-weight:800;min-width:19px;height:19px;border-radius:99px;
  display:flex;align-items:center;justify-content:center;padding:0 6px}
.avatar-wrap{position:relative;flex:none}
.status-circles{display:flex;gap:14px;overflow-x:auto;padding:4px 2px 12px;scrollbar-width:none}
.status-circles::-webkit-scrollbar{display:none}
.story{display:flex;flex-direction:column;align-items:center;gap:6px;width:70px;flex:none;cursor:pointer}
.story .ring{padding:2.5px;border-radius:50%;background:conic-gradient(from 210deg,var(--accent),#3aa0ff,var(--accent));position:relative}
.story .ring.seen{background:var(--surface-3)}
.story .ring .avatar{width:56px;height:56px;border:3px solid var(--bg)}
.story span{font-size:10.5px;color:var(--muted);max-width:66px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.story.add .ring{background:var(--surface-2);border:1px dashed var(--border-strong)}
.story.add .plus{width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--accent);border:3px solid var(--bg);background:var(--surface-2)}

/* Chat room */
.chat-room{display:flex;flex-direction:column;height:100%;background:var(--bg);position:relative}
.chat-head{display:flex;align-items:center;gap:11px;padding:10px 16px;border-bottom:1px solid var(--border);background:var(--surface);flex:none;z-index:5}
.chat-body{flex:1;overflow-y:auto;padding:18px 16px 10px;display:flex;flex-direction:column;gap:4px;
  background-image:radial-gradient(rgba(120,170,190,.055) 1px,transparent 1px);background-size:18px 18px}
.day-sep{align-self:center;font-size:10.5px;font-weight:600;color:var(--muted);background:var(--surface-2);padding:4px 10px;border-radius:99px;margin:10px 0 8px;border:1px solid var(--border)}
.msg{max-width:min(76%,540px);padding:8px 11px 7px;border-radius:14px;position:relative;font-size:14.3px;line-height:1.45;
  animation:pop .18s ease;word-wrap:break-word}
@keyframes pop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.msg.out{align-self:flex-end;background:linear-gradient(135deg,rgba(46,230,201,.22),rgba(58,160,255,.18));border:1px solid rgba(46,230,201,.22);border-bottom-right-radius:5px}
.msg.in{align-self:flex-start;background:var(--surface-2);border:1px solid var(--border);border-bottom-left-radius:5px}
.msg .txt{white-space:pre-wrap}
.msg .meta{display:flex;align-items:center;gap:4px;justify-content:flex-end;font-size:10px;color:var(--muted-2);margin-top:3px}
.msg .fwd{font-size:10.5px;color:var(--muted);font-style:italic;margin-bottom:3px;display:flex;align-items:center;gap:4px}
.msg .sender{font-size:11.5px;font-weight:700;color:var(--accent);margin-bottom:3px}
.msg img.ph{max-width:100%;border-radius:9px;margin-bottom:3px;cursor:pointer;max-height:340px;object-fit:cover}
.msg .audio-file{display:flex;align-items:center;gap:9px;min-width:210px}
.react-row{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px}
.react-chip{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:99px;background:rgba(255,255,255,.08);
  border:1px solid var(--border);font-size:12px;line-height:1.5}
.react-chip:hover{background:rgba(255,255,255,.14)}
.react-chip.mine{background:rgba(46,230,201,.16);border-color:rgba(46,230,201,.4)}
.react-pick{display:flex;gap:4px;flex-wrap:wrap;padding:8px 10px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border);margin-bottom:12px}
.react-pick button{width:36px;height:36px;border-radius:50%;font-size:19px;display:flex;align-items:center;justify-content:center;background:var(--surface-3)}
.react-pick button:hover{transform:scale(1.12);background:rgba(46,230,201,.18)}
.story-react{display:flex;gap:6px;justify-content:center;padding:6px 10px 2px}
.story-react button{width:40px;height:40px;border-radius:50%;font-size:21px;display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.2);color:#fff}
.story-react button.mine{background:rgba(46,230,201,.3);border-color:var(--accent)}
.msg .edited{font-size:10px;color:var(--muted-2)}
.tick{display:inline-flex;color:var(--muted-2)}
.tick.seen{color:#35d39e}
.chat-input{display:flex;align-items:flex-end;gap:8px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));border-top:1px solid var(--border);
  background:var(--surface);flex:none}
.chat-input textarea{flex:1;min-height:42px;max-height:120px;border-radius:22px;background:var(--surface-2);border:1px solid var(--border);
  padding:11px 14px;resize:none;outline:none;font-size:14.5px;line-height:1.4}
.chat-input textarea:focus{border-color:rgba(46,230,201,.5)}
.icon-btn-round{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none;background:var(--surface-2);border:1px solid var(--border);color:var(--muted)}
.icon-btn-round:hover{color:var(--text)}
.send-btn{width:44px;height:44px;border-radius:50%;background:var(--grad);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;flex:none;box-shadow:0 8px 20px -8px rgba(46,230,201,.8)}
.typing{display:flex;gap:3px;align-items:center;padding:10px 14px;background:var(--surface-2);border-radius:14px;align-self:flex-start;border:1px solid var(--border)}
.typing i{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:bounce 1.1s infinite}
.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
@keyframes bounce{0%,60%,100%{transform:translateY(0);opacity:.5}30%{transform:translateY(-4px);opacity:1}}
.chat-empty-hint{align-self:center;max-width:320px;text-align:center;color:var(--muted);font-size:12.5px;background:var(--surface-2);
  border:1px solid var(--border);padding:10px 14px;border-radius:12px;margin:auto}

/* Marketplace */
.grid-products{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:16px}
@media(max-width:520px){.grid-products{grid-template-columns:repeat(2,1fr);gap:11px}}
.product-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;transition:.18s;position:relative}
.product-card:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:var(--border-strong)}
.thumb{height:150px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
@media(max-width:520px){.thumb{height:124px}}
.thumb img{width:100%;height:100%;object-fit:cover}
.thumb .ph-emoji{font-size:44px;filter:drop-shadow(0 8px 16px rgba(0,0,0,.35))}
.thumb .badge{position:absolute;top:8px;left:8px;background:rgba(4,16,25,.65);backdrop-filter:blur(8px);border-color:rgba(255,255,255,.12);color:#dff6ff}
.product-body{padding:10px 12px 12px;display:flex;flex-direction:column;gap:5px;flex:1}
.product-name{font-size:13.5px;font-weight:650;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:36px}
.price{font-family:var(--display);font-weight:700;font-size:15px;color:var(--text)}
.price usd{color:var(--muted);font-size:11px;font-weight:500;margin-left:4px}
.stars-row{display:flex;align-items:center;gap:3px;font-size:11px;color:var(--muted)}
.star-btn{display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--muted);padding:3px 7px;border-radius:99px;background:var(--surface-2);border:1px solid var(--border)}
.star-btn.on{color:var(--gold);border-color:rgba(255,200,97,.35);background:rgba(255,200,97,.1)}

/* Wallet */
.wallet-grid{align-items:start}
.wallet-card{position:relative;overflow:hidden;border-radius:24px;padding:24px;background:
  radial-gradient(120% 140% at 0% 0%,rgba(46,230,201,.35),transparent 55%),
  radial-gradient(120% 140% at 100% 100%,rgba(58,160,255,.35),transparent 55%),
  linear-gradient(135deg,#08222e,#07161f);
  border:1px solid rgba(46,230,201,.22);color:#eafcff;box-shadow:0 24px 60px -30px rgba(46,230,201,.6)}
.wallet-card::after{content:"";position:absolute;right:-60px;top:-70px;width:240px;height:240px;border-radius:50%;background:rgba(46,230,201,.12);filter:blur(10px);pointer-events:none}
.wallet-bal{font-family:var(--display);font-size:38px;font-weight:800;letter-spacing:-.03em;line-height:1.1}
.wallet-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:18px}
.wallet-actions .btn{height:40px;font-size:12px;padding:0 4px;background:rgba(255,255,255,.92);border:1px solid rgba(255,255,255,.5);color:#062b25;backdrop-filter:blur(6px);font-weight:700}
.wallet-actions .btn:hover{background:#fff;transform:translateY(-1px)}
.coin{display:inline-flex;width:22px;height:22px;border-radius:50%;background:var(--grad);color:#04241f;align-items:center;justify-content:center;font-size:11px;font-weight:800;flex:none}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px}
.stat{background:var(--surface-2);border:1px solid var(--border);border-radius:14px;padding:13px 14px}
.stat .k{font-size:11.5px;color:var(--muted);font-weight:600;display:flex;align-items:center;gap:6px}
.stat .v{font-family:var(--display);font-size:19px;font-weight:700;margin-top:5px;letter-spacing:-.02em}

/* Tables + lists */
.table-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:14px;background:var(--surface)}
table.tbl{width:100%;border-collapse:collapse;font-size:13px;min-width:640px}
table.tbl th{text-align:left;padding:11px 13px;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);
  background:var(--surface-2);border-bottom:1px solid var(--border);white-space:nowrap}
table.tbl td{padding:11px 13px;border-bottom:1px solid var(--border);vertical-align:middle}
table.tbl tr:last-child td{border-bottom:0}
table.tbl tr:hover td{background:rgba(255,255,255,.02)}
.list{display:flex;flex-direction:column;gap:8px}
.list-item{display:flex;align-items:center;gap:11px;padding:11px 12px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border)}
.kv{display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px dashed var(--border);font-size:13px}
.kv:last-child{border:0}
.kv .k{color:var(--muted)}
.kv .v{font-weight:600;text-align:right}

/* Tabs */
.tabs{display:flex;gap:4px;background:var(--surface-2);padding:4px;border-radius:12px;border:1px solid var(--border);overflow-x:auto}
.tab{padding:8px 14px;border-radius:9px;font-size:13px;font-weight:600;color:var(--muted);white-space:nowrap;flex:none}
.tab.on{background:var(--surface);color:var(--text);box-shadow:0 1px 4px rgba(0,0,0,.2);border:1px solid var(--border)}

/* Modal / sheet */
.modal-back{position:fixed;inset:0;background:rgba(2,9,15,.72);backdrop-filter:blur(6px);z-index:100;display:flex;align-items:center;justify-content:center;padding:18px;animation:fade .16s}
@keyframes fade{from{opacity:0}to{opacity:1}}
.modal{background:var(--surface);border:1px solid var(--border-strong);border-radius:20px;width:100%;max-width:470px;max-height:89dvh;overflow:auto;
  box-shadow:0 40px 90px -30px rgba(0,0,0,.9);animation:up .2s ease}
@keyframes up{from{opacity:0;transform:translateY(14px) scale(.99)}to{opacity:1;transform:none}}
.modal-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--surface);z-index:2}
.modal-body{padding:18px}
.modal-foot{padding:14px 18px;border-top:1px solid var(--border);display:flex;gap:9px;justify-content:flex-end;position:sticky;bottom:0;background:var(--surface)}
@media(max-width:560px){
  .modal-back{align-items:flex-end;padding:0}
  .modal{border-radius:22px 22px 0 0;max-height:92dvh}
}
/* toast */

/* never let the support bubble block the chat composer */
body.chat-open #smartsupp-widget-container > div,
body.modal-open #smartsupp-widget-container > div { display: none !important; }
/* never let the chat launcher cover a payment / checkout action */
body[data-route="deposit"] #smartsupp-widget-container > div,
body[data-route="withdraw"] #smartsupp-widget-container > div,
body[data-route="cart"] #smartsupp-widget-container > div { display: none !important; }
body[data-route="bonuses"] #smartsupp-widget-container > div,
body[data-route="product"] #smartsupp-widget-container > div,
body[data-route="checkout"] #smartsupp-widget-container > div { bottom: calc(var(--nav-h) + 96px + env(safe-area-inset-bottom)) !important; }
.qr-thumb{width:108px;height:108px;object-fit:contain;background:#fff;border-radius:10px;padding:6px;cursor:zoom-in;border:1px solid var(--border);display:block}
.qr-preview{width:64px;height:64px;border-radius:10px;background:var(--surface-2);display:flex;align-items:center;justify-content:center;overflow:hidden;color:var(--muted);flex:none}
.qr-preview img{width:100%;height:100%;object-fit:contain;background:#fff}
.qr-big{width:min(78vw,320px);height:min(78vw,320px);object-fit:contain;background:#fff;border-radius:14px;padding:10px;margin:0 auto;display:block}
/* keep the Smartsupp launcher clear of the bottom navigation and app buttons */
@media (max-width:1023px){
  #smartsupp-widget-container > div { bottom: calc(var(--nav-h) + 30px + env(safe-area-inset-bottom)) !important; right: 12px !important; }
}
@media (min-width:1024px){
  #smartsupp-widget-container > div { bottom: 20px !important; right: 20px !important; }
}
/* when the install banner is on screen, lift the support bubble above it */
body.has-install-banner #smartsupp-widget-container > div { bottom: calc(var(--nav-h) + 138px + env(safe-area-inset-bottom)) !important; }
@media (min-width:1024px){
  body.has-install-banner #smartsupp-widget-container > div { bottom: 110px !important; }
}
.update-bar{position:fixed;left:12px;right:12px;bottom:16px;z-index:95;display:flex;align-items:center;gap:10px;
  padding:11px 12px;border-radius:14px;background:rgba(8,24,35,.96);border:1px solid rgba(46,230,201,.4);
  box-shadow:0 22px 60px -18px rgba(0,0,0,.9);backdrop-filter:blur(14px);max-width:520px;margin:0 auto;color:#e9f4f9}
.update-bar .tiny{color:#9cb6c6}
@media(min-width:1024px){
/* never let the support bubble block the chat composer */
body.chat-open #smartsupp-widget-container > div { display: none !important; }
/* keep the Smartsupp launcher clear of the bottom navigation and app buttons */
@media (max-width:1023px){
  #smartsupp-widget-container > div { bottom: calc(var(--nav-h) + 30px + env(safe-area-inset-bottom)) !important; right: 12px !important; }
}
@media (min-width:1024px){
  #smartsupp-widget-container > div { bottom: 20px !important; right: 20px !important; }
}
/* when the install banner is on screen, lift the support bubble above it */
body.has-install-banner #smartsupp-widget-container > div { bottom: calc(var(--nav-h) + 138px + env(safe-area-inset-bottom)) !important; }
@media (min-width:1024px){
  body.has-install-banner #smartsupp-widget-container > div { bottom: 110px !important; }
}
.update-bar{bottom:20px;right:20px;left:auto;margin:0;width:400px}}
.toasts{position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:200;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none;width:calc(100% - 28px);max-width:420px}
.toast{background:var(--surface-2);border:1px solid var(--border-strong);color:var(--text);padding:11px 16px;border-radius:12px;font-size:13px;
  box-shadow:var(--shadow);display:flex;gap:9px;align-items:center;animation:up .2s;max-width:100%}
.toast.ok{border-color:rgba(47,214,166,.4)}
.toast.err{border-color:rgba(255,95,116,.45)}
.toast .i{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none;background:var(--accent);color:#04241f}

/* status viewer */
.story-view{position:fixed;inset:0;background:#000;z-index:120;display:flex;flex-direction:column;color:#fff}
.story-bars{display:flex;gap:3px;padding:10px 10px 0;position:absolute;top:0;left:0;right:0;z-index:3}
.story-bars i{flex:1;height:2.5px;background:rgba(255,255,255,.3);border-radius:2px;overflow:hidden;position:relative}
.story-bars i.on::after{content:"";position:absolute;inset:0;background:#fff;animation:grow 5s linear forwards;transform-origin:left}
.story-bars i.done::after{content:"";position:absolute;inset:0;background:#fff}
@keyframes grow{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.story-head{position:absolute;top:20px;left:0;right:0;z-index:3;display:flex;align-items:center;gap:10px;padding:12px 14px}
.story-stage{flex:1;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:70px 0 90px}
.story-stage img,.story-stage video{max-width:100%;max-height:100%;object-fit:contain}
.story-text{font-family:var(--display);font-size:26px;line-height:1.35;text-align:center;padding:30px;max-width:640px;font-weight:600}

/* install banner */
.install-banner{position:fixed;left:12px;right:12px;bottom:calc(var(--nav-h) + 14px + env(safe-area-inset-bottom));z-index:90;
  background:linear-gradient(135deg,#0a2433,#0b1c2a);border:1px solid rgba(46,230,201,.35);border-radius:16px;padding:12px 13px;
  box-shadow:0 22px 60px -18px rgba(0,0,0,.85);display:flex;align-items:center;gap:11px;animation:up .3s;max-width:520px;margin:0 auto;color:#eafcff}
@media(min-width:1024px){.install-banner{bottom:20px;left:auto;right:20px;margin:0;width:400px}}
.install-banner img{width:42px;height:42px;border-radius:11px;flex:none}
.install-banner .x{position:absolute;top:5px;right:6px;color:#8ba4b6;font-size:16px;width:24px;height:24px;display:flex;align-items:center;justify-content:center}

/* misc */
.verified{width:15px;height:15px;border-radius:50%;background:var(--accent-2);display:inline-flex;align-items:center;justify-content:center;flex:none}
.verified svg{width:9px;height:9px;stroke:#fff;stroke-width:3.4;fill:none}
.empty{display:flex;flex-direction:column;align-items:center;gap:10px;padding:44px 16px;text-align:center;color:var(--muted)}
.empty .ic{width:58px;height:58px;border-radius:18px;background:var(--surface-2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted)}
.empty h3{font-size:15px;color:var(--text)}
.empty p{font-size:13px;max-width:34ch;line-height:1.6}
.spinner{width:17px;height:17px;border-radius:50%;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.skeleton{background:linear-gradient(90deg,var(--surface-2),var(--surface-3),var(--surface-2));background-size:200% 100%;animation:sk 1.2s infinite;border-radius:10px}
@keyframes sk{to{background-position:-200% 0}}
.scroll-x{display:flex;gap:9px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}
.scroll-x::-webkit-scrollbar{display:none}
.section-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 12px}
.section-title h3{font-size:15px}
.trend{font-size:11px;font-weight:700;color:var(--success)}
.trend.down{color:var(--danger)}
.profile-banner{position:relative;overflow:hidden}
.profile-banner>img{opacity:.32}
html[data-theme="light"] .profile-banner>img{opacity:.10}
.ring-progress{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;
  background:conic-gradient(var(--accent) var(--p,75%),var(--surface-3) 0);position:relative}
.ring-progress::before{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--surface)}
.ring-progress span{position:relative;z-index:1}
.media-preview{display:flex;gap:8px;padding:8px 12px;border-top:1px solid var(--border);background:var(--surface);flex-wrap:wrap}
.media-preview .pv{position:relative;border-radius:9px;overflow:hidden;border:1px solid var(--border);width:64px;height:64px;background:var(--surface-2);display:flex;align-items:center;justify-content:center}
.media-preview .pv img{width:100%;height:100%;object-fit:cover}
.media-preview .pv .rm{position:absolute;top:2px;right:2px;width:18px;height:18px;border-radius:50%;background:rgba(0,0,0,.7);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px}
.progress-line{height:4px;border-radius:99px;background:var(--surface-3);overflow:hidden;margin-top:6px}
.progress-line i{display:block;height:100%;background:var(--grad);transition:width .3s}
.audio-player{display:flex;align-items:center;gap:8px;min-width:200px}
.audio-player .ap-btn{width:34px;height:34px;border-radius:50%;background:rgba(46,230,201,.18);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none;border:1px solid rgba(46,230,201,.3)}
.wave{display:flex;align-items:center;gap:2px;height:26px;flex:1}
.wave i{width:2.5px;border-radius:2px;background:var(--muted);opacity:.55}
.wave i.on{background:var(--accent);opacity:1}
.chat-media{max-width:260px;border-radius:10px;display:block;cursor:pointer}
.voice-rec{display:flex;align-items:center;gap:10px;padding:6px 8px;color:var(--danger);font-size:13px;font-weight:600}
.rec-dot{width:9px;height:9px;border-radius:50%;background:var(--danger);animation:pulse 1s infinite}
@keyframes pulse{50%{opacity:.3}}
.copy-row{display:flex;gap:8px;align-items:center;background:var(--surface-2);border:1px dashed var(--border-strong);border-radius:11px;padding:10px 12px;font-size:12.5px}
.timeline{display:flex;flex-direction:column;gap:0;margin-top:8px}
.timeline .step{display:flex;gap:11px;position:relative;padding-bottom:18px}
.timeline .step:last-child{padding-bottom:0}
.timeline .bullet{width:22px;height:22px;border-radius:50%;border:2px solid var(--border-strong);display:flex;align-items:center;justify-content:center;flex:none;background:var(--surface);z-index:1}
.timeline .step.done .bullet{border-color:var(--accent);background:rgba(46,230,201,.15);color:var(--accent)}
.timeline .step::before{content:"";position:absolute;left:10px;top:22px;bottom:0;width:2px;background:var(--border)}
.timeline .step:last-child::before{display:none}
.timeline .step.done::before{background:rgba(46,230,201,.35)}
.timeline h4{font-size:13px}.timeline p{font-size:11.5px;color:var(--muted);margin-top:2px}

/* admin */
.admin-head{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap}
.kpi{display:flex;flex-direction:column;gap:8px;padding:15px 16px;border-radius:15px;background:var(--surface);border:1px solid var(--border);position:relative;overflow:hidden}
.kpi .ic{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:rgba(46,230,201,.12);color:var(--accent)}
.kpi .v{font-family:var(--display);font-size:22px;font-weight:700;letter-spacing:-.02em}
.kpi .k{font-size:11.5px;color:var(--muted);font-weight:600}
.kpi .spark{position:absolute;right:-10px;bottom:-10px;font-size:52px;opacity:.06}
.grid-kpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.grid-kpi.k4{grid-template-columns:repeat(4,1fr)}
@media(max-width:1100px){.grid-kpi.k4{grid-template-columns:repeat(2,1fr)}}
.admin-nav{display:flex;gap:6px;overflow-x:auto;padding-bottom:2px;margin-bottom:16px}
.admin-nav a{padding:8px 13px;border-radius:10px;font-size:12.5px;font-weight:600;color:var(--muted);white-space:nowrap;border:1px solid transparent}
.admin-nav a.on{background:var(--surface-2);border-color:var(--border);color:var(--text)}
.notif-item{display:flex;gap:11px;padding:12px;border-radius:12px;border:1px solid var(--border);background:var(--surface-2)}
.notif-item.unread{background:rgba(46,230,201,.06);border-color:rgba(46,230,201,.2)}
.checkbox-grid{display:flex;flex-direction:column;gap:6px;max-height:220px;overflow:auto;padding:4px}
.checkbox-grid label{display:flex;align-items:center;gap:9px;font-size:13px;padding:7px 9px;border-radius:8px}
.checkbox-grid label:hover{background:var(--surface-2)}

/* ============ maintenance / admin session ============ */
.maintenance{min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:22px;position:relative;z-index:1;
  background:radial-gradient(800px 520px at 50% 0%,rgba(255,176,32,.12),transparent 60%),radial-gradient(700px 480px at 88% 100%,rgba(46,230,201,.10),transparent 60%)}
.maint-card{width:100%;max-width:520px;background:var(--surface);border:1px solid var(--border-strong);border-radius:24px;padding:30px 26px;text-align:center;box-shadow:var(--shadow)}
.maint-logo{width:76px;height:76px;border-radius:50%;margin:0 auto 16px;box-shadow:0 0 0 1px rgba(46,230,201,.3),0 18px 40px -14px rgba(46,230,201,.5)}
.maint-card h1{font-size:26px;letter-spacing:-.03em}
.maint-msg{color:var(--muted);font-size:13.5px;line-height:1.7;margin:10px auto 20px;max-width:40ch}
.maint-count{display:flex;justify-content:center;gap:8px;flex-wrap:wrap}
.cd-unit{min-width:64px;padding:11px 8px;border-radius:13px;background:var(--surface-2);border:1px solid var(--border)}
.cd-unit b{display:block;font-family:var(--display);font-size:24px;font-weight:800;letter-spacing:-.03em;color:var(--accent-2)}
.cd-unit span{display:block;font-size:9.5px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-top:3px;font-weight:700}
.maint-track{height:5px;border-radius:99px;background:var(--surface-3);overflow:hidden;margin-top:20px}
.maint-track i{display:block;height:100%;background:var(--grad);transition:width 1s linear}
.impersonate-bar,.maint-admin-bar{display:flex;align-items:center;gap:8px;padding:6px 14px;min-height:40px;font-size:12px;font-weight:600;flex:none;z-index:21;flex-wrap:wrap}
.impersonate-bar{background:linear-gradient(90deg,rgba(255,176,32,.22),rgba(255,176,32,.08));color:var(--warn);border-bottom:1px solid rgba(255,176,32,.3)}
.maint-admin-bar{background:rgba(46,230,201,.12);color:var(--accent);border-bottom:1px solid rgba(46,230,201,.25)}
.impersonate-bar .btn,.maint-admin-bar .btn{flex:none}
@media(max-width:560px){.impersonate-bar,.maint-admin-bar{font-size:11px}.cd-unit{min-width:56px}.cd-unit b{font-size:20px}}
/* ============ support live chat ============ */
.support-live{margin:0 12px 8px;padding:12px 13px;border-radius:14px;border:1px solid rgba(46,230,201,.35);
  background:linear-gradient(120deg,rgba(46,230,201,.12),rgba(58,160,255,.08));animation:pop .2s ease}
/* ============ new month ============ */
.month-wish{position:relative;overflow:hidden;padding:30px 22px 24px;text-align:center;border-radius:20px;
  background:radial-gradient(120% 120% at 50% 0%,rgba(46,230,201,.22),transparent 60%),linear-gradient(160deg,#0a2230,#07141f);color:#eafcff}
.month-wish .mw-emoji{font-size:54px;line-height:1;filter:drop-shadow(0 12px 24px rgba(46,230,201,.4))}
.month-wish h2{font-size:24px;margin:12px 0 0;letter-spacing:-.03em}
.month-wish .mw-month{display:inline-block;margin-top:10px;padding:5px 12px;border-radius:99px;background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.18);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
.month-wish p{color:#a9c4d2;font-size:13.5px;line-height:1.7;margin:14px auto 0;max-width:34ch}
.month-wish .confetti{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.month-wish .confetti i{position:absolute;width:7px;height:12px;border-radius:2px;opacity:.85;animation:confetti 3.2s linear infinite}
@keyframes confetti{0%{transform:translateY(-20px) rotate(0);opacity:0}10%{opacity:.9}100%{transform:translateY(420px) rotate(420deg);opacity:0}}
</style>

