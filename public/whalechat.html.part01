};

function ic(name, size = 20, cls = '') {
  const p = ICONS[name] || '';
  return `<svg class="${cls}" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
}
const LOGO = 'data:image/png;base64,';

/* ---------------- utils ---------------- */
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
function esc(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function uid(p = 'id') {
  return p + '_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}
function coins(n) {
  const v = Math.round((Number(n) || 0) * 100) / 100;
  return v.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
}
function usd(n) { return '$' + (Math.round((Number(n) || 0) * 100) / 100).toFixed(2); }
function usdToCoins(u) { return Math.round((Number(u) || 0) / COIN_USD * 100) / 100; }
function coinsToUsd(c) { return Math.round((Number(c) || 0) * COIN_USD * 100) / 100; }
function fmtNum(n) { return (Number(n) || 0).toLocaleString('en-US'); }
function initials(name) {
  const parts = String(name || '').trim().split(/\s+/).filter(Boolean);
  if (!parts.length) return 'W';
  return (parts[0][0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
}
function hueFor(str) {
  let h = 0;
  for (let i = 0; i < String(str).length; i++) h = (h * 31 + str.charCodeAt(i)) % 360;
  return h;
}
function avGrad(seed) {
  const h = hueFor(seed || 'whale');
  return `linear-gradient(135deg,hsl(${h} 70% 45%),hsl(${(h + 55) % 360} 75% 38%))`;
}
function avatarHTML(u, size = '', extraCls = '') {
  const cls = 'avatar ' + size + ' ' + extraCls;
  if (u && u.avatar) return `<div class="${cls}"><img src="${u.avatar}" alt="${esc(u.fullName || u.username || '')}"/></div>`;
  const name = (u && (u.fullName || u.username)) || 'WhaleChat';
  return `<div class="${cls}" style="background:${avGrad(name)};color:#fff">${esc(initials(name))}</div>`;
}
function timeAgo(ts) {
  const d = Math.floor((Date.now() - ts) / 1000);
  if (d < 45) return 'now';
  if (d < 3600) return Math.floor(d / 60) + 'm';
  if (d < 86400) return Math.floor(d / 3600) + 'h';
  if (d < 604800) return Math.floor(d / 86400) + 'd';
  return new Date(ts).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
function clockTime(ts) {
  return new Date(ts).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
}
function dayLabel(ts) {
  const d = new Date(ts), n = new Date();
  const same = d.toDateString() === n.toDateString();
  const y = new Date(n.getTime() - 86400000).toDateString() === d.toDateString();
  if (same) return 'Today';
  if (y) return 'Yesterday';
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: d.getFullYear() !== n.getFullYear() ? 'numeric' : undefined });
}
function dateLabel(ts) {
  return new Date(ts).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }
async function hash(str) {
  const salt = 'whalechat::v1::';
  try {
    if (window.crypto && crypto.subtle) {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(salt + str));
      return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
    }
  } catch (e) { /* fall through */ }
  return 'fb' + fnv(salt + str) + fnv(str + salt);
}
function fnv(s) {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }
  return h.toString(16);
}
function copyText(text) {
  const done = () => toast('Copied to clipboard', 'ok');
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
  } else fallbackCopy(text, done);
}
function fallbackCopy(text, done) {
  const ta = document.createElement('textarea');
  ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
  document.body.appendChild(ta); ta.select();
  try { document.execCommand('copy'); done(); } catch (e) { toast('Copy failed', 'err'); }
  ta.remove();
}

/* ---------------- persistence ---------------- */
let DB = null;
let SESSION = null;
let SAVE_TIMER = null;

function blankDB() {
  return {
    version: 1,
    users: [], vendors: [], companyProducts: [], products: [], orders: [],
    deposits: [], withdrawals: [], messages: [], statuses: [], chatsMeta: {}, referrals: [], purchases: [],
    contacts: [], blocks: [], notifications: [], txs: [], reports: [], refunds: [], vendorApplications: [], bonuses: [], bonusClaims: [],
    settings: {
      crypto: [
        { id: 'cr_1', name: 'USDT (TRC20)', address: 'TQn9Y2khEsLJW1ChVWFMSMeRDow5KcbLSE', network: 'TRC20', note: 'Send only USDT on TRC20. Minimum $5.' },
        { id: 'cr_2', name: 'Bitcoin (BTC)', address: 'bc1qwhalechat9d2f7k4m8s3v6x1p5n0r2t4y7u', network: 'Bitcoin', note: 'Minimum $10.' }
      ],
