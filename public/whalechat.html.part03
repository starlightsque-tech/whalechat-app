'suPass').value;
  const pass2 = document.getElementById('suPass2').value;
  const ref = document.getElementById('suRef').value.trim();
  const terms = document.getElementById('suTerms').checked;

  if (fullName.length < 3) return formError('suName', 'Please enter your full name');
  if (!/^[a-zA-Z0-9_]{3,20}$/.test(username)) return formError('suUser', '3–20 characters: letters, numbers or underscores');
  if (DB.users.some(u => u.username.toLowerCase() === username.toLowerCase())) return formError('suUser', 'That username is already taken');
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return formError('suEmail', 'Enter a valid email address');
  if (DB.users.some(u => u.email.toLowerCase() === email.toLowerCase())) return formError('suEmail', 'An account with this email already exists');
  if (phone.replace(/\D/g, '').length < 7) return formError('suPhone', 'Enter a valid phone number');
  if (DB.users.some(u => (u.phone || '').replace(/\D/g, '') === phone.replace(/\D/g, ''))) return formError('suPhone', 'This phone number is already registered');
  if (pass.length < 6) return formError('suPass', 'Password must be at least 6 characters');
  if (pass !== pass2) return formError('suPass2', 'Passwords do not match');
  if (!terms) return toast('Please accept the Terms of Service', 'err');

  let referrer = null;
  let pendingReferralCode = null;
  const refCode = normalizeRefCode(ref);
  if (refCode) {
    if (!/^[A-Z0-9]{4,12}$/.test(refCode)) return formError('suRef', 'Enter a valid referral code, e.g. WC411CA');
    referrer = findReferrer(refCode);
    if (referrer && referrer.banned) referrer = null;
    if (!referrer) {
      // Valid-looking code from a database/device that isn't here yet — never block signup.
      pendingReferralCode = refCode;
    }
  }

  btn.disabled = true; btn.innerHTML = '<span class="spinner"></span> Creating account…';
  await sleep(250);
  const u = {
    id: uid('usr'), role: 'user', fullName, username, email, phone,
    pass: await hash(pass), pin: null, avatar: null, balance: 0,
    totalDeposits: 0, totalWithdrawals: 0, totalEarnings: 0,
    referralCode: uniqueReferralCode(),
    referredBy: referrer ? referrer.id : null,
    pendingReferralCode: pendingReferralCode || null,
    referralPaid: false,
    trustScore: 80, completedSales: 0, rating: 5, verified: false, banned: false,
    vendorId: null, cart: [], stars: [], settings: { notifications: true, theme: document.documentElement.getAttribute('data-theme') },
    createdAt: Date.now()
  };
  DB.users.push(u);
  if (pendingReferralCode) {
    toast('Referral code saved — it will link automatically', 'ok', 4200);
  }
  // Auto-add inviter as a contact for both sides
  if (referrer) {
    DB.contacts.push({ id: uid('ct'), ownerId: u.id, userId: referrer.id, createdAt: Date.now() });
    DB.contacts.push({ id: uid('ct'), ownerId: referrer.id, userId: u.id, createdAt: Date.now() });
    notify(referrer.id, 'New referral joined', `${fullName} (@${username}) signed up with your code. Earn 10 Whale Coins when they make their first deposit.`, '#/referrals', 'gift');
  }
  // Welcome notification + admin ping
  notify(u.id, 'Welcome to WhaleChat 🐋', 'Your account is ready. Set your withdrawal PIN, then deposit Whale Coins to start shopping.', '#/wallet', 'gift');
  notify('usr_admin', 'New user registered', `${fullName} (@${username}) just created an account.`, '#/admin/users', 'users');
  SESSION = { userId: u.id, at: Date.now() };
  localStorage.setItem(LS_SESSION, JSON.stringify(SESSION));
  sync();
  toast('Account created — welcome aboard!', 'ok');
  go('set-pin');
  requestNotifyPermission(false);
  if (Remote.enabled) setTimeout(() => Push.ensure(false), 1200);
};

function uniqueReferralCode() {
  let code;
  do { code = 'WC' + Math.random().toString(36).slice(2, 7).toUpperCase(); }
  while (DB.users.some(u => (u.referralCode || '').toUpperCase() === code));
  return code;
}

/* ---------------- forgot password ---------------- */
function viewForgot() {
  return authSplit(`
    <div class="row gap6 tiny muted" style="margin-bottom:14px;cursor:pointer" data-nav="#/login">${ic('back', 14)} Back to sign in</div>
    <h2>Reset password</h2>
    <p class="sub">Confirm your account details and choose a new password.</p>
    <form id="forgotForm">
      ${field('Username or email', 'fpUser', { ph: 'e.g. janedoe', icon: 'user' })}
      ${field('Registered phone number', 'fpPhone', { ph: 'Used at sign up', icon: 'user', help: 'Used to verify it is really you.' })}
      ${field('New password', 'fpPass', { type: 'password', ph: 'Min. 6 characters', icon: 'lock' })}
      ${field('Confirm new password', 'fpPass2', { type: 'password', ph: 'Repeat password', icon: 'lock' })}
      <button class="btn btn-primary btn-block btn-lg mt6" type="submit">Reset password</button>
    </form>
    <div class="auth-foot">Remembered it? <span class="link" data-nav="#/login">Sign in</span></div>
  `);
}
App.forgot = async function () {
  clearErrors();
  const id = document.getElementById('fpUser').value.trim();
  const phone = document.getElementById('fpPhone').value.trim();
  const p1 = document.getElementById('fpPass').value, p2 = document.getElementById('fpPass2').value;
  if (!id) return formError('fpUser', 'Enter your username or email');
  if (phone.replace(/\D/g, '').length < 7) return formError('fpPhone', 'Enter the phone number on your account');
  if (p1.length < 6) return formError('fpPass', 'Password must be at least 6 characters');
  if (p1 !== p2) return formError('fpPass2', 'Passwords do not match');
  const u = byUsername(id);
  if (!u || (u.phone || '').replace(/\D/g, '') !== phone.replace(/\D/g, '')) return formError('fpUser', 'No account matches those details');
  u.pass = await hash(p1);
  sync();
  toast('Password updated. You can sign in now.', 'ok');
  go('login');
};

/* ---------------- PIN pad ---------------- */
function askPin(opts) {
  const want = 4; // minimum 4, allow 6
  let value = '';
  let step = opts.confirm ? 'enter' : 'once';
  let first = '';
  return new Promise((resolve) => {
    const renderPad = () => {
      const dots = [0, 1, 2, 3, 4, 5].map(i => `<i style="width:13px;height:13px;border-radius:50%;background:${i < value.length ? 'var(--accent)' : 'var(--surface-3)'};border:1px solid var(--border-strong);display:inline-block;margin:0 5px"></i>`).join('');
      openModal(modalShell(opts.title || 'Enter your PIN', `
        <div class="center" style="padding:6px 0 14px">
          <div class="small muted" style="margin-bottom:14px">${esc(step === 'confirm' ? 'Re-enter your 4–6 digit PIN' : (opts.sub || 'Enter your 4–6 digit withdrawal PIN'))}</div>
          <div style="margin-bottom:6px">${dots}</div>
          <div class="tiny muted" style="margin-top:8px">${value.length ? value.length + ' digits' : '4 to 6 digits'}</div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:9px;max-width:290px;margin:0 auto">
          ${[1, 2, 3, 4, 5, 6, 7, 8, 9].map(n => `<button type="button" data-pin="${n}" style="height:52px;border-radius:14px;background:var(--surface-2);border:1px solid var(--border);font-size:19px;font-weight:600;font-family:var(--display)">${n}</button>`).join('')}
          <button type="button" data-pin="clear" style="height:52px;border-radius:14px;font-size:11px;font-weight:600;color:var(--muted)">CLEAR</button>
          <button type="button" data-pin="0" style="height:52px;border-radius:14px;background:var(--surface-2);border:1px solid var(--border);font-size:19px;font-weight:600;font-family:var(--display)">0</button>
          <button type="button" data-pin="del" style="height:52px;border-radius:14px;color:var(--muted);display:flex;align-items:center;justify-content:center">${ic('back', 18)}</button>
        </div>
        <div id="pinErr" class="err center mt10" style="display:none"></div>`,
        `<button class="btn btn-ghost" data-close style="flex:1">Cancel</button><button class="btn btn-primary" data-pinok style="flex:1" ${value.length < 4 ? 'disabled' : ''}>Continue</button>`), { locked: false });

      const pad = $('#overlay');
      const submit = () => {
        if (value.length < 4) return;
        if (step === 'confirm') {
          if (value !== first) {
            const e = $('#pinErr'); e.textContent = 'PINs do not match. Try again.'; e.style.display = 'block';
            value = ''; first = ''; step = 'enter'; renderPad(); return;
          }
          finish(value);
        } else if (step === 'once') finish(value);
        else {
          first = value; value = ''; step = 'confirm'; renderPad();
        }
      };
      pad.querySelectorAll('[data-pin]').forEach(b => {
        b.onclick = () => {
          const k = b.getAttribute('data-pin');
          if (k === 'del') value = value.slice(0, -1);
          else if (k === 'clear') value = '';
          else if (value.length < 6) value += k;
          renderPad();
          if (value.length === 6) setTimeout(() => { const btn = document.querySelector('[data-pinok]'); if (btn && !btn.disabled) btn.click(); }, 180);
        };
      });
      const ok = document.querySelector('[data-pinok]');
      if (ok) ok.onclick = (ev) => { ev.stopPropagation(); submit(); };
      const cancel = pad.querySelector('.modal-foot [data-close]');
      if (cancel) cancel.onclick = () => { closeModal(); resolve(null); };
      const x = pad.querySelector('.modal-head [data-close]');
      if (x) x.onclick = () => { closeModal(); resolve(null); };
    };
    const finish = (v) => { closeModal(); resolve(v); };
    renderPad();
  });
}

function viewSetPin() {
  const u = me();
  return authSplit(`
    <div class="steps"><i class="on"></i><i class="on"></i><i></i></div>
    <h2>Secure your wallet</h2>
    <p class="sub">Create a 4–6 digit withdrawal PIN. You'll need it every time you withdraw USDT — keep it private.</p>
    <div class="panel" style="padding:16px;margin-bottom:18px">
      <div class="row gap6 tiny muted" style="font-weight:600">${ic('shield', 14)} Why a PIN?</div>
      <p class="tiny muted mt6" style="line-height:1.6">Withdrawals move real value. Your PIN is hashed and stored securely, and every withdrawal is also reviewed by our team.</p>
    </div>
    <button class="btn btn-primary btn-block btn-lg" id="setPinBtn">Create withdrawal PIN</button>
    <button class="btn btn-ghost btn-block mt10" data-skip-pin>Skip for now</button>
    <div class="auth-foot">Signed in as @${esc(u ? u.username : '')}</div>
  `);
}
App.startSetPin = async function () {
  const pin = await askPin({ title: 'Set withdrawal PIN', sub: 'Choose a 4–6 digit PIN you will remember', confirm: true });
  if (!pin) return;
  const u = me(); if (!u) return go('login');
  u.pin = await hash('pin::' + pin);
  sync(); toast('Withdrawal PIN set', 'ok'); go('home');
};

