/* ---------------- admin: email messaging ---------------- */
function adminEmail() {
  const users = DB.users.filter(u => u.email);
  const campaigns = (DB.emailCampaigns || []).slice(0, 12);
  return `<div class="between wrap gap10 mb16">
      <div><h2 style="font-size:18px">Email messaging</h2><p class="tiny muted mt6">Compose a rich email and send it to one person, several, or everyone.</p></div>
      <span class="badge">${users.length} accounts with email</span>
    </div>
    <div class="card">
      <div class="between wrap gap10 mb14"><h3 style="font-size:15px">New message</h3><span class="tiny muted">Delivered through Brevo</span></div>
      <div class="field"><label class="label">Recipients</label>
        <div class="row gap16 wrap">
          <label class="row gap6 small" style="cursor:pointer"><input type="radio" name="emailMode" value="all" checked onchange="App.emailModeChange('all')"/> All users (${users.length})</label>
          <label class="row gap6 small" style="cursor:pointer"><input type="radio" name="emailMode" value="selected" onchange="App.emailModeChange('selected')"/> Selected users</label>
        </div>
      </div>
      <div id="emailRcpts" class="panel hidden" style="padding:10px;max-height:190px;overflow:auto">
        <div class="between mb8"><span class="tiny muted">Choose recipients</span>
          <div class="row gap6"><button class="btn btn-xs btn-ghost" data-act="email-pick" data-id="all">Select all</button>
          <button class="btn btn-xs btn-ghost" data-act="email-pick" data-id="none">Clear</button></div></div>
        ${users.map(u => `<label class="row gap8" style="padding:6px 2px;cursor:pointer;border-bottom:1px dashed var(--border)">
          <input type="checkbox" name="emailRcpt" value="${u.id}" style="accent-color:var(--accent)"/>
          <span class="grow"><span class="small" style="font-weight:600">${esc(u.fullName)}</span>
          <span class="tiny muted" style="display:block">@${esc(u.username)} · ${esc(u.email)}</span></span></label>`).join('')}
      </div>
      <div class="field mt12"><label class="label">Subject</label>
        <input class="input" id="emSubject" maxlength="160" placeholder="e.g. New bonuses this week"/></div>
      <div class="field"><label class="label">Message</label>
        <div class="composer-toolbar">
          <button class="btn btn-xs btn-ghost" data-act="email-cmd" data-id="bold" title="Bold"><b>B</b></button>
          <button class="btn btn-xs btn-ghost" data-act="email-cmd" data-id="italic" title="Italic"><i>I</i></button>
          <button class="btn btn-xs btn-ghost" data-act="email-cmd" data-id="underline" title="Underline"><u>U</u></button>
          <button class="btn btn-xs btn-ghost" data-act="email-cmd" data-id="formatBlock" data-val="h2" title="Heading">H2</button>
          <button class="btn btn-xs btn-ghost" data-act="email-cmd" data-id="insertUnorderedList" title="Bullet list">• List</button>
          <select class="input" id="emFont" style="width:130px;height:30px;padding:0 8px;font-size:12px" onchange="App.emailFont(this.value)">
            <option value="">Font</option><option>Inter, Arial, sans-serif</option><option>Arial, sans-serif</option><option>Georgia, serif</option><option>'Times New Roman', serif</option><option>'Courier New', monospace</option><option>Verdana, sans-serif</option><option>Tahoma, sans-serif</option>
          </select>
          <select class="input" id="emSize" style="width:88px;height:30px;padding:0 8px;font-size:12px" onchange="App.emailSize(this.value)">
            <option value="">Size</option><option value="2">Small</option><option value="3">Normal</option><option value="4">Large</option><option value="5">X-Large</option><option value="6">Huge</option>
          </select>
          <button class="btn btn-xs btn-ghost" data-act="email-link">${ic('link', 12)} Link</button>
          <button class="btn btn-xs btn-ghost" data-act="email-logo">${ic('image', 12)} Logo</button>
          <button class="btn btn-xs btn-ghost" data-act="email-image">${ic('image', 12)} Image</button>
        </div>
        <div id="emBody" class="email-editor" contenteditable="true" placeholder="Write your message…"></div>
        <div class="row gap10 wrap mt10" style="align-items:flex-end">
          <div class="field grow" style="margin:0;min-width:150px"><label class="label">Button name (optional)</label>
            <input class="input" id="emCtaLabel" maxlength="40" placeholder="Visit WhaleChat"/></div>
          <div class="field grow" style="margin:0;min-width:170px"><label class="label">Button link (optional)</label>
            <input class="input" id="emCtaUrl" placeholder="https://whalechat-qkgd.onrender.com"/></div>
        </div>
        <div class="help">Formatting, links, images and the WhaleChat logo are supported. Keep it short and useful.</div>
      </div>
      <div class="row gap10 wrap mt14">
        <button class="btn btn-primary" data-act="email-send">${ic('send', 15)} Send email</button>
        <span class="tiny muted" id="emHint">Will be sent to all ${users.length} users</span>
      </div>
    </div>
    <div class="card mt16">
      <div class="between mb12"><h3 style="font-size:15px">Sent campaigns</h3><span class="badge">${campaigns.length}</span></div>
      ${campaigns.length ? `<div class="table-wrap"><table class="tbl"><thead><tr><th>Subject</th><th>Recipients</th><th>Queued</th><th>Sent by</th><th>Date</th></tr></thead><tbody>
        ${campaigns.map(c => `<tr><td>${esc(c.subject)}</td><td>${c.recipients}</td><td>${c.queued}</td>
          <td>${esc((findUser(c.by) || {}).username || 'admin')}</td><td class="tiny muted">${new Date(c.createdAt).toLocaleString()}</td></tr>`).join('')}
      </tbody></table></div>` : `<div class="empty" style="padding:20px"><p>No campaigns sent yet.</p></div>`}
    </div>
    <style>
      .composer-toolbar{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:8px}
      .email-editor{min-height:190px;max-height:420px;overflow:auto;padding:14px;border:1px solid var(--border);border-radius:12px;background:var(--surface-2);line-height:1.65;font-size:14px;outline:none}
      .email-editor:empty:before{content:attr(placeholder);color:var(--muted)}
      .email-editor:focus{border-color:rgba(46,230,201,.5);box-shadow:0 0 0 3px rgba(46,230,201,.12)}
      .email-editor img{max-width:100%;height:auto}
    </style>`;
}

App.emailModeChange = function (mode) {
  const box = document.getElementById('emailRcpts');
  const hint = document.getElementById('emHint');
  if (box) box.classList.toggle('hidden', mode !== 'selected');
  if (hint) {
    const n = document.querySelectorAll('input[name="emailRcpt"]').length;
    hint.textContent = mode === 'selected' ? 'Only the users you tick will receive it' : 'Will be sent to all ' + n + ' users';
  }
};
App.emailPick = function (which) {
  document.querySelectorAll('input[name="emailRcpt"]').forEach(cb => { cb.checked = which === 'all'; });
};
App.emailCmd = function (cmd, ds) {
  const ed = document.getElementById('emBody');
  if (!ed) return;
  ed.focus();
  try { document.execCommand(cmd, false, (ds && ds.val) || null); } catch (e) {}
};
App.emailFont = function (v) { if (!v) return; const ed = document.getElementById('emBody'); if (ed) { ed.focus(); document.execCommand('fontName', false, v); } };
App.emailSize = function (v) { if (!v) return; const ed = document.getElementById('emBody'); if (ed) { ed.focus(); document.execCommand('fontSize', false, v); } };
App.emailLink = async function () {
  const url = await promptDialog({ title: 'Insert link', label: 'Link URL', placeholder: 'https://…' });
  if (!url) return;
  const ed = document.getElementById('emBody');
  if (!ed) return;
  ed.focus();
  document.execCommand('createLink', false, /^https?:\/\//i.test(url) ? url : 'https://' + url);
};
App.emailLogo = function () {
  const ed = document.getElementById('emBody');
  if (!ed) return;
  ed.focus();
  const src = location.origin + '/assets/logo-192.png';
  document.execCommand('insertHTML', false, `<a href="${location.origin}/whalechat.html"><img src="${src}" width="44" height="44" alt="WhaleChat" style="vertical-align:middle;border-radius:8px"/></a>&nbsp;`);
};
App.emailImage = async function () {
  const url = await promptDialog({ title: 'Insert image', label: 'Image URL', placeholder: 'https://…/image.png' });
  if (!url) return;
  const ed = document.getElementById('emBody');
  if (!ed) return;
  ed.focus();
  document.execCommand('insertHTML', false, `<img src="${esc(url)}" alt="" style="max-width:100%;border-radius:10px"/>`);
};
App.emailSend = async function () {
  const ed = document.getElementById('emBody');
  const subjectEl = document.getElementById('emSubject');
  const subject = ((subjectEl && subjectEl.value) || '').trim();
  let html = ((ed && ed.innerHTML) || '').trim();
  const ctaLabelEl = document.getElementById('emCtaLabel');
  const ctaUrlEl = document.getElementById('emCtaUrl');
  const ctaLabel = ((ctaLabelEl && ctaLabelEl.value) || '').trim();
  let ctaUrl = ((ctaUrlEl && ctaUrlEl.value) || '').trim();
  if (ctaLabel && ctaUrl) {
    if (!/^https?:\/\//i.test(ctaUrl)) ctaUrl = 'https://' + ctaUrl.replace(/^\/+/, '');
    const safeUrl = ctaUrl.replace(/"/g, '&quot;');
    const safeLabel = ctaLabel.replace(/[<>&]/g, '');
    html += '<div style="margin:24px 0 6px"><a href="' + safeUrl + '" target="_blank" '
      + 'style="display:inline-block;background:#2ee6c9;color:#03221d;text-decoration:none;font-weight:700;'
      + 'padding:13px 24px;border-radius:11px;font-size:14px">' + safeLabel + '</a></div>';
  }
  if (!subject) return toast('Add a subject', 'err');
  if (!html || !html.replace(/<[^>]+>/g, '').trim() && !/<img/i.test(html)) return toast('Write a message first', 'err');
  const modeEl = document.querySelector('input[name="emailMode"]:checked');
  const all = !modeEl || modeEl.value === 'all';
  const userIds = all ? [] : Array.from(document.querySelectorAll('input[name="emailRcpt"]:checked')).map(c => c.value);
  if (!all && !userIds.length) return toast('Select at least one recipient', 'err');
  if (!await confirmDialog({ title: all ? 'Send to every user?' : 'Send to ' + userIds.length + ' user(s)?', body: 'Subject: ' + subject, ok: 'Send now' })) return;
  const btn = document.querySelector('[data-act="email-send"]');
  if (btn) { btn.disabled = true; btn.innerHTML = '<span c