/* ---- vendor duration plans ---- */
App.vendorPlanNew = function () {
  openModal(modalShell('Add vendor plan', `
    ${field('Duration (months)', 'vpMonths', { type: 'number', min: '1', step: '1', value: '1' })}
    ${field('Fee (USD)', 'vpPrice', { type: 'number', min: '0', step: '1', value: '50' })}
    <input type="hidden" id="vpId" value=""/>`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="vendor-plan-save">Add plan</button>`), { width: '420px' });
};
App.vendorPlanEdit = function (id) {
  const pl = vendorPlanById(id); if (!pl) return;
  openModal(modalShell('Edit vendor plan', `
    ${field('Duration (months)', 'vpMonths', { type: 'number', min: '1', step: '1', value: pl.months })}
    ${field('Fee (USD)', 'vpPrice', { type: 'number', min: '0', step: '1', value: pl.priceUsd })}
    <input type="hidden" id="vpId" value="${esc(pl.id)}"/>`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="vendor-plan-save">Save plan</button>`), { width: '420px' });
};
App.vendorPlanSave = function () {
  const months = Math.max(1, Math.round(Number((document.getElementById('vpMonths') || {}).value) || 0));
  const price = Math.max(0, Number((document.getElementById('vpPrice') || {}).value) || 0);
  const id = (document.getElementById('vpId') || {}).value || '';
  if (!months) return toast('Enter a duration in months', 'err');
  DB.settings.vendorPlans = DB.settings.vendorPlans || [];
  if (id) {
    const pl = DB.settings.vendorPlans.find(x => x.id === id);
    if (pl) { pl.months = months; pl.priceUsd = price; }
  } else {
    DB.settings.vendorPlans.push({ id: uid('vpl'), months, priceUsd: price });
  }
  DB.settings.vendorPlans.sort((a, b) => a.months - b.months);
  if (DB.settings.vendorPlans[0]) DB.settings.vendorFeeUsd = DB.settings.vendorPlans[0].priceUsd;
  sync(); closeModal(); toast(id ? 'Plan updated' : 'Plan added', 'ok'); render();
};
App.vendorPlanDel = async function (id) {
  if ((DB.settings.vendorPlans || []).length <= 1) return toast('Keep at least one vendor plan', 'err');
  if (!await confirmDialog({ title: 'Remove plan?', body: 'Applicants will no longer see this duration.', danger: true, ok: 'Remove' })) return;
  DB.settings.vendorPlans = DB.settings.vendorPlans.filter(p => p.id !== id);
  sync(); toast('Plan removed', 'ok'); render();
};

App.vendorExtend = async function (id) {
  const v = vendorById(id); if (!v) return;
  if (!await confirmDialog({ title: 'Extend vendor by 30 days?', body: 'Adds one month to @' + v.username + (v.expiresAt ? ' from the current expiry.' : ' from today.'), ok: 'Extend 30 days' })) return;
  const base = Math.max(Date.now(), Number(v.expiresAt) || 0);
  v.expiresAt = base + 30 * 86400000;
  notify(v.userId, 'Vendor account extended', 'Admin added 30 days to your vendor subscription. New expiry: ' + new Date(v.expiresAt).toLocaleDateString() + '.', '#/vendor', 'check');
  sync(); toast('Vendor extended by 30 days', 'ok'); render();
};

App.vendorMethodNew = function () {
