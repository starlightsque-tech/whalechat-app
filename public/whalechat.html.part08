App.adminSavePassword = async function () {
  const u = me(); clearErrors();
  const oldp = document.getElementById('apOld').value;
  const n1 = document.getElementById('apNew').value, n2 = document.getElementById('apNew2').value;
  if (await hash(oldp) !== u.pass) return formError('apOld', 'Current password is incorrect');
  if (n1.length < 8) return formError('apNew', 'Use at least 8 characters');
  if (n1 !== n2) return formError('apNew2', 'Passwords do not match');
  u.pass = await hash(n1);
  sync(); closeModal(); toast('Admin password updated', 'ok');
};

/* ---------------- admin support chat ---------------- */
function adminChat() {
  const users = DB.users.filter(u => u.role !== 'admin');
  const rows = users.map(u => {
    const msgs = DB.messages.filter(m => m.chatId === chatId(u.id, 'usr_admin'));
    return { u, last: msgs[msgs.length - 1], count: msgs.filter(m => m.from === u.id && m.status !== 'seen').length };
  }).sort((a, b) => (b.last ? b.last.createdAt : 0) - (a.last ? a.last.createdAt : 0));
  return `<div class="card">
    <div class="between mb16"><div><h3 style="font-size:15px">Support inbox</h3><p class="tiny muted mt6">Chat with users and vendors about orders, tracking and payments.</p></div>
      <span class="badge">${rows.filter(r => r.count).length} unread chats</span></div>
    ${rows.length ? `<div class="list">${rows.map(({ u, last, count }) => `<div class="list-item" data-act="admin-msg-user" data-id="${u.id}" style="cursor:pointer">
      <div class="avatar-wrap">${avatarHTML(u, 'sm')}${Presence.isOnline(u.id) ? '<span class="status-dot" style="width:10px;height:10px"></span>' : ''}</div>
      <div class="grow" style="min-width:0"><div class="small" style="font-weight:600">${esc(u.fullName)} <span class="tiny muted">@${esc(u.username)}</span></div>
        <div class="tiny muted ellipsis">${last ? esc(previewOf(last)).slice(0, 60) : 'No messages yet'}</div></div>
      ${count ? `<span class="unread">${count}</span>` : `<span class="tiny muted">${last ? timeAgo(last.createdAt) : ''}</span>`}
      ${ic('chevron', 15)}</div>`).join('')}</div>` : `<div class="empty"><p>No users to chat with yet.</p></div>`}
  </div>`;
}
