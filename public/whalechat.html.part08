lass="spinner"></span> Sending…'; }
  try {
    const res = await fetch('/api/email/broadcast', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ subject, html, text: (ed.innerText || '').slice(0, 4000), all, userIds, adminId: me().id }) });
    const d = await res.json().catch(() => null);
    if (!res.ok || !d || !d.ok) throw new Error((d && (d.error || d.message)) || 'Send failed');
    toast('Email queued for ' + d.recipients + ' recipient(s)', 'ok');
    if (Remote.enabled) await Remote.refresh(true);
    render();
  } catch (e) {
    if (btn) { btn.disabled = false; btn.innerHTML = 'Send email'; }
    toast('Could not send: ' + e.message, 'err');
  }
};

function adminBonuses() {
  const list = DB.bonuses || [];
  const claims = (DB.bonusClaims || []).slice().sort((a, b) => (b.claimedAt || b.createdAt) - (a.claimedAt || a.createdAt));
  const users = DB.users.filter(u => u.role !== 'admin');
  const claimed = claims.filter(c => c.status === 'claimed');
  return `<div class="between wrap gap10 mb16">
      <div><h2 style="font-size:18px">Bonuses & tasks</h2><p class="tiny muted mt6">Create tasks, issue one-time codes and track redemptions.</p></div>
      <button class="btn btn-primary btn-sm" data-act="bonus-new">${ic('plus', 14)} New bonus</button>
    </div>
    <div class="grid-kpi k4 mb16">
      <div class="kpi"><div class="v">${list.length}</div><div class="k">Bonuses</div></div>
      <div class="kpi"><div class="v">${claims.filter(c => c.status !== 'claimed').length}</div><div class="k">Codes issued</div></div>
      <div class="kpi"><div class="v">${claimed.length}</div><div class="k">Claims</div></div>
      <div class="kpi"><div class="v">${usd(claimed.reduce((s, c) => s + (Number(c.rewardUsd) || 0), 0))}</div><div class="k">Value paid</div></div>
    </div>
    <div class="card">
      <div class="between mb14"><h3 style="font-size:15px">Task list</h3><span class="badge">${users.length} users</span></div>
      ${list.length ? `<div class="col gap10">${list.map(b => `<div class="list-item" style="align-items:flex-start">
        <div style="width:34px;height:34px;border-radius:10px;background:rgba(46,230,201,.12);color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none">${ic('gift', 16)}</div>
        <div class="grow" style="min-width:0">
          <div class="row gap8 wrap"><span class="small" style="font-weight:650">${esc(b.title)}</span>
            <span class="badge ${b.active === false ? '' : 'badge-success'}">${b.active === false ? 'Hidden' : 'Active'}</span></div>
          <div class="tiny muted mt4">${esc(b.description || '').slice(0, 140)}</div>
          ${b.taskUrl ? `<div class="tiny mt4" style="color:var(--accent);word-break:break-all">${ic('link', 11)} ${esc(b.taskLabel || b.taskUrl)} → ${esc(b.taskUrl)}</div>` : ''}
        </div>
        <div style="text-align:right;flex:none"><div class="small" style="font-weight:700">${usd(b.rewardUsd)}</div>
          <div class="tiny muted">${coins((Number(b.rewardUsd) || 0) / COIN_USD)} WC</div></div>
        <div class="row gap4" style="flex:none">
          <button class="btn btn-xs btn-ghost" data-act="bonus-code" data-id="${b.id}" title="Generate code">${ic('key', 12)}</button>
          <button class="btn btn-xs btn-ghost" data-act="bonus-edit" data-id="${b.id}">${ic('edit', 12)}</button>
          <button class="btn btn-xs btn-ghost" data-act="bonus-del" data-id="${b.id}">${ic('trash', 12)}</button>
        </div>
      </div>`).join('')}</div>` : `<div class="empty" style="padding:22px"><p>No bonuses yet. Create one to let users earn rewards.</p></div>`}
    </div>
    <div class="card mt16">
      <div class="between mb14"><h3 style="font-size:15px">Redemption ledger</h3><span class="badge">${claims.length} records</span></div>
      ${claims.length ? `<div class="table-wrap"><table class="tbl"><thead><tr><th>User</th><th>Bonus</th><th>Code</th><th>Status</th><th>Date</th></tr></thead><tbody>
        ${claims.slice(0, 100).map(c => {
          const u = findUser(c.userId); const b = (DB.bonuses || []).find(x => x.id === c.bonusId);
          return `<tr><td>${u ? esc(u.fullName) + ' <span class="tiny muted">@' + esc(u.username) + '</span>' : '—'}</td>
            <td>${b ? esc(b.title) : '—'}</td><td class="mono">••••${esc(c.codeHint || '')}</td>
            <td>${c.status === 'claimed' ? '<span class="badge badge-success">Claimed</span>' : '<span class="badge badge-warn">Issued</span>'}</td>
            <td class="tiny muted">${new Date(c.claimedAt || c.createdAt).toLocaleString()}</td></tr>`;
        }).join('')}
      </tbody></table></div>` : `<div class="empty" style="padding:20px"><p>No codes issued yet. Use the key icon on a bonus to create one.</p></div>`}
    </div>`;
}

App.bonusNew = function () { bonusForm(null); };
App.bonusEdit = function (id) { bonusForm((DB.bonuses || []).find(b => b.id === id)); };
function bonusForm(b) {
  openModal(modalShell(b ? 'Edit bonus' : 'New bonus', `
    ${field('Title', 'bnTitle', { value: b ? b.title : '', ph: 'e.g. Join our Telegram channel' })}
    <div class="field"><label class="label">Description</label><textarea class="input" id="bnDesc" style="min-height:80px" placeholder="Explain exactly what the user must do…">${esc(b ? b.description || '' : '')}</textarea></div>
    ${field('Reward in USD', 'bnReward', { type: 'number', value: b ? b.rewardUsd : '', ph: '10.00' })}
    ${field('Task button label', 'bnTaskLabel', { value: b ? b.taskLabel || '' : '', ph: 'Open Telegram' })}
    ${field('Task / embed link', 'bnTaskUrl', { value: b ? b.taskUrl || '' : '', ph: 'https://t.me/yourchannel' })}
    <div class="between panel" style="padding:10px 12px"><span class="small">Visible to users</span>
      <div class="switch ${!b || b.active !== false ? 'on' : ''}" data-act="bonus-toggle-active" data-id="${b ? b.id : ''}"></div></div>`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="bonus-save" data-id="${b ? b.id : ''}">Save bonus</button>`), { width: '520px' });
}
let BONUS_TEMP_ACTIVE = null;
App.bonusToggleActive = function () {
  const el = document.querySelector('[data-act="bonus-toggle-active"]');
  if (!el) return;
  el.classList.toggle('on');
};
App.bonusSave = function (id) {
  const title = (document.getElementById('bnTitle').value || '').trim();
  const description = (document.getElementById('bnDesc').value || '').trim();
  const rewardUsd = Math.max(0, Number(document.getElementById('bnReward').value) || 0);
  const taskLabel = (document.getElementById('bnTaskLabel').value || '').trim();
  let taskUrl = (document.getElementById('bnTaskUrl').value || '').trim();
  if (!title) return toast('Enter a title', 'err');
  if (!rewardUsd) return toast('Enter a reward amount', 'err');
  if (taskUrl && !/^https?:\/\//i.test(taskUrl)) taskUrl = 'https://' + taskUrl;
  if (taskUrl && !/^https?:\/\/[^\s]+$/i.test(taskUrl)) return toast('Enter a valid task link', 'err');
  const active = !!(document.querySelector('[data-act="bonus-toggle-active"]') || {}).classList?.contains('on');
  DB.bonuses = DB.bonuses || [];
  if (id) {
    const b = DB.bonuses.find(x => x.id === id);
    if (b) Object.assign(b, { title, description, rewardUsd, taskLabel, taskUrl, active, updatedAt: Date.now() });
  } else {
    DB.bonuses.push({ id: uid('bn'), title, description, rewardUsd, taskLabel, taskUrl, active, createdAt: Date.now(), createdBy: me().id });
  }
  sync(); closeModal(); toast('Bonus saved', 'ok'); render();
};
App.bonusDel = async function (id) {
  if (!await confirmDialog({ title: 'Delete this bonus?', body: 'Users will no longer see it. Issued codes stay in the ledger.', danger: true, ok: 'Delete' })) return;
  DB.bonuses = (DB.bonuses || []).filter(b => b.id !== id);
  sync(); toast('Bonus deleted', 'ok'); render();
};

App.bonusCode = function (id) {
  const b = (DB.bonuses || []).find(x => x.id === id);
  if (!b) return;
  const users = DB.users.filter(u => u.role !== 'admin');
  openModal(modalShell('Generate code · ' + b.title, `
    <p class="small muted" style="line-height:1.65">Issue a one-time code to a specific user after you verify their task. The code is shown once — copy it and send it to them in support chat.</p>
    <div class="field mt16"><label class="label">User</label>
      <select class="input" id="bcUser">${users.map(u => `<option value="${u.id}">${esc(u.fullName)} · @${esc(u.username)}</option>`).join('')}</select></div>
    <div class="panel" style="padding:11px 12px"><div class="between"><span class="tiny muted">Reward</span><span class="small" style="font-weight:700;color:var(--accent)">${usd(b.rewardUsd)}</span></div></div>`,
    `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" data-act="bonus-gen" data-id="${b.id}">${ic('key', 14)} Generate code</button>`), { width: '460px' });
};

async function makeBonusCode() {
  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  const bytes = new Uint8Array(12);
  (window.crypto || {}).getRandomValues ? crypto.getRandomValues(bytes) : bytes.forEach((_, i) => bytes[i] = Math.floor(Math.random() * 256));
  let out = '';
  for (let i = 0; i < 12; i++) { out += alphabet[bytes[i] % alphabet.length]; if (i === 3 || i === 7) out += '-'; }
  return out;
}

App.bonusGen = async function (id) {
  const b = (DB.bonuses || []).find(x => x.id === id);
  const userSel = document.getElementById('bcUser');
  const userId = userSel && userSel.value;
  if (!b || !userId) return toast('Choose a user first', 'err');
  const code = await makeBonusCode();
  const codeHash = await bonusCodeHash(code);
  DB.bonusClaims = DB.bonusClaims || [];
  DB.bonusClaims.push({
    id: uid('bc'), bonusId: b.id, userId, codeHash,
    codeHint: code.slice(-4), status: 'issued', rewardUsd: b.rewardUsd,
    createdAt: Date.now(), issuedBy: me().id
  });
  sync();
  const u = findUser(userId);
  openModal(modalShell('Code ready', `
    <p class="small muted">Send this one-time code to <b>${esc(u ? u.fullName : 'the user')}</b> in support chat. It will not be shown again.</p>
    <div class="panel mt16 center" style="padding:18px">
      <div class="mono" style="font-size:22px;font-weight:800;letter-spacing:.14em;color:var(--accent)">${esc(code)}</div>
      <div class="tiny muted mt8">${esc(b.title)} · ${usd(b.rewardUsd)}</div>
    </div>
    <div class="row gap8 mt14"><button class="btn btn-primary" data-act="copy" data-id="${esc(code)}" style="flex:1">${ic('copy', 14)} Copy code</button>
    <button class="btn btn-ghost" data-close style="flex:1">Done</button></div>`), { width: '440px' });
  toast('Code generated for ' + (u ? u.username : 'user'), 'ok');
};

