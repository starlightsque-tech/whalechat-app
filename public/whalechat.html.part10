  { slug:'lena-hoffmann',  name:'Lena Hoffmann',  username:'lena.hoffmann',  email:'lena.hoffmann@web.de',      phone:'+49 30 4820 1177', country:'Germany',     city:'Berlin',     address:'Torstraße 84',          postal:'10119',   cadence:[1,4] },
