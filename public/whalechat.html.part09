dashoffset="${(-off).toFixed(2)}"
      transform="rotate(-90 60 60)" stroke-linecap="butt"/>`;
    off += frac * C;
  });
  return `<svg viewBox="0 0 120 120" class="inv-donut">${out}
    <text x="60" y="57" text-anchor="middle" fill="var(--muted)" font-size="7.5" font-family="Inter,sans-serif">ALLOCATION</text>
    <text x="60" y="70" text-anchor="middle" fill="var(--text)" font-size="12" font-weight="700" font-family="Sora,Inter,sans-serif">${slices.length}</text>
    <text x="60" y="79" text-anchor="middle" fill="var(--muted)" font-size="6.5" font-family="Inter,sans-serif">POSITIONS</text></svg>`;
};

/* ------------------------------ portfolio maths ------------------------------ */
INV.portfolio = function (userId) {
  const hs = INV.holdings(userId);
  let valueUsd = 0, costUsd = 0, dayUsd = 0;
  hs.forEach(h => {
    const q = INV.quote(h.ticker); if (!q) return;
    valueUsd += h.shares * q.price;
    costUsd += h.shares * h.avgPrice;
    dayUsd += h.shares * (q.price - q.prevClose);
  });
  const u = findUser(userId || me().id) || me();
  return {
    holdings: hs, valueUsd, costUsd, dayUsd,
    earningsUsd: valueUsd - costUsd,
    dayPct: (valueUsd - dayUsd) ? (dayUsd / (valueUsd - dayUsd)) * 100 : 0,
    earnPct: costUsd ? ((valueUsd - costUsd) / costUsd) * 100 : 0,
    valueCoins: usdToCoins(valueUsd),
    cashCoins: (u && u.balance) || 0
  };
};
INV.portfolioSeries = function (tf, userId) {
  const hs = INV.holdings(userId);
  if (!hs.length) return [];
  const series = hs.map(h => INV.series(h.ticker, tf));
  const len = Math.min(...series.map(s => s.length));
  if (!len) return [];
  const out = [];
  for (let i = 0; i < len; i++) {
    let v = 0;
    hs.forEach((h, k) => { v += h.shares * (series[k][i] || series[k][len - 1] || h.avgPrice); });
    out.push(v);
  }
  return out;
};
INV.news = function (s) {
  const pools = [
    [`${s.name} beats quarterly estimates as margins hold`, 'Revenue topped consensus with management reiterating full-year guidance.'],
    [`Analysts raise ${s.ticker} price target after strong demand`, 'Several desks lifted targets citing durable growth and pricing power.'],
    [`${s.ticker} announces expanded ${s.sector.toLowerCase()} roadmap`, 'The company outlined new product lines and capital allocation priorities.'],
    [`What the latest ${s.sector} rotation means for ${s.ticker}`, 'Sector flows shifted this week as investors repositioned around rate expectations.'],
    [`${s.ceo} outlines next phase of ${s.name} strategy`, 'Leadership detailed operational priorities and investment in AI-driven efficiency.']
  ];
  const rnd = mulberry32(seedOf(s.ticker + 'news'));
  return pools.map((p, i) => ({
    title: p[0], body: p[1],
    src: ['Market Wire', 'Whale Research', 'Global Business Daily', 'Sector Brief', 'Investor Desk'][i % 5],
    ago: Math.floor(rnd() * 20) + 1
  }));
};

/* ------------------------------ small view atoms ------------------------------ */
INV.logoHTML = function (s, size) {
  const sz = size || 38;
  return `<span class="inv-logo" style="width:${sz}px;height:${sz}px;background:linear-gradient(135deg,${s.color},${s.color}bb)">
    <b style="font-size:${Math.round(sz * 0.34)}px">${esc(s.ticker.slice(0, 3))}</b></span>`;
};
INV.chgClass = function (v) { return v > 0 ? 'up' : v < 0 ? 'down' : ''; };
INV.chgHTML = function (q, cls) {
  const c = INV.chgClass(q.changePct);
  const chg = Number(q && q.changePct) || 0;
  return `<span class="inv-chg ${c} ${cls || ''}" data-lv="pct:${q.ticker || ''}">${chg >= 0 ? '+' : ''}${chg.toFixed(2)}%</span>`;
};
INV.feeLine = function () { return INV.fee() ? `Includes ${INV.fee()}% trading fee` : 'No trading fee'; };

/* ------------------------------ INVEST router ------------------------------ */
VIEWS.invest = function (parts, params) {
  const u = me();
  const sub = parts[1] || '';
  if (sub === 'market') return INV.viewMarket(params);
  if (sub === 'stock') return INV.viewStock(parts[2], params);
  if (sub === 'watchlist') return INV.viewWatchlist();
  if (sub === 'orders') return INV.viewOrders();
  return INV.viewDash(params);
};

INV.seg = function (tf) {
  const list = ['1D', '1W', '1M', '3M', '1Y', 'ALL'];
  return `<div class="inv-seg">${list.map(x => `<a href="#/invest?tf=${x}" class="inv-segbtn ${x === tf ? 'on' : ''}">${x}</a>`).join('')}</div>`;
};

INV.viewDash = function (params) {
  const u = me();
  const p = INV.portfolio(u.id);
  const tf = (params && params.tf && ['1D', '1W', '1M', '3M', '1Y', 'ALL'].includes(params.tf)) ? params.tf : '1M';
  const series = INV.portfolioSeries(tf, u.id);
  const hasHold = p.holdings.length > 0;

  const sliceMap = {};
  p.holdings.forEach(h => { const q = INV.quote(h.ticker); if (q) sliceMap[h.ticker] = h.shares * q.price; });
  const slices = Object.keys(sliceMap).map(t => ({ ticker: t, value: sliceMap[t] })).sort((a, b) => b.value - a.value);
  const cols = ['#2ee6c9', '#3aa0ff', '#8b7bff', '#ffc861', '#2fd6a6', '#ff7bb0', '#5ad1ff', '#ff9f5a'];

  const quick = [
    { ic: 'download', label: 'Deposit', nav: '#/deposit' },
    { ic: 'send', label: 'Withdraw', nav: '#/withdraw' },
    { ic: 'trend', label: 'Buy', nav: '#/invest/market' },
    { ic: 'wallet', label: 'Sell', nav: hasHold ? '#/invest/orders' : '#/invest/market' },
    { ic: 'star', label: 'Watchlist', nav: '#/invest/watchlist' }
  ];

  return `
  <div class="page-head">
    <div class="between">
      <div><div class="section-title" style="margin:0">Invest</div></div>
      <div class="row" style="gap:8px">
        <a href="#/invest/orders" class="btn btn-sm btn-ghost">${ic('clock', 14)} Orders</a>
        <a href="#/invest/market" class="btn btn-sm btn-soft">${ic('search', 14)} Market</a>
      </div>
    </div>
  </div>

  <div class="inv-hero">
    <div class="tiny muted">Total portfolio value</div>
    <div class="inv-big"><span data-lv="pv-coins">${coins(p.valueCoins)}</span> <span class="inv-unit">WC</span></div>
    <div class="tiny muted" data-lv="pv-usd">≈ ${usd(p.valueUsd)} USD</div>
    <div class="inv-day ${INV.chgClass(p.dayUsd)}">
      ${ic(p.dayUsd >= 0 ? 'trend' : 'down', 14)}
      <b>${p.dayUsd >= 0 ? '+' : '−'}${usd(Math.abs(p.dayUsd))}</b>
      <span>(${p.dayUsd >= 0 ? '+' : '−'}${Math.abs(p.dayPct).toFixed(2)}%) today</span>
    </div>
    <div class="inv-hero-grid">
      <div><span class="tiny muted">Invested</span><b data-lv="pv-cost">${coins(usdToCoins(p.costUsd))} WC</b></div>
      <div><span class="tiny muted">Earnings</span><b class="${INV.chgClass(p.earningsUsd)}" data-lv="pv-earn">${p.earningsUsd >= 0 ? '+' : '−'}${coins(usdToCoins(Math.abs(p.earningsUsd)))} WC</b></div>
      <div><span class="tiny muted">Available cash</span><b data-lv="cash">${coins(u.balance)} WC</b></div>
    </div>
  </div>

  <div class="inv-actions">${quick.map(q => `<a href="${q.nav}" class="inv-act"><span class="inv-act-ic">${ic(q.ic, 18)}</span><span>${q.label}</span></a>`).join('')}</div>

  <div class="card inv-chartcard">
    <div class="between" style="align-items:center">
      <div><div class="card-title" style="margin:0">Portfolio performance</div>
        <div class="tiny muted">${hasHold ? tf + ' · live simulation' : 'No positions yet'}</div></div>
      ${INV.seg(tf)}
    </div>
    <div class="inv-chart" data-chart="__portfolio__|${tf}|line">
      ${hasHold ? INV.lineChart(series, { h: 150 }) : `<div class="inv-empty">${ic('trend', 26)}<p class="small muted">Buy your first stock to start tracking performance.</p><a href="#/invest/market" class="btn btn-sm btn-primary">Explore market</a></div>`}
    </div>
  </div>

  <div class="inv-two">
    <div class="card">
      <div class="card-title">Allocation</div>
      ${slices.length ? `<div class="inv-alloc">${INV.donut(slices)}
        <div class="inv-legend">${slices.slice(0, 6).map((s, i) => `<div class="row" style="gap:7px;align-items:center">
          <i style="width:8px;height:8px;border-radius:3px;background:${cols[i % cols.length]};display:inline-block"></i>
          <span class="tiny ellipsis grow">${esc(s.ticker)}</span>
          <span class="tiny muted">${((s.value / (p.valueUsd || 1)) * 100).toFixed(0)}%</span></div>`).join('')}</div></div>`
        : `<div class="inv-empty"><p class="small muted">Allocation appears once you own stocks.</p></div>`}
    </div>

    <div class="card">
      <div class="between"><div class="card-title" style="margin:0">My holdings</div>
        <span class="tiny muted">${p.holdings.length} position${p.holdings.length === 1 ? '' : 's'}</span></div>
      ${hasHold ? `<div class="inv-list">${p.holdings.map(h => {
        const s = INV.stock(h.ticker) || { ticker: h.ticker, name: h.ticker, color: '#3aa0ff' };
        const q = INV.quote(h.ticker) || { price: h.avgPrice, prevClose: h.avgPrice, changePct: 0 };
        const val = h.shares * q.price;
        const pl = val - h.shares * h.avgPrice;
        const plPct = (h.avgPrice ? (q.price / h.avgPrice - 1) * 100 : 0);
        return `<a class="inv-row" href="#/invest/stock/${s.ticker}">
          ${INV.logoHTML(s)}
          <div class="grow" style="min-width:0">
            <div class="small ellipsis" style="font-weight:650">${esc(s.name)}</div>
            <div class="tiny muted">${h.shares.toFixed(4)} sh · avg ${usd(h.avgPrice)}</div>
          </div>
          <div style="text-align:right">
            <div class="small" style="font-weight:650" data-lv="price:${s.ticker}">${usd(q.price)}</div>
            <div class="tiny ${INV.chgClass(pl)}">${pl >= 0 ? '+' : '−'}${usd(Math.abs(pl))} (${plPct >= 0 ? '+' : '−'}${Math.abs(plPct).toFixed(2)}%)</div>
          </div></a>`;
      }).join('')}</div>` : `<div class="inv-empty">${ic('bag', 26)}<p class="small muted">Your portfolio is empty. Every WhaleChat user starts with zero positions — no demo data.</p><a href="#/invest/market" class="btn btn-sm btn-primary">Browse stocks</a></div>`}
    </div>
  </div>

  <div class="card inv-note">${ic('shield', 14)} <span class="tiny">Prices on this build are <b>simulated</b> for demonstration, moving every 5 seconds. Trades settle instantly against your Whale Coin balance at 1 WC = $0.50.</span></div>`;
};

/* ------------------------------ market ------------------------------ */
INV.marketCat = 'Top Gainers';
INV.marketQuery = '';
INV.CATS = ['Top Gainers', 'Top Losers', 'Most Traded', 'Trending', 'Technology', 'Crypto', 'Dividend', 'New'];

INV.marketFiltered = function () {
  let list = INV.stocks();
  const q = INV.marketQuery.trim().toLowerCase();
  if (q) {
    list = list.filter(s => s.ticker.toLowerCase().includes(q) || s.name.toLowerCase().includes(q) || (s.sector || '').toLowerCase().includes(q));
  } else {
    const cat = INV.marketCat;
    if (cat === 'Top Gainers') list = list.sort((a, b) => (INV.quote(b.ticker).changePct) - (INV.quote(a.ticker).changePct));
    else if (cat === 'Top Losers') list = list.sort((a, b) => (INV.quote(a.ticker).changePct) - (INV.quote(b.ticker).changePct));
    else if (cat === 'Most Traded') list = list.sort((a, b) => (INV.quote(b.ticker).vol) - (INV.quote(a.ticker).vol));
    else if (cat === 'Trending') list = list.slice().sort((a, b) => Math.abs(INV.quote(b.ticker).changePct) - Math.abs(INV.quote(a.ticker).changePct));
    else if (cat === 'Crypto') list = list.filter(s => s.crypto);
    else if (cat === 'Dividend') list = list.filter(s => (s.div || 0) > 0).sort((a, b) => b.div - a.div);
    else if (cat === 'New') list = list.filter(s => s.isNew || s.custom).slice().reverse();
    else list = list.filter(s => s.sector === cat);
  }
  return list;
};
INV.cardHTML = function (s) {
  const q = INV.quote(s.ticker);
  const c = INV.chgClass(q.changePct);
  return `<a class="inv-mcard" href="#/invest/stock/${s.ticker}">
    <div class="row" style="gap:9px;align-items:center">
      ${INV.logoHTML(s, 32)}
      <div class="grow" style="min-width:0">
        <div class="small ellipsis" style="font-weight:700">${esc(s.ticker)}</div>
        <div class="tiny muted ellipsis row" style="gap:5px"><span class="ellipsis">${esc(s.name)}</span>${INV.dividendBadge ? INV.dividendBadge(s.ticker) : ''}</div>
      </div>
      ${s.paused || INV.paused(s.ticker) ? `<span class="badge badge-warn" style="font-size:9px">Paused</span>` : ''}
    </div>
    <div class="inv-sparkwrap" data-spark="${s.ticker}">${INV.spark(s.ticker)}</div>
    <div class="between" style="align-items:flex-end;margin-top:2px">
      <div>
        <div class="small" style="font-weight:700" data-lv="price:${s.ticker}">${usd(q.price)}</div>
        <div class="tiny muted" data-lv="wc:${s.ticker}">${coins(usdToCoins(q.price))} WC</div>
      </div>
      <span class="inv-chg ${c} ${q.dir > 0 ? 'flash-up' : q.dir < 0 ? 'flash-down' : ''}" data-lv="pct:${s.ticker}">${q.changePct >= 0 ? '+' : ''}${q.changePct.toFixed(2)}%</span>
    </div></a>`;
};
INV.viewMarket = function () {
  const list = INV.marketFiltered();
  return `
  <div class="page-head"><div class="between">
    <div class="row" style="gap:10px;align-items:center"><a href="#/invest" class="btn-icon">${ic('back', 18)}</a>
      <div class="section-title" style="margin:0">Market</div></div>
    <a href="#/invest/watchlist" class="btn btn-sm btn-ghost">${ic('star', 14)} Watchlist</a>
  </div></div>
  <div class="searchbar" style="margin-bottom:10px">${ic('search', 17)}
    <input id="ivSearch" placeholder="Search company or ticker — AAPL, TSLA, NVDA…" value="${esc(INV.marketQuery)}" autocomplete="off"/></div>
  <div class="chip-row inv-cats" id="ivCats">${INV.CATS.map(c => `<button class="chip ${c === INV.marketCat && !INV.marketQuery ? 'on' : ''}" data-act="inv-cat" data-cat="${esc(c)}">${esc(c)}</button>`).join('')}</div>
  <div class="inv-grid" id="ivList">${list.length ? list.map(INV.cardHTML).join('') : `<div class="inv-empty" style="grid-column:1/-1">${ic('search', 26)}<p class="small muted">No stocks match “${esc(INV.marketQuery)}”.</p></div>`}</div>
  <div class="card inv-note">${ic('help', 14)} <span class="tiny">Simulated market data, refreshed every 5 seconds. Connect a market data API in Admin → Stocks to switch to live quotes.</span></div>`;
};
AFTER.invest = function (parts) {
  const sub = parts[1] || '';
  if (sub === 'market') {
    const inp = document.getElementById('ivSearch');
    if (inp) {
      if (INV.marketQuery) { inp.focus(); inp.setSelectionRange(inp.value.length, inp.value.length); }
      inp.addEventListener('input', () => {
        INV.marketQuery = inp.value;
        const box = document.getElementById('ivList');
        const list = INV.marketFiltered();
        if (box) box.innerHTML = list.length ? list.map(INV.cardHTML).join('')
          : `<div class="inv-empty" style="grid-column:1/-1">${ic('search', 26)}<p class="small muted">No matches.</p></div>`;
        $$('#ivCats .chip').forEach(c => c.classList.toggle('on', !INV.marketQuery && c.dataset.cat === INV.marketCat));
      });
    }
  }
  if (sub === 'stock') INV.bindTrade();
};

/* ------------------------------ stock details ------------------------------ */
INV.tradeMode = 'market';
INV.viewStock = function (rawTicker, params) {
  const u = me();
  const s = INV.stock(String(rawTicker || '').toUpperCase());
  if (!s) return `<div class="empty">${ic('search', 26)}<h3>Stock not found</h3><p>That ticker is not listed on WhaleChat Invest.</p><a href="#/invest/market" class="btn btn-primary">Back to market</a></div>`;
  const q = INV.quote(s.ticker);
  const tf = (params && ['1D', '1W', '1M', '3M', '1Y', 'ALL'].includes(params.tf)) ? params.tf : '1D';
  const mode = (params && params.mode === 'candle') ? 'candle' : 'line';
  const vals = INV.series(s.ticker, tf);
  const all = INV.series(s.ticker, 'ALL');
  const hi52 = Math.max(...all), lo52 = Math.min(...all);
  const hold = INV.holding(s.ticker, u.id);
  const watching = INV.watching(s.ticker);
  const paused = INV.paused(s.ticker);
  const fee = INV.fee();
  const news = INV.news(s);
  const chart = mode === 'candle' ? INV.candleChart(vals) : INV.lineChart(vals, { h: 150 });
  const chg = q.changePct;
  const links = tfList => tfList.map(x => `#/invest/stock/${s.ticker}?tf=${x}&mode=${mode}`);

  return `
  <div class="page-head"><div class="between">
    <div class="row" style="gap:10px;align-items:center">
      <a href="#/invest/market" class="btn-icon">${ic('back', 18)}</a>
      <div class="row" style="gap:9px;align-items:center">${INV.logoHTML(s, 34)}
        <div><div class="small" style="font-weight:700;display:flex;align-items:center;gap:6px">${esc(s.name)}${INV.dividendBadge ? INV.dividendBadge(s.ticker) : ''}</div>
        <div class="tiny muted">${esc(s.ticker)} · ${esc(s.sector)}</div></div></div>
    </div>
    <div class="row" style="gap:6px">
      <button class="btn btn-sm ${watching ? 'btn-soft' : 'btn-ghost'}" data-act="inv-star" data-t="${s.ticker}">
        ${ic('star', 15)} ${watching ? 'Watching' : 'Watch'}</button>
      <button class="btn btn-sm btn-ghost" data-act="inv-alert" data-t="${s.ticker}">${ic('bell', 15)}</button>
    </div>
  </div></div>

  <div class="card inv-pricecard">
    <div class="between" style="align-items:flex-end">
      <div>
        <div class="inv-price" data-lv="price:${s.ticker}">${usd(q.price)}</div>
        <div class="tiny muted" data-lv="wc:${s.ticker}">${coins(usdToCoins(q.price))} WC</div>
      </div>
      <div class="inv-chg ${INV.chgClass(chg)}" data-lv="pct:${s.ticker}">
        ${chg >= 0 ? '▲' : '▼'} ${Math.abs(chg).toFixed(2)}% · ${usd(Math.abs(q.changeUsd))}</div>
    </div>
    ${paused ? `<div class="inv-paused">${ic('pause', 13)} Trading is paused for ${esc(s.ticker)} by an administrator.</div>` : ''}
    <div class="between" style="margin-top:10px;align-items:center">
      <div class="inv-seg">${['1D', '1W', '1M', '1Y', 'ALL'].map((x, i) => `<a href="${links([x])[0]}" class="inv-segbtn ${x === tf ? 'on' : ''}">${x}</a>`).join('')}</div>
      <div class="inv-seg">
        <a href="#/invest/stock/${s.ticker}?tf=${tf}&mode=line" class="inv-segbtn ${mode === 'line' ? 'on' : ''}">Line</a>
        <a href="#/invest/stock/${s.ticker}?tf=${tf}&mode=candle" class="inv-segbtn ${mode === 'candle' ? 'on' : ''}">Candles</a>
      </div>
    </div>
    <div class="inv-chart" data-chart="${s.ticker}|${tf}|${mode}">${chart}</div>
    <div class="tiny muted center wc-feed-notice" data-market-notice="1" style="margin-top:4px">Simulated market data · 24/7</div>
  </div>

  <div class="inv-two">
    <div class="card">
      <div class="card-title">Trade</div>
      <div class="inv-mode">
        <button class="inv-modebtn ${INV.tradeMode === 'market' ? 'on' : ''}" data-act="inv-mode" data-mode="market">Market</button>
        <button class="inv-modebtn ${INV.tradeMode === 'limit' ? 'on' : ''}" data-act="inv-mode" data-mode="limit">Limit</button>
      </div>
      ${INV.tradeMode === 'limit' ? `<div class="field"><label class="label">Limit price (USD)</label>
        <input class="input" id="ivLimit" type="number" step="0.01" min="0" value="${q.price.toFixed(2)}"/></div>` : ''}
      <div class="field"><label class="label">Amount in USD</label>
        <div class="input-wrap"><span class="inv-prefix">$</span>
          <input class="input" id="ivUsd" type="number" step="0.01" min="0" placeholder="0.00"/></div></div>
      <div class="field"><label class="label">Amount in Whale Coin</label>
        <div class="input-wrap"><span class="inv-prefix">WC</span>
          <input class="input" id="ivCoins" type="number" step="0.01" min="0" placeholder="0.00"/></div></div>
      <div class="field"><label class="label">Shares</label>
        <input class="input" id="ivQty" type="number" step="0.0001" min="0" placeholder="0.0000"/></div>
      <div class="inv-sum" id="ivSum">
        <div class="between"><span class="tiny muted">Estimated cost</span><b class="tiny" id="ivCost">${coins(0)} WC</b></div>
        <div class="between"><span class="tiny muted">Fee (${fee}%)</span><b class="tiny" id="ivFee">${coins(0)} WC</b></div>
        <div class="between"><span class="tiny muted">Balance after trade</span><b class="tiny" id="ivAfter">${coins(u.balance)} WC</b></div>
        <div class="between"><span class="tiny muted">You own</span><b class="tiny" id="ivOwned">${hold ? hold.shares.toFixed(4) : '0.0000'} sh</b></div>
      </div>
      <div class="row" style="gap:8px;margin-top:10px">
        <button class="btn btn-primary grow" data-act="inv-trade" data-side="buy" data-t="${s.ticker}" ${paused ? 'disabled' : ''}>${ic('trend', 16)} Buy stock</button>
        <button class="btn btn-ghost grow" data-act="inv-trade" data-side="sell" data-t="${s.ticker}" ${paused || !hold ? 'disabled' : ''}>Sell${hold ? ' ' + hold.shares.toFixed(2) : ''}</button>
      </div>
      <div class="tiny muted center mt6">${ic('lock', 11)} Requires your transaction PIN · settles instantly from Whale Coin balance</div>
    </div>

    <div class="card">
      <div class="card-title">Key statistics</div>
      <div class="inv-statgrid">
        <div><span class="tiny muted">Open</span><b>${usd(q.open)}</b></div>
        <div><span class="tiny muted">Day high</span><b>${usd(q.dayHigh)}</b></div>
        <div><span class="tiny muted">Day low</span><b>${usd(q.dayLow)}</b></div>
        <div><span class="tiny muted">Volume</span><b>${(q.vol / 1e6).toFixed(1)}M</b></div>
        <div><span class="tiny muted">Market cap</span><b>$${(s.mcap || 0).toFixed(0)}B</b></div>
        <div><span class="tiny muted">P/E ratio</span><b>${s.pe ? s.pe.toFixed(1) : '—'}</b></div>
        <div><span class="tiny muted">52W high</span><b>${usd(hi52)}</b></div>
        <div><span class="tiny muted">52W low</span><b>${usd(lo52)}</b></div>
        <div><span class="tiny muted">Dividend yield</span><b>${(INV.dividendYield ? INV.dividendYield(s.ticker) : (s.div || 0)) > 0 ? (INV.dividendYield ? INV.dividendYield(s.ticker) : s.div).toFixed(2) + '%' : 'None'}</b></div>
        <div><span class="tiny muted">Your avg</span><b>${hold ? usd(hold.avgPrice) : '—'}</b></div>
      </div>
    </div>
  </div>

  <div class="inv-two">
    <div class="card">
      <div class="card-title">About ${esc(s.name)}</div>
      <p class="small" style="line-height:1.65;margin:0 0 10px">${esc(s.about || '')}</p>
      <div class="kv"><span class="k">Sector</span><span class="v">${esc(s.sector)}</span></div>
      <div class="kv"><span class="k">CEO</span><span class="v">${esc(s.ceo || '—')}</span></div>
      <div class="kv"><span class="k">Website</span><span class="v"><a class="link" href="https://${esc(s.website || '')}" target="_blank" rel="noopener">${esc(s.website || '—')}</a></span></div>
    </div>
    <div class="card">
      <div class="card-title">Latest news</div>
      ${news.map(n => `<div class="inv-news"><div class="tiny muted">${esc(n.src)} · ${n.ago}h ago</div>
        <div class="small" style="font-weight:650;margin:2px 0 3px">${esc(n.title)}</div>
        <div class="tiny muted" style="line-height:1.55">${esc(n.body)}</div></div>`).join('')}
      <div class="tiny muted mt6">Simulated editorial content for this build.</div>
    </div>
  </div>`;
};

INV.bindTrade = function () {
  const usdEl = document.getElementById('ivUsd');
  const coinEl = document.getElementById('ivCoins');
  const qtyEl = document.getElementById('ivQty');
  if (!usdEl || !coinEl || !qtyEl) return;
  const u = me();
  const t = (location.hash.split('/')[3] || '').split('?')[0];
  const s = INV.stock(t); if (!s) return;
  const q = INV.quote(s.ticker);
  const price = q.price;
  const fee = INV.fee() / 100;

  const paint = () => {
    const qty = Number(qtyEl.value) || 0;
    const grossUsd = qty * price;
    const feeUsd = grossUsd * fee;
    const totalUsd = grossUsd + feeUsd;
    const costCoins = usdToCoins(totalUsd);
    const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    set('ivCost', coins(costCoins) + ' WC');
    set('ivFee', coins(usdToCoins(feeUsd)) + ' WC');
    set('ivAfter', coins(u.balance - costCoins) + ' WC');
    const hold = INV.holding(s.ticker, u.id);
    set('ivOwned', ((hold ? hold.shares : 0) + qty).toFixed(4) + ' sh');
  };
  const fromUsd = () => {
    const v = Math.max(0, Number(usdEl.value) || 0);
    coinEl.value = v ? String(Math.round(usdToCoins(v) * 100) / 100) : '';
    qtyEl.value = v ? String(Math.round((v / price) * 10000) / 10000) : '';
    paint();
  };
  const fromCoins = () => {
    const c = Math.max(0, Number(coinEl.value) || 0);
    const v = coinsToUsd(c);
    usdEl.value = c ? v.toFixed(2) : '';
    qtyEl.value = c ? String(Math.round((v / price) * 10000) / 10000) : '';
    paint();
  };
  const fromQty = () => {
    const qty = Math.max(0, Number(qtyEl.value) || 0);
    const v = qty * price;
    usdEl.value = qty ? v.toFixed(2) : '';
    coinEl.value = qty ? String(Math.round(usdToCoins(v) * 100) / 100) : '';
    paint();
  };
  usdEl.addEventListener('input', fromUsd);
  coinEl.addEventListener('input', fromCoins);
  qtyEl.addEventListener('input', fromQty);
  const maxBtn = document.getElementById('ivMax');
  if (maxBtn) maxBtn.onclick = () => { usdEl.value = (coinsToUsd(u.balance) / (1 + fee)).toFixed(2); fromUsd(); };
  paint();
};

/* ------------------------------ trade execution ------------------------------ */
INV.execute = async function (side, ticker, shares, opts) {
  const o = opts || {};
  const u = me();
  const s = INV.stock(ticker);
  if (!u || !s) return false;
  const q = INV.quote(ticker);
  const price = o.fillPrice || q.price;
  const feePct = INV.fee() / 100;
  if (INV.paused(ticker)) { toast(`${ticker} trading is paused`, 'err'); return false; }
  if (!(shares > 0)) { toast('Enter a quantity of shares', 'err'); return false; }

  const grossUsd = shares * price;
  const feeUsd = grossUsd * feePct;
  const netUsd = side === 'buy' ? grossUsd + feeUsd : grossUsd - feeUsd;
  const coinsDelta = usdToCoins(netUsd);

  if (side === 'buy' && u.balance < coinsDelta) {
    toast(`Need ${coins(coinsDelta)} WC — top up your wallet`, 'err');
    return false;
  }
  const hold = INV.holding(ticker, u.id);
  if (side === 'sell' && (!hold || hold.shares + 1e-9 < shares)) {
    toast(`You only own ${hold ? hold.shares.toFixed(4) : 0} shares`, 'err');
    return false;
  }

  if (!o.limit && !o.noPin) {
    if (!u.pin) { toast('Create your transaction PIN first', 'err'); go('set-pin'); return false; }
    const pin = await askPin({ title: side === 'buy' ? 'Confirm purchase' : 'Confirm sale', sub: `Enter your PIN to ${side} ${shares.toFixed(4)} ${ticker}` });
    if (!pin) return false;
    if (await hash('pin::' + pin) !== u.pin) { toast('Incorrect PIN', 'err'); return false; }
  }

  // apply balances
  if (side === 'buy') {
    u.balance = Math.round((u.balance - coinsDelta) * 100) / 100;
    if (hold) {
      const newShares = hold.shares + shares;
      hold.avgPrice = Math.round(((hold.shares * hold.avgPrice) + grossUsd) / newShares * 10000) / 10000;
      hold.shares = newShares;
      hold.updatedAt = Date.now();
    } else {
      DB.holdings.push({ id: uid('hd'), userId: u.id, ticker, shares, avgPrice: Math.round(price * 100) / 100, createdAt: Date.now(), updatedAt: Date.now() });
    }
  } else {
    u.balance = Math.round((u.balance + coinsDelta) * 100) / 100;
    hold.shares = Math.round((hold.shares - shares) * 1e8) / 1e8;
    if (hold.shares <= 1e-7) DB.holdings = DB.holdings.filter(h => h.id !== hold.id);
    hold.updatedAt = Date.now();
  }
  const plUsd = side === 'sell' && hold ? (price - hold.avgPrice) * shares : 0;

  if (o.orderId) {
    const rec = DB.trades.find(x => x.id === o.orderId);
    if (rec) { rec.status = 'Completed'; rec.priceUsd = price; rec.coins = coinsDelta; rec.filledAt = Date.now(); }
  } else {
    DB.trades.unshift({
      id: uid('tr'), userId: u.id, ticker, name: s.name, side,
      shares, priceUsd: Math.round(price * 100) / 100, coins: coinsDelta,
      feeCoins: usdToCoins(feeUsd), type: o.limit ? 'limit' : 'market',
      status: 'Completed', limitUsd: o.limitUsd || null,
      plUsd: Math.round(plUsd * 100) / 100, createdAt: Date.now()
    });
  }
  tx(u.id, 'stock-' + side, `${side === 'buy' ? 'Bought' : 'Sold'} ${shares.toFixed(4)} ${ticker} @ ${usd(price)}`,
    side === 'buy' ? -coinsDelta : coinsDelta, { ticker, shares, priceUsd: price });
  notify(u.id, side === 'buy' ? 'Purchase complete' : 'Sale complete',
    `${side === 'buy' ? 'Bought' : 'Sold'} ${shares.toFixed(4)} ${ticker} @ ${usd(price)} · ${coins(coinsDelta)} WC`,
    '#/invest/stock/' + ticker, 'trend');
  toast(`${side === 'buy' ? 'Bought' : 'Sold'} ${shares.toFixed(4)} ${ticker}`, 'ok');
  persist(); render();
  return true;
};

App.invTrade = async function (id, ds) {
  const side = ds.side === 'sell' ? 'sell' : 'buy';
  const ticker = ds.t;
  const qtyEl = document.getElementById('ivQty');
  const shares = Number(qtyEl && qtyEl.value) || 0;
  const limitEl = document.getElementById('ivLimit');
  if (INV.tradeMode === 'limit' && limitEl) {
    const limitUsd = Number(limitEl.value) || INV.quote(ticker).price;
    if (!shares) return toast('Enter a quantity of shares', 'err');
    const u = me();
    if (!u.pin) { toast('Create your transaction PIN first', 'err'); return go('set-pin'); }
    const pin = await askPin({ title: 'Confirm limit order', sub: `Enter your PIN to place this ${side} order` });
    if (!pin) return;
    if (await hash('pin::' + pin) !== u.pin) return toast('Incorrect PIN', 'err');
    DB.trades.unshift({
      id: uid('tr'), userId: u.id, ticker, name: (INV.stock(ticker) || {}).name, side, shares,
      priceUsd: limitUsd, limitUsd, coins: usdToCoins(shares * limitUsd),
      feeCoins: usdToCoins(shares * limitUsd * INV.fee() / 100), type: 'limit', status: 'Pending',
      plUsd: 0, createdAt: Date.now()
    });
    notify(u.id, 'Limit order placed', `${side === 'buy' ? 'Buy' : 'Sell'} ${shares} ${ticker} at ${usd(limitUsd)} — waiting for the market.`,
      '#/invest/orders', 'clock');
    persist(); render(); toast('Limit order placed — it fills when the price is reached', 'ok');
    return;
  }
  await INV.execute(side, ticker, shares, {});
};
App.invMode = function (id, ds) { INV.tradeMode = ds.mode === 'limit' ? 'limit' : 'market'; render(); };
App.invCat = function (id, ds) { INV.marketCat = ds.cat; INV.marketQuery = ''; render(); };
App.invStar = function (id, ds) {
  const u = me(), t = ds.t;
  const i = DB.watchlist.findIndex(w => w.userId === u.id && w.ticker === t);
  if (i >= 0) { DB.watchlist.splice(i, 1); toast('Removed from watchlist'); }
  else { DB.watchlist.push({ id: uid('wl'), userId: u.id, ticker: t, createdAt: Date.now() }); toast('Added to watchlist', 'ok'); }
  persist(); render();
};
App.invAlert = function (id, ds) {
  const s = INV.stock(ds.t); if (!s) return;
  const q = INV.quote(s.ticker);
  openModal(modalShell(`Price alert · ${s.ticker}`, `
    <div class="small muted" style="margin-bottom:10px">Current price ${usd(q.price)}. We will notify you in-app, by push and by email when the target is reached.</div>
    <div class="field"><label class="label">Alert me when price is</label>
      <select class="input" id="alDir"><option value="above">At or above</option><option value="below">At or below</option></select></div>
    <div class="field"><label class="label">Target price (USD)</label>
      <input class="input" id="alTarget" type="number" step="0.01" value="${q.price.toFixed(2)}"/></div>`,
    `<button class="btn btn-ghost" data-close style="flex:1">Cancel</button>
     <button class="btn btn-primary" id="alSave" style="flex:1">Set alert</button>`), { locked: false });
  const btn = document.getElementById('alSave');
  if (btn) btn.onclick = () => {
    const dir = document.getElementById('alDir').value;
    const target = Number(document.getElementById('alTarget').value);
    if (!(target > 0)) return toast('Enter a target price', 'err');
    DB.alerts.push({ id: uid('al'), userId: me().id, ticker: s.ticker, dir, target, active: true, createdAt: Date.now() });
    closeModal(); persist();
    if (typeof Notification !== 'undefined' && Notification.permission === 'default') { try { Notification.requestPermission(); } catch (e) {} }
    toast(`Alert set for ${s.ticker} ${dir} ${usd(target)}`, 'ok');
    render();
  };
};
App.invDelAlert = function (id) {
  DB.alerts = DB.alerts.filter(a => a.id !== id); persist(); render(); toast('Alert removed');
};

/* ------------------------------ watchlist ------------------------------ */
INV.viewWatchlist = function () {
  const u = me();
  const rows = DB.watchlist.filter(w => w.userId === u.id);
  const alerts = INV.alerts();
  return `
  <div class="page-head"><div class="between">
    <div class="row" style="gap:10px;align-items:center"><a href="#/invest" class="btn-icon">${ic('back', 18)}</a>
      <div class="section-title" style="margin:0">Watchlist</div></div>
    <a href="#/invest/market" class="btn btn-sm btn-soft">${ic('plus', 14)} Add stocks</a>
  </div></div>
  <div class="card">
    <div class="card-title">Starred stocks</div>
    ${rows.length ? `<div class="inv-list">${rows.map(w => {
      const s = INV.stock(w.ticker); if (!s) return '';
      const q = INV.quote(s.ticker);
      return `<a class="inv-row" href="#/invest/stock/${s.ticker}">
        ${INV.logoHTML(s, 34)}
        <div class="grow" style="min-width:0"><div class="small" style="font-weight:650">${esc(s.ticker)}</div>
          <div class="tiny muted ellipsis">${esc(s.name)}</div>
          <div class="div-row">${INV.dividendBadge ? INV.dividendBadge(s.ticker) : ''}${INV.dividendEstimate ? INV.dividendEstimate(s.ticker, 100, 1440, '1d/100WC') : ''}</div></div>
        <div style="text-align:right"><div class="small" style="font-weight:650" data-lv="price:${s.ticker}">${usd(q.price)}</div>
          <div class="tiny ${INV.chgClass(q.changePct)}" data-lv="pct:${s.ticker}">${q.changePct >= 0 ? '+' : ''}${q.changePct.toFixed(2)}%</div></div>
        <button class="btn-icon" data-act="inv-star" data-t="${s.ticker}" title="Unstar">${ic('x', 15)}</button></a>`;
    }).join('')}</div>` : `<div class="inv-empty">${ic('star', 26)}<p class="small muted">No starred stocks yet. Tap the star on any stock to follow it.</p></div>`}
  </div>
  <div class="card">
    <div class="card-title">Price alerts</div>
    ${alerts.length ? `<div class="inv-list">${alerts.map(a => {
      const q = INV.quote(a.ticker);
      const hit = !a.active;
      return `<div class="inv-row">
        <div class="grow"><div class="small" style="font-weight:650">${esc(a.ticker)} ${a.dir === 'above' ? '≥' : '≤'} ${usd(a.target)}</div>
          <div class="tiny muted">Now ${usd(q.price)} ${hit ? '· triggered' : '· waiting'}</div></div>
        <span class="badge ${hit ? 'badge-success' : 'badge-warn'}">${hit ? 'Hit' : 'Active'}</span>
        <button class="btn-icon" data-act="inv-del-alert" data-id="${a.id}">${ic('trash', 15)}</button></div>`;
    }).join('')}</div>` : `<div class="inv-empty">${ic('bell', 26)}<p class="small muted">No price alerts yet. Open a stock and tap the bell.</p></div>`}
  </div>`;
};

/* ------------------------------ orders ------------------------------ */
INV.viewOrders = function () {
  const u = me();
  const trades = INV.trades(u.id);
  return `
  <div class="page-head"><div class="between">
    <div class="row" style="gap:10px;align-items:center"><a href="#/invest" class="btn-icon">${ic('back', 18)}</a>
      <div class="section-title" style="margin:0">Orders</div></div>
    <a href="#/invest/market" class="btn btn-sm btn-primary">${ic('plus', 14)} New trade</a>
  </div></div>
  <div class="card">
    ${trades.length ? `<div class="inv-list">${trades.map(t => {
      const s = INV.stock(t.ticker) || { ticker: t.ticker, color: '#3aa0ff' };
      const badge = t.status === 'Completed' ? 'badge-success' : t.status === 'Pending' ? 'badge-warn' : 'badge-danger';
      return `<div class="inv-row" style="align-items:flex-start">
        ${INV.logoHTML(s, 34)}
        <div class="grow" style="min-width:0">
          <div class="small" style="font-weight:650">${t.side === 'buy' ? 'Buy' : 'Sell'} ${esc(t.ticker)} <span class="tiny muted">· ${t.type}</span></div>
          <div class="tiny muted">${t.shares.toFixed(4)} sh @ ${usd(t.priceUsd)} · ${dateLabel(t.createdAt)} ${clockTime(t.createdAt)}</div>
          <div class="tiny">${t.side === 'buy' ? '−' : '+'}${coins(t.coins)} WC <span class="muted">(${usd(coinsToUsd(t.coins))})</span>
            ${t.plUsd ? `<span class="${INV.chgClass(t.plUsd)}"> · P/L ${t.plUsd >= 0 ? '+' : '−'}${usd(Math.abs(t.plUsd))}</span>` : ''}</div>
        </div>
        <span class="badge ${badge}">${t.status}</span></div>`;
    }).join('')}</div>` : `<div class="inv-empty">${ic('clock', 26)}<p class="small muted">No orders yet. Your completed and pending trades appear here.</p></div>`}
  </div>`;
};

/* ------------------------------ admin: stocks ------------------------------ */
INV.adminTabs = function () {
  const sub = 'stocks';
  return `<div class="admin-nav">${ADMIN_NAV.map(n => {
    const key = n.href.replace('#/admin', '') || '';
    const on = key === '/' + sub;
    return `<a href="${n.href}" class="${on ? 'on' : ''}">${n.label}</a>`;
  }).join('')}</div>`;
};

INV.viewAdminStocks = function () {
  const u = me();
  if (!u || u.role !== 'admin') return `<div class="card empty"><div class="ic">${ic('lock', 26)}</div><h3>Admin access only</h3></div>`;
  INV.db();
  const stocks = INV.stocks().sort((a0, b0) => a0.ticker.localeCompare(b0.ticker));
  const trades = DB.trades.slice().sort((a, b) => b.createdAt - a.createdAt).slice(0, 25);
  const holders = {};
  DB.holdings.forEach(h => { (holders[h.userId] = holders[h.userId] || []).push(h); });
  const fee = INV.fee();

  return `${INV.adminTabs()}
  <div class="page-head"><div class="between">
    <div><div class="section-title" style="margin:0">Stocks & trading</div>
      <div class="tiny muted">Catalogue, pricing, fees, paused symbols and user exposure</div></div>
    <button class="btn btn-sm btn-primary" data-act="inv-admin-add">${ic('plus', 14)} Add stock</button>
  </div></div>

  <div class="grid-kpi">
    <div class="kpi"><span class="tiny muted">Listed stocks</span><b>${stocks.length}</b></div>
    <div class="kpi"><span class="tiny muted">Open positions</span><b>${DB.holdings.length}</b></div>
    <div class="kpi"><span class="tiny muted">Trades</span><b>${DB.trades.length}</b></div>
    <div class="kpi"><span class="tiny muted">Trading fee</span><b>${fee}%</b></div>
  </div>

  <div class="card">
    <div class="card-title">Trading fee</div>
    <div class="row" style="gap:8px;align-items:flex-end;flex-wrap:wrap">
      <div class="field grow" style="margin:0;min-width:140px"><label class="label">Fee per trade (%)</label>
        <input class="input" id="ivFeeInput" type="number" step="0.05" min="0" max="5" value="${fee}"/></div>
      <button class="btn btn-primary" data-act="inv-admin-fee">Save fee</button>
    </div>
    <div class="tiny muted mt6">Applied to both buys and sells. 0% disables fees entirely.</div>
  </div>

  <div class="card">
    <div class="card-title">Catalogue</div>
    <div class="table-wrap"><table class="inv-table">
      <thead><tr><th>Symbol</th><th>Company</th><th>Sector</th><th class="num">Price</th><th class="num">24h</th><th>Status</th><th></th></tr></thead>
      <tbody>${stocks.map(s => {
        const q = INV.quote(s.ticker);
        const paused = INV.paused(s.ticker);
        return `<tr>
          <td><b>${esc(s.ticker)}</b></td>
          <td class="ellipsis" style="max-width:150px">${esc(s.name)}</td>
          <td class="muted">${esc(s.sector || '—')}</td>
          <td class="num"><span data-lv="price:${s.ticker}">${usd(q.price)}</span></td>
          <td class="num ${INV.chgClass(Number(q.changePct) || 0)}">${(Number(q.changePct) || 0) >= 0 ? '+' : ''}${(Number(q.changePct) || 0).toFixed(2)}%</td>
          <td><span class="badge ${paused ? 'badge-warn' : 'badge-success'}">${paused ? 'Paused' : 'Live'}</span></td>
          <td class="row" style="gap:4px;justify-content:flex-end">
            <button class="btn btn-xs btn-ghost" data-act="inv-admin-pause" data-t="${s.ticker}">${paused ? 'Resume' : 'Pause'}</button>
            <button class="btn btn-xs btn-ghost" data-act="inv-admin-edit" data-t="${s.ticker}">${ic('edit', 13)}</button>
            <button class="btn btn-xs btn-ghost" data-act="inv-admin-del" data-t="${s.ticker}" style="color:var(--danger)">${ic('trash', 13)}</button>
          </td></tr>`;
      }).join('')}</tbody></table></div>
  </div>

  <div class="card">
    <div class="card-title">User portfolios</div>
    ${Object.keys(holders).length ? `<div class="table-wrap"><table class="inv-table">
      <thead><tr><th>User</th><th class="num">Positions</th><th class="num">Value</th><th class="num">P/L</th><th></th></tr></thead>
      <tbody>${Object.keys(holders).map(uidx => {
        const usr = findUser(uidx); if (!usr) return '';
        const p = INV.portfolio(uidx);
        return `<tr><td>@${esc(usr.username)}<div class="tiny muted">${esc(usr.fullName || '')}</div></td>
          <td class="num">${p.holdings.length}</td><td class="num">${usd(p.valueUsd)}</td>
          <td class="num ${INV.chgClass(p.earningsUsd)}">${p.earningsUsd >= 0 ? '+' : '−'}${usd(Math.abs(p.earningsUsd))}</td>
          <td style="text-align:right"><button class="btn btn-xs btn-ghost" data-act="inv-admin-bal" data-id="${usr.id}">Edit balance</button></td></tr>`;
      }).join('')}</tbody></table></div>` : `<div class="tiny muted">No user holds stocks yet.</div>`}
  </div>

  <div class="card">
    <div class="card-title">Recent trades (all users)</div>
    ${trades.length ? `<div class="inv-list">${trades.map(t => {
      const usr = findUser(t.userId);
      return `<div class="inv-row"><div class="grow" style="min-width:0">
        <div class="small" style="font-weight:650">${t.side === 'buy' ? 'Buy' : 'Sell'} ${esc(t.ticker)} <span class="tiny muted">@${esc(usr ? usr.username : 'unknown')}</span></div>
        <div class="tiny muted">${(Number(t.shares) || 0).toFixed(4)} sh @ ${usd(Number(t.priceUsd) || 0)} · ${dateLabel(t.createdAt)}</div></div>
        <span class="badge ${t.status === 'Completed' ? 'badge-success' : 'badge-warn'}">${t.status}</span></div>`;
    }).join('')}</div>` : `<div class="tiny muted">No trades yet.</div>`}
  </div>`;
};

INV.stockFormHTML = function (s) {
  const x = s || {};
  return `
  <div class="field"><label class="label">Ticker</label><input class="input" id="sfTicker" maxlength="6" value="${esc(x.ticker || '')}" placeholder="AAPL" ${x.ticker ? 'disabled' : ''}/></div>
  <div class="field"><label class="label">Company name</label><input class="input" id="sfName" value="${esc(x.name || '')}"/></div>
  <div class="field"><label class="label">Sector</label><input class="input" id="sfSector" value="${esc(x.sector || 'Technology')}" placeholder="Technology / Crypto / Financials"/></div>
  <div class="row" style="gap:8px">
    <div class="field grow"><label class="label">Price (USD)</label><input class="input" id="sfPrice" type="number" step="0.01" value="${x.price != null ? x.price : ''}"/></div>
    <div class="field grow"><label class="label">P/E</label><input class="input" id="sfPe" type="number" step="0.1" value="${x.pe != null ? x.pe : 0}"/></div>
  </div>
  <div class="row" style="gap:8px">
    <div class="field grow"><label class="label">Market cap ($B)</label><input class="input" id="sfMcap" type="number" step="1" value="${x.mcap != null ? x.mcap : 0}"/></div>
    <div class="field grow"><label class="label">Dividend (%)</label><input class="input" id="sfDiv" type="number" step="0.01" value="${x.div != null ? x.div : 0}"/></div>
  </div>
  <div class="row" style="gap:8px">
    <div class="field grow"><label class="label">CEO</label><input class="input" id="sfCeo" value="${esc(x.ceo || '')}"/></div>
    <div class="field grow"><label class="label">Website</label><input class="input" id="sfWeb" value="${esc(x.website || '')}" placeholder="example.com"/></div>
  </div>
  <div class="field"><label class="label">About</label><textarea class="input" id="sfAbout" rows="3">${esc(x.about || '')}</textarea></div>
  <div class="row" style="gap:14px;flex-wrap:wrap">
    <label class="checkline"><input type="checkbox" id="sfCrypto" ${x.crypto ? 'checked' : ''}/> <span class="small">Crypto stock</span></label>
    <label class="checkline"><input type="checkbox" id="sfNew" ${x.isNew ? 'checked' : ''}/> <span class="small">New listing</span></label>
  </div>`;
};
App.invAdminAdd = function () {
  openModal(modalShell('Add stock', INV.stockFormHTML(null),
    `<button class="btn btn-ghost" data-close style="flex:1">Cancel</button>
     <button class="btn btn-primary" id="sfSave" style="flex:1">Add stock</button>`), { locked: false });
  document.getElementById('sfSave').onclick = () => {
    const ticker = (document.getElementById('sfTicker').value || '').trim().toUpperCase().replace(/[^A-Z.]/g, '');
    const name = document.getElementById('sfName').value.trim();
    const price = Number(document.getElementById('sfPrice').value);
    if (!ticker || !name || !(price > 0)) return toast('Ticker, name and a price are required', 'err');
    if (INV.stock(ticker)) return toast('That ticker already exists', 'err');
    DB.stocks.push({
      id: 'st_' + ticker.toLowerCase(), ticker, name, sector: document.getElementById('sfSector').value.trim() || 'Other',
      price, prevClose: price, pe: Number(document.getElementById('sfPe').value) || 0,
      mcap: Number(document.getElementById('sfMcap').value) || 0, div: Number(document.getElementById('sfDiv').value) || 0,
      ceo: document.getElementById('sfCeo').value.trim(), website: document.getElementById('sfWeb').value.trim(),
      about: document.getElementById('sfAbout').value.trim(), color: '#3aa0ff',
      crypto: document.getElementById('sfCrypto').checked, isNew: document.getElementById('sfNew').checked,
      paused: false, custom: true, createdAt: Date.now()
    });
    INV.live[ticker] = null; INV.seriesCache = {};
    closeModal(); persist(); toast(`${ticker} listed`, 'ok'); render();
  };
};
App.invAdminEdit = function (id, ds) {
  const s = INV.stock(ds.t); if (!s) return;
  openModal(modalShell(`Edit ${s.ticker}`, INV.stockFormHTML(s),
    `<button class="btn btn-ghost" data-close style="flex:1">Cancel</button>
     <button class="btn btn-primary" id="sfSave" style="flex:1">Save changes</button>`), { locked: false });
  document.getElementById('sfSave').onclick = () => {
    const price = Number(document.getElementById('sfPrice').value);
    s.name = document.getElementById('sfName').value.trim() || s.name;
    s.sector = document.getElementById('sfSector').value.trim() || s.sector;
    if (price > 0) { const old = s.price; s.price = price; s.prevClose = old || price; INV.live[s.ticker] = null; }
    s.pe = Number(document.getElementById('sfPe').value) || 0;
    s.mcap = Number(document.getElementById('sfMcap').value) || 0;
    s.div = Number(document.getElementById('sfDiv').value) || 0;
    s.ceo = document.getElementById('sfCeo').value.trim();
    s.website = document.getElementById('sfWeb').value.trim();
    s.about = document.getElementById('sfAbout').value.trim();
    s.crypto = document.getElementById('sfCrypto').checked;
    s.isNew = document.getElementById('sfNew').checked;
    INV.seriesCache = {};
    closeModal(); persist(); toast('Stock updated', 'ok'); render();
  };
};
App.invAdminDel = function (id, ds) {
  const s = INV.stock(ds.t); if (!s) return;
  const held = DB.holdings.filter(h => h.ticker === s.ticker).length;
  openModal(modalShell('Delete stock', `<p class="small">Remove <b>${esc(s.ticker)}</b> from the catalogue?${held ? ` <span style="color:var(--danger)">${held} user position(s) still hold this symbol.</span>` : ''}</p>`,
    `<button class="btn btn-ghost" data-close style="flex:1">Cancel</button>
     <button class="btn btn-danger" id="delYes" style="flex:1">Delete</button>`), { locked: false });
  document.getElementById('delYes').onclick = () => {
    DB.stocks = DB.stocks.filter(x => x.ticker !== s.ticker);
    delete INV.live[s.ticker];
    closeModal(); persist(); toast(`${s.ticker} removed`, 'ok'); render();
  };
};
App.invAdminPause = function (id, ds) {
  const s = INV.stock(ds.t); if (!s) return;
  const inv = INV.db();
  inv.paused[s.ticker] = !INV.paused(s.ticker);
  persist(); render();
  toast(`${s.ticker} trading ${INV.paused(s.ticker) ? 'paused' : 'resumed'}`, 'ok');
};
App.invAdminFee = function () {
  const v = Number((document.getElementById('ivFeeInput') || {}).value);
  if (!(v >= 0 && v <= 5)) return toast('Enter a fee between 0 and 5%', 'err');
  INV.db().feePct = v; persist(); toast(`Trading fee set to ${v}%`, 'ok'); render();
};
App.invAdminBal = function (id, ds) {
  const usr = findUser(ds.id); if (!usr) return;
  openModal(modalShell(`Edit balance · @${usr.username}`, `
    <div class="field"><label class="label">Whale Coin balance</label>
      <input class="input" id="balIn" type="number" step="0.01" value="${usr.balance}"/></div>
    <div class="tiny muted">≈ ${usd(coinsToUsd(usr.balance))} USD at 1 WC = $0.50</div>`,
    `<button class="btn btn-ghost" data-close style="flex:1">Cancel</button>
     <button class="btn btn-primary" id="balSave" style="flex:1">Save</button>`), { locked: false });
  document.getElementById('balSave').onclick = () => {
    const v = Number(document.getElementById('balIn').value);
    if (!isFinite(v) || v < 0) return toast('Invalid amount', 'err');
    usr.balance = Math.round(v * 100) / 100;
    tx(usr.id, 'admin-adjust', 'Balance adjusted by admin', v - (usr.balance || 0), { by: me().id });
    notify(usr.id, 'Balance updated', `An administrator updated your Whale Coin balance to ${coins(v)} WC.`, '#/wallet', 'wallet');
    closeModal(); persist(); toast('Balance updated', 'ok'); render();
  };
};

/* ------------------------------ live paint ------------------------------ */
INV.setText = function (el, txt) { if (el && el.textContent !== txt) el.textContent = txt; };

INV.paint = function () {
  const u = me(); if (!u) return;
  const dashNode = document.querySelector('[data-lv="pv-coins"]');
  let port = null;
  if (dashNode) port = INV.portfolio(u.id);

  $$('[data-lv]').forEach(el => {
    const spec = el.getAttribute('data-lv') || '';
    const idx = spec.indexOf(':');
    const kind = idx < 0 ? spec : spec.slice(0, idx);
    const t = idx < 0 ? '' : spec.slice(idx + 1);
    if (kind === 'pv-coins' && port) return INV.setText(el, coins(port.valueCoins));
    if (kind === 'pv-usd' && port) return INV.setText(el, '≈ ' + usd(port.valueUsd) + ' USD');
    if (kind === 'pv-cost' && port) return INV.setText(el, coins(usdToCoins(port.costUsd)) + ' WC');
    if (kind === 'pv-earn' && port) return INV.setText(el, (port.earningsUsd >= 0 ? '+' : '−') + coins(usdToCoins(Math.abs(port.earningsUsd))) + ' WC');
    if (kind === 'cash') return INV.setText(el, coins(u.balance) + ' WC');
    if (!t) return;
    const q = INV.quote(t); if (!q) return;
    if (kind === 'price') INV.setText(el, usd(q.price));
    if (kind === 'wc') INV.setText(el, coins(usdToCoins(q.price)) + ' WC');
    if (kind === 'pct') {
      INV.setText(el, (q.changePct >= 0 ? '+' : '') + q.changePct.toFixed(2) + '%');
      el.classList.remove('up', 'down', 'flash-up', 'flash-down');
      el.classList.add(INV.chgClass(q.changePct));
      if (q.dir) { el.classList.add(q.dir > 0 ? 'flash-up' : 'flash-down'); setTimeout(() => el.classList.remove('flash-up', 'flash-down'), 700); }
    }
  });

  const dayNode = document.querySelector('.inv-day');
  if (dayNode && port) {
    dayNode.classList.remove('up', 'down');
    dayNode.classList.add(INV.chgClass(port.dayUsd));
    dayNode.innerHTML = `${ic(port.dayUsd >= 0 ? 'trend' : 'down', 14)}<b>${port.dayUsd >= 0 ? '+' : '−'}${usd(Math.abs(port.dayUsd))}</b>
      <span>(${port.dayUsd >= 0 ? '+' : '−'}${Math.abs(port.dayPct).toFixed(2)}%) today</span>`;
  }

  $$('[data-spark]').forEach(el => {
    const t = el.getAttribute('data-spark');
    el.innerHTML = INV.spark(t);
  });
  $$('[data-chart]').forEach(el => {
    if (el.__wcLwc) return;
    const spec = (el.getAttribute('data-chart') || '').split('|');
    const t = spec[0], tf = spec[1] || '1D', mode = spec[2] || 'line';
    if (!t) return;
    if (t === '__portfolio__') {
      const ser = INV.portfolioSeries(tf, u.id);
      el.innerHTML = ser.length ? INV.lineChart(ser, { h: 150 })
        : `<div class="inv-empty">${ic('trend', 26)}<p class="small muted">No positions yet.</p></div>`;
    } else {
      const ser = INV.series(t, tf);
      el.innerHTML = mode === 'candle' ? INV.candleChart(ser) : INV.lineChart(ser, { h: 150 });
    }
  });

  const priceEl = document.querySelector('.inv-price');
  if (priceEl) { priceEl.classList.remove('flash-up', 'flash-down'); }
};

/* ------------------------------ nav + boot ------------------------------ */
(function injectInvestNav() {
  const tab = { key: 'invest', label: 'Invest', icon: 'trend', href: '#/invest' };
  const add = (arr, at) => { if (arr && !arr.some(n => n.key === 'invest')) arr.splice(at, 0, tab); };
  add(BOTTOM_NAV, 3);
  add(USER_NAV, 3);
  add(VENDOR_NAV, 4);
  if (!ADMIN_NAV.some(n => n.key === 'admin-stocks')) {
    ADMIN_NAV.splice(Math.max(0, ADMIN_NAV.length - 2), 0,
      { key: 'admin-stocks', label: 'Stocks', icon: 'trend', href: '#/admin/stocks' });
  }
})();

const _adminViewOriginal = VIEWS.admin;
VIEWS.admin = function (parts, params) {
  if ((parts[1] || '') === 'stocks') return INV.viewAdminStocks();
  return _adminViewOriginal.apply(this, arguments);
};

window.addEventListener('hashchange', () => {
  const h = location.hash || '';
  if (!h.startsWith('#/invest')) { INV.marketQuery = ''; }
});

setInterval(() => {
  try {
    if (typeof DB === 'undefined' || !DB || !me() || document.hidden) return;
    INV.tick();
  } catch (e) { console.error('invest tick failed', e); }
}, INV.TICK_MS);

</script>

<script>

/* =========================================================================
   WhaleChat extras — cart fix, save-contact-to-phone (.vcf), email CTA
   ========================================================================= */
'use strict';

/* 1. The marketplace button emits data-act="add-cart", but the handler was
      only ever defined as App.addToCart — so every "Add to cart" click was a
      no-op. Alias it, and give instant feedback. */
App.addCart = function (id, qty) {
  const u = me();
  const p = DB.products.find(x => x.id === id);
  if (!p) return;
  if (!p.active || p.stock < 1) return toast('This product is sold out', 'err');
  u.cart = u.cart || [];
  const want = Math.max(1, Number(qty) || 1);
  const line = u.cart.find(c => c.productId === id);
  if (line) {
    if (line.qty + want > p.stock) return toast('Only ' + p.stock + ' available', 'err');
    line.qty += want;
  } else {
    if (want > p.stock) return toast('Only ' + p.stock + ' available', 'err');
    u.cart.push({ productId: id, qty: want });
  }
  try { sync(); } catch (e) {}
  const n = (u.cart.find(c => c.productId === id) || {}).qty || want;
  toast(`${p.name} added to cart 🛒  (${n} in cart)`, 'ok');
  try { render(); } catch (e) {}
};

/* 2. Save a WhaleChat contact to the device as a vCard (.vcf) with any
      preferred display name — the way WhatsApp does it. */
App.contactSave = function (id) {
  const u = me();
  const c = findUser(id);
  if (!c) return;
  const suggest = (c.fullName || c.username || '').trim();
  openModal(modalShell('Save to phone', `
    <p class="small muted" style="line-height:1.65;margin-bottom:12px">Choose the name this contact is saved as in your phone's address book. We build a standard <b>.vcf</b> card — Android, iPhone, Google Contacts and Outlook all import it.</p>
    <div class="field"><label class="label">Save as</label>
      <input class="input" id="vcName" value="${esc(suggest)}" placeholder="Any name you prefer"/></div>
    <div class="field"><label class="label">Phone</label>
      <input class="input" id="vcPhone" value="${esc(c.phone || '')}" placeholder="+1 555 010 2030"/></div>
    <div class="field"><label class="label">Email</label>
      <input class="input" id="vcEmail" value="${esc(c.email || '')}" placeholder="name@email.com"/></div>
    <div class="inv-note tiny">${ic('shield', 13)} Only what you see here is written into the card. WhaleChat never uploads your address book.</div>`,
    `<button class="btn btn-ghost" data-close style="flex:1">Cancel</button>
     <button class="btn btn-soft" id="vcCopy" style="flex:1">Copy</button>
     <button class="btn btn-primary" id="vcGo" style="flex:1">Save .vcf</button>`), { locked: false });

  const build = () => {
    const name = ($('#vcName') || {}).value || suggest || 'WhaleChat contact';
    const phone = ($('#vcPhone') || {}).value || '';
    const email = ($('#vcEmail') || {}).value || '';
    const parts = String(name).trim().split(/\s+/);
    const first = parts.shift() || '';
    const last = parts.join(' ');
    const origin = location.origin;
    const lines = [
      'BEGIN:VCARD', 'VERSION:3.0',
      `N:${last};${first};;;`,
      `FN:${name}`,
      `ORG:WhaleChat`,
      phone ? `TEL;TYPE=CELL:${phone}` : '',
      email ? `EMAIL;TYPE=INTERNET:${email}` : '',
      `URL:${origin}/whalechat.html#/chat/${c.id}`,
      `NOTE:WhaleChat contact @${c.username}${phone ? '' : ''} — chat at ${origin}/whalechat.html`,
      `X-WHALECHAT-ID:${c.id}`,
      'END:VCARD'
    ].filter(Boolean);
    return { text: lines.join('\r\n'), name: String(name).replace(/[^\w \-.]/g, '').trim() || 'contact' };
  };

  const done = () => { try { closeModal(); } catch (e) {} };

  const share = async () => {
    const { text, name } = build();
    const file = new File([text], name + '.vcf', { type: 'text/vcard' });
    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      try {
        await navigator.share({ files: [file], title: name, text: 'WhaleChat contact' });
        toast('Contact shared — choose Contacts to save it', 'ok');
        return done();
      } catch (e) { /* user cancelled or share blocked — fall back */ }
    }
    const blob = new Blob([text], { type: 'text/vcard;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name + '.vcf';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    toast('Contact card downloaded — open it to add to your address book', 'ok');
    done();
  };

  const go = document.getElementById('vcGo');
  if (go) go.onclick = share;
  const copy = document.getElementById('vcCopy');
  if (copy) copy.onclick = () => {
    const { text } = build();
    copyText(text); done();
  };
};

/* keep the original menu, add the save option in front of it */
const _contactMenu = App.contactMenu;
App.contactMenu = function (id) {
  const c = findUser(id);
  const u = me();
  if (!c) return;
  openModal(modalShell(c.fullName, `
    <div class="list">
      <button class="list-item" data-act="open-chat" data-id="${id}" style="width:100%;text-align:left">${ic('chat', 17)} <span class="grow">Open chat</span></button>
      <button class="list-item" data-act="contact-save" data-id="${id}" style="width:100%;text-align:left">${ic('download', 17)} <span class="grow">Save to phone<span class="tiny muted" style="display:block">Download a .vcf contact card with any name</span></span></button>
      <button class="list-item" data-act="copy" data-id="${c.phone || '@' + c.username}" style="width:100%;text-align:left">${ic('copy', 17)} <span class="grow">Copy ${c.phone ? 'phone number' : 'username'}</span></button>
      <button class="list-item" data-act="delete-contact" data-id="${id}" style="width:100%;text-align:left;color:var(--danger)">${ic('trash', 17)} <span class="grow">Remove contact</span></button>
    </div>`, `<button class="btn btn-ghost" data-close style="width:100%">Close</button>`, '@' + c.username));
};

</script>
<script>
/* wc-tawk-control */

/* =========================================================================
   Live chat (Tawk.to) — admin on/off switch + placement that never covers
   the bottom navigation, the profile button or any other control.
   The embed is stripped at build time; this module loads it only when on.
   ========================================================================= */
'use strict';

const WC_TAWK = {
  DEFAULTS: { enabled: true, propertyId: '6af412c51859cf3c3d81d341', widgetId: '1k74milq6' },
  loaded: false,
  styleId: 'wc-tawk-style',

  cfg() {
    if (!DB || !DB.settings) return Object.assign({}, this.DEFAULTS);
    if (!DB.settings.liveChat) DB.settings.liveChat = Object.assign({}, this.DEFAULTS);
    return Object.assign(this.DEFAULTS, DB.settings.liveChat);
  },
  enabled() { return !!this.cfg().enabled; },

  css() {
    if (document.getElementById(this.styleId)) return;
    const st = document.createElement('style');
    st.id = this.styleId;
    /* Tawk places its bubble 20px from the bottom edge, which sits on top of the
       app's 70px bottom bar. Lift it clear of the nav and of any sticky action
       bar, and keep it under the app's modals (z-index 1000) so dialogs win. */
    st.textContent = `
      #tawk-bubble-container{
        bottom:calc(env(safe-area-inset-bottom,0px) + 86px) !important;
        right:14px !important; z-index:900 !important;
      }
      #tawkchat-container,#tawkchat-minified-container{
        bottom:calc(env(safe-area-inset-bottom,0px) + 86px) !important;
        right:12px !important; z-index:901 !important;
        height:min(68vh,560px) !important; max-height:calc(100vh - 190px) !important;
      }
      @media(min-width:1024px){
        #tawk-bubble-container{bottom:24px !important;right:24px !important;}
        #tawkchat-container,#tawkchat-minified-container{bottom:24px !important;right:24px !important;height:min(72vh,640px) !important;}
      }
      html.wc-tawk-off #tawk-bubble-container,
      html.wc-tawk-off #tawkchat-container,
      html.wc-tawk-off #tawkchat-minified-container{display:none !important;}
      /* never let the widget sit over the mobile nav / chat composer */
      body.chat-open #tawk-bubble-container{bottom:calc(env(safe-area-inset-bottom,0px) + 86px) !important;}
      /* hide entirely where a floating bubble could cover an action button */
      body.modal-open #tawk-bubble-container,
      body.modal-open #tawkchat-container,
      body.modal-open #tawkchat-minified-container,
      body[data-route="deposit"] #tawk-bubble-container,
      body[data-route="withdraw"] #tawk-bubble-container,
      body[data-route="cart"] #tawk-bubble-container,
      body[data-route="checkout"] #tawk-bubble-container{display:none !important;}
      html.wc-tawk-off #tawk-bubble-container,
      html.wc-tawk-off #tawkchat-container,
      html.wc-tawk-off #tawkchat-minified-container{display:none !important;}
    `;
    document.head.appendChild(st);
  },

  load() {
    if (this.loaded) return;
    this.loaded = true;
    const c = this.cfg();
    window.Tawk_API = window.Tawk_API || {};
    window.Tawk_LoadStart = new Date();
    /* positioning must be declared before the widget boots */
    try {
      window.Tawk_API.customStyle = {
        zIndex: 900,
        visibility: {
          desktop: { position: 'br', xOffset: 24, yOffset: 24 },
          mobile: { position: 'br', xOffset: 14, yOffset: 90 }
        }
      };
    } catch (e) {}
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://embed.tawk.to/' + c.propertyId + '/' + c.widgetId;
    s.charset = 'UTF-8';
    s.setAttribute('crossorigin', '*');
    s.id = 'wc-tawk-embed';
    document.head.appendChild(s);
  },

  apply() {
    this.css();
    const on = this.enabled();
    document.documentElement.classList.toggle('wc-tawk-off', !on);
    if (on) {
      this.load();
      try { window.Tawk_API && window.Tawk_API.showWidget && window.Tawk_API.showWidget(); } catch (e) {}
    } else {
      try { window.Tawk_API && window.Tawk_API.hideWidget && window.Tawk_API.hideWidget(); } catch (e) {}
      const host = document.getElementById('wc-tawk-embed');
      if (host) { /* stop re-injection after a reload while off */ host.remove(); this.loaded = false; }
    }
  },

  watch() {
    if (this._watching) return;
    this._watching = true;
    let last = this.enabled();
    /* an admin can flip this from another device: follow the setting live */
    setInterval(() => {
      let now = last;
      try { now = this.enabled(); } catch (e) { return; }
      if (now !== last) { last = now; this.apply(); }
    }, 4000);
  },

  boot() {
    if (!DB) return false;
    this.apply();
    this.watch();
    const u = me();
    if (u && window.Tawk_API) {
      try { window.Tawk_API.visitor = { name: u.fullName || u.username, email: u.email }; } catch (e) {}
    }
    return true;
  }
};

/* keep the existing in-app "Live chat" entry point honest */
const _openLiveChat = App.openLiveChat;
App.openLiveChat = function () {
  if (!WC_TAWK.enabled() || !WC_TAWK.loaded) {
    toast('Live chat is currently switched off', 'err');
    return App.liveChatHelp ? App.liveChatHelp(true) : undefined;
  }
  return _openLiveChat.apply(this, arguments);
};

/* ---------------- admin screen ---------------- */
App.tawkToggle = function () {
  const c = WC_TAWK.cfg();
  c.enabled = !c.enabled;
  if (DB.settings) DB.settings.liveChat = c;
  try { sync(); } catch (e) {}
  try { persist(); } catch (e) {}
  WC_TAWK.apply();
  toast('Live chat ' + (c.enabled ? 'enabled — the chat bubble is now visible' : 'disabled — the chat bubble is hidden'), 'ok');
  render();
};

App.tawkSave = function () {
  const p = (document.getElementById('twProperty') || {}).value || '';
  const w = (document.getElementById('twWidget') || {}).value || '';
  if (!/^[a-z0-9]{10,}$/i.test(p) || !/^[a-z0-9]{6,}$/i.test(w)) return toast('Enter a valid Tawk property and widget id', 'err');
  const c = WC_TAWK.cfg();
  c.propertyId = p.trim(); c.widgetId = w.trim();
  DB.settings.liveChat = c;
  try { sync(); } catch (e) {}
  try { persist(); } catch (e) {}
  /* reload the widget with the new ids */
  const host = document.getElementById('wc-tawk-embed');
  if (host) { host.remove(); WC_TAWK.loaded = false; }
  WC_TAWK.apply();
  toast('Widget details saved', 'ok');
  render();
};

function tawkAdminView() {
  const c = WC_TAWK.cfg();
  const on = !!c.enabled;
  const live = !!document.getElementById('wc-tawk-embed');
  const tabs = `<div class="admin-nav">${ADMIN_NAV.map(n => {
    const key = n.href.replace('#/admin', '') || '';
    return `<a href="${n.href}" class="${key === '/livechat' ? 'on' : ''}">${n.label}</a>`;
  }).join('')}</div>`;
  return `${tabs}
  <div class="page-head"><div><div class="section-title" style="margin:0">Live chat</div>
    <div class="tiny muted">Control the Tawk.to chat bubble for every user</div></div></div>

  <div class="card">
    <div class="between" style="align-items:center;gap:12px;flex-wrap:wrap">
      <div style="min-width:0">
        <div class="card-title" style="margin:0 0 4px">Chat bubble</div>
        <div class="small muted" style="line-height:1.6">
          ${on ? 'Visible on the app for all users. It floats above the bottom navigation and never covers the profile or action buttons.'
               : 'Hidden everywhere. Users see no chat bubble and the widget is not downloaded at all.'}
        </div>
      </div>
      <button class="btn ${on ? 'btn-danger' : 'btn-primary'}" data-act="tawk-toggle" style="min-width:130px">
        ${ic(on ? 'pause' : 'play', 15)} ${on ? 'Turn off' : 'Turn on'}
      </button>
    </div>
    <div class="row" style="gap:8px;margin-top:14px;flex-wrap:wrap">
      <span class="badge ${on ? 'badge-success' : 'badge-warn'}">${on ? 'Enabled' : 'Disabled'}</span>
      <span class="badge">${live ? 'Widget loaded on this device' : (on ? 'Loading…' : 'Not loaded')}</span>
      <span class="badge">Everyone syncs this setting</span>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Widget placement</div>
    <div class="tiny muted" style="line-height:1.7">
      The bubble is offset <b>86px</b> from the bottom on phones, so it clears the 70px bottom navigation and any sticky action bar.
      On desktop it sits 24px from the corner. It always stays below app dialogs (z-index 900 vs 1000), so PIN and checkout modals are never blocked.
    </div>
  </div>

  <div class="card">
    <div class="card-title">Widget details</div>
    <div class="row" style="gap:8px;flex-wrap:wrap;align-items:flex-end">
      <div class="field grow" style="margin:0;min-width:170px"><label class="label">Property ID</label>
        <input class="input" id="twProperty" value="${esc(c.propertyId)}"/></div>
      <div class="field grow" style="margin:0;min-width:130px"><label class="label">Widget ID</label>
        <input class="input" id="twWidget" value="${esc(c.widgetId)}"/></div>
      <button class="btn btn-soft" data-act="tawk-save">Save</button>
    </div>
    <div class="tiny muted mt6">Change these only if you move to a different Tawk property.</div>
  </div>`;
}

const _adminViewTawk = VIEWS.admin;
VIEWS.admin = function (parts, params) {
  if ((parts[1] || '') === 'livechat') {
    const u = me();
    if (!u || u.role !== 'admin') return `<div class="card empty"><div class="ic">${ic('lock', 26)}</div><h3>Admin access only</h3></div>`;
    return tawkAdminView();
  }
  return _adminViewTawk.apply(this, arguments);
};

if (!ADMIN_NAV.some(n => n.key === 'admin-livechat')) {
  ADMIN_NAV.splice(Math.max(0, ADMIN_NAV.length - 2), 0,
    { key: 'admin-livechat', label: 'Live chat', icon: 'chat', href: '#/admin/livechat' });
}

/* boot: after the database is ready, and again after login/logout */
(function tawkBoot() {
  let tries = 0;
  const t = setInterval(() => {
    tries += 1;
    let ok = false;
    try { ok = WC_TAWK.boot(); } catch (e) { ok = false; }
    if (ok || tries > 40) clearInterval(t);
  }, 250);
  window.addEventListener('hashchange', () => { try { WC_TAWK.apply(); } catch (e) {} });
})();

</script>
<script>
/* wc-live-trade */

/* =========================================================================
   WhaleChat live trades — capital-backed positions with real-time P&L,
   take-profit / stop-loss, duration auto-close and manual exit.
   Open positions live in DB.trades (status 'Open') so they sync everywhere.
   ========================================================================= */
'use strict';

const LT_COIN = (typeof COIN_USD === 'number') ? COIN_USD : 0.5;

const LT = {
  MIN_CAPITAL: 5,
  DURATIONS: [
    { label: '5 min', m: 5 }, { label: '15 min', m: 15 }, { label: '1 hour', m: 60 },
    { label: '4 hours', m: 240 }, { label: '1 day', m: 1440 }
  ],

  cfg() {
    if (!DB) return { leverage: 5 };
    if (!DB.invest) DB.invest = { feePct: 0.5, paused: {}, seededAt: Date.now() };
    if (!DB.invest.leverage) DB.invest.leverage = 5;
    return DB.invest;
  },
  leverage() { return Math.min(20, Math.max(1, Number(this.cfg().leverage) || 1)); },
  feePct() { return Math.max(0, Number(this.cfg().feePct) || 0); },
  all(userId) {
    if (!Array.isArray(DB.trades)) DB.trades = [];
    return DB.trades.filter(t => t.userId === (userId || me().id) && t.type === 'live');
  },
  open(userId) { return this.all(userId).filter(t => t.status === 'Open'); },
  closed(userId) { return this.all(userId).filter(t => t.status !== 'Open').sort((a, b) => b.closedAt - a.closedAt); },

  /* live numbers for a position */
  calc(t) {
    const q = INV.quote(t.ticker) || { price: t.entryPrice };
    const dir = t.side === 'short' ? -1 : 1;
    const move = t.entryPrice ? (q.price - t.entryPrice) / t.entryPrice : 0;
    let pnlCoins = t.capitalCoins * (t.leverage || 1) * move * dir;
    pnlCoins = Math.max(-t.capitalCoins, pnlCoins);          /* never lose more than the stake */
    const payout = Math.max(0, t.capitalCoins + pnlCoins);
    return {
      price: q.price,
      prev: q.prevClose,
      movePct: move * 100 * dir,
      pnlCoins: Math.round(pnlCoins * 100) / 100,
      pnlUsd: coinsToUsd(pnlCoins),
      pnlPct: t.capitalCoins ? (pnlCoins / t.capitalCoins) * 100 : 0,
      payoutCoins: Math.round(payout * 100) / 100,
      totalLoss: payout <= 0,
      left: Math.max(0, (t.expiresAt || 0) - Date.now())
    };
  },

  /* ---------------- open a position ---------------- */
  start(side, ticker, capitalCoins, opts) {
    const u = me();
    const s = INV.stock(ticker);
    if (!u || !s) return false;
    const o = opts || {};
    const capital = Math.round((Number(capitalCoins) || 0) * 100) / 100;
    if (capital < this.MIN_CAPITAL) { toast('Minimum trade is ' + this.MIN_CAPITAL + ' WC', 'err'); return false; }
    if (capital > u.balance) { toast('Not enough Whale Coin — top up your wallet', 'err'); return false; }
    if (INV.paused && INV.paused(ticker)) { toast(ticker + ' trading is paused', 'err'); return false; }
    const q = INV.quote(ticker);
    if (!q) return false;

    const fee = Math.round(capital * this.feePct() / 100 * 100) / 100;
    const minutes = Math.max(1, Math.min(7 * 24 * 60, Number(o.minutes) || 60));
    const trade = {
      id: uid('lt'), userId: u.id, type: 'live', ticker, name: s.name, side: side === 'short' ? 'short' : 'long',
      capitalCoins: capital, entryPrice: q.price, leverage: this.leverage(),
      tpPct: Math.max(0, Math.min(500, Number(o.tpPct) || 0)),
      slPct: Math.max(0, Math.min(100, Number(o.slPct) || 0)),
      expiresAt: Date.now() + minutes * 60000,
      status: 'Open', createdAt: Date.now(), feeCoins: fee
    };
    u.balance = Math.round((u.balance - capital - fee) * 100) / 100;
    DB.trades.unshift(trade);
    tx(u.id, 'trade-open', `${side === 'short' ? 'Short' : 'Long'} ${ticker} · ${coins(capital)} WC`, -capital - fee,
      { tradeId: trade.id, leverage: trade.leverage, entry: q.price });
    notify(u.id, 'Trade opened',
      `${side === 'short' ? 'Short' : 'Long'} ${ticker} with ${coins(capital)} WC at ${usd(q.price)} — closes in ${minutes} min.`,
      '#/invest/orders', 'trend');
    persist(); toast('Trade started — tracking live', 'ok'); render();
    return true;
  },

  /* ---------------- settle ---------------- */
  settle(t, reason) {
    if (!t || t.status !== 'Open') return false;
    const u = findUser(t.userId);
    if (!u) return false;
    const p = this.calc(t);
    const payout = p.totalLoss ? 0 : p.payoutCoins;
    u.balance = Math.round((u.balance + payout) * 100) / 100;
    t.status = 'Completed';
    t.closedAt = Date.now();
    t.closeReason = reason;
    t.exitPrice = p.price;
    t.pnlCoins = p.pnlCoins;
    t.pnlUsd = p.pnlUsd;
    t.payoutCoins = payout;
    t.result = p.totalLoss ? 'loss' : p.pnlCoins > 0 ? 'profit' : 'flat';

    tx(u.id, 'trade-close', `${t.ticker} trade ${reason} · ${payout ? '+' + coins(payout) + ' WC returned' : 'total loss'}`,
      payout, { tradeId: t.id, pnlCoins: p.pnlCoins, reason });

    if (p.totalLoss) {
      notify(u.id, 'Trade closed — total loss',
        `${t.ticker} moved against your position and the stake was lost. Nothing was returned.`,
        '#/invest/orders', 'ban');
      toast(`${t.ticker} closed at a total loss`, 'err');
    } else if (p.pnlCoins >= 0) {
      notify(u.id, 'Take profit — trade closed',
        `${t.ticker} closed with +${coins(p.pnlCoins)} WC profit. ${coins(payout)} WC (capital + profit) was credited.`,
        '#/invest/orders', 'trend');
      toast(`Profit taken — ${coins(payout)} WC credited`, 'ok');
    } else {
      notify(u.id, 'Trade closed at a loss',
        `${t.ticker} closed with −${coins(Math.abs(p.pnlCoins))} WC. ${coins(payout)} WC of capital was returned.`,
        '#/invest/orders', 'down');
      toast(`Trade stopped — ${coins(payout)} WC returned`, 'ok');
    }
    try { sync(); } catch (e) {}
    persist();
    render();
    return true;
  },

  /* auto close on target / stop / expiry */
  auto() {
    if (!DB || !DB.trades) return;
    this.open().forEach(t => {
      const p = this.calc(t);
      if (t.tpPct > 0 && p.pnlPct >= t.tpPct) return void this.settle(t, 'Take profit target hit');
      if (t.slPct > 0 && p.pnlPct <= -t.slPct) return void this.settle(t, 'Stop loss hit');
      if (t.expiresAt && Date.now() >= t.expiresAt) return void this.settle(t, 'Time limit reached');
    });
  },

  /* ---------------- view helpers ---------------- */
  clock(ms) {
    const total = Math.max(0, Math.floor(ms / 1000));
    const d = Math.floor(total / 86400), h = Math.floor((total % 86400) / 3600);
    const m = Math.floor((total % 3600) / 60), s = total % 60;
    if (d) return d + 'd ' + h + 'h';
    if (h) return h + 'h ' + String(m).padStart(2, '0') + 'm';
    return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
  },

  cardHTML(t) {
    const p = this.calc(t);
    const s = INV.stock(t.ticker) || { ticker: t.ticker, color: '#3aa0ff' };
    const up = p.pnlCoins > 0, down = p.pnlCoins < 0;
    const dirLabel = t.side === 'short' ? 'Short' : 'Long';
    return `<div class="lt-card" data-lt="${t.id}">
      <div class="row" style="gap:9px;align-items:center">
        ${INV.logoHTML(s, 32)}
        <div class="grow" style="min-width:0">
          <div class="small" style="font-weight:700">${esc(t.ticker)}
            <span class="lt-side ${t.side}">${dirLabel} ${t.leverage}×</span></div>
          <div class="tiny muted">${coins(t.capitalCoins)} WC · entry ${usd(t.entryPrice)}</div>
        </div>
        <span class="lt-mini">${INV.spark(t.ticker)}</span>
        <div style="text-align:right">
          <div class="lt-pnl ${up ? 'up' : down ? 'down' : ''}" data-lt-pnl="${t.id}">
            ${p.pnlCoins >= 0 ? '+' : '−'}${coins(Math.abs(p.pnlCoins))} WC</div>
          <div class="tiny ${up ? 'up' : down ? 'down' : 'muted'}" data-lt-pct="${t.id}">
            ${p.pnlPct >= 0 ? '+' : '−'}${Math.abs(p.pnlPct).toFixed(2)}%</div>
        </div>
      </div>
      <div class="lt-row">
        <span class="tiny muted">Price <b data-lt-price="${t.id}">${usd(p.price)}</b>
          <span data-lt-move="${t.id}" class="${p.movePct >= 0 ? 'up' : 'down'}">${p.movePct >= 0 ? '▲' : '▼'} ${Math.abs(p.movePct).toFixed(2)}%</span></span>
        <span class="tiny muted" data-lt-left="${t.id}">⏱ ${this.clock(p.left)}</span>
      </div>
      <div class="lt-bar"><i style="width:${Math.min(100, Math.max(0, 50 + p.pnlPct))}%"
        class="${up ? 'up' : down ? 'down' : ''}"></i></div>
      <div class="row" style="gap:7px;margin-top:9px">
        <button class="btn btn-sm btn-primary grow" data-act="lt-tp" data-id="${t.id}">
          ${ic('trend', 13)} Take profit ${p.pnlCoins > 0 ? '(+' + coins(p.pnlCoins) + ')' : ''}</button>
        <button class="btn btn-sm btn-ghost grow" data-act="lt-sl" data-id="${t.id}">
          ${ic('down', 13)} Take loss ${p.pnlCoins < 0 ? '(−' + coins(Math.abs(p.pnlCoins)) + ')' : ''}</button>
      </div>
      <div class="tiny muted center" style="margin-top:6px">Returns ${coins(p.payoutCoins)} WC if closed now</div>
    </div>`;
  },

  closedRow(t) {
    const pnl = Number(t.pnlCoins) || 0;
    const win = pnl > 0, lost = t.result === 'loss';
    return `<div class="inv-row" style="align-items:flex-start">
      <div class="grow" style="min-width:0">
        <div class="small" style="font-weight:650">${esc(t.ticker)} ${t.side === 'short' ? 'Short' : 'Long'}
          <span class="tiny muted">· ${t.leverage}× · ${esc(t.closeReason || 'closed')}</span></div>
        <div class="tiny muted">${coins(t.capitalCoins)} WC @ ${usd(t.entryPrice)} → ${usd(t.exitPrice || 0)} · ${dateLabel(t.closedAt)} ${clockTime(t.closedAt)}</div>
        <div class="tiny ${win ? 'up' : lost ? 'down' : 'muted'}">
          ${lost ? 'Total loss — nothing returned' : (win ? '+' : '') + coins(pnl) + ' WC P/L'} ·
          returned ${coins(t.payoutCoins || 0)} WC</div>
      </div>
      <span class="badge ${win ? 'badge-success' : lost ? 'badge-danger' : 'badge-warn'}">
        ${lost ? 'Lost' : win ? 'Profit' : 'Flat'}</span></div>`;
  },

  /* ---------------- live paint ---------------- */
  paint() {
    this.open().forEach(t => {
      const p = this.calc(t);
      const set = (sel, txt) => { const el = document.querySelector(sel); if (el) el.textContent = txt; };
      set('[data-lt-pnl="' + t.id + '"]', (p.pnlCoins >= 0 ? '+' : '−') + coins(Math.abs(p.pnlCoins)) + ' WC');
      set('[data-lt-pct="' + t.id + '"]', (p.pnlPct >= 0 ? '+' : '−') + Math.abs(p.pnlPct).toFixed(2) + '%');
      set('[data-lt-price="' + t.id + '"]', usd(p.price));
      set('[data-lt-move="' + t.id + '"]', (p.movePct >= 0 ? '▲ ' : '▼ ') + Math.abs(p.movePct).toFixed(2) + '%');
      set('[data-lt-left="' + t.id + '"]', '⏱ ' + this.clock(p.left));
      document.querySelectorAll('[data-lt-pnl="' + t.id + '"], [data-lt-pct="' + t.id + '"]').forEach(el => {
        el.classList.toggle('up', p.pnlCoins > 0);
        el.classList.toggle('down', p.pnlCoins < 0);
      });
      document.querySelectorAll('[data-lt-move="' + t.id + '"]').forEach(el => {
        el.classList.toggle('up', p.movePct >= 0);
        el.classList.toggle('down', p.movePct < 0);
      });
      const bar = document.querySelector('[data-lt="' + t.id + '"] .lt-bar i');
      if (bar) {
        bar.style.width = Math.min(100, Math.max(0, 50 + p.pnlPct)) + '%';
        bar.className = p.pnlCoins >= 0 ? 'up' : 'down';
      }
      const ret = document.querySelector('[data-lt="' + t.id + '"] .tiny.muted.center');
      if (ret) ret.textContent = 'Returns ' + coins(p.payoutCoins) + ' WC if closed now';
    });
    this.paintEarnings();
  },

  /* the hero "Earnings" figure follows the live trades, not old holdings */
  paintEarnings() {
    const el = document.querySelector('[data-lv="pv-earn"]');
    if (!el) return;
    const pos = this.open();
    const pnl = pos.reduce((sum, t) => sum + this.calc(t).pnlCoins, 0);
    el.textContent = (pnl >= 0 ? '+' : '\u2212') + coins(Math.abs(pnl)) + ' WC';
    el.classList.remove('up', 'down');
    if (pnl > 0) el.classList.add('up');
    else if (pnl < 0) el.classList.add('down');
    const cell = el.parentElement;
    const label = cell && cell.querySelector('.tiny.muted');
    if (label) label.textContent = pos.length ? 'Active trade earnings' : 'Earnings';
  },

  /* ---------------- mounts ---------------- */
  activeBlock() {
    const list = this.open();
    if (!list.length) return '';
    return `<div class="card lt-panel" id="ltActive">
      <div class="between"><div class="card-title" style="margin:0">Active trades
        <span class="badge badge-accent" style="margin-left:6px">${list.length} live</span></div>
        <span class="tiny muted">updates every 2s</span></div>
      ${list.map(t => this.cardHTML(t)).join('')}
    </div>`;
  },

  closedBlock() {
    const list = this.closed().slice(0, 8);
    if (!list.length) return '';
    return `<div class="card"><div class="card-title">Closed trades</div>
      <div class="inv-list">${list.map(t => this.closedRow(t)).join('')}</div></div>`;
  },

  /* the stock-page panel: buy to open, then take profit / take loss */
  ticketHTML(ticker) {
    const s = INV.stock(ticker); if (!s) return '';
    const lev = this.leverage();
    const pos = this.open().filter(t => t.ticker === ticker)[0];
    const head = `<div class="between"><div class="card-title" style="margin:0">Trade · ${esc(ticker)}</div>
        <span class="badge">${lev}×</span></div>`;

    if (pos) {
      return `<div class="card" id="ltTicket">
        ${head}
        <div class="tiny muted" style="margin:4px 0 10px">Your position is live and counting now — it is not waiting for the market.</div>
        ${this.cardHTML(pos)}
        <div class="row" style="gap:8px;margin-top:10px">
          <button class="btn btn-primary grow" data-act="lt-tp" data-id="${pos.id}">
            ${ic('trend', 15)} Take profit</button>
          <button class="btn btn-ghost grow" data-act="lt-sl" data-id="${pos.id}">
            ${ic('down', 15)} Take loss</button>
        </div>
        <div class="tiny muted center mt6">Profit: capital + gain · Loss: remaining capital · Total loss: nothing returned</div>
      </div>`;
    }

    return `<div class="card" id="ltTicket">
      ${head}
      <div class="tiny muted" style="margin:4px 0 10px;line-height:1.6">
        Enter your limit and how long the trade runs, then press <b>Buy</b>. The trade starts immediately and earns or loses in real time.</div>
      <div class="lt-side-pick">
        <button class="lt-side-btn on" data-act="lt-side" data-side="long">▲ Long (price rises)</button>
        <button class="lt-side-btn" data-act="lt-side" data-side="short">▼ Short (price falls)</button>
      </div>
      <div class="field"><label class="label">Capital (Whale Coin)</label>
        <div class="input-wrap"><span class="inv-prefix">WC</span>
          <input class="input" id="ltCapital" type="number" step="1" min="${this.MIN_CAPITAL}" placeholder="0"/></div>
        <div class="tiny muted" id="ltCapitalUsd">≈ $0.00 · balance ${coins(me().balance)} WC</div></div>
      <div class="row" style="gap:8px">
        <div class="field grow"><label class="label">Take profit %</label>
          <input class="input" id="ltTp" type="number" step="1" min="0" placeholder="limit"/></div>
        <div class="field grow"><label class="label">Take loss %</label>
          <input class="input" id="ltSl" type="number" step="1" min="0" placeholder="limit"/></div>
      </div>
      <div class="field"><label class="label">Trade duration</label>
        <select class="input" id="ltDuration">${this.DURATIONS.map(d => `<option value="${d.m}" ${d.m === 60 ? 'selected' : ''}>${d.label}</option>`).join('')}</select></div>
      <button class="btn btn-primary" data-act="lt-start" data-t="${esc(ticker)}" style="width:100%">
        ${ic('play', 15)} Buy</button>
      <div class="tiny muted center mt6">${ic('lock', 11)} Capital is held while the trade runs · ${this.feePct()}% fee · it closes by itself at your limit or when time is up</div>
    </div>`;
  }
};


/* ---------------- styles ---------------- */
(function () {
  if (document.getElementById('lt-style')) return;
  const st = document.createElement('style');
  st.id = 'lt-style';
  st.textContent = `
  .lt-panel .card-title{display:flex;align-items:center}
  .lt-card{border:1px solid var(--border);border-radius:14px;padding:11px;margin-top:10px;
    background:linear-gradient(160deg,var(--surface-2),var(--surface));position:relative;overflow:hidden}
  .lt-card:first-of-type{margin-top:6px}
  .lt-side{font-size:9.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:2px 6px;border-radius:6px;margin-left:5px}
  .lt-side.long{background:rgba(47,214,166,.16);color:var(--success)}
  .lt-side.short{background:rgba(255,95,116,.16);color:var(--danger)}
  .lt-pnl{font-family:var(--display);font-weight:800;font-size:15px;font-variant-numeric:tabular-nums}
  .lt-row{display:flex;justify-content:space-between;gap:8px;margin-top:8px;align-items:center}
  .lt-bar{height:5px;border-radius:99px;background:var(--surface-3);overflow:hidden;margin-top:8px}
  .lt-bar i{display:block;height:100%;border-radius:99px;transition:width .35s ease}
  .lt-bar i.up{background:linear-gradient(90deg,#2fd6a6,#2ee6c9)}
  .lt-bar i.down{background:linear-gradient(90deg,#ff5f74,#ff8a5b)}
  .lt-side-pick{display:flex;gap:6px;margin-bottom:10px}
  .lt-side-btn{flex:1;padding:9px 6px;border-radius:11px;border:1px solid var(--border);background:var(--surface-2);
    color:var(--muted);font-size:11.5px;font-weight:700;cursor:pointer;transition:all .15s ease}
  .lt-side-btn.on{border-color:rgba(46,230,201,.55);color:var(--text);background:linear-gradient(135deg,rgba(46,230,201,.16),rgba(58,160,255,.12))}
  .lt-day{display:inline-flex;align-items:center;gap:6px;margin-top:10px;padding:6px 11px;border-radius:99px;
    font-size:12px;background:rgba(255,255,255,.06);border:1px solid var(--border);font-variant-numeric:tabular-nums}
  .lt-day.up{color:var(--success);background:rgba(47,214,166,.10);border-color:rgba(47,214,166,.25)}
  .lt-day.down{color:var(--danger);background:rgba(255,95,116,.10);border-color:rgba(255,95,116,.25)}
  .lt-up{color:var(--success) !important;transition:color .2s ease}
  .lt-down{color:var(--danger) !important;transition:color .2s ease}
  .lt-push-banner{position:fixed;left:10px;right:10px;bottom:calc(env(safe-area-inset-bottom,0px) + 86px);z-index:940;
    display:flex;gap:9px;align-items:center;padding:10px 12px;border-radius:14px;
    background:var(--surface);border:1px solid var(--border-strong);box-shadow:var(--shadow)}
  .lt-push-ic{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(135deg,rgba(46,230,201,.18),rgba(58,160,255,.18));color:var(--accent);flex:0 0 auto}
  @media(min-width:760px){.lt-push-banner{left:auto;right:20px;bottom:20px;max-width:400px}}
  .lt-mini{display:inline-block;width:46px;height:22px;margin:0 6px;vertical-align:middle;opacity:.9;flex:0 0 auto}
  .lt-mini svg{width:100%;height:100%;display:block}
  `;
  document.head.appendChild(st);
})();

/* keep spot orders and live positions apart: the spot Orders view expects shares */
(function () {
  if (typeof INV === 'undefined' || INV.__ltPatched) return;
  const base = INV.trades;
  INV.trades = function (userId) {
    return base.call(INV, userId).filter(t => t.type !== 'live');
  };
  INV.__ltPatched = true;
})();

/* ============================ 1D intraday data ============================
   The base engine generated a single point for 1D, so every 1D chart and every
   market sparkline rendered empty. Build a real intraday series instead. */
(function () {
  if (typeof INV === 'undefined' || INV.__lt1d) return;
  const baseSeries = INV.series;
  INV.series = function (ticker, tf) {
    if (tf !== '1D') return baseSeries.call(INV, ticker, tf);
    const s = INV.stock(ticker);
    if (!s) return [];
    const q = INV.quote(ticker);
    const key = ticker + '::1D';
    const cached = INV.seriesCache && INV.seriesCache[key];
    if (cached && cached.length > 20) { cached[cached.length - 1] = q.price; return cached; }
    const n = 78;                                  /* 5-minute bars across a session */
    const rnd = mulberry32(seedOf(ticker + '::1d'));
    const open = q.prevClose || q.price;
    const drift = (q.price - open) / n;
    const out = [];
    let v = open;
    for (let i = 0; i < n; i++) {
      v = v + drift + (rnd() - 0.5) * open * 0.0045;
      out.push(Math.max(0.01, v));
    }
    out[0] = open;
    out[n - 1] = q.price;
    INV.seriesCache = INV.seriesCache || {};
    INV.seriesCache[key] = out;
    return out;
  };
  INV.seriesCache = INV.seriesCache || {};
  INV.__lt1d = true;
})();

/* ======================= 2-second market ticker ==========================
   Every stock card shows live price, direction and a redrawn sparkline so a
   user can see whether it is rising or falling before opening a trade. */
LT.paintMarket = function () {
  if (!DB) return;
  const nodes = document.querySelectorAll('[data-lv]');
  if (!nodes.length) return;
  nodes.forEach(el => {
    const spec = el.getAttribute('data-lv') || '';
    const i = spec.indexOf(':');
    if (i < 0) return;
    const kind = spec.slice(0, i), ticker = spec.slice(i + 1);
    const q = INV.quote(ticker);
    if (!q) return;
    if (kind === 'price') {
      const txt = '$' + q.price.toFixed(2);
      if (el.textContent !== txt) {
        el.textContent = txt;
        el.classList.remove('lt-up', 'lt-down');
        el.classList.add(q.dir > 0 ? 'lt-up' : q.dir < 0 ? 'lt-down' : '');
        setTimeout(() => el.classList.remove('lt-up', 'lt-down'), 800);
      }
    } else if (kind === 'wc') {
      const txt = coins(usdToCoins(q.price)) + ' WC';
      if (el.textContent !== txt) el.textContent = txt;
    } else if (kind === 'pct') {
      const p = q.changePct;
      const txt = (p >= 0 ? '▲ +' : '▼ ') + Math.abs(p).toFixed(2) + '%';
      if (el.textContent !== txt) el.textContent = txt;
      el.classList.toggle('up', p > 0);
      el.classList.toggle('down', p < 0);
    }
  });
  /* redraw the mini charts on the market cards */
  document.querySelectorAll('[data-spark]').forEach(el => {
    const t = el.getAttribute('data-spark');
    const svg = INV.spark(t);
    if (svg && el.innerHTML !== svg) el.innerHTML = svg;
  });
  /* a live trade page chart should breathe too */
  const chart = document.querySelector('[data-lt-live-chart]');
  if (chart) {
    const t = chart.getAttribute('data-lt-live-chart');
    const tf = chart.getAttribute('data-lt-tf') || '1D';
    const mode = chart.getAttribute('data-lt-mode') || 'line';
    const vals = INV.series(t, tf);
    chart.innerHTML = mode === 'candle' ? INV.candleChart(vals) : INV.lineChart(vals, { h: 150 });
  }
};

/* =========================== dashboard (trade aware) ====================== */
const LT_WINDOW = { '1D': 864e5, '1W': 7 * 864e5, '1M': 30 * 864e5, '3M': 90 * 864e5, '1Y': 365 * 864e5, 'ALL': 730 * 864e5 };

LT.positions = function (userId) {
  const trades = LT.open(userId).map(t => {
    const p = LT.calc(t);
    return {
      kind: 'trade', trade: t, ticker: t.ticker, side: t.side, lev: t.leverage,
      capital: t.capitalCoins, entry: t.entryPrice, pnlCoins: p.pnlCoins,
      valueCoins: Math.max(0, t.capitalCoins + p.pnlCoins), pnlPct: p.pnlPct, price: p.price
    };
  });
  const spots = INV.holdings(userId).map(h => {
    const q = INV.quote(h.ticker) || { price: h.avgPrice, prevClose: h.avgPrice };
    const valueUsd = h.shares * q.price;
    return {
      kind: 'spot', holding: h, ticker: h.ticker, side: 'long', lev: 1,
      capital: usdToCoins(h.shares * h.avgPrice), entry: h.avgPrice,
      pnlCoins: usdToCoins(valueUsd - h.shares * h.avgPrice),
      valueCoins: usdToCoins(valueUsd),
      pnlPct: h.avgPrice ? (q.price / h.avgPrice - 1) * 100 : 0, price: q.price
    };
  });
  return trades.concat(spots);
};

LT.summary = function (userId) {
  const pos = LT.positions(userId);
  const valueCoins = pos.reduce((s, p) => s + p.valueCoins, 0);
  const capital = pos.reduce((s, p) => s + p.capital, 0);
  const pnl = pos.reduce((s, p) => s + p.pnlCoins, 0);
  const u = me();
  return {
    pos, valueCoins, capital, pnl,
    valueUsd: coinsToUsd(valueCoins),
    capitalUsd: coinsToUsd(capital),
    pnlUsd: coinsToUsd(pnl),
    pnlPct: capital ? (pnl / capital) * 100 : 0,
    cash: (u && u.balance) || 0,
    live: pos.filter(p => p.kind === 'trade').length
  };
};

/* series for the performance chart: spot holdings + live trades */
LT.seriesWithTrades = function (tf, userId) {
  const pos = LT.positions(userId);
  if (!pos.length) return [];
  const win = LT_WINDOW[tf] || LT_WINDOW['1M'];
  const now = Date.now();
  const series = pos.map(p => ({ p, data: INV.series(p.ticker, tf) }));
  const len = Math.max(...series.map(s => s.data.length));
  const out = [];
  for (let i = 0; i < len; i++) {
    let v = 0;
    series.forEach(({ p, data }) => {
      if (!data.length) { v += p.capital; return; }
      const price = data[Math.min(i, data.length - 1)];
      if (p.kind === 'spot') { v += (p.holding.shares * price) * (1 / COIN_USD); return; }
      const t = p.trade;
      const idx = Math.min(data.length - 1, i);
      const msAgo = (1 - idx / Math.max(1, data.length - 1)) * win;
      const started = now - (t.createdAt || now);
      if (msAgo > started) { v += p.capital; return; }           /* before entry: flat capital */
      const dir = t.side === 'short' ? -1 : 1;
      const move = t.entryPrice ? (price - t.entryPrice) / t.entryPrice : 0;
      const pnl = Math.max(-p.capital, p.capital * (t.leverage || 1) * move * dir);
      v += Math.max(0, p.capital + pnl);
    });
    out.push(v);
  }
  return out;
};

LT.allocSlices = function (userId) {
  const map = {};
  LT.positions(userId).forEach(p => { map[p.ticker] = (map[p.ticker] || 0) + p.valueCoins; });
  return Object.keys(map).map(t => ({ ticker: t, val