{$DOMAIN:localhost} {
	encode zstd gzip
	@events path /api/events
	handle @events {
		reverse_proxy whalechat:8090 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy whalechat:8090
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
