{
  "name": "whalechat",
  "version": "3.62.10",
  "private": true,
  "description": "WhaleChat — chat, marketplace and wallet. Web app + sync server + Android/iOS shells.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:mobile": "node scripts/build-mobile.mjs",
    "build": "node scripts/prepare-assets.js",
    "demo:catalog": "node scripts/generate-demo-catalog.mjs",
    "verify:finnhub": "node scripts/verify-finnhub.js",
    "test:b2b": "node scripts/test-b2b-desk.js",
    "verify:b2b": "node scripts/verify-b2b-links.mjs",
    "test:wc-invest": "node scripts/test-wc-invest.js",
    "test:chat": "node scripts/test-chat-live.js",
    "test:chat-client": "node scripts/test-chat-presence-client.js",
    "build:pages": "bash scripts/build-pages.sh",
    "restore:users": "node scripts/restore-users-360.mjs",
    "db:init": "cd cloudflare/whalechat-api && wrangler d1 execute whalechat_db --file=./schema.sql --remote",
    "db:check": "node scripts/check-cloudflare-db.mjs",
    "test:email-worker": "node scripts/validate-email-worker.mjs",
    "test:composer": "node scripts/test-composer-clear.mjs"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "pg": "^8.11.5",
    "ws": "^8.18.0"
  }
}
