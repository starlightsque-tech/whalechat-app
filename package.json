{
  "name": "whalechat",
  "version": "3.65.0",
  "private": true,
  "description": "WhaleChat \u2014 chat, marketplace and wallet. Web app + sync server + Android/iOS shells.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:mobile": "node scripts/build-mobile.mjs",
    "build": "node scripts/verify-connections.js && node scripts/prepare-assets.js",
    "demo:catalog": "node scripts/generate-demo-catalog.mjs",
    "verify:finnhub": "node scripts/verify-finnhub.js",
    "test:b2b": "node scripts/test-b2b-desk.js",
    "verify:b2b": "node scripts/verify-b2b-links.mjs",
    "test:wc-invest": "node scripts/test-wc-invest.js",
    "test:offline": "node scripts/test-offline.js",
    "test:brevo": "node scripts/test-brevo.js",
    "deploy:render": "node scripts/deploy-render.mjs",
    "test:offline:runtime": "node scripts/test-offline-runtime.js",
    "backup:state": "node scripts/backup-state.mjs",
    "restore:state": "node scripts/restore-state.mjs",
    "test:ui": "node scripts/test-trading-ui.mjs",
    "audit:routes": "node scripts/audit-routes.js --all",
    "verify:twelvedata": "node scripts/verify-twelvedata.js",
    "deploy:appwrite": "node scripts/deploy-appwrite.mjs",
    "test:v357": "node scripts/test-v357.mjs",
    "verify:connections": "node scripts/verify-connections.js",
    "deploy:appwrite:db": "node scripts/deploy-appwrite-collections.mjs",
    "deploy:appwrite:function": "node scripts/deploy-appwrite-function.mjs",
    "deploy:appwrite:all": "node scripts/deploy-appwrite-collections.mjs && node scripts/deploy-appwrite-function.mjs && node scripts/deploy-appwrite.mjs",
    "test:offline-trading": "node scripts/test-offline-trading.mjs",
    "mono:build": "turbo run build",
    "mono:typecheck": "turbo run typecheck",
    "mono:test": "turbo run test",
    "dev:web": "pnpm --filter @whalechat/web dev",
    "build:web": "pnpm --filter @whalechat/web build",
    "build:shared": "pnpm --filter @whalechat/shared build",
    "dev:mobile": "pnpm --filter @whalechat/mobile start",
    "appwrite:provision": "node scripts/provision-monorepo-appwrite.mjs"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "nodemailer": "^6.9.14",
    "pg": "^8.11.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "fake-indexeddb": "^6.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3",
    "pnpm": "^10.4.1"
  },
  "packageManager": "pnpm@10.34.9"
}
