{
  "name": "@whalechat/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile production",
    "clean": "node -e \"import('node:fs').then(f=>f.rmSync('.expo',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@react-native-community/netinfo": "11.4.1",
    "@whalechat/shared": "workspace:*",
    "expo": "~52.0.46",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.20",
    "expo-status-bar": "~2.0.1",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-mmkv": "^3.2.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.3.12",
    "eas-cli": "^13.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
