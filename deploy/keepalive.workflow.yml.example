# Keeps the Render service warm so nobody meets a cold start.
# Render (and most hosts) count any request as activity; a small health ping
# every 10 minutes keeps the instance responsive around the clock.
name: keep-alive

on:
  schedule:
    - cron: '*/10 * * * *'   # every 10 minutes (GitHub may delay under load)
  workflow_dispatch:

concurrency:
  group: keepalive
  cancel-in-progress: true

jobs:
  ping:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Ping WhaleChat
        env:
          APP_URL: ${{ vars.WHALECHAT_URL || 'https://whalechat-qkgd.onrender.com' }}
        run: |
          set -e
          for i in 1 2 3; do
            code=$(curl -s -o /dev/null -m 60 -w '%{http_code}' "$APP_URL/api/health" || echo 000)
            echo "attempt $i -> HTTP $code"
            if [ "$code" = "200" ]; then exit 0; fi
            sleep 20
          done
          echo "App did not answer 200 — leaving a red run so it is visible"
          exit 1
