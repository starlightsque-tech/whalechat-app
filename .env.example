PORT=8090
DATA_DIR=./data
PUBLIC_URL=https://chat.yourdomain.com
VAPID_EMAIL=support@whalechat.app
BACKUP_KEEP=48
FINNHUB_API_KEY=
FINNHUB_MODE=simulated

# --- Brevo email (connect the app's mail server) -------------------------
# Brevo transactional API (recommended; also settable in Admin → Servers)
BREVO_API_KEY=
BREVO_FROM=whalechat1@gmail.com
BREVO_FROM_NAME=WhaleChat
# Brevo SMTP relay (alternative to the API key)
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
# Shared sender used for every provider
MAIL_FROM=whalechat1@gmail.com
MAIL_FROM_NAME=WhaleChat
