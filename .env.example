PORT=8090
DATA_DIR=./data
PUBLIC_URL=https://chat.yourdomain.com
VAPID_EMAIL=support@whalechat.app
BACKUP_KEEP=48
FINNHUB_API_KEY=
FINNHUB_MODE=simulated
# 3.46: required for admin sessions and encrypted provider keys
# long random strings, e.g. `openssl rand -hex 32`; keep them secret and stable
ADMIN_SESSION_SECRET=
WC_ENCRYPTION_KEY=
DATABASE_URL=
TWELVEDATA_API_KEY=
TWELVEDATA_MS=65000
# free keys allow 8 credits/min; 6 keeps headroom for an admin test
TWELVEDATA_BATCH=6
# keep 3000 ticks/symbol; rows older than this are pruned
MARKET_TICK_RETENTION_MS=1209600000

# 3.57: Appwrite backup + static-site deployment
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=whalechat
APPWRITE_DATABASE_ID=whalechat
APPWRITE_SITE_ID=whalechat
