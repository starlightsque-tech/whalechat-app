# WhaleChat 3.64.0 — server configuration
# Copy to .env and fill the secrets. NOTHING here is committed with a value.
PORT=8090
DATA_DIR=./data
PUBLIC_URL=https://whalechat.appwrite.network
VAPID_EMAIL=support@whalechat.app
BACKUP_KEEP=48

# ---------------------------------------------------------------- Appwrite
# New server configuration (3.64): the NYC region project.
# The endpoint + project id are public and also shipped in
# public/wc-server-config.js; the API key is server-only.
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6aff3eda000983f5a975
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=6aff48620020a44c714f
APPWRITE_DATABASE_ID=6aff488e0006a3fe39e0
APPWRITE_SITE_ID=whalechat
APPWRITE_SITE_NAME=WhaleChat
APPWRITE_FUNCTION_ID=whalechat-sync

# ------------------------------------------------------- Telesign (SMS/OTP)
# Server-side only: the app calls /api/telesign/* and the server signs the
# Telesign request with HTTP Basic auth. Never expose these in the browser.
TELESIGN_CUSTOMER_ID=
TELESIGN_API_KEY=
TELESIGN_BASE_API=https://rest-ww.telesign.com/v1
TELESIGN_SENDER_ID=
TELESIGN_VERIFY_TEMPLATE=Your WhaleChat code is $$CODE$$. It expires in 5 minutes.
TELESIGN_CODE_TTL_MS=300000
# set to 0 outside North America only if Telesign provisioning requires it
TELESIGN_DEFAULT_COUNTRY=1

# ------------------------------------------------------------ Brevo (email)
# Transactional receipts, verification mail and offline trade summaries.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=whalechat1@gmail.com
BREVO_SENDER_NAME=WhaleChat
MAIL_FROM=whalechat1@gmail.com
MAIL_FROM_NAME=WhaleChat

# ------------------------------------------------- market data (server side)
FINNHUB_API_KEY=
FINNHUB_MODE=hybrid
TWELVEDATA_API_KEY=
TWELVEDATA_MS=65000
TWELVEDATA_BATCH=6
BINANCE_WS=wss://stream.binance.com:9443/stream
BINANCE_MS=15000
MARKET_TICK_RETENTION_MS=1209600000

# ---------------------------------------- offline → online reconciliation
# Market orders inside this band honour the offline execution price.
WC_OFFLINE_TOLERANCE_PCT=2
WC_OFFLINE_BATCH=25

# ------------------------------------------------------------------ security
ADMIN_SESSION_SECRET=
WC_ENCRYPTION_KEY=
DATABASE_URL=
